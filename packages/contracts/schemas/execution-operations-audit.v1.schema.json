{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-operations-audit.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "items",
    "has_more",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.operations-audit.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit_id",
          "at_ms",
          "actor",
          "action",
          "subject",
          "receipt_ref"
        ],
        "properties": {
          "audit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "action": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "OPERATION",
                  "INCIDENT",
                  "ACCOUNT",
                  "PORTFOLIO",
                  "DEPLOYMENT",
                  "APPROVAL",
                  "CAPITAL_COMMAND",
                  "ACCESS_GRANT"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              }
            }
          },
          "receipt_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy_revision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "type": "object",
      "if": {
        "type": "object",
        "required": [
          "has_more"
        ],
        "properties": {
          "has_more": {
            "const": true
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "next_cursor": {
            "type": "null"
          }
        }
      }
    }
  ]
}
