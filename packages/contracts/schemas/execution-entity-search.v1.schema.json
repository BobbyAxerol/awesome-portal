{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-entity-search.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "query",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.entity-search.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "kinds",
        "limit"
      ],
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "alpha",
              "portfolio",
              "account",
              "operation",
              "incident",
              "approval"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "total_matched",
          "rows"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "alpha",
              "portfolio",
              "account",
              "operation",
              "incident",
              "approval"
            ]
          },
          "total_matched": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "rows": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "label",
                "detail",
                "route_hint"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "alpha",
                    "portfolio",
                    "account",
                    "operation",
                    "incident",
                    "approval"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 191,
                  "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                },
                "detail": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "route_hint": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 512,
                  "pattern": "^/[^\\u0000-\\u001f\\u007f\\s]*$(?![\\s\\S])"
                }
              }
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "NOT_COMMISSIONED"
            ]
          }
        },
        "if": {
          "properties": {
            "state": {
              "const": "NOT_COMMISSIONED"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        "then": {
          "properties": {
            "total_matched": {
              "type": "null"
            },
            "rows": {
              "type": "array",
              "maxItems": 0
            }
          },
          "type": "object"
        }
      }
    }
  }
}
