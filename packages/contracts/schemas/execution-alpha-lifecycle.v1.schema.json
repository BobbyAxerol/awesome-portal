{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-alpha-lifecycle.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "alpha_id",
    "record_authority",
    "read_at_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.alpha-lifecycle.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "alpha_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
    },
    "alpha_version_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stages": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "state",
              "entered_at_ms",
              "exited_at_ms",
              "days_in_stage",
              "criteria",
              "decider_role",
              "decided_by",
              "receipt_ref",
              "blocked_reason"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "R1",
                  "R2",
                  "PAPER",
                  "SANDBOX",
                  "CANARY",
                  "LIVE"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "DONE",
                  "CURRENT",
                  "BLOCKED",
                  "NOT_STARTED"
                ]
              },
              "entered_at_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exited_at_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "days_in_stage": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "criteria": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "met",
                      "total",
                      "items"
                    ],
                    "properties": {
                      "met": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "items": {
                        "type": "array",
                        "maxItems": 32,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "label",
                            "observed",
                            "threshold",
                            "met"
                          ],
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                            },
                            "observed": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "threshold": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "met": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decider_role": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decided_by": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "receipt_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "blocked_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "truncated",
            "items"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "truncated": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_id",
                  "kind",
                  "at_ms",
                  "title",
                  "actor",
                  "receipt_ref"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "stage",
                      "decision",
                      "incident",
                      "recall",
                      "flow"
                    ]
                  },
                  "at_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  "actor": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "receipt_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 191,
                        "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "regime_fit": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "ratio_scale",
            "value",
            "reason_code"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "PUBLISHED",
                "NOT_PUBLISHED"
              ]
            },
            "ratio_scale": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "FRACTION",
                    "PERCENT"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason_code": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "INSUFFICIENT_DATA",
                    "REGIME_MODEL_NOT_PUBLISHED"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "venue_net_pnl": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "venue",
              "economic_domain",
              "currency",
              "net_pnl",
              "as_of_ms"
            ],
            "properties": {
              "venue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "economic_domain": {
                "type": "string",
                "enum": [
                  "ACTUAL",
                  "PAPER",
                  "SANDBOX"
                ]
              },
              "currency": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "net_pnl": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])",
                "maxLength": 80
              },
              "as_of_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "type": "object",
      "if": {
        "type": "object",
        "required": [
          "regime_fit"
        ],
        "properties": {
          "regime_fit": {
            "type": "object",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "PUBLISHED"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "regime_fit": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "ratio_scale": {
                "type": "string"
              },
              "reason_code": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "type": "object",
      "if": {
        "type": "object",
        "required": [
          "regime_fit"
        ],
        "properties": {
          "regime_fit": {
            "type": "object",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "NOT_PUBLISHED"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "regime_fit": {
            "type": "object",
            "properties": {
              "value": {
                "type": "null"
              },
              "ratio_scale": {
                "type": "null"
              },
              "reason_code": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
