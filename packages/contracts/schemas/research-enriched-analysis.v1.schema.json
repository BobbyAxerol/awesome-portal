{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.enriched-analysis.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service",
    "basis",
    "lane",
    "run_id",
    "input_digest",
    "source_tables",
    "scope",
    "windows",
    "facts",
    "curves",
    "monthly_returns",
    "return_distribution",
    "drawdown_episodes",
    "library_summary",
    "rolling"
  ],
  "properties": {
    "schema_version": {
      "const": "research.enriched-analysis.v1"
    },
    "service": {
      "const": "enrich_analysis"
    },
    "basis": {
      "const": "ALL_TIME"
    },
    "lane": {
      "enum": [
        "FIXED",
        "WFO"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^rrun_[a-f0-9]{32}$"
    },
    "input_digest": {
      "$ref": "#/$defs/Digest"
    },
    "source_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "row_count",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,64}$"
          },
          "row_count": {
            "$ref": "#/$defs/Count"
          },
          "digest": {
            "$ref": "#/$defs/Digest"
          }
        }
      },
      "maxItems": 8,
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "first_at_utc_ms",
        "last_at_utc_ms",
        "observation_count",
        "fold_count",
        "locator",
        "benchmark_locator",
        "coverage",
        "source_observation_count"
      ],
      "properties": {
        "window": {
          "const": "OOS"
        },
        "first_at_utc_ms": {
          "$ref": "#/$defs/UtcMs"
        },
        "last_at_utc_ms": {
          "$ref": "#/$defs/UtcMs"
        },
        "observation_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2000000
        },
        "fold_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "benchmark_locator": {
          "$ref": "#/$defs/Locator"
        },
        "coverage": {
          "enum": [
            "FULL_RETAINED_OOS",
            "SAMPLED_RETAINED_EQUITY"
          ]
        },
        "source_observation_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2000000
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is",
        "oos",
        "holdout"
      ],
      "properties": {
        "is": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "NOT_PUBLISHED",
                "NOT_APPLICABLE"
              ]
            },
            "reason_code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "start_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "end_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "source_locator": {
              "$ref": "#/$defs/Locator"
            },
            "bounds_semantics": {
              "const": "START_INCLUSIVE_END_EXCLUSIVE"
            }
          },
          "dependentRequired": {
            "start_ms": [
              "end_ms",
              "source_locator",
              "bounds_semantics"
            ],
            "end_ms": [
              "start_ms",
              "source_locator",
              "bounds_semantics"
            ],
            "source_locator": [
              "start_ms",
              "end_ms",
              "bounds_semantics"
            ],
            "bounds_semantics": [
              "start_ms",
              "end_ms",
              "source_locator"
            ]
          }
        },
        "oos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "NOT_PUBLISHED",
                "NOT_APPLICABLE"
              ]
            },
            "reason_code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "start_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "end_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "source_locator": {
              "$ref": "#/$defs/Locator"
            },
            "bounds_semantics": {
              "const": "START_INCLUSIVE_END_EXCLUSIVE"
            }
          },
          "dependentRequired": {
            "start_ms": [
              "end_ms",
              "source_locator",
              "bounds_semantics"
            ],
            "end_ms": [
              "start_ms",
              "source_locator",
              "bounds_semantics"
            ],
            "source_locator": [
              "start_ms",
              "end_ms",
              "bounds_semantics"
            ],
            "bounds_semantics": [
              "start_ms",
              "end_ms",
              "source_locator"
            ]
          }
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "NOT_PUBLISHED",
                "NOT_APPLICABLE"
              ]
            },
            "reason_code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "start_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "end_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "source_locator": {
              "$ref": "#/$defs/Locator"
            },
            "bounds_semantics": {
              "const": "START_INCLUSIVE_END_EXCLUSIVE"
            }
          },
          "dependentRequired": {
            "start_ms": [
              "end_ms",
              "source_locator",
              "bounds_semantics"
            ],
            "end_ms": [
              "start_ms",
              "source_locator",
              "bounds_semantics"
            ],
            "source_locator": [
              "start_ms",
              "end_ms",
              "bounds_semantics"
            ],
            "bounds_semantics": [
              "start_ms",
              "end_ms",
              "source_locator"
            ]
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics",
        "behaviour"
      ],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sharpe",
            "sortino",
            "cagr_fraction",
            "profit_factor",
            "long_hit_rate_fraction",
            "short_hit_rate_fraction",
            "volatility_fraction",
            "skew",
            "excess_kurtosis",
            "beta",
            "correlation",
            "benchmark_return_fraction",
            "max_drawdown_duration_days",
            "sharpe_decay"
          ],
          "properties": {
            "sharpe": {
              "$ref": "#/$defs/Fact"
            },
            "sortino": {
              "$ref": "#/$defs/Fact"
            },
            "cagr_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "profit_factor": {
              "$ref": "#/$defs/Fact"
            },
            "long_hit_rate_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "short_hit_rate_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "volatility_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "skew": {
              "$ref": "#/$defs/Fact"
            },
            "excess_kurtosis": {
              "$ref": "#/$defs/Fact"
            },
            "beta": {
              "$ref": "#/$defs/Fact"
            },
            "correlation": {
              "$ref": "#/$defs/Fact"
            },
            "benchmark_return_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "max_drawdown_duration_days": {
              "$ref": "#/$defs/Fact"
            },
            "sharpe_decay": {
              "$ref": "#/$defs/Fact"
            }
          }
        },
        "behaviour": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exposure_long_fraction",
            "exposure_short_fraction",
            "exposure_flat_fraction",
            "win_rate",
            "payoff_ratio",
            "average_hold_seconds",
            "max_consecutive_losses",
            "turnover_notional"
          ],
          "properties": {
            "exposure_long_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "exposure_short_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "exposure_flat_fraction": {
              "$ref": "#/$defs/Fact"
            },
            "win_rate": {
              "$ref": "#/$defs/Fact"
            },
            "payoff_ratio": {
              "$ref": "#/$defs/Fact"
            },
            "average_hold_seconds": {
              "$ref": "#/$defs/Fact"
            },
            "max_consecutive_losses": {
              "$ref": "#/$defs/Fact"
            },
            "turnover_notional": {
              "$ref": "#/$defs/Fact"
            }
          }
        }
      }
    },
    "curves": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampling",
        "strategy_rebased_100",
        "benchmark_rebased_100",
        "drawdown_fraction"
      ],
      "properties": {
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_observation_count",
            "emitted_point_count",
            "method"
          ],
          "properties": {
            "source_observation_count": {
              "$ref": "#/$defs/Count"
            },
            "emitted_point_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "method": {
              "const": "EXTREMA_BUCKET_V1"
            }
          }
        },
        "strategy_rebased_100": {
          "$ref": "#/$defs/Curve"
        },
        "benchmark_rebased_100": {
          "$ref": "#/$defs/Curve"
        },
        "drawdown_fraction": {
          "$ref": "#/$defs/Curve"
        }
      }
    },
    "monthly_returns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "origin",
        "includes_partial_months",
        "sampling",
        "total_period_count",
        "omitted_transport_period_count",
        "definition_id",
        "values"
      ],
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "NOT_PUBLISHED",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "const": "PORTAL_DERIVED"
        },
        "includes_partial_months": {
          "const": true
        },
        "sampling": {
          "enum": [
            "FULL",
            "TAIL_WINDOW_V1"
          ]
        },
        "total_period_count": {
          "$ref": "#/$defs/Count"
        },
        "omitted_transport_period_count": {
          "$ref": "#/$defs/Count"
        },
        "definition_id": {
          "const": "OOS_MONTH_CLOSE_OVER_FIRST_OOS_OR_PREVIOUS_OBSERVED_MONTH_CLOSE_V1"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "month_start_utc_ms",
              "return_fraction",
              "observation_count",
              "expected_observation_count",
              "partial",
              "basis",
              "base_at_utc_ms",
              "close_at_utc_ms"
            ],
            "properties": {
              "month_start_utc_ms": {
                "$ref": "#/$defs/UtcMs"
              },
              "return_fraction": {
                "$ref": "#/$defs/Decimal"
              },
              "observation_count": {
                "$ref": "#/$defs/Count"
              },
              "expected_observation_count": {
                "$ref": "#/$defs/Count"
              },
              "partial": {
                "type": "boolean"
              },
              "basis": {
                "enum": [
                  "FIRST_OOS_CLOSE",
                  "PREVIOUS_OBSERVED_MONTH_CLOSE"
                ]
              },
              "base_at_utc_ms": {
                "$ref": "#/$defs/UtcMs"
              },
              "close_at_utc_ms": {
                "$ref": "#/$defs/UtcMs"
              }
            }
          },
          "maxItems": 120
        }
      }
    },
    "return_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "origin",
        "sampling",
        "observation_count",
        "bucket_basis",
        "buckets"
      ],
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "NOT_PUBLISHED",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "const": "PORTAL_DERIVED"
        },
        "sampling": {
          "const": "UTC_DAY"
        },
        "observation_count": {
          "$ref": "#/$defs/Count"
        },
        "bucket_basis": {
          "const": "ALL_TIME_SOURCE_UTC_DAILY_RETURNS_12_BIN_V1"
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lower_inclusive",
              "upper",
              "upper_inclusive",
              "count"
            ],
            "properties": {
              "lower_inclusive": {
                "$ref": "#/$defs/Decimal"
              },
              "upper": {
                "$ref": "#/$defs/Decimal"
              },
              "upper_inclusive": {
                "enum": [
                  "true",
                  "false"
                ]
              },
              "count": {
                "$ref": "#/$defs/Count"
              }
            }
          },
          "maxItems": 12
        },
        "statistics_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantile_method",
            "probability",
            "risk_variable",
            "risk_sign",
            "tail",
            "minimum_observations"
          ],
          "properties": {
            "quantile_method": {
              "const": "LINEAR_TYPE_7"
            },
            "probability": {
              "const": "0.95"
            },
            "risk_variable": {
              "const": "LOSS_FRACTION_NEGATIVE_RETURN"
            },
            "risk_sign": {
              "const": "SIGNED_LOSS_FRACTION"
            },
            "tail": {
              "const": "LOSS_GTE_VAR_INCLUSIVE"
            },
            "minimum_observations": {
              "const": 2
            }
          }
        },
        "mean": {
          "$ref": "#/$defs/Fact"
        },
        "median": {
          "$ref": "#/$defs/Fact"
        },
        "var_95": {
          "$ref": "#/$defs/Fact"
        },
        "cvar_95": {
          "$ref": "#/$defs/Fact"
        }
      },
      "dependentRequired": {
        "statistics_policy": [
          "mean",
          "median",
          "var_95",
          "cvar_95"
        ],
        "mean": [
          "statistics_policy",
          "median",
          "var_95",
          "cvar_95"
        ],
        "median": [
          "statistics_policy",
          "mean",
          "var_95",
          "cvar_95"
        ],
        "var_95": [
          "statistics_policy",
          "mean",
          "median",
          "cvar_95"
        ],
        "cvar_95": [
          "statistics_policy",
          "mean",
          "median",
          "var_95"
        ]
      }
    },
    "drawdown_episodes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "origin",
        "total",
        "open_episode_present",
        "longest_open",
        "values"
      ],
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "NOT_PUBLISHED",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "const": "PORTAL_DERIVED"
        },
        "total": {
          "$ref": "#/$defs/Count"
        },
        "open_episode_present": {
          "type": "boolean"
        },
        "longest_open": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_utc_ms",
              "trough_utc_ms",
              "recovery_utc_ms",
              "depth_fraction",
              "duration_seconds"
            ],
            "properties": {
              "start_utc_ms": {
                "$ref": "#/$defs/UtcMs"
              },
              "trough_utc_ms": {
                "$ref": "#/$defs/UtcMs"
              },
              "recovery_utc_ms": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/UtcMs"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depth_fraction": {
                "$ref": "#/$defs/Decimal"
              },
              "duration_seconds": {
                "$ref": "#/$defs/UtcMs"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "regime": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "reason_code",
                  "value",
                  "source_locator",
                  "input_digest"
                ],
                "properties": {
                  "state": {
                    "const": "NOT_PUBLISHED"
                  },
                  "reason_code": {
                    "const": "SOURCE_DID_NOT_PUBLISH_MARKET_REGIME"
                  },
                  "value": {
                    "type": "null"
                  },
                  "source_locator": {
                    "$ref": "#/$defs/Locator"
                  },
                  "input_digest": {
                    "$ref": "#/$defs/Digest"
                  }
                }
              }
            }
          },
          "maxItems": 10
        }
      }
    },
    "library_summary": {
      "$ref": "#/$defs/LibrarySummary"
    },
    "rolling": {
      "type": "null"
    }
  },
  "$defs": {
    "MonthlyPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month_start_utc_ms",
        "return_fraction",
        "partial",
        "observation_count",
        "basis",
        "base_at_utc_ms",
        "close_at_utc_ms"
      ],
      "properties": {
        "month_start_utc_ms": {
          "$ref": "#/$defs/UtcMs"
        },
        "return_fraction": {
          "$ref": "#/$defs/Decimal"
        },
        "partial": {
          "type": "boolean"
        },
        "observation_count": {
          "$ref": "#/$defs/PositiveCount"
        },
        "basis": {
          "enum": [
            "FIRST_OOS_CLOSE",
            "PREVIOUS_OBSERVED_MONTH_CLOSE"
          ]
        },
        "base_at_utc_ms": {
          "$ref": "#/$defs/UtcMs"
        },
        "close_at_utc_ms": {
          "$ref": "#/$defs/UtcMs"
        }
      }
    },
    "DistributionBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_inclusive",
        "upper",
        "upper_inclusive",
        "count"
      ],
      "properties": {
        "lower_inclusive": {
          "$ref": "#/$defs/Decimal"
        },
        "upper": {
          "$ref": "#/$defs/Decimal"
        },
        "upper_inclusive": {
          "enum": [
            "true",
            "false"
          ]
        },
        "count": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 7
        }
      }
    },
    "Distributions": {
      "title": "ResearchAllTimeDistributions",
      "type": "object",
      "additionalProperties": false,
      "description": "Additive precomputed OOS companion, including a partial leading month. Daily histogram is all-time, not a trade or per-bar histogram. Original seals remain immutable.",
      "required": [
        "schema_version",
        "origin",
        "scope",
        "scope_locator",
        "input_digest",
        "oos_observation_count",
        "monthly_definition",
        "distribution_definition",
        "monthly_returns",
        "return_distribution"
      ],
      "properties": {
        "schema_version": {
          "const": "research.all-time-distributions.v1"
        },
        "origin": {
          "const": "PORTAL_DERIVED"
        },
        "scope": {
          "const": "OOS"
        },
        "scope_locator": {
          "$ref": "#/$defs/Locator"
        },
        "input_digest": {
          "$ref": "#/$defs/Digest"
        },
        "oos_observation_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2000000
        },
        "monthly_definition": {
          "const": "OOS_MONTH_CLOSE_OVER_FIRST_OOS_OR_PREVIOUS_OBSERVED_MONTH_CLOSE_V1"
        },
        "distribution_definition": {
          "const": "ALL_TIME_SOURCE_UTC_DAILY_RETURNS_12_BIN_V1"
        },
        "monthly_returns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code",
            "source_observation_count",
            "emitted_point_count",
            "total_period_count",
            "omitted_leading_period_count",
            "omitted_transport_period_count",
            "sampling",
            "values"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "reason_code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_observation_count": {
              "$ref": "#/$defs/Count"
            },
            "emitted_point_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "total_period_count": {
              "$ref": "#/$defs/Count"
            },
            "omitted_leading_period_count": {
              "$ref": "#/$defs/Count"
            },
            "omitted_transport_period_count": {
              "$ref": "#/$defs/Count"
            },
            "sampling": {
              "enum": [
                "FULL",
                "TAIL_WINDOW_V1"
              ]
            },
            "values": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/MonthlyPoint"
              }
            }
          }
        },
        "return_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code",
            "source_observation_count",
            "emitted_point_count",
            "sampling",
            "values"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "reason_code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_observation_count": {
              "$ref": "#/$defs/Count"
            },
            "emitted_point_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "sampling": {
              "enum": [
                "FULL_RETURN_HISTOGRAM_V2",
                "NOT_APPLICABLE"
              ]
            },
            "values": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/DistributionBucket"
              }
            }
          }
        }
      }
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 96
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UtcMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000000
    },
    "PositiveCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "Locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Reason": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,159}$"
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "value",
        "origin",
        "scope",
        "source_locator",
        "input_digest"
      ],
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "NOT_PUBLISHED",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "ENGINE_DIRECT",
            "PORTAL_DERIVED"
          ]
        },
        "scope": {
          "const": "OOS"
        },
        "source_locator": {
          "$ref": "#/$defs/Locator"
        },
        "input_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/Decimal"
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason_code": {
                "$ref": "#/$defs/Reason"
              }
            }
          }
        }
      ]
    },
    "Curve": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at_utc_ms",
          "value"
        ],
        "properties": {
          "at_utc_ms": {
            "$ref": "#/$defs/UtcMs"
          },
          "value": {
            "$ref": "#/$defs/Decimal"
          }
        }
      }
    },
    "LibrarySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code",
        "label",
        "basis",
        "sparkline",
        "sampling",
        "source_observation_count",
        "coverage",
        "return_fraction",
        "sharpe",
        "max_drawdown_fraction",
        "input_digest"
      ],
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "NOT_PUBLISHED",
            "NOT_APPLICABLE"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "const": "all time"
        },
        "basis": {
          "const": "ALL_TIME"
        },
        "sparkline": {
          "$ref": "#/$defs/Curve"
        },
        "sampling": {
          "const": "EXTREMA_BUCKET_V1"
        },
        "source_observation_count": {
          "$ref": "#/$defs/Count"
        },
        "coverage": {
          "enum": [
            "FULL_RETAINED_OOS",
            "SAMPLED_RETAINED_EQUITY"
          ]
        },
        "return_fraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "sharpe": {
          "$ref": "#/$defs/Fact"
        },
        "max_drawdown_fraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_digest": {
          "$ref": "#/$defs/Digest"
        },
        "return_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition_id",
            "scope",
            "first_at_utc_ms",
            "last_at_utc_ms",
            "start_equity",
            "end_equity",
            "source_locator"
          ],
          "properties": {
            "definition_id": {
              "const": "FIRST_LAST_RETAINED_OOS_EQUITY_V1"
            },
            "scope": {
              "const": "RETAINED_OOS_OBSERVATIONS"
            },
            "first_at_utc_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "last_at_utc_ms": {
              "$ref": "#/$defs/UtcMs"
            },
            "start_equity": {
              "$ref": "#/$defs/Decimal"
            },
            "end_equity": {
              "$ref": "#/$defs/Decimal"
            },
            "source_locator": {
              "$ref": "#/$defs/Locator"
            }
          }
        }
      }
    }
  }
}
