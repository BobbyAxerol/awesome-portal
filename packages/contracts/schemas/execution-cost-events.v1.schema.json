{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-cost-events.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.cost-events.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ALPHA",
            "PORTFOLIO",
            "ACCOUNT",
            "DEPLOYMENT",
            "OPERATION",
            "INCIDENT",
            "APPROVAL"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        }
      }
    },
    "events": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "kind",
              "at_ms",
              "currency",
              "amount",
              "order_id"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "FEE",
                  "FUNDING",
                  "INTEREST"
                ]
              },
              "at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "amount": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
              },
              "order_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "totals": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "currency",
              "amount"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "FEE",
                  "FUNDING",
                  "INTEREST"
                ]
              },
              "currency": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "amount": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
