{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-alpha-resource.v1.schema.json",
  "title": "Alpha 360 resource, LEGACY_COMPATIBILITY body (execution.alpha-resource.v1)",
  "description": "The body GET /resources/alphas/{id} returns while the workspace is NOT in SCOPED_V2. In SCOPED_V2 the same route answers execution.alpha-resource.v2 (execution-resource-scoped.v2.schema.json): raw authorized facts only, no alpha_label/version/health summary. The server, not the browser, selects the variant; a reader must dispatch on schema_version. Names: alpha_label is \"Unnamed alpha\" and deployments[].portfolio_name is null because no execution source publishes an alpha or allocation-level portfolio name (portfolios[].name is the portfolio relation's own name, join it on portfolio_id). Money is an exact decimal string. Synthetic fixtures are produced by the real service and do not certify production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_authority",
    "source_authority",
    "delivery_profile",
    "workspace_id",
    "requested_environment",
    "selected_environment",
    "resource",
    "read_at_ms",
    "as_of_ms",
    "read_at",
    "as_of",
    "state",
    "freshness",
    "completeness",
    "projection",
    "capabilities",
    "panels",
    "data",
    "unavailable_branches",
    "actor"
  ],
  "properties": {
    "schema_version": {
      "const": "execution.alpha-resource.v1"
    },
    "record_authority": {
      "const": "PORTAL_CONTROL"
    },
    "source_authority": {
      "const": "TRADING_SYSTEM"
    },
    "delivery_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requested_environment": {
      "enum": [
        "all",
        "paper",
        "sandbox",
        "live"
      ]
    },
    "selected_environment": {
      "anyOf": [
        {
          "enum": [
            "paper",
            "sandbox",
            "live"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "ALPHA"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": -8640000000000000,
      "maximum": 8640000000000000
    },
    "as_of_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -8640000000000000,
          "maximum": 8640000000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "read_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "as_of": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "ready",
        "empty",
        "partial",
        "stale",
        "unavailable"
      ]
    },
    "freshness": {
      "enum": [
        "FRESH",
        "AGING",
        "STALE",
        "UNKNOWN"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL"
      ]
    },
    "projection": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Projection"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "panels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RowsPanel"
      }
    },
    "data": {
      "$ref": "#/$defs/Data"
    },
    "unavailable_branches": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/UnavailableBranch"
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "username",
        "roles"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ADMIN",
              "USER"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "UtcEpochMs": {
      "type": "integer",
      "minimum": -8640000000000000,
      "maximum": 8640000000000000
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "Decimal": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "Row": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "oneOf": [
          {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 8192
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          {
            "type": "array",
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ]
      }
    },
    "PanelClocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_time_ms",
        "source_published_at_ms",
        "received_at_ms",
        "ingested_at_ms",
        "processed_at_ms",
        "as_of_ms",
        "read_at_ms"
      ],
      "properties": {
        "event_time_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_published_at_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "ingested_at_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "processed_at_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_at_ms": {
          "$ref": "#/$defs/UtcEpochMs"
        }
      }
    },
    "PanelCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_ms",
        "to_ms",
        "source_total",
        "filtered_total",
        "returned_count",
        "truncated",
        "downsampled",
        "has_more",
        "next_cursor",
        "gaps"
      ],
      "properties": {
        "from_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "to_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcEpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_total": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "pattern": "^(?:0|[1-9][0-9]*)$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "filtered_total": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "pattern": "^(?:0|[1-9][0-9]*)$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        },
        "downsampled": {
          "type": "boolean"
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_ms",
              "to_ms",
              "reason_code"
            ],
            "properties": {
              "from_ms": {
                "$ref": "#/$defs/UtcEpochMs"
              },
              "to_ms": {
                "$ref": "#/$defs/UtcEpochMs"
              },
              "reason_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code"
      ],
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "EMPTY",
            "PARTIAL",
            "UNAVAILABLE"
          ]
