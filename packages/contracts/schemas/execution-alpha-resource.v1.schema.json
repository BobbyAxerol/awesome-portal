            },
            {
              "type": "null"
            }
          ]
        },
        "position_fact_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "realized_pnl": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
