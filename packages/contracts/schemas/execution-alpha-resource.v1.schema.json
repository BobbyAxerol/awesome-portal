          "type": "string",
          "maxLength": 128,
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "active": {
          "type": "boolean"
        },
        "health": {
          "enum": [
            "READY",
            "ATTENTION",
            "FINDING"
          ]
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at_ms": {
          "type": "integer",
          "minimum": -8640000000000000,
          "maximum": 8640000000000000
        }
      }
