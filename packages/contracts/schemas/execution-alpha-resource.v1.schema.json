              "minLength": 1,
              "maxLength": 191
            },
            {
              "type": "null"
            }
          ]
        },
        "portfolio_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
