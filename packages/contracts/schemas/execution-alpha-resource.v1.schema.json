        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "portfolio_id": {
          "anyOf": [
