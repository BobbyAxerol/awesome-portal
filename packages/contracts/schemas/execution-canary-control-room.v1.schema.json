{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-canary-control-room.v1.schema.json",
  "title": "Execution Canary Control Room v1",
  "oneOf": [
    { "$ref": "#/$defs/CanaryEnvelopeCreateRequest" },
    { "$ref": "#/$defs/CanaryControlRoom" }
  ],
  "$defs": {
    "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,191}$" },
    "Hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "PositiveDecimal": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.0*[1-9][0-9]*)$",
      "maxLength": 57
    },
    "CanaryLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capital_cap", "gross_notional_cap", "daily_loss_cap", "max_open_orders", "duration_days"],
      "properties": {
        "capital_cap": { "$ref": "#/$defs/PositiveDecimal" },
        "gross_notional_cap": { "$ref": "#/$defs/PositiveDecimal" },
        "daily_loss_cap": { "$ref": "#/$defs/PositiveDecimal" },
        "max_open_orders": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "duration_days": { "type": "integer", "minimum": 1, "maximum": 90 }
      }
    },
    "CanaryEnvelopeCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "workspace_id", "request_key", "deployment_id",
        "certification_id", "promotion_plan_id", "expected_certification_workflow_version",
        "expected_evidence_set_hash", "expected_latest_envelope_id",
        "base_risk_profile_revision", "currency", "limits", "reason"
      ],
      "properties": {
        "schema_version": { "const": "governance.canary-envelope-create-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
        "deployment_id": { "$ref": "#/$defs/Identifier" },
        "certification_id": { "$ref": "#/$defs/Identifier" },
        "promotion_plan_id": { "$ref": "#/$defs/Identifier" },
        "expected_certification_workflow_version": { "type": "integer", "minimum": 1 },
        "expected_evidence_set_hash": { "$ref": "#/$defs/Hash" },
        "expected_latest_envelope_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "base_risk_profile_revision": { "$ref": "#/$defs/Identifier" },
        "currency": { "type": "string", "pattern": "^[A-Z0-9]{2,12}$" },
        "limits": { "$ref": "#/$defs/CanaryLimits" },
        "reason": { "type": "string", "minLength": 8, "maxLength": 2000 }
      }
    },
    "SourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id", "source_authority", "panel_state", "freshness_state",
        "delivery_profile", "source_verification_state", "as_of", "read_at",
        "age_seconds", "lag_ms", "source_cursor", "projection_epoch",
        "projection_sequence", "capability_snapshot_id", "data", "warnings"
      ],
      "properties": {
        "panel_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_authority": { "enum": ["EXECUTION", "BROKER", "DERIVED"] },
        "panel_state": { "const": "unavailable" },
        "freshness_state": { "const": "UNKNOWN" },
        "delivery_profile": { "const": "fixture" },
        "source_verification_state": { "const": "UNAVAILABLE" },
        "as_of": { "type": "null" },
        "read_at": { "$ref": "#/$defs/Timestamp" },
        "age_seconds": { "type": "null" },
        "lag_ms": { "type": "null" },
        "source_cursor": { "type": "null" },
        "projection_epoch": { "type": "null" },
        "projection_sequence": { "type": "null" },
        "capability_snapshot_id": { "type": "null" },
        "data": { "type": "null" },
        "warnings": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["code"],
            "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 191 } }
          }
        }
      }
    },
    "UnavailableCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "exact_total", "returned_count", "rows"],
      "properties": {
        "envelope": { "$ref": "#/$defs/SourceEnvelope" },
        "exact_total": { "type": "null" },
        "returned_count": { "const": 0 },
        "rows": { "type": "array", "maxItems": 0 }
      }
    },
    "ActionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_tier", "visible", "enabled", "broker_sync_blocks", "blocker_codes"],
      "properties": {
        "risk_tier": { "enum": ["R3_LIVE_PROTECTIVE", "R4_LIVE_RISK_INCREASING"] },
        "visible": { "const": false },
        "enabled": { "const": false },
        "broker_sync_blocks": { "type": "boolean" },
        "blocker_codes": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 191 }
        }
      }
    },
    "CanaryControlRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_authority", "delivery_profile",
        "source_integration_state", "source_side_effect_requested",
        "runtime_activation_requested", "promotion_execution_requested",
        "production_command_active", "replayed", "read_at", "actor",
        "deployment", "lineage", "envelope", "lifecycle", "kpis",
        "envelope_compliance", "source_panels", "positions", "blotter",
        "series", "rollback_readiness", "command_policy"
      ],
      "properties": {
        "schema_version": { "const": "execution.canary-control-room.v1" },
        "record_authority": { "const": "PORTAL" },
        "delivery_profile": { "enum": ["fixture", "LIVE_BINANCE_USDM"] },
        "source_integration_state": { "enum": ["UNAVAILABLE", "SOURCE_BACKED"] },
        "source_side_effect_requested": { "const": false },
        "runtime_activation_requested": { "const": false },
        "promotion_execution_requested": { "const": false },
        "production_command_active": { "const": false },
        "replayed": { "type": "boolean" },
        "read_at": { "$ref": "#/$defs/Timestamp" },
        "actor": {
          "type": "object", "additionalProperties": false,
          "required": ["user_id", "username", "roles"],
          "properties": {
            "user_id": { "$ref": "#/$defs/Identifier" },
            "username": { "type": "string", "minLength": 1, "maxLength": 191 },
            "roles": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "enum": ["ADMIN", "USER"] } }
          }
        },
        "current_source": { "$ref": "execution-profile-read.v1.schema.json#/$defs/ProfileRead" },
        "deployment": {
          "type": "object", "additionalProperties": false,
          "required": ["deployment_id", "portfolio_id", "account_id", "external_account_ref", "venue", "declared_environment", "runtime_state"],
          "properties": {
            "deployment_id": { "$ref": "#/$defs/Identifier" },
            "portfolio_id": { "$ref": "#/$defs/Identifier" },
            "account_id": { "$ref": "#/$defs/Identifier" },
            "external_account_ref": { "$ref": "#/$defs/Identifier" },
            "venue": { "$ref": "#/$defs/Identifier" },
            "declared_environment": { "const": "LIVE_CANARY" },
            "runtime_state": { "type": "null" }
          }
        },
        "lineage": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "value", "href"],
            "properties": {
              "kind": { "enum": ["ARTIFACT", "R1_APPROVAL", "R2_APPROVAL", "SANDBOX_EXIT", "CANARY_PROMOTION_PLAN"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 191 },
              "href": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 512 }, { "type": "null" }] }
            }
          }
        },
        "envelope": {
          "type": "object", "additionalProperties": false,
          "required": ["envelope_id", "revision", "previous_envelope_id", "status", "base_risk_profile_revision", "currency", "limits", "evidence_set_hash", "blocker_codes", "created_by_user_id", "reason", "created_at"],
          "properties": {
            "envelope_id": { "$ref": "#/$defs/Identifier" },
            "revision": { "type": "integer", "minimum": 1 },
            "previous_envelope_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
            "status": { "const": "DRAFT" },
            "base_risk_profile_revision": { "$ref": "#/$defs/Identifier" },
            "currency": { "type": "string", "pattern": "^[A-Z0-9]{2,12}$" },
            "limits": { "$ref": "#/$defs/CanaryLimits" },
            "evidence_set_hash": { "$ref": "#/$defs/Hash" },
            "blocker_codes": { "type": "array", "minItems": 4, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 191 } },
            "created_by_user_id": { "$ref": "#/$defs/Identifier" },
            "reason": { "type": "string", "minLength": 8, "maxLength": 2000 },
            "created_at": { "$ref": "#/$defs/Timestamp" }
          }
        },
        "lifecycle": {
          "type": "object", "additionalProperties": false,
          "required": ["declared_stage", "runtime_state", "day_index", "duration_days", "blocker_codes"],
          "properties": {
            "declared_stage": { "const": "LIVE_CANARY" },
            "runtime_state": { "type": "null" },
            "day_index": { "type": "null" },
            "duration_days": { "type": "integer", "minimum": 1, "maximum": 90 },
            "blocker_codes": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string" } }
          }
        },
        "kpis": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "label", "value", "unit", "envelope"],
            "properties": {
              "key": { "enum": ["capital_consumed", "gross_notional", "daily_pnl", "open_orders", "broker_equity"] },
              "label": { "type": "string", "minLength": 1, "maxLength": 96 },
              "value": { "type": "null" },
              "unit": { "type": "string", "pattern": "^[A-Z0-9]{2,12}$" },
              "envelope": { "$ref": "#/$defs/SourceEnvelope" }
            }
          }
        },
        "envelope_compliance": {
          "type": "object", "additionalProperties": false,
          "required": ["envelope", "limits", "consumed", "headroom", "base_risk_profile_verified"],
          "properties": {
            "envelope": { "$ref": "#/$defs/SourceEnvelope" },
            "limits": {
              "type": "object", "additionalProperties": false,
              "required": ["capital_cap", "gross_notional_cap", "daily_loss_cap", "max_open_orders"],
              "properties": {
                "capital_cap": { "$ref": "#/$defs/PositiveDecimal" },
                "gross_notional_cap": { "$ref": "#/$defs/PositiveDecimal" },
                "daily_loss_cap": { "$ref": "#/$defs/PositiveDecimal" },
                "max_open_orders": { "type": "integer", "minimum": 1 }
              }
            },
            "consumed": { "type": "null" },
            "headroom": { "type": "null" },
            "base_risk_profile_verified": { "const": false }
          }
        },
        "source_panels": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/SourceEnvelope" } },
        "positions": { "$ref": "#/$defs/UnavailableCollection" },
        "blotter": { "$ref": "#/$defs/UnavailableCollection" },
        "series": {
          "type": "object", "additionalProperties": false,
          "required": ["envelope", "resolution", "points"],
          "properties": {
            "envelope": { "$ref": "#/$defs/SourceEnvelope" },
            "resolution": { "type": "null" },
            "points": { "type": "array", "maxItems": 0 }
          }
        },
        "rollback_readiness": {
          "type": "object", "additionalProperties": false,
          "required": ["envelope", "ready", "evidence_hash", "blocker_codes"],
          "properties": {
            "envelope": { "$ref": "#/$defs/SourceEnvelope" },
            "ready": { "const": false },
            "evidence_hash": { "type": "null" },
            "blocker_codes": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string" } }
          }
        },
        "command_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["production_command_active", "guard_semantics", "protective", "scale_up"],
          "properties": {
            "production_command_active": { "const": false },
            "guard_semantics": { "const": "BROKER_STALE_BLOCKS_SCALE_ONLY" },
            "protective": { "$ref": "#/$defs/ActionPolicy" },
            "scale_up": { "$ref": "#/$defs/ActionPolicy" }
          }
        }
      }
    }
  }
}
