{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-approval-evidence.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "approval_id",
    "record_authority",
    "read_at_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.approval-evidence.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
      "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "MD-S12 producer/reader rule: epoch milliseconds must also be within the ECMAScript Date range."
    },
    "prior_economic_history": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "metric",
            "unit",
            "currency",
            "ratio_scale",
            "window",
            "methodology_ref",
            "points",
            "as_of_ms"
          ],
          "properties": {
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject_type",
                "subject_id"
              ],
              "properties": {
                "subject_type": {
                  "type": "string",
                  "enum": [
                    "ALPHA",
                    "PORTFOLIO",
                    "ACCOUNT",
                    "DEPLOYMENT"
                  ]
                },
                "subject_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 191,
                  "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                }
              }
            },
            "metric": {
              "type": "string",
              "enum": [
                "NAV",
                "NET_PNL",
                "RETURN",
                "DRAWDOWN"
              ]
            },
            "unit": {
              "type": "string",
              "enum": [
                "MONEY",
                "RATIO"
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
                  "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
                },
                {
                  "type": "null"
                }
              ]
            },
            "ratio_scale": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "FRACTION",
                    "PERCENT"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_ms",
                "to_ms"
              ],
              "properties": {
                "from_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "MD-S12 producer/reader rule: epoch milliseconds must also be within the ECMAScript Date range."
                },
                "to_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "MD-S12 producer/reader rule: epoch milliseconds must also be within the ECMAScript Date range."
                }
              },
              "description": "EV-1: from_ms must be strictly less than to_ms; observations may lie on either endpoint."
            },
            "methodology_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
              "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
            },
            "points": {
              "type": "array",
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ts_ms",
                  "value"
                ],
                "properties": {
                  "ts_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "MD-S12 producer/reader rule: epoch milliseconds must also be within the ECMAScript Date range."
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])",
                    "maxLength": 80,
                    "description": "Reader display-safety rule MD-S2: negative zero is refused; producers must not invent a value."
                  }
                }
              },
              "description": "EV-1: timestamps must be strictly ascending and inside the inclusive window; an empty array is valid."
            },
            "as_of_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "MD-S12 producer/reader rule: epoch milliseconds must also be within the ECMAScript Date range."
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_diff": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previous_revision",
            "changes"
          ],
          "properties": {
            "previous_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
              "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
            },
            "changes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "before",
                  "after",
                  "unit"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
                    "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
                  },
                  "before": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
                        "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "after": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
                        "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "MONEY",
                      "RATIO",
                      "COUNT",
                      "TEXT",
                      "TIMESTAMP_MS"
                    ]
                  }
                },
                "description": "EV-3: before and after must not be identical, including null-to-null."
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "obligations_after_approval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open_positions",
            "working_orders",
            "reservations",
            "unknown_outcomes",
            "settlement_pending"
          ],
          "properties": {
            "open_positions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "working_orders": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reservations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unknown_outcomes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "settlement_pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_preview": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what_changes",
            "counts_as"
          ],
          "properties": {
            "what_changes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])",
              "description": "MD-S1 producer/reader display rule: nonblank, well-formed text without C1, invisible or bidirectional control characters."
            },
            "counts_as": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "met_after",
                "required"
              ],
              "properties": {
                "met_after": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "required": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "prior_economic_history"
        ],
        "properties": {
          "prior_economic_history": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "prior_economic_history": {
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "enum": [
                        "RETURN",
                        "DRAWDOWN"
                      ]
                    }
                  },
                  "required": [
                    "metric"
                  ]
                },
                "then": {
                  "properties": {
                    "unit": {
                      "const": "RATIO"
                    },
                    "currency": {
                      "type": "null"
                    },
                    "ratio_scale": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "else": {
                  "properties": {
                    "unit": {
                      "const": "MONEY"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "ratio_scale": {
                      "type": "null"
                    }
                  },
                  "type": "object"
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "const": "DRAWDOWN"
                    }
                  },
                  "required": [
                    "metric"
                  ]
                },
                "then": {
                  "properties": {
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "pattern": "^(?:0(?:\\.0+)?|-(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?)$(?![\\s\\S])"
                          }
                        }
                      }
                    }
                  },
                  "type": "object"
                }
              }
            ]
          }
        },
        "type": "object"
      }
    }
  ]
}
