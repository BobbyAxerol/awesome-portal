{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-manager-realtime.v2.schema.json",
  "title": "Portal Manager projection realtime snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "delivery_profile", "workspace_id", "environment", "profile_id",
    "projection_epoch", "projection_sequence", "cursor", "stream_available", "data_state",
    "fact_count", "source_read_at", "projection_state_digest", "resnapshot_not_before",
    "activation_manifest_digest"
  ],
  "properties": {
    "schema_version": { "const": "execution.manager-realtime-snapshot.v2" },
    "delivery_profile": { "const": "current_projection" },
    "workspace_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "environment": { "enum": ["paper", "sandbox", "live"] },
    "profile_id": { "type": "string", "pattern": "^(PAPER|SANDBOX|LIVE)_[A-Z0-9_]{2,120}$" },
    "projection_epoch": { "type": "string", "format": "uuid" },
    "projection_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "cursor": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:[0-9]+$",
      "maxLength": 80
    },
    "stream_available": { "const": true },
    "data_state": { "enum": ["AVAILABLE", "EMPTY_VALID"] },
    "fact_count": { "type": "integer", "minimum": 0, "maximum": 80000 },
    "source_read_at": { "type": "string", "format": "date-time" },
    "projection_state_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resnapshot_not_before": { "type": "null" },
    "activation_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "data_state": { "const": "EMPTY_VALID" } } },
      "then": { "properties": { "fact_count": { "const": 0 } } },
      "else": { "properties": { "fact_count": { "type": "integer", "minimum": 1 } } }
    }
  ]
}
