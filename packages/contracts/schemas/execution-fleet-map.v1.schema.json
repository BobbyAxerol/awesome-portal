{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-fleet-map.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "window",
    "rows",
    "total_count",
    "truncated"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.fleet-map.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "window": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_key",
          "stage_presence"
        ],
        "properties": {
          "row_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "allocation": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currency",
                  "value"
                ],
                "properties": {
                  "currency": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "window_return": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ratio_scale",
                  "value"
                ],
                "properties": {
                  "ratio_scale": {
                    "type": "string",
                    "enum": [
                      "FRACTION",
                      "PERCENT"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "net_pnl": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currency",
                  "value"
                ],
                "properties": {
                  "currency": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "health": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "stage_presence": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "PAPER",
                "SANDBOX",
                "CANARY",
                "LIVE"
              ]
            }
          }
        }
      }
    },
    "total_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
