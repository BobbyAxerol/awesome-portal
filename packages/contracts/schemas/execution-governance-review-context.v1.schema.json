{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-governance-review-context.v1.schema.json",
  "title": "Portal Governance review action context v1",
  "$defs": {
    "DecisionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "workspace_id",
        "approval_id",
        "expected_approval_version",
        "evidence_set_hash",
        "evidence_hashes",
        "command_type",
        "request_schema_version",
        "plan_path",
        "availability",
        "source_side_effect_requested"
      ],
      "properties": {
        "gate": {
          "enum": [
            "R1",
            "R2"
          ]
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,192}$"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,192}$"
        },
        "expected_approval_version": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_set_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence_hashes": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "command_type": {
          "enum": [
            "GOVERNANCE_R1_DECISION",
            null
          ]
        },
        "request_schema_version": {
          "enum": [
            "governance.r1-decision-plan-request.v1",
            null
          ]
        },
        "plan_path": {
          "enum": [
            "/api/v1/execution/commands/plans",
            null
          ]
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "BLOCKED"
              ]
            },
            "reason_code": {
              "enum": [
                null,
                "GOVERNANCE_CAPABILITY_REQUIRED",
                "ADMIN_ROLE_REQUIRED",
                "APPROVAL_NOT_PENDING",
                "APPROVAL_EXPIRED",
                "EVIDENCE_HASH_LIMIT_EXCEEDED",
                "R2_EXECUTION_DECISION_NOT_COMMISSIONED",
                "R1_APPROVAL_REQUIRED",
                "R1_EVIDENCE_INCOMPLETE",
                "R2_ACCEPTED_LINEAGE_UNAVAILABLE",
                "R2_REVIEW_CLOSED",
                "CAPTURE_RETAINED_REVIEW_READ_ONLY",
                "CAPTURE_PROJECTION_NOT_AUTHORIZED",
                "CAPTURE_PROJECTION_UNAVAILABLE",
                "CAPTURE_PROJECTION_SCOPE_MISMATCH",
                "CAPTURE_PROJECTION_STALE",
                "CAPTURE_DEPLOYMENT_SOURCE_UNAVAILABLE",
                "R2_RISK_GRANT_SOURCE_UNAVAILABLE",
                "R2_PORTFOLIO_SCOPE_NOT_FOUND",
                "CAPTURE_DEPLOYMENT_SCOPE_NOT_FOUND",
                "PAPER_VENUE_UNAVAILABLE"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason_code": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "source_side_effect_requested": {
          "const": false
        }
      },
      "description": "Immutable evidence pins for the existing R1 command. Executor availability is not permission to bypass per-verb eligibility. R2 has no commissioned executor: null command/path and typed refusal, never an R1 alias.",
      "allOf": [
        {
          "if": {
            "properties": {
              "gate": {
                "const": "R1"
              }
            },
            "required": [
              "gate"
            ]
          },
          "then": {
            "properties": {
              "command_type": {
                "const": "GOVERNANCE_R1_DECISION"
              },
              "request_schema_version": {
                "const": "governance.r1-decision-plan-request.v1"
              },
              "plan_path": {
                "const": "/api/v1/execution/commands/plans"
              }
            }
          },
          "else": {
            "properties": {
              "command_type": {
                "type": "null"
              },
              "request_schema_version": {
                "type": "null"
              },
              "plan_path": {
                "type": "null"
              },
              "evidence_hashes": {
                "type": "null"
              },
              "availability": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "BLOCKED"
                  },
                  "reason_code": {
                    "const": "R2_EXECUTION_DECISION_NOT_COMMISSIONED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "evidence_hashes": {
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "CaptureContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "workspace_id",
        "parent_approval_id",
        "expected_parent_version",
        "expected_projection_digest",
        "availability",
        "candidates",
        "candidates_truncated",
        "currency_semantics",
        "source_side_effect_requested"
      ],
      "properties": {
        "action": {
          "enum": [
            "R2_CREATE",
            "PAPER_EXIT_CREATE"
          ]
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,192}$"
        },
        "parent_approval_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,192}$"
        },
        "expected_parent_version": {
          "type": "integer",
          "minimum": 1
        },
        "expected_projection_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "BLOCKED"
              ]
            },
            "reason_code": {
              "enum": [
                null,
                "GOVERNANCE_CAPABILITY_REQUIRED",
                "ADMIN_ROLE_REQUIRED",
                "APPROVAL_NOT_PENDING",
                "APPROVAL_EXPIRED",
                "EVIDENCE_HASH_LIMIT_EXCEEDED",
                "R2_EXECUTION_DECISION_NOT_COMMISSIONED",
                "R1_APPROVAL_REQUIRED",
                "R1_EVIDENCE_INCOMPLETE",
                "R2_ACCEPTED_LINEAGE_UNAVAILABLE",
                "R2_REVIEW_CLOSED",
                "CAPTURE_RETAINED_REVIEW_READ_ONLY",
                "CAPTURE_PROJECTION_NOT_AUTHORIZED",
                "CAPTURE_PROJECTION_UNAVAILABLE",
                "CAPTURE_PROJECTION_SCOPE_MISMATCH",
                "CAPTURE_PROJECTION_STALE",
                "CAPTURE_DEPLOYMENT_SOURCE_UNAVAILABLE",
                "R2_RISK_GRANT_SOURCE_UNAVAILABLE",
                "R2_PORTFOLIO_SCOPE_NOT_FOUND",
                "CAPTURE_DEPLOYMENT_SCOPE_NOT_FOUND",
                "PAPER_VENUE_UNAVAILABLE"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason_code": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deployment_id",
              "portfolio_id",
              "risk_grant_id",
              "currency"
            ],
            "properties": {
              "deployment_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,192}$"
              },
              "portfolio_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,192}$"
              },
              "risk_grant_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,192}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "currency": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{2,12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "candidates_truncated": {
          "type": "boolean"
        },
        "currency_semantics": {
          "const": "REVIEWER_REQUESTED_NOT_FX_CONVERSION"
        },
        "source_side_effect_requested": {
          "const": false
        }
      },
      "description": "At most 50 accepted, parent/workspace/profile-bound capture choices; no Manager relations/cursors. Null currency is unrecorded, never USDT by default. Capture creates a Portal review, not execution authorization. Retained/source-off/stale/outage profiles are blocked.",
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "expected_projection_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "candidates": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "expected_projection_digest": {
                "type": "null"
              },
              "candidates": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "R2_CREATE"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "risk_grant_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._:-]{1,192}$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "PaperExitDecisionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "workspace_id",
        "review_id",
        "expected_review_version",
        "evidence_set_hash",
        "source_snapshot_hash",
        "evidence_hashes",
        "command_type",
        "request_schema_version",
        "plan_path",
        "availability",
        "source_side_effect_requested"
      ],
      "properties": {
        "gate": {
          "const": "PAPER_EXIT"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96
        },
        "review_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "expected_review_version": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_set_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_snapshot_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence_hashes": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "command_type": {
          "const": "GOVERNANCE_PAPER_EXIT_DECISION"
        },
        "request_schema_version": {
          "const": "governance.paper-exit-decision-plan-request.v1"
        },
        "plan_path": {
          "const": "/api/v1/execution/commands/plans"
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code"
          ],
          "properties": {
            "state": {
              "enum": [
                "AVAILABLE",
                "BLOCKED"
              ]
            },
            "reason_code": {
              "enum": [
                null,
                "APPROVER_ROLE_REQUIRED",
                "EXIT_REVIEW_NOT_PENDING",
                "EXIT_REVIEW_EXPIRED",
                "ACTOR_ALREADY_DECIDED",
                "PAPER_EXIT_QUORUM_UNSUPPORTED",
                "EVIDENCE_HASH_LIMIT_EXCEEDED"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason_code": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "source_side_effect_requested": {
          "const": false
        }
      },
      "description": "Verified same-read Paper Exit manifest pins, not lineage/finding digests. AVAILABLE allows planning only in intersection with existing per-verb eligibility; self-promotion and unmet evidence remain blocked by PROMOTE policy, while safe extend/reject retain their policy. This records a Portal decision/grant only, never TS activation.",
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "AVAILABLE"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "evidence_hashes": {
                "type": "array"
              }
            }
          }
        }
      ]
    }
  }
}
