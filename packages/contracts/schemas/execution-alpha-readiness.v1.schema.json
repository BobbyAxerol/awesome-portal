{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-alpha-readiness.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "environment",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.alpha-readiness.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "environment": {
      "type": "string",
      "enum": [
        "paper",
        "sandbox",
        "live"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alpha_id"
        ],
        "properties": {
          "alpha_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          },
          "readiness": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "met",
                  "total"
                ],
                "properties": {
                  "met": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "archive_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "PAPER_WATCH",
                  "ARCHIVE_IN_PROGRESS",
                  "ARCHIVED"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
