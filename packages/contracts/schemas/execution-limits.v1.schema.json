{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-limits.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.limits.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ALPHA",
            "PORTFOLIO",
            "ACCOUNT",
            "DEPLOYMENT",
            "OPERATION",
            "INCIDENT",
            "APPROVAL"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        }
      }
    },
    "items": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit_id",
              "scope",
              "label",
              "model_revision",
              "used_ratio",
              "state",
              "cap"
            ],
            "properties": {
              "limit_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "WORKSPACE",
                      "PORTFOLIO",
                      "ACCOUNT",
                      "DEPLOYMENT"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  }
                }
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "model_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "used_ratio": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "OK",
                  "WARN",
                  "BREACH",
                  "UNKNOWN"
                ]
              },
              "cap": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "currency",
                      "value"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 80,
                        "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
