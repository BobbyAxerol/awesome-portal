      "properties": {
        "schema_version": {
          "const": "governance.r1-decision-apply.v1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96
        },
        "receipt_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,192}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "PENDING"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
