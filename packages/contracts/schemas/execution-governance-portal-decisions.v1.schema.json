          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "conditions",
            "evidence_hashes"
          ],
          "properties": {
            "decision": {
              "enum": [
                "APPROVE",
                "APPROVE_WITH_CONDITION",
                "DENY",
                "REQUEST_CHANGES"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 8,
              "maxLength": 2000
            },
            "conditions": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "$ref": "execution-governance-approval-workflow.v1.schema.json#/$defs/TypedCondition"
              }
            },
            "evidence_hashes": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "execution-governance-approval-workflow.v1.schema.json#/$defs/Hash"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "decision": {
                    "enum": [
                      "APPROVE_WITH_CONDITION",
                      "REQUEST_CHANGES"
                    ]
                  }
                },
                "required": [
                  "decision"
                ]
              },
              "then": {
                "properties": {
                  "conditions": {
                    "minItems": 1,
                    "type": "array"
                  }
                }
              },
              "else": {
                "properties": {
                  "conditions": {
                    "maxItems": 0,
                    "type": "array"
                  }
                }
              }
            }
          ]
        }
      }
