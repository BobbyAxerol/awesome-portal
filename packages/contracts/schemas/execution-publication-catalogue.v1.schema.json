{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-publication-catalogue.v1.schema.json",
  "title": "Pinned logical publication catalogue; not current source readiness",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "portal.execution.publication-catalogue.v1"
    },
    "lane": {
      "const": "SOURCE_CONTRACT_NOT_RUNTIME_ACCEPTANCE"
    },
    "source_catalogue_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "field_dictionary_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "metric_dependencies_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "family_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
          },
          "authority_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "grain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "availability": {
            "const": "UNAVAILABLE"
          },
          "reason_code": {
            "const": "NEW_EDGE_V1_EXPORT_NOT_QUALIFIED"
          },
          "history_capability": {
            "const": "UNKNOWN"
          },
          "history_full": {
            "const": false
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from_ms": {
                "type": "null"
              },
              "to_ms": {
                "type": "null"
              },
              "duration_ms": {
                "type": "null"
              },
              "proof_ref": {
                "type": "null"
              }
            },
            "required": [
              "from_ms",
              "to_ms",
              "duration_ms",
              "proof_ref"
            ]
          },
          "runtime_enabled": {
            "const": false
          }
        },
        "required": [
          "family_id",
          "authority_owner",
          "grain",
          "availability",
          "reason_code",
          "history_capability",
          "history_full",
          "retention",
          "runtime_enabled"
        ]
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
          },
          "scalar_type": {
            "enum": [
              "DECIMAL",
              "UTC_MS",
              "ID",
              "ENUM",
              "BOOLEAN"
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "const": "UNAVAILABLE"
          },
          "reason_code": {
            "const": "SOURCE_FIELD_PUBLICATION_NOT_QUALIFIED"
          }
        },
        "required": [
          "field_id",
          "scalar_type",
          "unit",
          "availability",
          "reason_code"
        ]
      }
    },
    "current_page_adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "EXISTING_SEPARATE_AUTHORITY"
        },
        "history_capability": {
          "const": "CURRENT_ONLY"
        },
        "stable_snapshot": {
          "const": false
        },
        "authoritative_replay": {
          "const": false
        },
        "maximum_rows": {
          "const": 200
        },
        "maximum_response_bytes": {
          "const": 1048576
        },
        "total_history_cap": {
          "type": "null"
        }
      },
      "required": [
        "status",
        "history_capability",
        "stable_snapshot",
        "authoritative_replay",
        "maximum_rows",
        "maximum_response_bytes",
        "total_history_cap"
      ]
    }
  },
  "required": [
    "schema_version",
    "lane",
    "source_catalogue_digest",
    "field_dictionary_digest",
    "metric_dependencies_digest",
    "families",
    "fields",
    "current_page_adapter"
  ]
}
