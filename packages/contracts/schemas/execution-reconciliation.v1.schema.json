{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-reconciliation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.reconciliation.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ALPHA",
            "PORTFOLIO",
            "ACCOUNT",
            "DEPLOYMENT",
            "OPERATION",
            "INCIDENT",
            "APPROVAL"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        }
      }
    },
    "runs": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "state",
              "started_at_ms",
              "finished_at_ms",
              "breaks_open"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "state": {
                "type": "string",
                "enum": [
                  "RUNNING",
                  "MATCHED",
                  "BREAKS_FOUND",
                  "FAILED"
                ]
              },
              "started_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "finished_at_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "breaks_open": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "breaks": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "break_id",
              "run_id",
              "state",
              "kind",
              "resolution_revision",
              "detected_at_ms"
            ],
            "properties": {
              "break_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "state": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "RESOLVING",
                  "RESOLVED"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "POSITION",
                  "BALANCE",
                  "ORDER",
                  "FILL"
                ]
              },
              "resolution_revision": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detected_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
