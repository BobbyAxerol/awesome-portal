{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/governance-live-review.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_authority", "source_authority", "delivery_profile", "read_at",
    "actor", "approval_id", "canary_ref", "governance_backbone", "current_source",
    "derived_branches", "source_side_effect_requested", "production_command_active"
  ],
  "properties": {
    "schema_version": { "const": "governance.live-review.v1" },
    "record_authority": { "const": "PORTAL_CONTROL" },
    "source_authority": { "const": "TRADING_SYSTEM" },
    "delivery_profile": { "const": "LIVE_BINANCE_USDM" },
    "read_at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["user_id", "username", "roles"],
      "properties": {
        "user_id": { "type": "string", "minLength": 1, "maxLength": 191 },
        "username": { "type": "string", "minLength": 1, "maxLength": 191 },
        "roles": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["ADMIN", "USER"] } }
      }
    },
    "approval_id": { "type": "string", "minLength": 1, "maxLength": 191 },
    "canary_ref": {
      "type": "object", "additionalProperties": false, "required": ["deployment_id", "composition"],
      "properties": {
        "deployment_id": { "type": "string", "minLength": 1, "maxLength": 191 },
        "composition": { "const": "PORTAL_CANARY_GOVERNANCE_OVER_LIVE_FACTS" }
      }
    },
    "governance_backbone": { "$ref": "execution-governance-r2-review.v1.schema.json" },
    "current_source": { "$ref": "execution-profile-read.v1.schema.json#/$defs/ProfileRead" },
    "derived_branches": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["capability_id", "state", "reason_code"],
        "properties": {
          "capability_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "state": { "enum": ["AVAILABLE", "EMPTY", "PARTIAL", "UNAVAILABLE"] },
          "reason_code": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "source_side_effect_requested": { "const": false },
    "production_command_active": { "const": false }
  }
}
