{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "workspace_id",
    "may_mark_seen",
    "mark_seen_reason",
    "reason_code",
    "snapshot_revision",
    "observed_at",
    "coverage",
    "baseline",
    "items",
    "unseen_count",
    "mark_seen"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.visit-digest.v1"
    },
    "state": {
      "enum": [
        "NO_BASELINE",
        "READY",
        "EMPTY"
      ]
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "may_mark_seen": {
      "type": "boolean"
    },
    "mark_seen_reason": {
      "enum": [
        "READ_ONLY_PROFILE",
        null
      ]
    },
    "reason_code": {
      "enum": [
        "NO_COMPARISON_BASELINE",
        null
      ]
    },
    "snapshot_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "const": "BOUNDED_OBSERVATIONS"
    },
    "baseline": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "seen_at",
            "snapshot_revision"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483646
            },
            "seen_at": {
              "type": "string",
              "format": "date-time"
            },
            "snapshot_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "value",
          "href",
          "as_of",
          "change",
          "seen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "INCIDENT",
              "APPROVAL",
              "OPERATION",
              "RECONCILIATION",
              "REVIEW_DUE",
              "CONDITION_EXPIRY",
              "VERIFIED_OPERATION",
              "JOURNAL_COMMAND",
              "SOURCE",
              "STAGE"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "value": {
            "type": "string",
            "maxLength": 1024
          },
          "href": {
            "type": "string",
            "pattern": "^/(?:execution|governance|deployments)(?:/|\\?|$)",
            "maxLength": 2048
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "change": {
            "enum": [
              "NEW_OBSERVATION",
              "CHANGED"
            ]
          },
          "seen": {
            "const": false
          }
        }
      }
    },
    "unseen_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "mark_seen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_revision",
        "expected_baseline_version"
      ],
      "properties": {
        "snapshot_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_baseline_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483646
        }
      }
    }
  },
  "description": "Portal-owned per-user/workspace last-seen observation baseline. GET has no writes. No complete event-history claim: absent rows are never inferred as resolved/deleted. Every read reapplies current authorization. NEW_OBSERVATION may be newly visible, not newly created. Mark seen explicitly with the supplied revision/version; stale source or another-tab baseline returns 409. First visit returns NO_BASELINE until acknowledged; no fabricated history. Real producer currently covers authorized bounded command-center triage/today/source facts, not NAV deltas or lifecycle event history.",
  "allOf": [
    {
      "if": {
        "properties": {
          "may_mark_seen": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "mark_seen_reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "mark_seen_reason": {
            "const": "READ_ONLY_PROFILE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "NO_BASELINE"
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "type": "null"
          },
          "reason_code": {
            "const": "NO_COMPARISON_BASELINE"
          },
          "items": {
            "maxItems": 0
          },
          "unseen_count": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "seen_at",
              "snapshot_revision"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483646
              },
              "seen_at": {
                "type": "string",
                "format": "date-time"
              },
              "snapshot_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "reason_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 1
          },
          "unseen_count": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "EMPTY"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          },
          "unseen_count": {
            "const": 0
          }
        }
      }
    }
  ]
}
