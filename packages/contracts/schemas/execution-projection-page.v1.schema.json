{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-projection-page.v1.schema.json",
  "title": "Portal execution projection keyset page v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows",
    "total_count",
    "filtered_count",
    "next_cursor",
    "prev_cursor",
    "has_more",
    "has_previous",
    "applied_filters",
    "applied_sort",
    "aggregates_by_currency",
    "retention"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "maxItems": 250,
      "items": {}
    },
    "total_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "filtered_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "next_cursor": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4096
    },
    "prev_cursor": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4096
    },
    "has_more": { "type": "boolean" },
    "has_previous": { "type": "boolean" },
    "applied_filters": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "op", "value"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 64 },
          "op": { "enum": ["eq", "in", "contains", "gte", "lte"] },
          "value": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "applied_sort": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "direction"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 64 },
          "direction": { "enum": ["asc", "desc"] }
        }
      }
    },
    "aggregates_by_currency": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "row_count",
          "quantity_count",
          "quantity",
          "notional_count",
          "notional",
          "invalid_numeric_count"
        ],
        "properties": {
          "currency": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{2,12}$" },
          "row_count": { "type": "integer", "minimum": 0 },
          "quantity_count": { "type": "integer", "minimum": 0 },
          "quantity": { "type": "string", "pattern": "^[+-]?[0-9]+([.][0-9]+)?$" },
          "notional_count": { "type": "integer", "minimum": 0 },
          "notional": { "type": "string", "pattern": "^[+-]?[0-9]+([.][0-9]+)?$" },
          "invalid_numeric_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "policy_version"],
      "properties": {
        "availability": {
          "enum": ["HOT", "PARTIAL_HOT", "COLD_REQUESTABLE", "PURGED", "UNKNOWN"]
        },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
