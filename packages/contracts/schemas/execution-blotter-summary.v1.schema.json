{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-blotter-summary.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.blotter-summary.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "environment": {
      "type": "string",
      "enum": [
        "paper",
        "sandbox",
        "live"
      ]
    },
    "status_buckets": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bucket",
              "count"
            ],
            "properties": {
              "bucket": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "WORKING",
                  "CONDITIONAL",
                  "PARTIAL",
                  "FILLED",
                  "CANCELLED",
                  "REJECTED"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "funnel": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submitted",
            "risk_granted",
            "venue_acknowledged",
            "filled"
          ],
          "properties": {
            "submitted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "risk_granted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "venue_acknowledged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "filled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
