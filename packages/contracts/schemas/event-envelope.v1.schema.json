{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/event-envelope.v1.schema.json",
  "title": "Portal Event Envelope v1",
  "description": "Canonical event envelope (guide §6.7): schema version, producer, workspace, trace and occurrence time are mandatory; events describe committed facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "workspace_id",
    "occurred_at",
    "produced_at",
    "producer",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "event_id": {"$ref": "https://schemas.primusspark.com/portal/common.v1.schema.json#/$defs/opaqueId"},
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.]{2,127}\\.v[0-9]+$"
    },
    "schema_version": {"type": "integer", "minimum": 1},
    "aggregate_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "aggregate_id": {"$ref": "https://schemas.primusspark.com/portal/common.v1.schema.json#/$defs/opaqueId"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "workspace_id": {"$ref": "https://schemas.primusspark.com/portal/common.v1.schema.json#/$defs/opaqueId"},
    "occurred_at": {"$ref": "https://schemas.primusspark.com/portal/common.v1.schema.json#/$defs/utcTimestamp"},
    "produced_at": {"$ref": "https://schemas.primusspark.com/portal/common.v1.schema.json#/$defs/utcTimestamp"},
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}@[a-z0-9.-]{1,63}$",
      "maxLength": 160
    },
    "traceparent": {"$ref": "https://schemas.primusspark.com/portal/common.v1.schema.json#/$defs/traceparent"},
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
    },
    "payload": {"type": "object"}
  }
}
