{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-controls.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.controls.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "locks": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lock_id",
              "scope",
              "revision",
              "state",
              "set_at_ms",
              "set_by",
              "reason_code"
            ],
            "properties": {
              "lock_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "WORKSPACE",
                      "PORTFOLIO",
                      "ACCOUNT",
                      "DEPLOYMENT"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  }
                }
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "state": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "RELEASED"
                ]
              },
              "set_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "set_by": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "trading_state": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "since_ms",
            "history"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "REDUCING",
                "HALTED"
              ]
            },
            "since_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "history": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "at_ms",
                  "actor",
                  "reason_code"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "REDUCING",
                      "HALTED"
                    ]
                  },
                  "at_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "actor": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason_code": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
