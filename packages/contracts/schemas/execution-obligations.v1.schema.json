{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-obligations.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "record_authority",
    "read_at_ms",
    "subject"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.obligations.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ALPHA",
            "PORTFOLIO",
            "ACCOUNT",
            "DEPLOYMENT",
            "OPERATION",
            "INCIDENT",
            "APPROVAL"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
        }
      }
    },
    "items": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligation_id",
              "kind",
              "state",
              "recovery_id",
              "order_id",
              "operation_id",
              "opened_at_ms"
            ],
            "properties": {
              "obligation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "OPEN_POSITION",
                  "WORKING_ORDER",
                  "RESERVATION",
                  "UNKNOWN_OUTCOME",
                  "SETTLEMENT_PENDING"
                ]
              },
              "state": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"
              },
              "recovery_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "order_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "operation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "opened_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
