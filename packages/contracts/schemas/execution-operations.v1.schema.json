{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-operations.v1.schema.json",
  "title": "Portal execution operations contracts v1",
  "$defs": {
    "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,191}$" },
    "Hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "Date": { "type": "string", "format": "date" },
    "DateTime": { "type": "string", "format": "date-time" },
    "RiskTier": {
      "enum": [
        "R0_READ", "R1_PAPER_MUTATION", "R2_SANDBOX", "R3_LIVE_PROTECTIVE",
        "R4_LIVE_RISK_INCREASING", "UNCLASSIFIED", "BLOCKED"
      ]
    },
    "TypedCondition": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "expires_at must be on or after deadline when both values are non-null; enforced by the application semantic validator",
      "required": ["text", "owner", "deadline", "expires_at", "blocking"],
      "properties": {
        "text": { "type": "string", "minLength": 8, "maxLength": 2000, "pattern": "\\S" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "deadline": { "oneOf": [{ "$ref": "#/$defs/Date" }, { "type": "null" }] },
        "expires_at": { "oneOf": [{ "$ref": "#/$defs/Date" }, { "type": "null" }] },
        "blocking": { "type": "boolean" }
      }
    },
    "CommandCatalogueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "command", "action", "group", "risk_tier", "source_risk_tier",
        "owner_review_required",
        "plan_required", "apply_required", "verify_required", "portal_reachable",
        "source_route_state", "http_method", "http_path", "blocked_reason",
        "source_reference"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9-]+/(?:[a-z0-9-]+|<root>)$" },
        "command": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "action": { "type": "string", "pattern": "^(?:[a-z0-9-]+|<root>)$" },
        "group": {
          "enum": [
            "ACCOUNT_CAPITAL", "ALPHA_DEPLOYMENT", "ORDER_CONTROL",
            "OPERATIONS_INCIDENTS", "MARKET_REFERENCE", "PLATFORM_DIAGNOSTICS"
          ]
        },
        "risk_tier": { "$ref": "#/$defs/RiskTier" },
        "source_risk_tier": { "$ref": "#/$defs/RiskTier" },
        "owner_review_required": { "type": "boolean" },
        "plan_required": { "type": "boolean" },
        "apply_required": { "type": "boolean" },
        "verify_required": { "type": "boolean" },
        "portal_reachable": { "const": false },
        "source_route_state": {
          "enum": ["OBSERVED", "AMBIGUOUS", "UNPUBLISHED", "DIRECT_ACCESS_PROHIBITED"]
        },
        "http_method": { "type": ["string", "null"], "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", null] },
        "http_path": { "type": ["string", "null"], "maxLength": 512 },
        "blocked_reason": {
          "enum": [
            "COMMAND_RELAY_DISABLED", "SOURCE_ROUTE_MAPPING_AMBIGUOUS",
            "TRADING_SYSTEM_HTTP_ROUTE_UNPUBLISHED",
            "TRADING_SYSTEM_TYPED_HTTP_ROUTE_UNPUBLISHED",
            "GENERIC_REDIS_ACCESS_PROHIBITED",
            "DESTRUCTIVE_OR_LAB_ONLY_COMMAND_PROHIBITED"
          ]
        },
        "source_reference": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "CommandCatalogueScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id", "actor_user_id", "actor_role", "environment", "entity",
        "requested_risk_tier", "capability_state", "freshness_state", "policy_revision"
      ],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "actor_user_id": { "$ref": "#/$defs/Identifier" },
        "actor_role": { "const": "ADMIN" },
        "environment": { "enum": ["PAPER", "SANDBOX", "LIVE"] },
        "entity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "id"],
              "properties": {
                "type": { "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] },
                "id": { "$ref": "#/$defs/Identifier" }
              }
            }
          ]
        },
        "requested_risk_tier": { "oneOf": [{ "$ref": "#/$defs/RiskTier" }, { "type": "null" }] },
        "capability_state": { "const": "DISABLED" },
        "freshness_state": { "const": "UNAVAILABLE" },
        "policy_revision": { "const": "execution.command-catalogue.f0.v2" }
      }
    },
    "CommandCatalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "catalogue_revision", "delivery_profile", "capability", "source",
        "scope", "total_entries", "returned_entries", "entries"
      ],
      "properties": {
        "schema_version": { "const": "execution.command-catalog.v1" },
        "catalogue_revision": { "const": 2 },
        "delivery_profile": { "const": "fixture" },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "DISABLED" },
            "reason": { "const": "EX_BE_05B_F0_CONTRACT_ONLY" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trading_system_commit", "cli_map_sha256", "openapi_sha256", "generated_from_read_only_extract"],
          "properties": {
            "trading_system_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "cli_map_sha256": { "$ref": "#/$defs/Hash" },
            "openapi_sha256": { "$ref": "#/$defs/Hash" },
            "generated_from_read_only_extract": { "const": true }
          }
        },
        "scope": { "$ref": "#/$defs/CommandCatalogueScope" },
        "total_entries": { "const": 64 },
        "returned_entries": { "type": "integer", "minimum": 0, "maximum": 64 },
        "entries": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/CommandCatalogueEntry" }
        }
      }
    },
    "ExecutionCommandPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "workspace_id", "request_key", "command_type",
        "command_version", "command_key", "environment", "target",
        "expected_target_version", "payload", "conditions"
      ],
      "properties": {
        "schema_version": { "const": "execution.command-plan-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "command_type": { "const": "EXECUTION_COMMAND" },
        "command_version": { "const": 1 },
        "command_key": { "type": "string", "pattern": "^[a-z0-9-]+/(?:[a-z0-9-]+|<root>)$" },
        "environment": { "enum": ["PAPER", "SANDBOX", "LIVE"] },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] },
            "id": { "$ref": "#/$defs/Identifier" }
          }
        },
        "expected_target_version": { "type": "integer", "minimum": 1 },
        "payload": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "maxLength": 128 },
          "$comment": "Application validator enforces HASH_ONLY_NO_RAW storage, max 32768 UTF-8 bytes, depth 6, 512 nodes, 128 array items, 4096-character strings, and forbidden sensitive key fragments"
        },
        "conditions": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/TypedCondition" } }
      }
    },
    "ExecutionCommandPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "operation_id", "command_type", "command_version",
        "command_key", "risk_tier", "payload_hash", "plan_digest", "status",
        "blockers", "warnings", "apply_token", "expires_at", "payload_storage_policy",
        "relay_capability", "source_side_effect_requested", "replayed"
      ],
      "properties": {
        "schema_version": { "const": "execution.command-plan.v1" },
        "operation_id": { "$ref": "#/$defs/Identifier" },
        "command_type": { "const": "EXECUTION_COMMAND" },
        "command_version": { "const": 1 },
        "command_key": { "type": "string", "minLength": 3, "maxLength": 128 },
        "risk_tier": { "$ref": "#/$defs/RiskTier" },
        "payload_hash": { "$ref": "#/$defs/Hash" },
        "plan_digest": { "$ref": "#/$defs/Hash" },
        "status": { "const": "BLOCKED" },
        "blockers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "warnings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "apply_token": { "type": "null" },
        "expires_at": { "$ref": "#/$defs/DateTime" },
        "payload_storage_policy": { "const": "HASH_ONLY_NO_RAW" },
        "relay_capability": { "const": "DISABLED" },
        "source_side_effect_requested": { "const": false },
        "replayed": { "type": "boolean" }
      }
    },
    "ExecutionCommandApplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "command_type"],
      "properties": {
        "schema_version": { "const": "execution.command-apply-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "command_type": { "const": "EXECUTION_COMMAND" }
      }
    },
    "ExecutionCommandOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "operation_id", "command_type", "command_key",
        "status", "verification_result", "blockers", "warnings",
        "relay_receipt", "source_side_effect_requested", "created_at", "updated_at"
      ],
      "properties": {
        "schema_version": { "const": "execution.command-operation.v1" },
        "operation_id": { "$ref": "#/$defs/Identifier" },
        "command_type": { "const": "EXECUTION_COMMAND" },
        "command_key": { "type": "string", "minLength": 3, "maxLength": 128 },
        "status": { "const": "BLOCKED" },
        "verification_result": { "const": "NOT_STARTED" },
        "blockers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "warnings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "relay_receipt": { "type": "null" },
        "source_side_effect_requested": { "const": false },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "OperationQueueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id", "operation_kind", "command_key", "environment", "target",
        "risk_tier", "severity", "source_authority", "source_status",
        "verification_result", "triage_state", "workflow_version",
        "assigned_to", "assigned_at", "incident_id",
        "acknowledged_at", "acknowledged_by_user_id", "resolved_at",
        "resolved_by_user_id", "resolution_reason", "resolution_evidence_hash",
        "created_at", "updated_at"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/Identifier" },
        "operation_kind": { "const": "EXECUTION_COMMAND" },
        "command_key": { "type": "string", "pattern": "^[a-z0-9-]+/(?:[a-z0-9-]+|<root>)$" },
        "environment": { "enum": ["PAPER", "SANDBOX", "LIVE"] },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] },
            "id": { "$ref": "#/$defs/Identifier" }
          }
        },
        "risk_tier": { "$ref": "#/$defs/RiskTier" },
        "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
        "source_authority": { "enum": ["PORTAL", "EXECUTION", "BROKER"] },
        "source_status": { "enum": ["BLOCKED", "PENDING", "RUNNING", "SUCCEEDED", "FAILED", "EXPIRED", "UNCERTAIN"] },
        "verification_result": { "enum": ["NOT_STARTED", "PENDING", "SUCCEEDED", "FAILED", "PARTIAL", "UNCERTAIN", "DENIED", "EXPIRED"] },
        "triage_state": { "enum": ["UNACKNOWLEDGED", "ACKNOWLEDGED", "RESOLVED"] },
        "workflow_version": { "type": "integer", "minimum": 1 },
        "assigned_to": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["user_id", "username"],
              "properties": {
                "user_id": { "$ref": "#/$defs/Identifier" },
                "username": { "type": "string", "minLength": 1, "maxLength": 128 }
              }
            },
            { "type": "null" }
          ]
        },
        "assigned_at": { "oneOf": [{ "$ref": "#/$defs/DateTime" }, { "type": "null" }] },
        "incident_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "acknowledged_at": { "oneOf": [{ "$ref": "#/$defs/DateTime" }, { "type": "null" }] },
        "acknowledged_by_user_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "resolved_at": { "oneOf": [{ "$ref": "#/$defs/DateTime" }, { "type": "null" }] },
        "resolved_by_user_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "resolution_reason": { "type": ["string", "null"], "minLength": 8, "maxLength": 2000 },
        "resolution_evidence_hash": { "oneOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "OperationQueueResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_authority", "delivery_profile",
        "source_integration_state", "read_at", "actor", "page"
      ],
      "properties": {
        "schema_version": { "const": "execution.operations-queue.v1" },
        "record_authority": { "const": "PORTAL" },
        "delivery_profile": { "const": "fixture" },
        "source_integration_state": { "const": "UNAVAILABLE" },
        "read_at": { "$ref": "#/$defs/DateTime" },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_id", "username", "roles"],
          "properties": {
            "user_id": { "$ref": "#/$defs/Identifier" },
            "username": { "type": "string", "minLength": 1, "maxLength": 128 },
            "roles": { "type": "array", "const": ["ADMIN"] }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows", "total_count", "filtered_count", "next_cursor", "prev_cursor",
            "has_more", "has_previous", "applied_filters", "applied_sort"
          ],
          "properties": {
            "rows": { "type": "array", "maxItems": 250, "items": { "$ref": "#/$defs/OperationQueueItem" } },
            "total_count": { "type": "integer", "minimum": 0 },
            "filtered_count": { "type": "integer", "minimum": 0 },
            "next_cursor": { "type": ["string", "null"] },
            "prev_cursor": { "type": ["string", "null"] },
            "has_more": { "type": "boolean" },
            "has_previous": { "type": "boolean" },
            "applied_filters": { "type": "array", "maxItems": 12, "items": { "type": "object" } },
            "applied_sort": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object" } }
          }
        }
      }
    },
    "OperationAcknowledgeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version"],
      "properties": {
        "schema_version": { "const": "execution.operation-acknowledge-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 }
      }
    },
    "OperationResolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version", "reason", "evidence_hash"],
      "properties": {
        "schema_version": { "const": "execution.operation-resolve-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "evidence_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "OperationWorkflowResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_authority", "delivery_profile", "source_integration_state",
        "source_status_unchanged", "source_side_effect_requested", "replayed", "operation"
      ],
      "properties": {
        "schema_version": { "const": "execution.operation-workflow.v1" },
        "record_authority": { "const": "PORTAL" },
        "delivery_profile": { "const": "fixture" },
        "source_integration_state": { "const": "UNAVAILABLE" },
        "source_status_unchanged": { "const": true },
        "source_side_effect_requested": { "const": false },
        "replayed": { "type": "boolean" },
        "operation": { "$ref": "#/$defs/OperationQueueItem" }
      }
    },
    "IncidentCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "title", "summary", "severity", "environment", "target", "correlated_operation_ids"],
      "properties": {
        "schema_version": { "const": "execution.incident-create-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" },
        "title": { "type": "string", "minLength": 8, "maxLength": 200, "pattern": "\\S" },
        "summary": { "type": "string", "minLength": 8, "maxLength": 2000, "pattern": "\\S" },
        "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
        "environment": { "enum": ["PAPER", "SANDBOX", "LIVE"] },
        "target": {
          "type": "object", "additionalProperties": false, "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] },
            "id": { "$ref": "#/$defs/Identifier" }
          }
        },
        "correlated_operation_ids": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } }
      }
    },
    "IncidentAcknowledgeRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version"],
      "properties": {
        "schema_version": { "const": "execution.incident-acknowledge-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 }
      }
    },
    "IncidentAssignRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version", "assignee_user_id"],
      "properties": {
        "schema_version": { "const": "execution.incident-assign-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 },
        "assignee_user_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "IncidentAnnotateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version", "body"],
      "properties": {
        "schema_version": { "const": "execution.incident-annotate-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 },
        "body": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" }
      }
    },
    "IncidentEvidenceRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version", "evidence_kind", "sha256", "evidence_schema_version", "declared_source_authority", "summary", "captured_at"],
      "properties": {
        "schema_version": { "const": "execution.incident-evidence-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 },
        "evidence_kind": { "enum": ["MITIGATION_ATTESTATION", "CLEAN_DRY_RUN", "SYNC_SNAPSHOT", "FINDING_REFERENCE", "BLAST_RADIUS", "PROBABLE_CAUSE", "OTHER"] },
        "sha256": { "$ref": "#/$defs/Hash" },
        "evidence_schema_version": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "declared_source_authority": { "enum": ["PORTAL", "EXECUTION", "BROKER", "DERIVED"] },
        "summary": { "type": "string", "minLength": 8, "maxLength": 1000, "pattern": "\\S" },
        "captured_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "IncidentCorrelateOperationRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version", "operation_id", "relationship"],
      "properties": {
        "schema_version": { "const": "execution.incident-correlate-operation-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 },
        "operation_id": { "$ref": "#/$defs/Identifier" },
        "relationship": { "enum": ["TRIGGERED_BY", "MITIGATES", "RELATED"] }
      }
    },
    "IncidentMitigateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version", "mitigation_evidence_hash"],
      "properties": {
        "schema_version": { "const": "execution.incident-mitigate-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 },
        "mitigation_evidence_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "IncidentResolveRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "request_key", "expected_workflow_version", "reason", "clean_dry_run_evidence_hash"],
      "properties": {
        "schema_version": { "const": "execution.incident-resolve-request.v1" },
        "workspace_id": { "type": "string", "minLength": 3, "maxLength": 96 },
        "request_key": { "$ref": "#/$defs/Identifier" },
        "expected_workflow_version": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 8, "maxLength": 2000, "pattern": "\\S" },
        "clean_dry_run_evidence_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "IncidentDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_authority", "delivery_profile", "source_integration_state", "read_at", "actor", "incident", "source_panels", "correlated_operations", "evidence", "annotations", "timeline", "resolution_gate"],
      "properties": {
        "schema_version": { "const": "execution.incident-detail.v1" },
        "record_authority": { "const": "PORTAL" },
        "delivery_profile": { "const": "fixture" },
        "source_integration_state": { "const": "UNAVAILABLE" },
        "read_at": { "$ref": "#/$defs/DateTime" },
        "actor": {
          "type": "object", "additionalProperties": false, "required": ["user_id", "username", "roles"],
          "properties": {
            "user_id": { "$ref": "#/$defs/Identifier" },
            "username": { "type": "string", "minLength": 1, "maxLength": 128 },
            "roles": { "const": ["ADMIN"] }
          }
        },
        "incident": { "$ref": "#/$defs/IncidentRecord" },
        "source_panels": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": { "$ref": "#/$defs/IncidentUnavailablePanel" }
        },
        "correlated_operations": { "$ref": "#/$defs/IncidentOperationCollection" },
        "evidence": { "$ref": "#/$defs/IncidentEvidenceCollection" },
        "annotations": { "$ref": "#/$defs/IncidentAnnotationCollection" },
        "timeline": { "$ref": "#/$defs/IncidentTimelineCollection" },
        "resolution_gate": {
          "type": "object", "additionalProperties": false,
          "required": ["eligible", "blocker_codes", "clean_dry_run_evidence_present", "reason_required", "deployment_resume_requested"],
          "properties": {
            "eligible": { "type": "boolean" },
            "blocker_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
            "clean_dry_run_evidence_present": { "type": "boolean" },
            "reason_required": { "const": true },
            "deployment_resume_requested": { "const": false }
          }
        }
      }
    },
    "IncidentRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["incident_id", "title", "summary", "severity", "environment", "target", "workflow_state", "workflow_version", "assigned_to_user_id", "acknowledged_at", "acknowledged_by_user_id", "mitigated_at", "mitigated_by_user_id", "mitigation_evidence_hash", "resolved_at", "resolved_by_user_id", "resolution_reason", "clean_dry_run_evidence_hash", "opened_by_user_id", "source_side_effect_requested", "deployment_resume_requested", "created_at", "updated_at"],
      "properties": {
        "incident_id": { "$ref": "#/$defs/Identifier" },
        "title": { "type": "string", "minLength": 8, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
        "environment": { "enum": ["PAPER", "SANDBOX", "LIVE"] },
        "target": {
          "type": "object", "additionalProperties": false, "required": ["type", "id"],
          "properties": {
            "type": { "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] },
            "id": { "$ref": "#/$defs/Identifier" }
          }
        },
        "workflow_state": { "enum": ["OPEN", "MITIGATED", "RESOLVED"] },
        "workflow_version": { "type": "integer", "minimum": 1 },
        "assigned_to_user_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "acknowledged_at": { "oneOf": [{ "$ref": "#/$defs/DateTime" }, { "type": "null" }] },
        "acknowledged_by_user_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "mitigated_at": { "oneOf": [{ "$ref": "#/$defs/DateTime" }, { "type": "null" }] },
        "mitigated_by_user_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "mitigation_evidence_hash": { "oneOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] },
        "resolved_at": { "oneOf": [{ "$ref": "#/$defs/DateTime" }, { "type": "null" }] },
        "resolved_by_user_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "resolution_reason": { "type": ["string", "null"], "minLength": 8, "maxLength": 2000 },
        "clean_dry_run_evidence_hash": { "oneOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] },
        "opened_by_user_id": { "$ref": "#/$defs/Identifier" },
        "source_side_effect_requested": { "const": false },
        "deployment_resume_requested": { "const": false },
        "created_at": { "$ref": "#/$defs/DateTime" },
        "updated_at": { "$ref": "#/$defs/DateTime" }
      }
    },
    "IncidentUnavailablePanel": {
      "type": "object", "additionalProperties": false,
      "required": ["panel_id", "source_authority", "as_of", "read_at", "source_cursor", "source_sequence", "projection_epoch", "projection_sequence", "source_completeness", "poll_interval_ms", "panel_state", "freshness_state", "age_seconds", "lag_ms", "formula_version", "capability_snapshot_id", "delivery_profile", "source_verification_state", "data", "warnings"],
      "properties": {
        "panel_id": { "enum": ["findings", "alerts", "dead_letters", "trace_order"] },
        "source_authority": { "const": "EXECUTION" },
        "as_of": { "type": "null" },
        "read_at": { "$ref": "#/$defs/DateTime" },
        "source_cursor": { "type": "null" },
        "source_sequence": { "type": "null" },
        "projection_epoch": { "type": "null" },
        "projection_sequence": { "type": "null" },
        "source_completeness": { "const": "UNKNOWN" },
        "poll_interval_ms": { "type": "null" },
        "panel_state": { "const": "unavailable" },
        "freshness_state": { "const": "UNKNOWN" },
        "age_seconds": { "type": "null" },
        "lag_ms": { "type": "null" },
        "formula_version": { "type": "null" },
        "capability_snapshot_id": { "type": "null" },
        "delivery_profile": { "const": "fixture" },
        "source_verification_state": { "const": "UNAVAILABLE" },
        "data": { "type": "null" },
        "warnings": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["code"],
            "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 128 } }
          }
        }
      }
    },
    "IncidentOperationCollection": {
      "type": "object", "additionalProperties": false,
      "required": ["total_count", "returned_count", "truncated", "rows"],
      "properties": {
        "total_count": { "type": "integer", "minimum": 0 },
        "returned_count": { "type": "integer", "minimum": 0, "maximum": 250 },
        "truncated": { "type": "boolean" },
        "rows": {
          "type": "array", "maxItems": 250,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["operation_id", "relationship", "linked_by_user_id", "linked_at", "command_key", "severity", "triage_state", "source_status", "verification_result", "workflow_version"],
            "properties": {
              "operation_id": { "$ref": "#/$defs/Identifier" },
              "relationship": { "enum": ["TRIGGERED_BY", "MITIGATES", "RELATED"] },
              "linked_by_user_id": { "$ref": "#/$defs/Identifier" },
              "linked_at": { "$ref": "#/$defs/DateTime" },
              "command_key": { "type": "string", "minLength": 3, "maxLength": 128 },
              "severity": { "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] },
              "triage_state": { "enum": ["UNACKNOWLEDGED", "ACKNOWLEDGED", "RESOLVED"] },
              "source_status": { "type": "string", "minLength": 1, "maxLength": 32 },
              "verification_result": { "type": "string", "minLength": 1, "maxLength": 32 },
              "workflow_version": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "IncidentEvidenceCollection": {
      "type": "object", "additionalProperties": false,
      "required": ["total_count", "returned_count", "truncated", "rows"],
      "properties": {
        "total_count": { "type": "integer", "minimum": 0 },
        "returned_count": { "type": "integer", "minimum": 0, "maximum": 250 },
        "truncated": { "type": "boolean" },
        "rows": {
          "type": "array", "maxItems": 250,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence_id", "evidence_kind", "sha256", "schema_version", "declared_source_authority", "source_verification_state", "summary", "captured_at", "attached_by_user_id", "created_at"],
            "properties": {
              "evidence_id": { "$ref": "#/$defs/Identifier" },
              "evidence_kind": { "enum": ["MITIGATION_ATTESTATION", "CLEAN_DRY_RUN", "SYNC_SNAPSHOT", "FINDING_REFERENCE", "BLAST_RADIUS", "PROBABLE_CAUSE", "OTHER"] },
              "sha256": { "$ref": "#/$defs/Hash" },
              "schema_version": { "type": "string", "minLength": 1, "maxLength": 128 },
              "declared_source_authority": { "enum": ["PORTAL", "EXECUTION", "BROKER", "DERIVED"] },
              "source_verification_state": { "const": "UNAVAILABLE" },
              "summary": { "type": "string", "minLength": 8, "maxLength": 1000 },
              "captured_at": { "$ref": "#/$defs/DateTime" },
              "attached_by_user_id": { "$ref": "#/$defs/Identifier" },
              "created_at": { "$ref": "#/$defs/DateTime" }
            }
          }
        }
      }
    },
    "IncidentAnnotationCollection": {
      "type": "object", "additionalProperties": false,
      "required": ["total_count", "returned_count", "truncated", "rows"],
      "properties": {
        "total_count": { "type": "integer", "minimum": 0 },
        "returned_count": { "type": "integer", "minimum": 0, "maximum": 250 },
        "truncated": { "type": "boolean" },
        "rows": {
          "type": "array", "maxItems": 250,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["annotation_id", "author_user_id", "body", "redaction_state", "created_at"],
            "properties": {
              "annotation_id": { "$ref": "#/$defs/Identifier" },
              "author_user_id": { "$ref": "#/$defs/Identifier" },
              "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "redaction_state": { "const": "CLEAR" },
              "created_at": { "$ref": "#/$defs/DateTime" }
            }
          }
        }
      }
    },
    "IncidentTimelineCollection": {
      "type": "object", "additionalProperties": false,
      "required": ["total_count", "returned_count", "truncated", "rows"],
      "properties": {
        "total_count": { "type": "integer", "minimum": 0 },
        "returned_count": { "type": "integer", "minimum": 0, "maximum": 250 },
        "truncated": { "type": "boolean" },
        "rows": {
          "type": "array", "maxItems": 250,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["event_id", "actor_user_id", "action", "workflow_version_before", "workflow_version_after", "metadata", "created_at"],
            "properties": {
              "event_id": { "$ref": "#/$defs/Identifier" },
              "actor_user_id": { "$ref": "#/$defs/Identifier" },
              "action": { "enum": ["CREATE", "ACKNOWLEDGE", "ASSIGN", "ANNOTATE", "ATTACH_EVIDENCE", "CORRELATE_OPERATION", "MITIGATE", "RESOLVE"] },
              "workflow_version_before": { "type": "integer", "minimum": 0 },
              "workflow_version_after": { "type": "integer", "minimum": 1 },
              "metadata": { "type": "object" },
              "created_at": { "$ref": "#/$defs/DateTime" }
            }
          }
        }
      }
    },
    "IncidentWorkflowResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_authority", "delivery_profile", "source_integration_state", "source_side_effect_requested", "deployment_resume_requested", "replayed", "detail"],
      "properties": {
        "schema_version": { "const": "execution.incident-workflow.v1" },
        "record_authority": { "const": "PORTAL" },
        "delivery_profile": { "const": "fixture" },
        "source_integration_state": { "const": "UNAVAILABLE" },
        "source_side_effect_requested": { "const": false },
        "deployment_resume_requested": { "const": false },
        "replayed": { "type": "boolean" },
        "detail": { "$ref": "#/$defs/IncidentDetail" }
      }
    },
    "RelayDenied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation_id", "decision", "reason", "retry_allowed", "source_request_sent"],
      "properties": {
        "schema_version": { "const": "execution.command-relay-decision.v1" },
        "operation_id": { "$ref": "#/$defs/Identifier" },
        "decision": { "const": "DENIED" },
        "reason": { "const": "COMMAND_RELAY_DISABLED" },
        "retry_allowed": { "const": false },
        "source_request_sent": { "const": false }
      }
    }
  }
}
