{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-profile-read.v1.schema.json",
  "title": "N23 Sandbox and Live Profile Reads",
  "$ref": "#/$defs/ProfileRead",
  "$defs": {
    "Timestamp": { "type": "string", "format": "date-time" },
    "Identifier": { "type": "string", "minLength": 1, "maxLength": 191 },
    "Scalar": {
      "oneOf": [
        { "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      ]
    },
    "ManagerRecord": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 80,
      "propertyNames": { "not": { "pattern": "(^|_)(raw|secret|credential|password|token|dsn)(_|$)" } },
      "additionalProperties": { "$ref": "#/$defs/Scalar" }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "state", "relations", "reason_code", "retryable"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "enum": ["AVAILABLE", "EMPTY", "PARTIAL", "UNAVAILABLE"] },
        "relations": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "reason_code": { "type": ["string", "null"], "maxLength": 128 },
        "retryable": { "const": false }
      }
    },
    "UnavailableBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "state", "reason_code", "retryable"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "const": "UNAVAILABLE" },
        "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "retryable": { "const": false }
      }
    },
    "ProfileRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_authority", "source_authority", "delivery_profile",
        "requested_environment", "source_environment", "composition", "workspace_id", "resource",
        "read_at", "as_of", "state", "freshness", "completeness", "actor", "capabilities",
        "data", "unavailable_branches"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "execution.sandbox-overview.v1", "execution.sandbox-current-source.v1",
            "execution.live-overview.v1", "execution.live-current-source.v1",
            "execution.canary-live-facts.v1"
          ]
        },
        "record_authority": { "const": "PORTAL_CONTROL" },
        "source_authority": { "const": "TRADING_SYSTEM" },
        "delivery_profile": { "enum": ["SANDBOX_BINANCE_USDM", "LIVE_BINANCE_USDM"] },
        "requested_environment": { "enum": ["sandbox", "live", "canary"] },
        "source_environment": { "enum": ["sandbox", "live"] },
        "composition": { "enum": ["DIRECT_PROFILE_READ", "PORTAL_CANARY_GOVERNANCE_OVER_LIVE_FACTS"] },
        "workspace_id": { "$ref": "#/$defs/Identifier" },
        "resource": {
          "type": "object", "additionalProperties": false, "required": ["kind", "id"],
          "properties": { "kind": { "enum": ["WORKSPACE", "DEPLOYMENT"] }, "id": { "$ref": "#/$defs/Identifier" } }
        },
        "read_at": { "$ref": "#/$defs/Timestamp" },
        "as_of": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "state": { "enum": ["ready", "empty", "stale", "partial", "unavailable"] },
        "freshness": { "enum": ["FRESH", "AGING", "STALE", "UNKNOWN"] },
        "completeness": { "enum": ["COMPLETE", "PARTIAL"] },
        "projection": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["epoch", "sequence", "sourceCursor", "payloadDigest", "lastSuccessfulRefreshAt"],
              "properties": {
                "epoch": { "$ref": "#/$defs/Identifier" },
                "sequence": { "type": "integer", "minimum": 0 },
                "sourceCursor": { "type": ["string", "null"], "maxLength": 4096 },
                "payloadDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "lastSuccessfulRefreshAt": { "$ref": "#/$defs/Timestamp" }
              }
            }
          ]
        },
        "actor": {
          "type": "object", "additionalProperties": false, "required": ["user_id", "username", "roles"],
          "properties": {
            "user_id": { "$ref": "#/$defs/Identifier" }, "username": { "$ref": "#/$defs/Identifier" },
            "roles": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["ADMIN", "USER"] } }
          }
        },
        "capabilities": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/Capability" } },
        "data": {
          "type": "object", "minProperties": 1, "maxProperties": 16,
          "additionalProperties": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/ManagerRecord" } }
        },
        "unavailable_branches": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/UnavailableBranch" } }
      },
      "allOf": [
        {
          "if": { "properties": { "requested_environment": { "const": "sandbox" } } },
          "then": { "properties": { "source_environment": { "const": "sandbox" }, "delivery_profile": { "const": "SANDBOX_BINANCE_USDM" }, "composition": { "const": "DIRECT_PROFILE_READ" } } }
        },
        {
          "if": { "properties": { "requested_environment": { "const": "canary" } } },
          "then": { "properties": { "source_environment": { "const": "live" }, "delivery_profile": { "const": "LIVE_BINANCE_USDM" }, "composition": { "const": "PORTAL_CANARY_GOVERNANCE_OVER_LIVE_FACTS" } } }
        },
        {
          "if": { "properties": { "requested_environment": { "const": "live" } } },
          "then": { "properties": { "source_environment": { "const": "live" }, "delivery_profile": { "const": "LIVE_BINANCE_USDM" }, "composition": { "const": "DIRECT_PROFILE_READ" } } }
        }
      ]
    }
  }
}
