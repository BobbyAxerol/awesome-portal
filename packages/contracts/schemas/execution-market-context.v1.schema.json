{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-market-context.v1.schema.json",
  "title": "Portal EDS-11R4 Market Context BFF responses",
  "description": "Two named same-origin Portal BFF responses. These schemas never expose a Manager relation, upstream cursor, deployment credential, mTLS material or delegated JWT. A response is current market observation or a bounded provider series; neither is an event replay claim.",
  "oneOf": [
    { "$ref": "#/$defs/LatestResponse" },
    { "$ref": "#/$defs/CandlesResponse" }
  ],
  "$defs": {
    "Environment": { "type": "string", "enum": ["paper", "sandbox", "live"] },
    "ProfileId": { "type": "string", "enum": ["PAPER_BINANCE_USDM", "SANDBOX_BINANCE_USDM", "LIVE_BINANCE_USDM"] },
    "Token": { "type": "string", "minLength": 1, "maxLength": 191, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$" },
    "Venue": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$" },
    "Interval": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
    "Decimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 8640000000000000 },
    "SourceHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "freshness", "completeness", "as_of_ms"],
      "properties": {
        "availability": { "const": "AVAILABLE" },
        "freshness": { "enum": ["FRESH", "AGING", "DEGRADED", "STALE"] },
        "completeness": { "enum": ["COMPLETE", "PARTIAL", "POLL_BOUNDED"] },
        "as_of_ms": { "$ref": "#/$defs/UtcMilliseconds" }
      }
    },
    "CommonResponse": {
      "type": "object",
      "required": [
        "schema_version",
        "authority",
        "logical_operation_id",
        "environment",
        "profile_id",
        "provenance",
        "source_health",
        "state"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "authority": { "const": "PORTAL_CONTROL_API" },
        "logical_operation_id": { "type": "string" },
        "environment": { "$ref": "#/$defs/Environment" },
        "profile_id": { "$ref": "#/$defs/ProfileId" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_contract_revision", "history_semantics", "derived"],
          "properties": {
            "source_contract_revision": { "const": "trading-system.portal-execution.market-context.v1" },
            "history_semantics": { "type": "string" },
            "derived": { "const": false }
          }
        },
        "source_health": { "$ref": "#/$defs/SourceHealth" },
        "state": { "enum": ["POPULATED", "AUTHORITATIVE_EMPTY"] }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venue", "instrument", "value", "observation_kind", "observed_at_ms", "quote_currency", "provider"],
      "properties": {
        "venue": { "$ref": "#/$defs/Venue" },
        "instrument": { "$ref": "#/$defs/Token" },
        "value": { "$ref": "#/$defs/Decimal" },
        "observation_kind": { "enum": ["TRADE", "MARK", "INDEX", "BAR_CLOSE"] },
        "observed_at_ms": { "$ref": "#/$defs/UtcMilliseconds" },
        "quote_currency": { "type": "string", "minLength": 1, "maxLength": 32 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "Candle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_ms", "close_ms", "open", "high", "low", "close", "volume"],
      "properties": {
        "open_ms": { "$ref": "#/$defs/UtcMilliseconds" },
        "close_ms": { "$ref": "#/$defs/UtcMilliseconds" },
        "open": { "$ref": "#/$defs/Decimal" },
        "high": { "$ref": "#/$defs/Decimal" },
        "low": { "$ref": "#/$defs/Decimal" },
        "close": { "$ref": "#/$defs/Decimal" },
        "volume": { "$ref": "#/$defs/Decimal" }
      }
    },
    "LatestResponse": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/CommonResponse" },
        {
          "type": "object",
          "required": ["observations"],
          "properties": {
            "schema_version": { "const": "portal.execution.market-context.latest.v1" },
            "logical_operation_id": { "const": "managerMarketContextLatestV1" },
            "provenance": {
              "type": "object",
              "properties": {
                "history_semantics": { "const": "CURRENT_MARKET_OBSERVATION_NO_REPLAY_CLAIM" }
              }
            },
            "observations": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/Observation" } }
          },
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "AUTHORITATIVE_EMPTY" } }, "required": ["state"] },
              "then": { "properties": { "observations": { "type": "array", "maxItems": 0 } } },
              "else": { "properties": { "observations": { "type": "array", "minItems": 1 } } }
            },
            {
              "if": { "properties": { "environment": { "const": "paper" } }, "required": ["environment"] },
              "then": { "properties": { "profile_id": { "const": "PAPER_BINANCE_USDM" } } }
            },
            {
              "if": { "properties": { "environment": { "const": "sandbox" } }, "required": ["environment"] },
              "then": { "properties": { "profile_id": { "const": "SANDBOX_BINANCE_USDM" } } }
            },
            {
              "if": { "properties": { "environment": { "const": "live" } }, "required": ["environment"] },
              "then": { "properties": { "profile_id": { "const": "LIVE_BINANCE_USDM" } } }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "CandlesResponse": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/CommonResponse" },
        {
          "type": "object",
          "required": ["range", "coverage", "sampling", "candles"],
          "properties": {
            "schema_version": { "const": "portal.execution.market-context.candles.v1" },
            "logical_operation_id": { "const": "managerMarketContextCandlesV1" },
            "provenance": {
              "type": "object",
              "properties": {
                "history_semantics": { "const": "BOUNDED_PROVIDER_SERIES_NO_REPLAY_CLAIM" }
              }
            },
            "range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["venue", "instrument", "interval", "from_ms", "to_ms", "point_limit"],
              "properties": {
                "venue": { "$ref": "#/$defs/Venue" },
                "instrument": { "$ref": "#/$defs/Token" },
                "interval": { "$ref": "#/$defs/Interval" },
                "from_ms": { "$ref": "#/$defs/UtcMilliseconds" },
                "to_ms": { "$ref": "#/$defs/UtcMilliseconds" },
                "point_limit": { "type": "integer", "minimum": 1, "maximum": 2000 }
              }
            },
            "coverage": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
            "sampling": { "enum": ["NONE", "SOURCE_BOUNDED", "SOURCE_AGGREGATED"] },
            "candles": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/Candle" } }
          },
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "AUTHORITATIVE_EMPTY" } }, "required": ["state"] },
              "then": { "properties": { "candles": { "type": "array", "maxItems": 0 } } },
              "else": { "properties": { "candles": { "type": "array", "minItems": 1 } } }
            },
            {
              "if": { "properties": { "environment": { "const": "paper" } }, "required": ["environment"] },
              "then": { "properties": { "profile_id": { "const": "PAPER_BINANCE_USDM" } } }
            },
            {
              "if": { "properties": { "environment": { "const": "sandbox" } }, "required": ["environment"] },
              "then": { "properties": { "profile_id": { "const": "SANDBOX_BINANCE_USDM" } } }
            },
            {
              "if": { "properties": { "environment": { "const": "live" } }, "required": ["environment"] },
              "then": { "properties": { "profile_id": { "const": "LIVE_BINANCE_USDM" } } }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
