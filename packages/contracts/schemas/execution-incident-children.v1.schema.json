{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-incident-children.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "incident_id",
    "record_authority",
    "read_at_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "portal.execution.incident-children.v1"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191,
      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
    },
    "record_authority": {
      "const": "PORTAL_PROJECTION"
    },
    "read_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidence": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "digest",
              "label",
              "added_at_ms"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "FINDING",
                  "ALERT",
                  "DEAD_LETTER",
                  "ORDER_TRACE"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "added_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "assigned_to": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "assigned_at_ms"
          ],
          "properties": {
            "actor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            },
            "assigned_at_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution_gate": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible",
            "blocker_codes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "blocker_codes": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "timeline": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "action",
              "actor",
              "version_before",
              "version_after",
              "at_ms"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "actor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version_before": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version_after": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "linked_operations": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "original_target"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              },
              "original_target": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "id"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "ACCOUNT",
                          "PORTFOLIO",
                          "DEPLOYMENT"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 191,
                        "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "type": "object",
      "if": {
        "type": "object",
        "required": [
          "resolution_gate"
        ],
        "properties": {
          "resolution_gate": {
            "type": "object",
            "required": [
              "eligible"
            ],
            "properties": {
              "eligible": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "resolution_gate": {
            "type": "object",
            "properties": {
              "blocker_codes": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
