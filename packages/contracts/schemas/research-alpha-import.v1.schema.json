{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/research-alpha-import.v1.schema.json",
  "title": "Research Alpha Import P07 public responses",
  "description": "The five same-origin P07 Research Alpha Import operations. Source bytes are accepted only by Parse and never occur in any response. The legacy QuantBT /api/v1/alphas compatibility API is a separate contract and is not represented here.",
  "oneOf": [
    { "$ref": "#/$defs/SourceResponse" },
    { "$ref": "#/$defs/GatesResponse" },
    { "$ref": "#/$defs/RegistryListResponse" },
    { "$ref": "#/$defs/RegistrationResponse" },
    { "$ref": "#/$defs/ActivationResponse" }
  ],
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UtcMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "AlphaId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "AlphaVersionId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^av_[A-Za-z0-9_]+_[0-9]+_[0-9]+_[0-9]+$"
    },
    "MirrorField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "state", "check", "note"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": {
          "enum": ["parsed", "missing", "server_assigned", "server_computed", "not_in_contract"],
          "description": "CG-P07-03: where the value came from. server_assigned is set at registration (strategy_id = alpha_id, DQ-07); not_in_contract is a HiFi field the v1 single-file contract cannot carry (DQ-05) and is never filled."
        },
        "value": {},
        "check": {
          "enum": ["PASS", "FAIL", "VERIFY", "GATED", "NOT_APPLICABLE"],
          "description": "PASS/FAIL: the verdict of the gate named in `gate`. VERIFY: parsed but no gate reads it. GATED: missing, so its gate cannot pass. NOT_APPLICABLE: server-assigned or not in the v1 contract."
        },
        "gate": { "anyOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] },
        "note": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "GateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "name", "state", "message", "ms"],
      "properties": {
        "n": { "type": "integer", "minimum": 1, "maximum": 7 },
        "name": {
          "enum": [
            "contract-complete",
            "entrypoint-importable",
            "digest-unique",
            "parameter-space-sane",
            "determinism-declared",
            "data-contract-known",
            "no-lookahead-static-scan"
          ]
        },
        "state": { "enum": ["PASS", "FAIL", "SKIPPED"] },
        "message": { "type": "string", "maxLength": 512 },
        "ms": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "timing_source": {
          "anyOf": [{ "enum": ["ANALYSER", "CONTROL_API"] }, { "type": "null" }],
          "description": "CG-P07-04: ANALYSER = the private parser measured this gate's own check (see analyser_us); CONTROL_API = timed in Control API (gate 3 registry lookup); null for SKIPPED. Gates run in one synchronous request, so RUNNING is only the client's in-flight state."
        },
        "analyser_us": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 600000000 }, { "type": "null" }] },
        "quarantine_code": {
          "enum": ["QUARANTINED_CONTRACT", "QUARANTINED_ENTRYPOINT", "QUARANTINED_DIGEST_ALREADY_REGISTERED", "QUARANTINED_PARAMETER_SPACE", "QUARANTINED_DETERMINISM", "QUARANTINED_DATA_CONTRACT", "QUARANTINED_LOOKAHEAD"]
        }
      }
    },
    "DeclarationScalar": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "ParameterDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "fixed" },
            "value": { "$ref": "#/$defs/DeclarationScalar" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "low", "high", "step"],
          "properties": {
            "kind": { "const": "int_range" },
            "low": { "type": "integer" },
            "high": { "type": "integer" },
            "step": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "low", "high", "step"],
          "properties": {
            "kind": { "const": "float_range" },
            "low": { "type": "number" },
            "high": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "categorical" },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/DeclarationScalar" }
            }
          }
        }
      ]
    },
    "AlphaVersionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Safe immutable projection of the AlphaVersion declaration. It is a validator input, not raw source, provenance, an adapter command or a mutable contract.",
      "required": ["schema_version", "entrypoint", "timeframes", "determinism", "parameter_space"],
      "properties": {
        "schema_version": { "const": "research.alpha-version-declaration.v1" },
        "entrypoint": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z][A-Za-z0-9_.:]{0,159}$" },
        "timeframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[1-9][0-9]*(?:m|h|d|w)$" }
        },
        "required_columns": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["open", "high", "low", "close", "volume"] } },
        "warmup_bars": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "determinism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed_required"],
          "properties": { "seed_required": { "type": "boolean" } }
        },
        "parameter_space": {
          "type": "object",
          "maxProperties": 12,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/ParameterDeclaration" }
        }
      }
    },
    "ResearchAlphaAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "description": "research.alpha-analysis.v1 is the bounded Control-API↔private-parser document. It is generated for shared type compatibility but is never a browser route or a source-byte export.",
      "required": ["schema_version", "source_digest", "analysis_digest", "parse_ok", "declared_contract", "mirror", "gate_facts"],
      "properties": {
        "schema_version": { "const": "research.alpha-analysis.v1" },
        "source_digest": { "$ref": "#/$defs/Digest" },
        "analysis_digest": { "$ref": "#/$defs/Digest" },
        "parse_ok": { "type": "boolean" },
        "declared_contract": { "type": "object", "additionalProperties": true },
        "mirror": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/MirrorField" } },
        "gate_timings_us": {
          "type": "object",
          "description": "CG-P07-04: measured analyser time per check in microseconds; excluded from analysis_digest.",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 600000000 }
        },
        "gate_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_complete", "contract_message", "entrypoint_restricted_definition_load", "entrypoint_message",
            "parameter_space_sane", "parameter_message", "determinism_declared", "determinism_message",
            "data_contract_known", "data_contract_message", "no_lookahead_static_scan", "no_lookahead_message"
          ],
          "properties": {
            "contract_complete": { "type": "boolean" },
            "contract_message": { "type": "string", "maxLength": 512 },
            "entrypoint_restricted_definition_load": { "type": "boolean" },
            "entrypoint_message": { "type": "string", "maxLength": 512 },
            "parameter_space_sane": { "type": "boolean" },
            "parameter_message": { "type": "string", "maxLength": 512 },
            "determinism_declared": { "type": "boolean" },
            "determinism_message": { "type": "string", "maxLength": 512 },
            "data_contract_known": { "type": "boolean" },
            "data_contract_message": { "type": "string", "maxLength": 512 },
            "no_lookahead_static_scan": { "type": "boolean" },
            "no_lookahead_message": { "type": "string", "maxLength": 512 }
          }
        }
      }
    },
    "SourceResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "research.alpha-source.v1: the Parse receipt. It intentionally contains a read-only mirror, not source bytes or a mutable declared contract.",
      "required": ["schema_version", "source_file_ref", "source_digest", "analysis_digest", "parse_ok", "expires_at_utc_ms", "mirror"],
      "properties": {
        "schema_version": { "const": "research.alpha-source.v1" },
        "source_file_ref": { "$ref": "#/$defs/OpaqueId" },
        "source_digest": { "$ref": "#/$defs/Digest" },
        "analysis_digest": { "$ref": "#/$defs/Digest" },
        "parse_ok": { "type": "boolean" },
        "expires_at_utc_ms": { "$ref": "#/$defs/UtcMilliseconds" },
        "mirror": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/MirrorField" } }
      }
    },
    "GatesResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "research.alpha-import-gates.v1: server-ordered gates. The client renders this order and must never synthesize PASS or skip state.",
      "required": ["schema_version", "gate_receipt_id", "source_file_ref", "source_digest", "analysis_digest", "gates", "all_pass", "expires_at_utc_ms", "static_scan_disclosure"],
      "properties": {
        "schema_version": { "const": "research.alpha-import-gates.v1" },
        "gate_receipt_id": { "$ref": "#/$defs/OpaqueId" },
        "source_file_ref": { "$ref": "#/$defs/OpaqueId" },
        "source_digest": { "$ref": "#/$defs/Digest" },
        "analysis_digest": { "$ref": "#/$defs/Digest" },
        "gates": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/GateRow" } },
        "all_pass": { "type": "boolean" },
        "expires_at_utc_ms": { "$ref": "#/$defs/UtcMilliseconds" },
        "static_scan_disclosure": { "const": "Static scan — runtime causality is proven per run at Stage 3/4." }
      }
    },
    "RegistryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpha_id", "alpha_version_id", "version_label", "lifecycle_state", "entrypoint", "declaration", "source_digest_prefix", "alpha_revision", "registered_at_utc_ms", "may_activate"],
      "properties": {
        "alpha_id": { "$ref": "#/$defs/AlphaId" },
        "alpha_version_id": { "$ref": "#/$defs/AlphaVersionId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "strategy_id": { "$ref": "#/$defs/AlphaId" },
        "source_digest": { "$ref": "#/$defs/Digest" },
        "supersedes": {
          "anyOf": [{ "$ref": "#/$defs/AlphaVersionId" }, { "type": "null" }],
          "description": "Immutable predecessor captured at registration; null is authoritative only with supersedes_state RECORDED."
        },
        "supersedes_state": {
          "enum": ["RECORDED", "HISTORICAL_NOT_RECORDED"],
          "description": "Distinguishes a proven first version from an older row without registration-time lineage."
        },
        "version_label": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^av_[0-9]+(?:_[0-9]+){2}$" },
        "lifecycle_state": { "enum": ["DRAFT", "ACTIVE", "SUPERSEDED", "ABANDONED"] },
        "entrypoint": { "type": "string", "minLength": 1, "maxLength": 160 },
        "declaration": { "$ref": "#/$defs/AlphaVersionDeclaration" },
        "source_digest_prefix": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "alpha_revision": { "type": "integer", "minimum": 1 },
        "registered_at_utc_ms": { "$ref": "#/$defs/UtcMilliseconds" },
        "may_activate": {
          "type": "boolean",
          "description": "Caller-specific admission evaluated by the exact server policy that guards POST activate; it is not inferred from lifecycle or a browser-held role."
        }
      }
    },
    "RegistryListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": { "const": "research.alpha-registry.v1" },
        "entries": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/RegistryEntry" } }
      }
    },
    "RegistrationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "alpha_id", "alpha_version_id", "version_label", "source_digest", "lifecycle_state", "supersedes", "alpha_revision", "replayed", "may_activate"],
      "properties": {
        "schema_version": { "const": "research.alpha-registration.v1" },
        "alpha_id": { "$ref": "#/$defs/AlphaId" },
        "alpha_version_id": { "$ref": "#/$defs/AlphaVersionId" },
        "version_label": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^av_[0-9]+(?:_[0-9]+){2}$" },
        "source_digest": { "$ref": "#/$defs/Digest" },
        "lifecycle_state": { "const": "DRAFT" },
        "supersedes": { "type": ["string", "null"], "maxLength": 160 },
        "alpha_revision": { "type": "integer", "minimum": 1 },
        "replayed": { "type": "boolean" },
        "may_activate": {
          "type": "boolean",
          "description": "Caller-specific admission evaluated by the exact server policy that guards POST activate; it is not inferred from lifecycle or a browser-held role."
        }
      }
    },
    "ActivationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "alpha_id", "alpha_version_id", "lifecycle_state", "superseded_alpha_version_id", "alpha_revision", "replayed"],
      "properties": {
        "schema_version": { "const": "research.alpha-activation.v1" },
        "alpha_id": { "$ref": "#/$defs/AlphaId" },
        "alpha_version_id": { "$ref": "#/$defs/AlphaVersionId" },
        "lifecycle_state": { "const": "ACTIVE" },
        "superseded_alpha_version_id": { "type": ["string", "null"], "maxLength": 160 },
        "alpha_revision": { "type": "integer", "minimum": 1 },
        "replayed": { "type": "boolean" }
      }
    }
  }
}
