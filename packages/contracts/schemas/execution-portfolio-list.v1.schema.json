{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution-portfolio-list.v1.schema.json",
  "$defs": {
    "Identifier": { "type": "string", "minLength": 1, "maxLength": 191 },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Decimal": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
    "Environment": { "enum": ["paper", "sandbox", "live"] },
    "CurrencyValue": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "value"],
      "properties": { "currency": { "$ref": "#/$defs/Identifier" }, "value": { "$ref": "#/$defs/Decimal" } }
    },
    "EnvironmentBranch": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reason_code"],
      "properties": {
        "state": { "enum": ["AVAILABLE", "EMPTY", "PARTIAL", "UNAVAILABLE"] },
        "reason_code": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }] }
      }
    },
    "PortfolioListItem": {
      "type": "object", "additionalProperties": false,
      "required": ["portfolio_id", "name", "owner", "state", "base_currency", "environments", "allocation_count", "deployment_count", "allocated_by_currency", "updated_at"],
      "properties": {
        "portfolio_id": { "$ref": "#/$defs/Identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "owner": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }] },
        "state": { "$ref": "#/$defs/Identifier" },
        "base_currency": { "$ref": "#/$defs/Identifier" },
        "environments": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/Environment" } },
        "allocation_count": { "type": "integer", "minimum": 0 },
        "deployment_count": { "type": "integer", "minimum": 0 },
        "allocated_by_currency": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/CurrencyValue" } },
        "updated_at": { "$ref": "#/$defs/Timestamp" },
        "health": { "$ref": "#/$defs/PortfolioHealth" },
        "root_id": { "$ref": "#/$defs/Identifier", "description": "WP-K (GAP-17), OPTIONAL: the capital root this portfolio hangs under; omitted = this producer has no owning source." },
        "owner_user_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }], "description": "WP-K (GAP-19), OPTIONAL: the owner as a Portal user id (the link target); `owner` stays the display text. null = the owner has no Portal user; omitted = no owning source." }
      }
    },
    "PortfolioHealth": {
      "description": "WP-K slice 6 (N3). A typed portfolio health roll-up with its source: the worst health among the portfolio's deployments, with the count of deployments in each class. The lifecycle `state` stays what it is; this is NOT it. OPTIONAL on an item: omitted = this producer has no owning source; NOT_PUBLISHED carries a reason code and no value (never a default of HEALTHY).",
      "type": "object", "additionalProperties": false,
      "required": ["state", "value", "basis", "deployments_by_health", "as_of", "reason_code"],
      "properties": {
        "state": { "enum": ["PUBLISHED", "NOT_PUBLISHED"] },
        "value": { "oneOf": [{ "enum": ["HEALTHY", "ATTENTION", "DEGRADED", "HALTED"] }, { "type": "null" }] },
        "basis": { "oneOf": [{ "const": "WORST_OF_DEPLOYMENT_HEALTH" }, { "type": "null" }] },
        "deployments_by_health": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["HEALTHY", "ATTENTION", "DEGRADED", "HALTED"],
          "properties": { "HEALTHY": { "type": "integer", "minimum": 0 }, "ATTENTION": { "type": "integer", "minimum": 0 }, "DEGRADED": { "type": "integer", "minimum": 0 }, "HALTED": { "type": "integer", "minimum": 0 } } }, { "type": "null" }] },
        "as_of": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "reason_code": { "oneOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }, { "type": "null" }] }
      },
      "allOf": [{
        "if": { "type": "object", "required": ["state"], "properties": { "state": { "const": "PUBLISHED" } } },
        "then": { "type": "object", "properties": { "value": { "type": "string" }, "basis": { "type": "string" }, "deployments_by_health": { "type": "object" }, "as_of": { "type": "string" }, "reason_code": { "type": "null" } } },
        "else": { "type": "object", "properties": { "value": { "type": "null" }, "basis": { "type": "null" }, "deployments_by_health": { "type": "null" }, "as_of": { "type": "null" }, "reason_code": { "type": "string" } } }
      }]
    },
    "PortfolioListResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "record_authority", "source_authority", "delivery_profile", "workspace_id", "environment", "read_at", "source_as_of", "freshness", "completeness", "environments", "total_portfolios", "truncated", "items"],
      "properties": {
        "schema_version": { "const": "execution.portfolio-list.v1" },
        "record_authority": { "const": "PORTAL_PROJECTION" },
        "source_authority": { "const": "TRADING_SYSTEM" },
        "delivery_profile": { "enum": ["ALL_EXECUTION_PROFILES", "PAPER_BINANCE_USDM", "SANDBOX_BINANCE_USDM", "LIVE_BINANCE_USDM"] },
        "workspace_id": { "$ref": "#/$defs/Identifier" },
        "environment": { "enum": ["all", "paper", "sandbox", "live"] },
        "read_at": { "$ref": "#/$defs/Timestamp" },
        "source_as_of": { "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "freshness": { "enum": ["FRESH", "AGING", "STALE"] },
        "freshness_budget_ms": { "type": "object", "additionalProperties": false, "required": ["fresh", "stale"], "properties": { "fresh": { "type": "integer", "minimum": 1 }, "stale": { "type": "integer", "minimum": 1 } } },
        "completeness": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
        "environments": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "paper": { "$ref": "#/$defs/EnvironmentBranch" },
            "sandbox": { "$ref": "#/$defs/EnvironmentBranch" },
            "live": { "$ref": "#/$defs/EnvironmentBranch" }
          }
        },
        "total_portfolios": { "type": "integer", "minimum": 0 },
        "matching_portfolios": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Present only for q: exact matches among authorized retained rows, not the uncapped source population. Preserve truncated/completeness disclosure. total_portfolios remains the unfiltered source census." },
        "truncated": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/PortfolioListItem" } }
      }
    }
  },
  "$ref": "#/$defs/PortfolioListResponse"
}
