{
  "lane": "TEST_ONLY_SYNTHETIC_NOT_PRODUCT_RECEIPT",
  "bases": {
    "published": "execution-recovery-events.published.synthetic.valid.json",
    "none": "execution-recovery-events.none.synthetic.valid.json"
  },
  "cases": [
    {
      "id": "kind-unknown",
      "base": "published",
      "rule": "kinds are closed",
      "ops": [
        {
          "op": "set",
          "path": [
            "events",
            0,
            "kind"
          ],
          "value": "FIXED_ITSELF"
        }
      ],
      "refused_by": "SCHEMA_AND_READER"
    },
    {
      "id": "at-float",
      "base": "published",
      "rule": "a clock is an integer",
      "ops": [
        {
          "op": "set",
          "path": [
            "events",
            0,
            "at_ms"
          ],
          "value": 1.5
        }
      ],
      "refused_by": "SCHEMA_AND_READER"
    }
  ]
}
