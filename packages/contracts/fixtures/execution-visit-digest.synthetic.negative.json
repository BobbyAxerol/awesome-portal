{
  "lane": "TEST_ONLY_SYNTHETIC_NOT_PRODUCT_RECEIPT",
  "bases": {
    "first": "execution-visit-digest.first.synthetic.valid.json",
    "seen": "execution-visit-digest.seen.synthetic.valid.json",
    "quiet": "execution-visit-digest.quiet.synthetic.valid.json"
  },
  "cases": [
    {
      "id": "baseline-without-who",
      "base": "seen",
      "rule": "a baseline names who set it",
      "ops": [
        {
          "op": "delete",
          "path": [
            "baseline",
            "set_by"
          ]
        }
      ],
      "refused_by": "SCHEMA_AND_READER"
    },
    {
      "id": "item-unknown-kind",
      "base": "first",
      "rule": "item kinds are closed",
      "ops": [
        {
          "op": "set",
          "path": [
            "items",
            0,
            "kind"
          ],
          "value": "GOSSIP"
        }
      ],
      "refused_by": "SCHEMA_AND_READER"
    },
    {
      "id": "count-float",
      "base": "first",
      "rule": "a count is an integer",
      "ops": [
        {
          "op": "set",
          "path": [
            "counts_by_kind",
            0,
            "count"
          ],
          "value": 1.5
        }
      ],
      "refused_by": "SCHEMA_AND_READER"
    },
    {
      "id": "cut-not-a-digest",
      "base": "first",
      "rule": "a cut revision is a sha256",
      "ops": [
        {
          "op": "set",
          "path": [
            "current_cut",
            "revision"
          ],
          "value": "abc"
        }
      ],
      "refused_by": "SCHEMA_AND_READER"
    },
    {
      "id": "unknown-key",
      "base": "first",
      "rule": "closed object",
      "ops": [
        {
          "op": "set",
          "path": [
            "score"
          ],
          "value": 1
        }
      ],
      "refused_by": "SCHEMA_AND_READER"
    }
  ]
}
