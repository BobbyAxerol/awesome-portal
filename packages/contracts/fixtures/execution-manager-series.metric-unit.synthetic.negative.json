{
  "lane": "TEST_ONLY_SYNTHETIC_NOT_PRODUCT_RECEIPT",
  "bases": {
    "nav": "execution-manager-series.populated.synthetic.valid.json",
    "return": "execution-manager-series.return.synthetic.valid.json",
    "unscaled": "execution-manager-series.return-scale-not-published.synthetic.valid.json",
    "pub": "execution-manager-series-publication.synthetic.valid.json",
    "pubReturn": "execution-manager-series-publication.return.synthetic.valid.json"
  },
  "note": "FE-013: the metric fixes the unit. NAV and NET_PNL are MONEY with a currency (the partition currency); RETURN is a RATIO with a ratio_scale and no currency; nothing else. The scale is stated by the source, never inferred from magnitudes.",
  "scales": {
    "FRACTION": "1 = 100% (0.0123 is 1.23%)",
    "PERCENT": "100 = 100% (1.23 is 1.23%)"
  },
  "cases": [
    {
      "id": "FE-013/nav-as-ratio",
      "base": "nav",
      "rule": "NAV is MONEY",
      "refused_by": "SCHEMA_AND_PRODUCER",
      "code": "MANAGER_SERIES_METRIC_UNIT_MISMATCH",
      "ops": [
        {
          "op": "set",
          "path": [
            "series",
            0,
            "unit"
          ],
          "value": "RATIO"
        },
        {
          "op": "set",
          "path": [
            "series",
            1,
            "unit"
          ],
          "value": "RATIO"
        },
        {
          "op": "set",
