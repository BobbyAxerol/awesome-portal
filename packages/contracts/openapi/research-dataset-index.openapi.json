{
  "openapi": "3.1.0",
  "info": {
    "title": "Research indexed data declaration",
    "version": "1.0.0",
    "description": "Explicit operator-built immutable index. Fixed UTC timestamps/exact counts over declared indexed ranges only; not instrument authority, constituent-minute completeness, a preflight token, engine admission or sealed-holdout values. GET does not build/scan HMD. V1 remains unchanged."
  },
  "paths": {
    "/api/v1/research/datasets/catalog-v2": {
      "get": {
        "operationId": "researchDatasetCatalogGetV2",
        "summary": "Read bounded Research historical metadata without scanning market data",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Named metadata response; absence remains typed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetCatalogV2"
                }
              }
            }
          },
          "400": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/research/datasets/{dataset_id}/symbols": {
      "get": {
        "operationId": "researchDatasetSymbolsGetV1",
        "summary": "Read bounded Research historical metadata without scanning market data",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{0,32}$",
              "default": ""
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "PERPETUAL",
                "QUARTERLY"
              ]
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(?:min|m|h|d)$"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Named metadata response; absence remains typed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SymbolPage"
                }
              }
            }
          },
          "400": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Typed refusal; never a market-data fallback",
            "content": {
              "application/json": {
