{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Run Library API",
    "version": "1.1.0",
    "description": "P12 same-origin Screen-01 persisted Run Library. It reads a bounded Portal PostgreSQL projection only; it does not execute QuantBT, scan Parquet/artifacts, or disclose source/worker/private transport inputs. Cursor tokens are opaque and bound to the exact workspace, filter, sort and page size."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs": {
      "get": {
        "operationId": "researchRunLibraryListV1",
        "summary": "List persisted Research runs in created-descending keyset order",
        "description": "At most 50 rows. Exact totals, counters and claim ledger are server-computed in the same read snapshot. ids polling is mutually exclusive with pagination and library filters. The result never assigns an OOS metric, certificate, claim, sparkline or source fact that persisted Research data did not publish. COMPLETED-card stats come from the persisted P13 projection and its metric registry; rc comes only from persisted P21 relations. q matches run id, alpha id/name, av, symbol, timeframe, optimization mode, schedule, protocol and sealed rc id; a legacy 1.0.8 row matches only its run id and recorded protocol. mode filters the optimization mode, never a protocol. A legacy row is excluded from every alpha filter, including scratch.",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/RunLibraryQuery" },
          { "$ref": "#/components/parameters/RunLibraryStatus" },
          { "$ref": "#/components/parameters/RunLibraryMode" },
          { "$ref": "#/components/parameters/RunLibraryAlpha" },
          { "$ref": "#/components/parameters/RunLibraryIds" },
          { "$ref": "#/components/parameters/RunLibraryCursor" },
          { "$ref": "#/components/parameters/RunLibraryBefore" },
          { "$ref": "#/components/parameters/RunLibraryLimit" }
        ],
        "responses": {
          "200": { "description": "One bounded historical Library page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunLibraryResponse" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/quantbt/runs/{runId}/sparkline": {
      "get": {
        "operationId": "researchRunLibrarySparklineV1",
        "summary": "Read at most 24 explicitly published display points for one run",
        "description": "For a COMPLETED durable run the values are the persisted P13 EQUITY_OOS equity points of the run's newest projection revision (the series the Screen-04 Hub reads), integrity-checked against their stored digest and reduced to at most 24 by an extrema-preserving bucket that always keeps the first, last, minimum and maximum. `source` names the revision and sampling. Nothing reads a worker artifact or Parquet file; every other case is a typed unavailable/legacy state.",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": { "description": "At most 24 exact decimal display points, or an honest unavailable state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunSparklineResponse" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "parameters": {
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "RunLibraryQuery": { "name": "q", "in": "query", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 96 } },
      "RunLibraryStatus": { "name": "status", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/components/schemas/RunStatus" } } },
      "RunLibraryMode": { "name": "mode", "in": "query", "required": false, "style": "form", "explode": true, "description": "Exact optimization mode (requested_spec.optimization_mode). A protocol key or a legacy row never matches.", "schema": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_:-]{1,120}$" } } },
      "RunLibraryAlpha": { "name": "alpha", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "anyOf": [{ "$ref": "#/components/schemas/AlphaId" }, { "const": "scratch" }] } } },
      "RunLibraryIds": { "name": "ids", "in": "query", "required": false, "style": "form", "explode": true, "description": "Visible-running-row poll only. Mutually exclusive with filters and cursors.", "schema": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/components/schemas/RunId" } } },
      "RunLibraryCursor": { "name": "cursor", "in": "query", "required": false, "description": "Opaque after cursor; binds workspace/filter/sort/limit.", "schema": { "type": "string", "minLength": 1, "maxLength": 4096 } },
      "RunLibraryBefore": { "name": "before", "in": "query", "required": false, "description": "Opaque before cursor; mutually exclusive with cursor. Boundaries carry exact PostgreSQL microsecond timestamps, so paging back never repeats or skips a row.", "schema": { "type": "string", "minLength": 1, "maxLength": 4096 } },
      "RunLibraryLimit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 50 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal. It never discloses a database relation, raw SQL, source transport, worker identity, artifact path, mTLS material or delegated credential.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "WorkspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "AlphaId": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{2,63}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ExactDecimal": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "LEGACY_METADATA_ONLY", "PENDING_SOURCE_CALLBACK"] }, "reason_code": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 160 }, { "type": "null" }] } } },
      "RunStatus": { "enum": ["COMPLETED", "RUNNING", "FAILED", "QUEUED", "DRAFT", "CANCELLED", "RECOVERY_REQUIRED"] },
      "StageCell": { "type": "object", "additionalProperties": false, "required": ["key", "state", "tip", "tooltip_source", "availability"], "properties": { "key": { "enum": ["S1", "S2", "S3", "S4", "S5"] }, "state": { "enum": ["done", "cap", "blocked", "run", "pend"] }, "tip": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1024 }, { "type": "null" }] }, "tooltip_source": { "enum": ["SOURCE_VERBATIM", "DERIVED_FROM_PERSISTED_STATE", "NOT_PUBLISHED"] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "MetricCell": { "type": "object", "additionalProperties": false, "required": ["key", "label", "role", "value", "tone", "availability", "scope", "definition_id"], "properties": { "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 96 }, "role": { "enum": ["OOS_SHARPE", "DECAY", "TRADE_COUNT", "PROGRESS", "TRIALS", "ELAPSED", "FAILED_AT", "FAILURE_REASON", "RUNTIME"] }, "value": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 192 }, { "type": "null" }] }, "tone": { "enum": ["DEFAULT", "BAD", "ACCENT"] }, "availability": { "$ref": "#/components/schemas/Availability" }, "scope": { "description": "P13 metric-registry scope of a COMPLETED-card value (TRADE_COUNT covers the full child tape, not OOS only). Null for lifecycle cells and absent values.", "anyOf": [{ "enum": ["OOS", "IS_PLUS_OOS", "CHILD_TAPE"] }, { "type": "null" }] }, "definition_id": { "description": "E11: also the retained lane's definition ids (research.current-source.v1.…), which Screen 10 already publishes for the same two values, so 01 and 10 name one definition.", "anyOf": [{ "type": "string", "pattern": "^research\\.(?:metric|current-source)\\.[a-z0-9_.-]{1,120}$" }, { "type": "null" }] } } },
      "ReleaseCandidateRef": { "type": "object", "additionalProperties": false, "description": "A persisted P21 relation only: the newest Portal-local sealed pack for the run, otherwise the viewer's own draft. Never inferred from a run name, claim or certificate.", "required": ["kind", "release_candidate_id", "draft_id", "delivery_state", "approval_state", "sealed_at_utc_ms"], "properties": { "kind": { "enum": ["LOCAL_SEAL", "ACTOR_DRAFT"] }, "release_candidate_id": { "anyOf": [{ "type": "string", "pattern": "^rc_[0-9A-HJKMNP-TV-Z]{26}$" }, { "type": "null" }] }, "draft_id": { "anyOf": [{ "type": "string", "pattern": "^rcd_[0-9A-HJKMNP-TV-Z]{26}$" }, { "type": "null" }] }, "delivery_state": { "anyOf": [{ "enum": ["NOT_DELIVERED", "PENDING", "DELIVERED", "UNKNOWN"] }, { "type": "null" }] }, "approval_state": { "anyOf": [{ "enum": ["NOT_APPROVED", "PENDING", "APPROVED", "REJECTED", "UNKNOWN"] }, { "type": "null" }] }, "sealed_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] } } },
      "AlphaBinding": { "type": "object", "additionalProperties": false, "required": ["alpha_id", "alpha_name", "alpha_version_id", "av", "digest"], "properties": { "alpha_id": { "$ref": "#/components/schemas/AlphaId" }, "alpha_name": { "type": "string", "minLength": 1, "maxLength": 240 }, "alpha_version_id": { "type": "string", "minLength": 1, "maxLength": 160 }, "av": { "type": "string", "minLength": 1, "maxLength": 160 }, "digest": { "$ref": "#/components/schemas/Digest" } } },
      "RunRelationship": { "type": "object", "additionalProperties": false, "required": ["kind", "logical_run_key", "parent_run_id", "technical_retry_count"], "properties": { "kind": { "enum": ["PRIMARY", "AUDIT_OF_SELECTION", "DIAGNOSTIC_OF_RUN", "REPRODUCTION_OF_RUN", "EXPORT_OF_RUN", "VERIFY_OF_RUN", "PROJECTION_OF_RUN", "LEGACY_UNKNOWN"] }, "logical_run_key": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] }, "parent_run_id": { "anyOf": [{ "$ref": "#/components/schemas/RunId" }, { "type": "null" }] }, "technical_retry_count": { "type": "integer", "minimum": 0 } } },
      "RunLibraryItem": { "type": "object", "additionalProperties": false, "required": ["run_id", "display_label", "attempt_id", "source_kind", "row_kind", "relationship", "status", "status_basis", "mode", "strategy_id", "binding", "binding_availability", "rc", "rc_availability", "instrument", "created_at_utc_ms", "certificate", "claim", "stages", "stats", "superseded_note", "comparison", "sparkline", "evidence_revision", "source_updated_at_utc_ms"], "properties": {
        "run_id": { "$ref": "#/components/schemas/RunId" }, "display_label": { "description": "D1: the short label the hi-fi prints (`R-WFO-118`) - the run's execution profile kind plus its position among the logical runs of that kind in this workspace, ordered by creation (run_id breaks a tie). Server-derived so two readers cannot disagree; presentation only - run_id remains the identity and is the only value a request may carry. null when the row is not a logical run of a known profile, and the reader prints the short id.", "anyOf": [{ "type": "string", "pattern": "^R-[A-Z0-9]{1,8}-[0-9]{3,6}$" }, { "type": "null" }] }, "attempt_id": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 160 }, { "type": "null" }] }, "source_kind": { "enum": ["RESEARCH_DURABLE", "LEGACY_1_0_8_METADATA"] }, "row_kind": { "enum": ["LOGICAL_RUN", "WORKER_CHILD", "AUDIT_CHILD", "REPRODUCTION_CHILD", "LEGACY_RUN"] }, "relationship": { "$ref": "#/components/schemas/RunRelationship" }, "status": { "$ref": "#/components/schemas/RunStatus" },
        "status_basis": { "type": "object", "additionalProperties": false, "description": "DURABLE_LIFECYCLE: the durable job/run lifecycle. LEGACY_RECORDED_STATUS: the value the retired 1.0.8 engine recorded; a recorded QUEUED/RUNNING is not monitored by anything (reason LEGACY_1_0_8_NON_TERMINAL_STATUS_NOT_MONITORED) and must not be presented as live work.", "required": ["kind", "availability"], "properties": { "kind": { "enum": ["DURABLE_LIFECYCLE", "LEGACY_RECORDED_STATUS"] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "mode": { "type": "object", "additionalProperties": false, "description": "display is `optimization_mode · optimization_schedule` for a durable run. key is the optimization mode only (null when none is published); protocol is carried separately and is never a mode.", "required": ["display", "key", "schedule", "protocol", "availability"], "properties": { "display": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 240 }, { "type": "null" }] }, "key": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 120 }, { "type": "null" }] }, "schedule": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 120 }, { "type": "null" }] }, "protocol": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 120 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "strategy_id": { "type": "object", "additionalProperties": false, "required": ["value", "availability"], "properties": { "value": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 192 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "binding": { "anyOf": [{ "$ref": "#/components/schemas/AlphaBinding" }, { "type": "null" }] }, "binding_availability": { "$ref": "#/components/schemas/Availability" }, "rc": { "anyOf": [{ "$ref": "#/components/schemas/ReleaseCandidateRef" }, { "type": "null" }] }, "rc_availability": { "$ref": "#/components/schemas/Availability" },
        "instrument": { "type": "object", "additionalProperties": false, "required": ["display", "availability"], "properties": { "display": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 192 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "created_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" },
        "certificate": { "type": "object", "additionalProperties": false, "required": ["grade", "availability"], "properties": { "grade": { "anyOf": [{ "enum": ["A", "B", "C", "D"] }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "claim": { "type": "object", "additionalProperties": false, "description": "The persisted Stage-5 claim, state and sentence verbatim, identical to the Screen-04 Hub claim for the same run (a NOT_ISSUED sentence is still the source sentence).", "required": ["state", "text", "availability"], "properties": { "state": { "anyOf": [{ "enum": ["FORECAST", "NOT_ISSUED", "ISSUED"] }, { "type": "null" }] }, "text": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1024 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "stages": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/components/schemas/StageCell" } }, "stats": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/components/schemas/MetricCell" } },
        "superseded_note": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1024 }, { "type": "null" }] },
        "comparison": { "type": "object", "additionalProperties": false, "required": ["key", "availability"], "properties": { "key": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 160 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "sparkline": { "type": "object", "additionalProperties": false, "required": ["kind", "availability"], "properties": { "kind": { "anyOf": [{ "enum": ["oos_equity", "search_progress", "failed"] }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        "evidence_revision": { "description": "The persisted P13 projection revision the COMPLETED stats and sparkline come from.", "anyOf": [{ "type": "string", "pattern": "^p13r[0-9]+_[0-9a-f]{64}$" }, { "type": "null" }] }, "source_updated_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }
      } },
      "RunLibraryResponse": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "items", "page", "counters", "status_counts", "claim_ledger", "filter_catalog", "as_of_utc_ms"], "properties": {
        "schema_version": { "const": "research.run-library.v1" }, "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" }, "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/components/schemas/RunLibraryItem" } },
        "page": { "type": "object", "additionalProperties": false, "required": ["limit", "total_rows", "filtered_rows", "next_cursor", "prev_cursor", "has_more", "has_previous", "order"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 50 }, "total_rows": { "type": "integer", "minimum": 0 }, "filtered_rows": { "type": "integer", "minimum": 0 }, "next_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "prev_cursor": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "has_more": { "type": "boolean" }, "has_previous": { "type": "boolean" }, "order": { "const": "CREATED_AT_DESC_RUN_ID_DESC" } } },
        "counters": { "type": "object", "additionalProperties": false, "required": ["logical_runs", "worker_children", "technical_retries", "legacy_metadata_rows"], "properties": { "logical_runs": { "type": "integer", "minimum": 0 }, "worker_children": { "type": "integer", "minimum": 0 }, "technical_retries": { "type": "integer", "minimum": 0 }, "legacy_metadata_rows": { "type": "integer", "minimum": 0 } } },
        "status_counts": { "type": "object", "additionalProperties": false, "description": "D3: status counts over the filtered rows — the HiFi's first summary line (\"7 runs · 5 completed · 1 running · 1 failed\"). The seven statuses partition page.filtered_rows and come from the same effective_status the cards print, so a count can never contradict a card.", "required": ["COMPLETED", "RUNNING", "FAILED", "QUEUED", "DRAFT", "CANCELLED", "RECOVERY_REQUIRED"], "properties": { "COMPLETED": { "type": "integer", "minimum": 0 }, "RUNNING": { "type": "integer", "minimum": 0 }, "FAILED": { "type": "integer", "minimum": 0 }, "QUEUED": { "type": "integer", "minimum": 0 }, "DRAFT": { "type": "integer", "minimum": 0 }, "CANCELLED": { "type": "integer", "minimum": 0 }, "RECOVERY_REQUIRED": { "type": "integer", "minimum": 0 } } },
        "claim_ledger": { "type": "object", "additionalProperties": false, "description": "Six buckets that partition the filtered rows (their sum is page.filtered_rows). pending_source is only a durable, non-cancelled run still waiting for its source claim; a run cancelled before its source published is cancelled_before_source; a legacy 1.0.8 row is legacy_metadata_only.", "required": ["issued", "not_issued", "pending_source", "failed", "cancelled_before_source", "legacy_metadata_only"], "properties": { "issued": { "type": "integer", "minimum": 0 }, "not_issued": { "type": "integer", "minimum": 0 }, "pending_source": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "cancelled_before_source": { "type": "integer", "minimum": 0 }, "legacy_metadata_only": { "type": "integer", "minimum": 0 } } },
        "filter_catalog": { "type": "object", "additionalProperties": false, "required": ["alphas", "modes", "scratch_available"], "properties": { "alphas": { "type": "array", "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["alpha_id", "alpha_name"], "properties": { "alpha_id": { "$ref": "#/components/schemas/AlphaId" }, "alpha_name": { "type": "string", "minLength": 1, "maxLength": 240 } } } }, "modes": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["key", "display"], "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 120 }, "display": { "type": "string", "minLength": 1, "maxLength": 240 } } } }, "scratch_available": { "type": "boolean" } } },
        "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }
      } },
      "RunSparklineResponse": { "type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "values", "availability", "source_revision", "source"], "properties": { "schema_version": { "const": "research.run-sparkline.v1" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "values": { "type": "array", "maxItems": 24, "items": { "$ref": "#/components/schemas/ExactDecimal" } }, "availability": { "$ref": "#/components/schemas/Availability" }, "source_revision": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 160 }, { "type": "null" }] }, "source": { "anyOf": [{ "$ref": "#/components/schemas/RunSparklineSource" }, { "type": "null" }] } } },
      "RunSparklineSource": { "type": "object", "additionalProperties": false, "description": "Provenance of the display values: the lane that answered, its series, its source sampling and the Library's own <=24-point reduction. Null whenever values is empty. A retained walk-forward run has no P13 series, so its curve is the sealed RS-02 observation tape.", "required": ["lane", "series_kind", "value_field", "projection_revision", "series_digest", "source_observation_count", "source_sampling", "persisted_point_count", "display_sampling", "first_at_utc_ms", "last_at_utc_ms"], "properties": { "lane": { "enum": ["PORTAL_PERSISTED_RESEARCH", "PORTAL_RETAINED_CURRENT_SOURCE"] }, "series_kind": { "enum": ["EQUITY_OOS", "EQUITY"] }, "value_field": { "const": "equity" }, "projection_revision": { "type": "string", "pattern": "^(?:p13r[0-9]+_[0-9a-f]{64}|rs02r[0-9]+)$" }, "series_digest": { "description": "Null on the retained lane: its integrity is the seal's, not a per-series digest.", "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "source_observation_count": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }, "source_sampling": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 64 }, { "type": "null" }] }, "persisted_point_count": { "type": "integer", "minimum": 0 }, "display_sampling": { "enum": ["FULL", "EXTREMA_BUCKET_24_V1"] }, "first_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "last_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" } } }
    }
  }
}
