{
  "openapi": "3.1.0",
  "info": {
    "title": "portfolio-members",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/portfolios/{portfolio_id}/members": {
      "get": {
        "operationId": "executionPortfolioMembersGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "The people with a membership on a portfolio. `role_label` is a DISPLAY word, never an authorization. CONTRACT ONLY: no producer exists yet (Edge/Core inputs are in WP_K_CONTRACTS_2026-10-23.md), so nothing serves this route and every screen keeps its typed absence.",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191,
              "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current answer; absence stays typed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioMembers"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioMembersProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioMembersProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioMembersProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioMembersProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "PortfolioMembers": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms",
          "portfolio_id"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.portfolio-members.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "portfolio_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          },
          "members": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "membership_id",
                    "user_id",
                    "role_label",
                    "valid_from_ms",
                    "valid_until_ms",
                    "state"
                  ],
                  "properties": {
                    "membership_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "user_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "role_label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                    },
                    "valid_from_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "valid_until_ms": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "ACTIVE",
                        "SCHEDULED",
                        "ENDED"
                      ]
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PortfolioMembersProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
