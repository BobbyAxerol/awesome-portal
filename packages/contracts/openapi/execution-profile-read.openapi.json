{
  "openapi": "3.1.0",
  "info": { "title": "Primus Portal N23 Profile Read API", "version": "1.0.0" },
  "paths": {
    "/api/v1/execution/screens/sandbox": {
      "get": {
        "operationId": "executionSandboxOverviewV1",
        "responses": { "200": { "description": "Sandbox profile overview", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-profile-read.v1.schema.json#/$defs/ProfileRead" } } } } }
      }
    },
    "/api/v1/execution/screens/live": {
      "get": {
        "operationId": "executionLiveOverviewV1",
        "responses": { "200": { "description": "Live profile overview, including truthful empty", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-profile-read.v1.schema.json#/$defs/ProfileRead" } } } } }
      }
    },
    "/api/v1/execution/screens/accounts/{account_id}": {
      "get": {
        "operationId": "executionAccountBroker360V1",
        "parameters": [
          { "name": "account_id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 191 } },
          { "name": "environment", "in": "query", "required": false, "schema": { "type": "string", "enum": ["paper", "sandbox", "live"] } }
        ],
        "responses": { "200": { "description": "Exact Account/Broker 360 read across current profiles", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-profile-read.v1.schema.json#/$defs/AccountRead" } } } } }
      }
    },
    "/api/v1/execution/governance/approvals/{approval_id}/live": {
      "get": {
        "operationId": "executionGateLiveReviewV1",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Legacy Live review OR finite current-authorized stored LIVE_GATE root. Separate source facts stay typed unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "../schemas/governance-live-review.v1.schema.json"
                    },
                    {
                      "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/LiveParentReadV2"
                    }
                  ]
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            }
          },
          "400": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Strict finite input invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "401": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Current authenticated Portal session required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "403": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Current actor/session lifecycle denied; no parent detail returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "404": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Uniform unknown, hidden, wrong workspace/family/target parent; no disclosure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "409": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "ACCESS_RETRY_REQUIRED: current authority or stored parent changed; no legacy fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "503": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Fixed parent field-purpose, integrity, bound or configuration unavailable; no raw SQL/provider/Zod text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          }
        },
        "description": "Sticky current Core selects the independent exact Live reader before legacy reads. SCOPED_V2 requires current qualified DEPLOYMENT/LIVE audit, governance.live.read and LIVE_ROOT purpose before protected SQL. No fabricated Portfolio or predecessor, owner/read_all/decide shortcut or source-screen call. One SAME flight fences successful metadata and held errors after exact local equality, source and LAST Core/session/clock checks. Historical approval expiry is not read expiry; stored approval is not current TS acceptance, execution or activation."
      }
    }
  }
}
