    "/api/admin/step-up": {
      "get": {
        "operationId": "getStepUpState",
        "summary": "Whether this session has a live step-up, and until when.",
        "responses": {
          "200": {
            "description": "Current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StepUpState"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "grantStepUp",
        "summary": "Re-authenticate the owner for this session with their OWN password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Step-up granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StepUpState"
                }
              }
            }
          },
          "403": {
            "description": "The password was not accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/profile-access": {
      "get": {
        "operationId": "getAccessPolicy",
        "summary": "Every account and the Governance capabilities it holds.",
        "responses": {
          "200": {
            "description": "The policy matrix.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schema_version",
                    "accounts"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "string",
                      "const": "portal.profile-access.v1"
                    },
                    "record_authority": {
                      "type": "string",
                      "const": "PORTAL_CONTROL"
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PolicyAccount"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "grantCapability",
        "summary": "Grant one capability from the finite namespace. Step-up required.",
        "parameters": [
          {
            "name": "x-portal-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "grantee_user_id",
                  "capability"
                ],
                "properties": {
                  "grantee_user_id": {
                    "type": "string"
                  },
                  "capability": {
                    "type": "string"
                  },
                  "workspace_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantChangeResult"
                }
              }
            }
          },
          "403": {
            "description": "Not the owner, or no step-up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "SELF_GRANT_REFUSED, OWNER_ANCHOR_PROTECTED, GRANT_ALREADY_ACTIVE, GRANTEE_NOT_IN_WORKSPACE, ACCOUNT_NOT_ACTIVE, CAPABILITY_NOT_DELEGABLE or a replayed key with a different payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "CAPABILITY_NOT_IN_NAMESPACE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/profile-access/activity": {
      "get": {
        "operationId": "getAccessActivity",
        "summary": "The immutable delegation lineage for one account, refusals included.",
        "parameters": [
          {
            "name": "grantee_user_id",
            "in": "query",
            "required": true,
