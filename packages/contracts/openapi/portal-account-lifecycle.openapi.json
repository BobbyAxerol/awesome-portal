                    },
                    "activity": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GrantActivityEntry"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/profile-access/{grant_id}": {
      "delete": {
        "operationId": "revokeCapability",
        "summary": "Revoke a grant, pinned to its revision. Effective on the next decision.",
        "parameters": [
          {
            "name": "grant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-portal-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_revision"
                ],
                "properties": {
                  "expected_revision": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantChangeResult"
                }
              }
            }
          },
          "409": {
            "description": "STALE_GRANT_REVISION or GRANT_ALREADY_REVOKED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountSummary": {
        "type": "object",
        "description": "An account as the roster may see it. §20.5 item 1 excludes hashes, tokens, Cloudflare subject/email, session ids and audit internals; this is the whole published shape.",
        "required": [
          "user_id",
          "username",
          "display_name",
          "role",
          "account_state",
          "must_change_password",
          "account_revision",
          "locked"
        ],
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "description": "Opaque and stable. Never a database sequence or an email."
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "USER"
            ],
            "description": "The coarse product role kept for compatibility. It is NOT ownership and authorizes nothing in this plane."
          },
          "account_state": {
            "type": "string",
            "enum": [
              "INVITED",
              "ACTIVE",
              "DISABLED",
              "ARCHIVED"
            ],
            "description": "ARCHIVED is disabled plus a retained lineage marker; no account row is ever deleted."
          },
          "must_change_password": {
            "type": "boolean",
            "description": "True means login accepts only an activation credential, so any earlier password is unreachable."
          },
          "account_revision": {
            "type": "integer",
            "description": "Pin the next operation to this. It changes on every lifecycle write and on nothing else."
          },
          "locked": {
            "type": "boolean"
          }
        }
      },
      "LifecycleHistoryEntry": {
        "type": "object",
        "required": [
          "operation_id",
          "action",
          "outcome",
          "actor_user_id",
          "expected_revision",
          "state_before",
          "rollback_description",
          "step_up_used",
          "occurred_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "CREATE_INVITED",
              "UPDATE_PROFILE",
              "ISSUE_ACTIVATION",
              "REVOKE_SESSIONS",
              "DISABLE",
              "ENABLE",
              "ARCHIVE"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "APPLIED",
              "REPLAYED",
              "CONFLICT",
              "DENIED"
            ],
            "description": "Refusals are recorded too. A history that shows only what worked cannot answer 'why did nothing happen when I pressed that'."
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_user_id": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer"
          },
          "resulting_revision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "state_before": {
            "$ref": "#/components/schemas/AccountSummary"
          },
          "state_after": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccountSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "rollback_description": {
            "type": "string",
            "description": "What undoing this would mean, in the imperative, for a human reading the log during an incident."
          },
          "step_up_used": {
            "type": "boolean"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OperationResult": {
        "type": "object",
        "required": [
          "schema_version",
          "outcome",
          "operation_id",
          "account",
          "rollback_description"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "portal.account-operation.v1"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "APPLIED",
              "REPLAYED"
            ]
          },
          "operation_id": {
            "type": "string"
          },
          "account": {
            "type": "object",
            "required": [
              "user_id",
              "username",
              "account_revision"
            ],
            "properties": {
              "user_id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "account_revision": {
                "type": "integer"
              }
            }
          },
          "rollback_description": {
            "type": "string"
          },
          "activation": {
            "$ref": "#/components/schemas/ActivationHandoff",
            "description": "Present ONLY on the response that minted the credential. A REPLAYED outcome never carries it: the one view has already happened, and re-revealing on every retry would make 'one view' mean 'as many as the network felt like'."
          }
        }
      },
      "ActivationHandoff": {
        "type": "object",
        "required": [
          "token",
          "acknowledgement_required",
          "note"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Plaintext, once, on a no-store response. Stored nowhere — not in the operation record, not in an audit row, not in a log."
          },
          "acknowledgement_required": {
            "type": "boolean",
            "const": true
          },
          "note": {
            "type": "string"
          }
        }
      },
      "StepUpState": {
        "type": "object",
        "required": [
          "schema_version",
          "state",
          "expires_at"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "portal.owner-step-up.v1"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "REQUIRED"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "STEP_UP_REQUIRED, STALE_ACCOUNT_REVISION, IDEMPOTENCY_KEY_PAYLOAD_CONFLICT, ACTIVATION_ALREADY_ISSUED, OWNER_ANCHOR_PROTECTED, ACCOUNT_NOT_FOUND, USERNAME_TAKEN, USERNAME_INVALID."
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "GrantedCapability": {
        "type": "object",
        "required": [
          "capability",
          "grant_id",
          "workspace_id",
          "grant_revision"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "governance.r1.read",
              "governance.r1.decide",
              "governance.r2.read",
              "governance.r2.decide",
              "governance.canary.read",
              "governance.canary.decide",
              "governance.live.read",
              "governance.live.decide"
            ]
          },
          "grant_id": {
            "type": "string"
          },
          "workspace_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "null means every workspace the grantee is already a member of. A grant says what somebody may do, never where they may go."
          },
          "grant_revision": {
            "type": "integer",
            "description": "Pin a revoke to this."
          }
        }
      },
      "PolicyAccount": {
        "type": "object",
        "required": [
          "user_id",
          "username",
          "display_name",
          "is_owner",
          "account_state",
          "capabilities"
        ],
        "properties": {
          "user_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "is_owner": {
            "type": "boolean",
            "description": "The owner holds every capability through the anchor, not through a grant row — which is why a grant aimed at the owner is refused."
          },
          "account_state": {
            "type": "string",
            "enum": [
              "INVITED",
              "ACTIVE",
              "DISABLED",
              "ARCHIVED"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GrantedCapability"
            }
          }
        }
      },
      "GrantActivityEntry": {
        "type": "object",
        "required": [
          "event_id",
          "action",
          "capability",
          "outcome",
          "actor_user_id",
          "occurred_at"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "GRANT",
              "REVOKE"
            ]
          },
          "capability": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "APPLIED",
              "REPLAYED",
              "CONFLICT",
              "DENIED"
            ],
            "description": "Refusals are published too: a trail of only what worked cannot answer 'why does this person still not have it'."
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_user_id": {
            "type": "string"
          },
          "grant_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "step_up_used": {
            "type": "boolean"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GrantChangeResult": {
        "type": "object",
        "required": [
          "schema_version",
          "outcome",
          "event_id",
          "external_effect"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "portal.profile-access-change.v1"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "APPLIED",
              "REPLAYED"
            ]
          },
          "event_id": {
            "type": "string"
          },
          "grant": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GrantedCapability"
              },
              {
                "type": "null"
              }
            ]
          },
          "external_effect": {
            "type": "string",
            "const": "NONE",
            "description": "§20.2 rule 5: delegating a Governance capability creates no Trading System command, promotes no capital and changes no source data."
          }
        }
      }
    }
  }
}
