{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal owner control plane (A4-2 accounts, A4-3 Governance delegation)",
    "version": "1.0.0",
    "description": "Owner-only account control plane. Every mutation carries the account revision it is acting on, an idempotency key, and — for the destructive ones — a step-up performed in the same session. No response ever contains a password hash, a Cloudflare subject or email, a session id, or an activation credential other than on the single response that minted it."
  },
  "paths": {
    "/api/admin/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "The owner account roster.",
        "responses": {
          "200": {
            "description": "Every account, sanitized.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schema_version",
                    "accounts"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "string",
                      "const": "portal.account-roster.v1"
                    },
                    "record_authority": {
                      "type": "string",
                      "const": "PORTAL_CONTROL"
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AccountSummary"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createInvitedAccount",
        "summary": "Create an invited account. Deliberately mints no credential.",
        "parameters": [
          {
            "name": "x-portal-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Makes a retry answerable rather than re-executable. The same key with a DIFFERENT payload is refused, because that is a caller bug and not a retry."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "USER"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account, and the operation that created it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "201": {
            "description": "The account, and the operation that created it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "403": {
            "description": "Not the owner, or the step-up has expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale revision, replayed key with a different payload, an activation already live, or the owner anchor protected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/accounts/{user_id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "One account and its action history.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account plus history.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schema_version",
                    "account",
                    "history"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "string",
                      "const": "portal.account-detail.v1"
                    },
                    "record_authority": {
                      "type": "string",
                      "const": "PORTAL_CONTROL"
                    },
                    "account": {
                      "$ref": "#/components/schemas/AccountSummary"
                    },
                    "history": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LifecycleHistoryEntry"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateAccountProfile",
        "summary": "Change display name or base role.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-portal-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Makes a retry answerable rather than re-executable. The same key with a DIFFERENT payload is refused, because that is a caller bug and not a retry."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_revision"
                ],
                "properties": {
                  "expected_revision": {
                    "type": "integer"
                  },
                  "display_name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ADMIN",
                      "USER"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "201": {
            "description": "The operation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "403": {
            "description": "Not the owner, or the step-up has expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale revision, replayed key with a different payload, an activation already live, or the owner anchor protected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/accounts/{user_id}/activation": {
      "post": {
        "operationId": "issueActivation",
        "summary": "Issue a one-time activation credential. Step-up required; non-replayable.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-portal-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Makes a retry answerable rather than re-executable. The same key with a DIFFERENT payload is refused, because that is a caller bug and not a retry."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expected_revision"
                ],
                "properties": {
                  "expected_revision": {
                    "type": "integer"
                  },
                  "reissue": {
                    "type": "boolean",
                    "description": "Revoke a still-live activation and mint another. Never implicit — a repeat without this is refused by name."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "201": {
            "description": "The operation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResult"
                }
              }
            }
          },
          "403": {
            "description": "Not the owner, or the step-up has expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale revision, replayed key with a different payload, an activation already live, or the owner anchor protected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
