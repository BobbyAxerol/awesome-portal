{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Attempt Lineage API",
    "version": "1.0.0",
    "description": "P19 same-origin Screen-10 Attempt Lineage. It reads a bounded Portal-persisted Research graph only. It does not submit/fork/reproduce a run, start QuantBT, read worker/artifact/source paths, expose cursors/leases/credentials, reset governance gates, or choose a promotion from metrics, lifecycle state or recency."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/research/alphas/{alphaId}/lineage": {
      "get": {
        "operationId": "researchAttemptLineageGetV1",
        "summary": "Read one bounded, source-backed Alpha attempt lineage",
        "description": "The graph is chronological and bounded to 128 attempts. When a history exceeds the bound, coverage is explicitly PARTIAL with P19_BOUNDED_GRAPH_LIMIT_REACHED; consumers must not present its returned prefix as complete. Each returned attempt also bounds child runs and declares P19_CHILD_RUNS_BOUNDED_PER_ATTEMPT when needed. promotion_pick is PUBLISHED only from an immutable source-attested fact. A missing pick is typed NOT_PUBLISHED with P19_SOURCE_DID_NOT_PUBLISH_PROMOTION_PICK and must never be replaced by best/newest/ACTIVE logic in the browser.",
        "parameters": [
          { "$ref": "#/components/parameters/AlphaId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/LineageLimit" }
        ],
        "responses": {
          "200": { "description": "One bounded persisted lineage snapshot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttemptLineageResponse" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" }
    },
    "parameters": {
      "AlphaId": { "name": "alphaId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/AlphaId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "LineageLimit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 128, "default": 128 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal. It never discloses a relation, raw config payload, source path, worker identity, lease, cursor, delegated credential or promotion policy.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "WorkspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "AlphaId": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{2,63}$" },
      "OpaqueId": { "type": "string", "minLength": 1, "maxLength": 191, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ReasonCode": { "type": "string", "minLength": 1, "maxLength": 160 },
      "Problem": {
        "type": "object", "additionalProperties": false, "required": ["error"],
        "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } }
      },
      "Availability": {
        "type": "object", "additionalProperties": false, "required": ["state", "reason_code"],
        "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PARTIAL"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } }
      },
      "PromotionPick": {
        "type": "object", "additionalProperties": false,
        "required": ["state", "attempt_id", "run_id", "source_contract_rev", "source_digest", "source_as_of_utc_ms", "availability"],
        "properties": {
          "state": { "enum": ["PUBLISHED", "NOT_PUBLISHED"] },
          "attempt_id": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueId" }, { "type": "null" }] },
          "run_id": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueId" }, { "type": "null" }] },
          "source_contract_rev": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 160 }, { "type": "null" }] },
          "source_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] },
          "source_as_of_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] },
          "availability": { "$ref": "#/components/schemas/Availability" }
        }
      },
      "AlphaVersion": {
        "type": "object", "additionalProperties": false,
        "required": ["alpha_version_id", "label", "code_digest", "entrypoint", "lifecycle_state", "registered_at_utc_ms", "promotion_pick"],
        "properties": {
          "alpha_version_id": { "$ref": "#/components/schemas/OpaqueId" },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "code_digest": { "$ref": "#/components/schemas/Digest" },
          "entrypoint": { "type": "string", "minLength": 1, "maxLength": 512 },
          "lifecycle_state": { "enum": ["DRAFT", "ACTIVE", "SUPERSEDED", "ABANDONED"] },
          "registered_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" },
          "promotion_pick": { "$ref": "#/components/schemas/PromotionPick" }
        }
      },
      "SemanticChange": {
        "type": "object", "additionalProperties": false, "required": ["path", "kind", "before", "after"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
          "kind": { "enum": ["CONFIG", "DATA", "ENGINE", "ALPHA_VERSION"] },
          "before": { "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }] },
          "after": { "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }] }
        }
      },
      "SemanticDiff": {
        "type": "object", "additionalProperties": false, "required": ["state", "changes", "gates_reset", "availability"],
        "properties": {
          "state": { "enum": ["ROOT", "AVAILABLE", "NOT_PUBLISHED", "PARENT_OUTSIDE_RETURNED_GRAPH"] },
          "changes": { "type": "array", "maxItems": 48, "items": { "$ref": "#/components/schemas/SemanticChange" } },
          "gates_reset": { "type": "boolean", "description": "Disclosure/navigation fact only; no click/action writes a gate or approval." },
          "availability": { "$ref": "#/components/schemas/Availability" }
        }
      },
      "ChildRun": {
        "type": "object", "additionalProperties": false, "required": ["run_id", "run_kind", "relationship_kind", "parent_run_id", "state", "created_at_utc_ms"],
        "properties": {
          "run_id": { "$ref": "#/components/schemas/OpaqueId" },
          "run_kind": { "enum": ["PRIMARY", "AUDIT", "DIAGNOSTIC", "REPRODUCTION", "EXPORT", "VERIFY", "PROJECTION"] },
          "relationship_kind": { "enum": ["PRIMARY", "AUDIT_OF_SELECTION", "DIAGNOSTIC_OF_RUN", "REPRODUCTION_OF_RUN", "EXPORT_OF_RUN", "VERIFY_OF_RUN", "PROJECTION_OF_RUN"] },
          "parent_run_id": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueId" }, { "type": "null" }] },
          "state": { "enum": ["DRAFT", "QUEUED", "RUNNING", "SEALING", "READY", "FAILED", "CANCELLED", "RECOVERY_REQUIRED"] },
          "created_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }
        }
      },
      "ChildRunsCoverage": {
        "type": "object", "additionalProperties": false, "required": ["state", "reason_code"],
        "properties": {
          "state": { "enum": ["COMPLETE", "PARTIAL"] },
          "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }
        }
      },
      "Exposure": {
        "type": "object", "additionalProperties": false, "required": ["state", "count", "roles", "latest_source_as_of_utc_ms", "availability"],
        "properties": {
          "state": { "enum": ["RECORDED", "NOT_PUBLISHED"] },
          "count": { "type": "integer", "minimum": 0 },
          "roles": { "type": "array", "maxItems": 7, "items": { "enum": ["QUALITY_SCAN", "TRAIN", "SELECTION_INPUT", "OUTER_OOS", "HOLDOUT", "RETROSPECTIVE", "UNKNOWN"] } },
          "latest_source_as_of_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] },
          "availability": { "$ref": "#/components/schemas/Availability" }
        }
      },
      "AttemptNode": {
        "type": "object", "additionalProperties": false,
        "required": ["attempt_id", "parent_attempt_id", "parent_state", "alpha_version_id", "alpha_version_label", "state", "intent_kind", "relation_to_parent", "reason", "space_signature", "created_at_utc_ms", "updated_at_utc_ms", "primary_run", "child_runs", "child_runs_coverage", "semantic_diff", "exposure"],
        "properties": {
          "attempt_id": { "$ref": "#/components/schemas/OpaqueId" },
          "parent_attempt_id": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueId" }, { "type": "null" }] },
          "parent_state": { "enum": ["ROOT", "RETURNED", "OUTSIDE_RETURNED_GRAPH"] },
          "relation_to_parent": { "anyOf": [{ "enum": ["SIBLING_OF"] }, { "type": "null" }], "description": "W5a: SIBLING_OF when this attempt was forked from a Screen-07 what-if node of its parent attempt's run; its own intent and config_hash." },
          "alpha_version_id": { "$ref": "#/components/schemas/OpaqueId" },
          "alpha_version_label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "state": { "enum": ["DRAFT", "PREFLIGHT_VALID", "QUEUED", "CLAIMED", "RUNNING", "COMPUTE_DONE", "SEALING", "READY", "CANCEL_REQUESTED", "CANCELLED", "FAILED", "RECOVERY_REQUIRED", "ABANDONED"] },
          "intent_kind": { "enum": ["NEW", "CLONE_FOR_EXPERIMENT", "REPRODUCE_EXISTING", "UPGRADE_ENGINE_EXPERIMENT"] },
          "reason": { "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }] },
          "space_signature": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] },
          "created_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" },
          "updated_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" },
          "primary_run": { "type": "object", "additionalProperties": false, "required": ["run_id", "state", "effective_spec_digest", "engine_release_id", "dataset_binding_digest", "technical_retry_count"], "properties": { "run_id": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueId" }, { "type": "null" }] }, "state": { "anyOf": [{ "enum": ["DRAFT", "QUEUED", "RUNNING", "SEALING", "READY", "FAILED", "CANCELLED", "RECOVERY_REQUIRED"] }, { "type": "null" }] }, "effective_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "engine_release_id": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] }, "dataset_binding_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "technical_retry_count": { "type": "integer", "minimum": 0 } } },
          "child_runs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/components/schemas/ChildRun" } },
          "child_runs_coverage": { "$ref": "#/components/schemas/ChildRunsCoverage" },
          "semantic_diff": { "$ref": "#/components/schemas/SemanticDiff" },
          "exposure": { "$ref": "#/components/schemas/Exposure" }
        }
      },
      "AttemptLineageResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "read_authority", "alpha", "attempts", "counts", "coverage", "source_absences", "as_of_utc_ms"],
        "properties": {
          "schema_version": { "const": "research.attempt-lineage.v1" },
          "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" },
          "alpha": { "type": "object", "additionalProperties": false, "required": ["alpha_id", "name", "active_version_id", "active_version_state", "active_version_availability", "versions"], "properties": { "alpha_id": { "$ref": "#/components/schemas/AlphaId" }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "active_version_id": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueId" }, { "type": "null" }] }, "active_version_state": { "anyOf": [{ "enum": ["DRAFT", "ACTIVE", "SUPERSEDED", "ABANDONED"] }, { "type": "null" }] }, "active_version_availability": { "$ref": "#/components/schemas/Availability" }, "versions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/components/schemas/AlphaVersion" } } } },
          "attempts": { "type": "array", "maxItems": 128, "items": { "$ref": "#/components/schemas/AttemptNode" } },
          "counts": { "type": "object", "additionalProperties": false, "required": ["total_attempts", "returned_attempts", "draft_attempts", "submitted_attempts", "failed_attempts", "abandoned_attempts", "child_runs", "technical_retries"], "properties": { "total_attempts": { "type": "integer", "minimum": 0 }, "returned_attempts": { "type": "integer", "minimum": 0 }, "draft_attempts": { "type": "integer", "minimum": 0 }, "submitted_attempts": { "type": "integer", "minimum": 0 }, "failed_attempts": { "type": "integer", "minimum": 0 }, "abandoned_attempts": { "type": "integer", "minimum": 0 }, "child_runs": { "type": "integer", "minimum": 0 }, "technical_retries": { "type": "integer", "minimum": 0 } } },
          "coverage": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "oldest_returned_created_at_utc_ms"], "properties": { "state": { "enum": ["COMPLETE", "PARTIAL"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "oldest_returned_created_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] } } },
          "source_absences": { "type": "object", "additionalProperties": false, "required": ["promotion_pick", "historical_semantic_diff"], "properties": { "promotion_pick": { "$ref": "#/components/schemas/Availability" }, "historical_semantic_diff": { "$ref": "#/components/schemas/Availability" } } },
          "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }
        }
      }
    }
  }
}
