{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Search API",
    "version": "1.0.0",
    "description": "P15 same-origin current-P04 Search reader. The installed source is a fixed-parameter qualification, so this contract publishes its exact immutable fixed profile and typed optimizer-ledger/diagnostic absences. It never starts a search, reads worker/artifact/Parquet paths, exposes a source relation/cursor/credential, or reselects a parameter. RF-05 (additive): `revision` names the immutable content and is fold-independent, while the ETag is the representation validator and binds `inspection.requested_fold` (Astra A06) — another fold's ETag never answers 304; If-None-Match is compared weakly and responses are `Cache-Control: private, no-cache`; `as_of_utc_ms` is the P14 source time (`as_of_basis`), never read time; `claim_row` carries the Screen-06 claim facts, each run-sourced or a typed absence."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/search": {
      "get": {
        "operationId": "researchSearchDetailGetV1",
        "summary": "Read immutable current-source Search, ledger and diagnostics truth for one run",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/Fold" },
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "Fixed current-P04 qualification truth or typed source absence", "headers": { "ETag": { "$ref": "#/components/headers/Etag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchDetail" } } } },
          "304": { "description": "The If-None-Match validator (weak comparison) names this exact representation, including the requested fold", "headers": { "ETag": { "$ref": "#/components/headers/Etag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "Etag": { "description": "Quoted strong representation validator (RF-05): a digest of the exact published body, so it differs per requested fold for one content revision. A proxy may weaken it to W/\"…\"; the server compares weakly.", "schema": { "type": "string", "pattern": "^\\\"p15r1_[0-9a-f]{64}\\\"$" } }, "CacheControl": { "description": "Per-session read; revalidate before reuse.", "schema": { "const": "private, no-cache" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "Fold": { "name": "fold", "in": "query", "required": false, "description": "Requested inspection fold. Current P04 has no optimizer fold; response returns typed NOT_APPLICABLE rather than treating one as a trial fold.", "schema": { "type": "integer", "minimum": 1, "maximum": 256 } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "description": "Entity-tag list or *; W/ prefixes are compared weakly.", "schema": { "type": "string", "maxLength": 512 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal; no worker attempt, lease, source relation/cursor, artifact/path, raw market data, credential or command authority is disclosed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" },
      "ExactDecimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "SourceGap": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_PUBLISHED", "NOT_APPLICABLE", "NOT_ASSERTED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Parameter": { "type": "object", "additionalProperties": false, "required": ["name", "kind", "minimum", "maximum", "step", "effective_value", "position_percent", "bound_state"], "properties": { "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }, "kind": { "const": "NUMERIC" }, "minimum": { "$ref": "#/components/schemas/ExactDecimal" }, "maximum": { "$ref": "#/components/schemas/ExactDecimal" }, "step": { "$ref": "#/components/schemas/ExactDecimal" }, "effective_value": { "$ref": "#/components/schemas/ExactDecimal" }, "position_percent": { "type": "number", "minimum": 0, "maximum": 100 }, "bound_state": { "const": "WITHIN_DECLARED_RANGE" } } },
      "FixedProfile": { "type": "object", "additionalProperties": false, "required": ["state", "adapter_contract_digest", "parameter_bundle_digest", "parameters", "strict_outer_oos", "availability"], "properties": { "state": { "const": "FIXED_PROFILE_NO_SEARCH" }, "adapter_contract_digest": { "$ref": "#/components/schemas/Digest" }, "parameter_bundle_digest": { "$ref": "#/components/schemas/Digest" }, "parameters": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/components/schemas/Parameter" } }, "strict_outer_oos": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "UnavailableFixedProfile": { "type": "object", "additionalProperties": false, "required": ["state", "adapter_contract_digest", "parameter_bundle_digest", "parameters", "strict_outer_oos", "availability"], "properties": { "state": { "const": "NOT_PUBLISHED" }, "adapter_contract_digest": { "type": "null" }, "parameter_bundle_digest": { "type": "null" }, "parameters": { "type": "array", "maxItems": 0, "items": { "$ref": "#/components/schemas/Parameter" } }, "strict_outer_oos": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "SourceProfile": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["FIXED_PROFILE_NO_SEARCH", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_PUBLISHED"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "CandidateSelectionMetric": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "value", "provenance", "reason_code", "availability"],
            "properties": {
              "state": { "const": "CONFIRMED" },
              "value": { "type": "string", "pattern": "^[A-Za-z0-9_:-]{1,120}$" },
              "provenance": { "const": "RUN_BOUND_ENGINE_DEFAULT" },
              "reason_code": { "type": "null" },
              "availability": { "$ref": "#/components/schemas/Availability" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "value", "provenance", "reason_code", "availability"],
            "properties": {
              "state": { "const": "NOT_PUBLISHED" },
              "value": { "type": "null" },
              "provenance": { "const": "NONE" },
              "reason_code": { "$ref": "#/components/schemas/ReasonCode" },
              "availability": { "$ref": "#/components/schemas/Availability" }
            }
          }
        ]
      },
      "RequestedOptimizer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "schedule", "state", "candidate_selection_metric", "availability"],
        "properties": {
          "mode": { "anyOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_:-]{1,120}$" }, { "type": "null" }] },
          "schedule": { "anyOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_:-]{1,120}$" }, { "type": "null" }] },
          "state": { "enum": ["DECLARED_NOT_EXECUTED", "NOT_PUBLISHED"] },
          "candidate_selection_metric": {
            "$ref": "#/components/schemas/CandidateSelectionMetric",
            "description": "Run-bound candidate-selection metric only. Current P04 declared requests publish NOT_PUBLISHED; engine-catalogue defaults and mode-name inferences are not historic run evidence."
          },
          "availability": { "$ref": "#/components/schemas/Availability" }
        }
      },
      "Selection": { "type": "object", "additionalProperties": false, "required": ["state", "selected_trial_ref", "parameter_bundle_digest", "selection_trace", "availability"], "properties": { "state": { "enum": ["FIXED_PARAMETER_PROFILE", "NOT_PUBLISHED"] }, "selected_trial_ref": { "type": "null" }, "parameter_bundle_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "selection_trace": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Inspection": { "type": "object", "additionalProperties": false, "required": ["requested_fold", "state", "availability"], "properties": { "requested_fold": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 256 }, { "type": "null" }] }, "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Ledger": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "total_rows", "sampled_rows", "page", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "total_rows": { "type": "null" }, "sampled_rows": { "type": "null" }, "page": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Diagnostics": { "type": "object", "additionalProperties": false, "required": ["state", "availability", "scatter", "distributions", "parameter_frequency", "progression", "prune_reasons", "importance", "interactions"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "availability": { "$ref": "#/components/schemas/Availability" }, "scatter": { "$ref": "#/components/schemas/SourceGap" }, "distributions": { "$ref": "#/components/schemas/SourceGap" }, "parameter_frequency": { "$ref": "#/components/schemas/SourceGap" }, "progression": { "$ref": "#/components/schemas/SourceGap" }, "prune_reasons": { "$ref": "#/components/schemas/SourceGap" }, "importance": { "$ref": "#/components/schemas/SourceGap" }, "interactions": { "$ref": "#/components/schemas/SourceGap" } } },
      "Provenance": { "type": "object", "additionalProperties": false, "required": ["source_adapter_id", "adapter_contract_digest", "engine_version", "input_scope", "source_transform_digest", "requested_spec_digest", "effective_spec_digest", "dataset_binding_digest", "manifest_digest"], "properties": { "source_adapter_id": { "anyOf": [{ "const": "p04.delta-rsi.v1" }, { "type": "null" }] }, "adapter_contract_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "engine_version": { "anyOf": [{ "const": "1.1.1" }, { "type": "null" }] }, "input_scope": { "anyOf": [{ "const": "P08_OPTIONAL_WARMUP_PLUS_IS_OOS_ONLY" }, { "type": "null" }] }, "source_transform_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "requested_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "effective_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "dataset_binding_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "manifest_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] } } },
      "ClaimTokenFact": { "description": "RF-05 CG-P15-05: a run-sourced claim token, or a typed absence. A declared-but-unexecuted optimizer has no mode claim.", "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state", "value", "provenance", "reason_code", "availability"], "properties": { "state": { "const": "CONFIRMED" }, "value": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$" }, "provenance": { "const": "RUN_SOURCE_RECEIPT" }, "reason_code": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "value", "provenance", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "value": { "type": "null" }, "provenance": { "const": "NONE" }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } }
      ] },
      "OosUsedForSelection": { "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state", "value", "provenance", "reason_code", "availability"], "properties": { "state": { "const": "CONFIRMED" }, "value": { "enum": ["USED", "NOT_USED"] }, "provenance": { "const": "RUN_SOURCE_RECEIPT" }, "reason_code": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "value", "provenance", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_ASSERTED", "NOT_APPLICABLE", "NOT_PUBLISHED"] }, "value": { "type": "null" }, "provenance": { "const": "NONE" }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } }
      ] },
      "OosColumn": { "type": "object", "additionalProperties": false, "required": ["state", "source_evaluation_state", "provenance", "reason_code", "availability"], "description": "Screen-06 OOS column chip. REPORT_ONLY: the outer-OOS window was observed after the parameters were fixed and fed no selection inside this run (P14 evaluation_state); strict outer-OOS selection stays NOT_ASSERTED in oos_used_for_selection.", "properties": { "state": { "enum": ["SELECTION_INPUT", "RETROSPECTIVE", "REPORT_ONLY", "WITHHELD", "NOT_APPLICABLE", "NOT_PUBLISHED"] }, "source_evaluation_state": { "anyOf": [{ "const": "P04_OBSERVED_AFTER_FIXED_PROFILE" }, { "type": "null" }] }, "provenance": { "enum": ["P14_SOURCE_RECEIPT", "NONE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "ScoringBackend": { "type": "object", "additionalProperties": false, "required": ["state", "declared_value", "provenance", "reason_code", "availability"], "description": "declared_value is what the request declared (requested_spec.optimization_config.scoring_backend); it is an executed fact only when state is CONFIRMED.", "properties": { "state": { "enum": ["CONFIRMED", "NOT_APPLICABLE", "NOT_PUBLISHED"] }, "declared_value": { "anyOf": [{ "enum": ["proxy", "endpoint"] }, { "type": "null" }] }, "provenance": { "enum": ["RUN_REQUESTED_SPEC", "RUN_SOURCE_RECEIPT", "NONE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "ClaimRow": { "type": "object", "additionalProperties": false, "required": ["basis", "validation_claim", "chronological_claim", "oos_used_for_selection", "oos_column", "scoring_backend", "mode_reference"], "description": "RF-05 CG-P15-05 Screen-06 claim row. What the declared mode would claim is Atlas release metadata (researchEngineAtlasGetV1), referenced by mode_reference and never copied in as run evidence.", "properties": { "basis": { "enum": ["DECLARED_NOT_EXECUTED", "NOT_DECLARED", "NOT_PUBLISHED"] }, "validation_claim": { "$ref": "#/components/schemas/ClaimTokenFact" }, "chronological_claim": { "$ref": "#/components/schemas/ClaimTokenFact" }, "oos_used_for_selection": { "$ref": "#/components/schemas/OosUsedForSelection" }, "oos_column": { "$ref": "#/components/schemas/OosColumn" }, "scoring_backend": { "$ref": "#/components/schemas/ScoringBackend" }, "mode_reference": { "anyOf": [{ "type": "object", "additionalProperties": false, "required": ["mode", "schedule", "operation_id", "relation"], "properties": { "mode": { "type": "string", "pattern": "^[A-Za-z0-9_:-]{1,120}$" }, "schedule": { "type": "string", "pattern": "^[A-Za-z0-9_:-]{1,120}$" }, "operation_id": { "const": "researchEngineAtlasGetV1" }, "relation": { "const": "DECLARED_MODE_RELEASE_METADATA_NOT_RUN_EVIDENCE" } } }, { "type": "null" }] } } },
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } },
      "SearchDetail": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "run_id", "revision", "etag", "availability", "readiness", "as_of_utc_ms", "as_of_basis", "provenance", "source_profile", "requested_optimizer", "claim_row", "fixed_profile", "selection", "inspection", "ledger", "diagnostics", "source_absences"], "properties": {
        "schema_version": { "const": "research.search-detail.v1" },
        "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" },
        "run_id": { "$ref": "#/components/schemas/RunId" },
        "revision": { "anyOf": [{ "type": "string", "pattern": "^p15r1_[0-9a-f]{64}$" }, { "type": "null" }] },
        "etag": { "anyOf": [{ "type": "string", "pattern": "^\\\"p15r1_[0-9a-f]{64}\\\"$" }, { "type": "null" }] },
        "availability": { "$ref": "#/components/schemas/Availability" },
        "readiness": { "enum": ["PARTIAL", "NOT_READY"] },
        "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds", "description": "RF-05 CG-P14-04: time of the P14 fact named by as_of_basis; never read time." },
        "as_of_basis": { "enum": ["P14_PROJECTION_RECEIVED_AT", "RUN_STATE_UPDATED_AT", "LEGACY_READ_MODEL_UPDATED_AT"] },
        "provenance": { "$ref": "#/components/schemas/Provenance" },
        "source_profile": { "$ref": "#/components/schemas/SourceProfile" },
        "requested_optimizer": { "$ref": "#/components/schemas/RequestedOptimizer" },
        "claim_row": { "$ref": "#/components/schemas/ClaimRow" },
        "fixed_profile": { "oneOf": [{ "$ref": "#/components/schemas/FixedProfile" }, { "$ref": "#/components/schemas/UnavailableFixedProfile" }] },
        "selection": { "$ref": "#/components/schemas/Selection" },
        "inspection": { "$ref": "#/components/schemas/Inspection" },
        "ledger": { "$ref": "#/components/schemas/Ledger" },
        "diagnostics": { "$ref": "#/components/schemas/Diagnostics" },
        "source_absences": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/SourceGap" } }
      } }
    }
  }
}
