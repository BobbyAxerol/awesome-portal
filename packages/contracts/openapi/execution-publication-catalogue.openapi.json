{
  "openapi": "3.1.0",
  "info": {
    "title": "Execution named operations and publication contract inventory",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/manager/operations": {
      "get": {
        "operationId": "executionManagerPublicationCatalogueGet",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Static checked-in contract metadata only. Existing same-origin route. Not source availability, permissions, streaming or runtime activation. No browser relation or upstream selectors.",
        "responses": {
          "200": {
            "description": "Legacy operation manifest with additive logical publication inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagerPublicationManifest"
                }
              }
            }
          },
          "401": {
            "description": "Session required"
          },
          "503": {
            "description": "Contract inventory rejected"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portal_session"
      }
    },
    "schemas": {
      "PublicationCatalogue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "portal.execution.publication-catalogue.v1"
          },
          "lane": {
            "const": "SOURCE_CONTRACT_NOT_RUNTIME_ACCEPTANCE"
          },
          "source_catalogue_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
          },
          "field_dictionary_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
          },
          "metric_dependencies_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
          },
          "families": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "family_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
                },
                "authority_owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "grain": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "availability": {
                  "const": "UNAVAILABLE"
                },
                "reason_code": {
                  "const": "NEW_EDGE_V1_EXPORT_NOT_QUALIFIED"
                },
                "history_capability": {
                  "const": "UNKNOWN"
                },
                "history_full": {
                  "const": false
                },
                "retention": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from_ms": {
                      "type": "null"
                    },
                    "to_ms": {
                      "type": "null"
                    },
                    "duration_ms": {
                      "type": "null"
                    },
                    "proof_ref": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "from_ms",
                    "to_ms",
                    "duration_ms",
                    "proof_ref"
                  ]
                },
                "runtime_enabled": {
                  "const": false
                }
              },
              "required": [
                "family_id",
                "authority_owner",
                "grain",
                "availability",
                "reason_code",
                "history_capability",
                "history_full",
                "retention",
                "runtime_enabled"
              ]
            }
          },
          "fields": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
                },
                "scalar_type": {
                  "enum": [
                    "DECIMAL",
                    "UTC_MS",
                    "ID",
                    "ENUM",
                    "BOOLEAN"
                  ]
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "availability": {
                  "const": "UNAVAILABLE"
                },
                "reason_code": {
                  "const": "SOURCE_FIELD_PUBLICATION_NOT_QUALIFIED"
                }
              },
              "required": [
                "field_id",
                "scalar_type",
                "unit",
                "availability",
                "reason_code"
              ]
            }
          },
          "current_page_adapter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "EXISTING_SEPARATE_AUTHORITY"
              },
              "history_capability": {
                "const": "CURRENT_ONLY"
              },
              "stable_snapshot": {
                "const": false
              },
              "authoritative_replay": {
                "const": false
              },
              "maximum_rows": {
                "const": 200
              },
              "maximum_response_bytes": {
                "const": 1048576
              },
              "total_history_cap": {
                "type": "null"
              }
            },
            "required": [
              "status",
              "history_capability",
              "stable_snapshot",
              "authoritative_replay",
              "maximum_rows",
              "maximum_response_bytes",
              "total_history_cap"
            ]
          }
        },
        "required": [
          "schema_version",
          "lane",
          "source_catalogue_digest",
          "field_dictionary_digest",
          "metric_dependencies_digest",
          "families",
          "fields",
          "current_page_adapter"
        ]
      },
      "PublicationFamily": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "family_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
          },
          "authority_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "grain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "availability": {
            "const": "UNAVAILABLE"
          },
          "reason_code": {
            "const": "NEW_EDGE_V1_EXPORT_NOT_QUALIFIED"
          },
          "history_capability": {
            "const": "UNKNOWN"
          },
          "history_full": {
            "const": false
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from_ms": {
                "type": "null"
              },
              "to_ms": {
                "type": "null"
              },
              "duration_ms": {
                "type": "null"
              },
              "proof_ref": {
                "type": "null"
              }
            },
            "required": [
              "from_ms",
              "to_ms",
              "duration_ms",
              "proof_ref"
            ]
          },
          "runtime_enabled": {
            "const": false
          }
        },
        "required": [
          "family_id",
          "authority_owner",
          "grain",
          "availability",
          "reason_code",
          "history_capability",
          "history_full",
          "retention",
          "runtime_enabled"
        ]
      },
      "PublicationField": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
          },
          "scalar_type": {
            "enum": [
              "DECIMAL",
              "UTC_MS",
              "ID",
              "ENUM",
              "BOOLEAN"
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "const": "UNAVAILABLE"
          },
          "reason_code": {
            "const": "SOURCE_FIELD_PUBLICATION_NOT_QUALIFIED"
          }
        },
        "required": [
          "field_id",
          "scalar_type",
          "unit",
          "availability",
          "reason_code"
        ]
      },
      "ManagerPublicationManifest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "portal.execution.eds11r.named-operation-manifest.v1"
          },
          "source_catalogue_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
          },
          "source_contract_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "screen_bound_relation_count": {
            "const": 54
          },
          "non_browser_classification_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projectionInput": {
                "const": 16
              },
              "auditOnly": {
                "const": 13
              },
              "internalOnly": {
                "const": 13
              }
            },
            "required": [
              "projectionInput",
              "auditOnly",
              "internalOnly"
            ]
          },
          "operations": {
            "type": "array",
            "minItems": 54,
            "maxItems": 54,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "route_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "field_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "identity_disposition": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "kind": {
                        "enum": [
                          "BOOLEAN",
                          "INTEGER",
                          "DECIMAL",
                          "TEXT",
                          "TIMESTAMP"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "kind"
                    ]
                  }
                },
                "screen_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  }
                }
              },
              "required": [
                "operation_id",
                "route_id",
                "field_id",
                "identity_disposition",
                "fields",
                "screen_ids"
              ]
            }
          },
          "publication_catalogue": {
            "$ref": "#/components/schemas/PublicationCatalogue"
          }
        },
        "required": [
          "schema_version",
          "source_catalogue_sha256",
          "source_contract_revision",
          "screen_bound_relation_count",
          "non_browser_classification_counts",
          "operations",
          "publication_catalogue"
        ]
      }
    }
  }
}
