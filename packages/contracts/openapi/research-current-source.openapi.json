{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Retained Current-Source API",
    "version": "1.1.0",
    "description": "RS-02 named same-origin reads over Portal-retained, P05-sealed QuantBT 1.1.1 Advanced WFO data. These routes never run QuantBT, reopen source bytes, expose an artifact/table/lease input or raw fold/candidate payload, or replace P04 fixed-run contracts. Parameter maps are capped at 24 declared fields. Runtime Zod contracts are strict; this document is the generated-client source."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/current-source/evidence": {
      "get": {
        "operationId": "researchCurrentSourceEvidenceGetV1",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": { "200": { "$ref": "#/components/responses/Evidence" }, "304": { "description": "Exact immutable revision unchanged" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quantbt/runs/{runId}/current-source/evidence/series": {
      "get": {
        "operationId": "researchCurrentSourceEvidenceSeriesGetV1",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/SeriesKind" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": { "200": { "$ref": "#/components/responses/EvidenceSeries" }, "304": { "description": "Exact immutable revision unchanged" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quantbt/runs/{runId}/current-source/split": {
      "get": {
        "operationId": "researchCurrentSourceSplitGetV1",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": { "200": { "$ref": "#/components/responses/Split" }, "304": { "description": "Exact immutable revision unchanged" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quantbt/runs/{runId}/current-source/search": {
      "get": {
        "operationId": "researchCurrentSourceSearchGetV1",
        "description": "Cursor-bearing response is private/no-store. Use cursor/before for a relation page or at for a minted playhead; never reuse a stale cache body.",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Before" }, { "$ref": "#/components/parameters/At" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "$ref": "#/components/responses/Search" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quantbt/runs/{runId}/current-source/freeze": {
      "get": {
        "operationId": "researchCurrentSourceFreezeGetV1",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": { "200": { "$ref": "#/components/responses/Freeze" }, "304": { "description": "Exact immutable revision unchanged" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quantbt/runs/{runId}/current-source/replay": {
      "get": {
        "operationId": "researchCurrentSourceReplayGetV1",
        "description": "Cursor-bearing response is private/no-store. Rows are retained research-model samples, never broker execution state.",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Before" }, { "$ref": "#/components/parameters/At" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "$ref": "#/components/responses/Replay" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "SeriesKind": { "name": "kind", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/SeriesKind" } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "$ref": "#/components/schemas/OpaqueCursor" } },
      "Before": { "name": "before", "in": "query", "schema": { "$ref": "#/components/schemas/OpaqueCursor" } },
      "At": { "name": "at", "in": "query", "description": "Opaque playhead minted by this exact run/revision/relation.", "schema": { "$ref": "#/components/schemas/OpaqueCursor" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "schema": { "type": "string", "maxLength": 160 } }
    },
    "headers": { "Etag": { "schema": { "type": "string", "pattern": "^\\\"rs02_[a-z0-9_-]{2,32}_[0-9a-f]{64}\\\"$" } } },
    "responses": {
      "Problem": { "description": "Typed refusal with no source path, table selector, artifact locator, lease, raw market slice or credential.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Evidence": { "description": "Current-source evidence passport", "headers": { "ETag": { "$ref": "#/components/headers/Etag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Evidence" } } } },
      "EvidenceSeries": { "description": "Bounded local retained-source evidence series", "headers": { "ETag": { "$ref": "#/components/headers/Etag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceSeries" } } } },
      "Split": { "description": "Observed Advanced WFO fold plan", "headers": { "ETag": { "$ref": "#/components/headers/Etag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Split" } } } },
      "Search": { "description": "Bounded retained trial/candidate ledger", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Search" } } } },
      "Freeze": { "description": "Local retained manifest/batch-receipt verification; no GET reopens source artifact bytes", "headers": { "ETag": { "$ref": "#/components/headers/Etag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Freeze" } } } },
      "Replay": { "description": "Bounded retained research-model replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Replay" } } } }
    },
    "schemas": {
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "Decimal": { "type": "string", "maxLength": 96, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
      "UtcMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "OpaqueCursor": { "type": "string", "maxLength": 4096, "pattern": "^kc1\\.[A-Za-z0-9_-]{1,32}\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
      "SeriesKind": { "type": "string", "enum": ["EQUITY", "RETURNS", "POSITIONS", "MONTHLY_RETURNS", "ROLLING_RETURNS_20", "RETURN_DISTRIBUTION"] },
      "Availability": { "type": "object", "required": ["state", "reason_code"], "properties": { "state": { "type": "string", "enum": ["AVAILABLE", "PENDING_RETENTION", "NOT_RETAINED_LEGACY", "NOT_PUBLISHED", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] } } },
      "Fact": { "type": "object", "required": ["state", "reason_code", "availability"], "properties": { "state": { "type": "string", "enum": ["AVAILABLE", "NOT_PUBLISHED", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Provenance": { "type": "object", "required": ["source_adapter_id", "profile_id", "engine_version", "source_manifest_digest", "source_transform_digest", "retained_import_digest", "requested_spec_digest", "effective_spec_digest", "dataset_binding_digest", "retained_at_utc_ms"], "properties": { "source_adapter_id": { "const": "rs02.quantbt-advanced-wfo.v1" }, "profile_id": { "const": "rs02.delta-wfo-global.v1" }, "engine_version": { "const": "1.1.1" }, "source_manifest_digest": { "$ref": "#/components/schemas/Digest" }, "source_transform_digest": { "$ref": "#/components/schemas/Digest" }, "retained_import_digest": { "$ref": "#/components/schemas/Digest" }, "requested_spec_digest": { "$ref": "#/components/schemas/Digest" }, "effective_spec_digest": { "$ref": "#/components/schemas/Digest" }, "dataset_binding_digest": { "$ref": "#/components/schemas/Digest" }, "retained_at_utc_ms": { "$ref": "#/components/schemas/UtcMs" } } },
      "Common": { "type": "object", "required": ["read_authority", "run_id", "revision", "etag", "availability", "as_of_utc_ms", "provenance"], "properties": { "read_authority": { "const": "PORTAL_RETAINED_CURRENT_SOURCE" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "revision": { "type": "string", "pattern": "^rs02_[a-z0-9_-]{2,32}_[0-9a-f]{64}$" }, "etag": { "type": "string", "pattern": "^\\\"rs02_[a-z0-9_-]{2,32}_[0-9a-f]{64}\\\"$" }, "availability": { "$ref": "#/components/schemas/Availability" }, "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMs" }, "provenance": { "$ref": "#/components/schemas/Provenance" } } },
      "Page": { "type": "object", "required": ["limit", "next_cursor", "prev_cursor", "has_more", "has_previous", "order"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 200 }, "next_cursor": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueCursor" }, { "type": "null" }] }, "prev_cursor": { "anyOf": [{ "$ref": "#/components/schemas/OpaqueCursor" }, { "type": "null" }] }, "has_more": { "type": "boolean" }, "has_previous": { "type": "boolean" }, "order": { "const": "SOURCE_TABLE_ORDINAL_ASC" } } },
      "ObservationSample": { "type": "object", "required": ["at_utc_ms", "equity", "return_fraction", "accepted_position", "drawdown_fraction", "signal_target"], "properties": { "at_utc_ms": { "$ref": "#/components/schemas/UtcMs" }, "equity": { "$ref": "#/components/schemas/Decimal" }, "return_fraction": { "$ref": "#/components/schemas/Decimal" }, "accepted_position": { "$ref": "#/components/schemas/Decimal" }, "drawdown_fraction": { "$ref": "#/components/schemas/Decimal" }, "signal_target": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] } } },
      "MonthlySample": { "type": "object", "required": ["month_start_utc_ms", "return_fraction"], "properties": { "month_start_utc_ms": { "$ref": "#/components/schemas/UtcMs" }, "return_fraction": { "$ref": "#/components/schemas/Decimal" } } },
      "RollingSample": { "type": "object", "required": ["at_utc_ms", "return_fraction"], "properties": { "at_utc_ms": { "$ref": "#/components/schemas/UtcMs" }, "return_fraction": { "$ref": "#/components/schemas/Decimal" } } },
      "DistributionBucket": { "type": "object", "required": ["lower_inclusive", "upper", "upper_inclusive", "count"], "properties": { "lower_inclusive": { "$ref": "#/components/schemas/Decimal" }, "upper": { "$ref": "#/components/schemas/Decimal" }, "upper_inclusive": { "type": "string", "enum": ["true", "false"] }, "count": { "type": "string", "pattern": "^[0-9]+$" } } },
      "SourceSample": { "type": "object", "required": ["source_observation_count", "emitted_point_count", "sampling"], "properties": { "source_observation_count": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "emitted_point_count": { "type": "integer", "minimum": 0, "maximum": 192 }, "sampling": { "type": "string", "enum": ["FULL", "RETENTION_STRIDE_V1", "TAIL_WINDOW_V1", "EXTREMA_BUCKET_V1", "FULL_RETURN_HISTOGRAM_V2", "NOT_APPLICABLE"] } } },
      "Fold": { "type": "object", "required": ["source_ordinal", "fold_id", "train_start_utc_ms", "train_end_utc_ms", "test_start_utc_ms", "test_end_utc_ms"], "properties": { "source_ordinal": { "type": "integer", "minimum": 0 }, "fold_id": { "type": "string" }, "train_start_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMs" }, { "type": "null" }] }, "train_end_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMs" }, { "type": "null" }] }, "test_start_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMs" }, { "type": "null" }] }, "test_end_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMs" }, { "type": "null" }] } } },
      "Trial": { "type": "object", "required": ["source_ordinal", "trial_id", "state", "objective", "parameters", "playback_cursor"], "properties": { "source_ordinal": { "type": "integer", "minimum": 0 }, "trial_id": { "type": "string" }, "state": { "type": "string" }, "objective": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] }, "parameters": { "type": "object", "maxProperties": 24, "additionalProperties": { "$ref": "#/components/schemas/Decimal" } }, "playback_cursor": { "$ref": "#/components/schemas/OpaqueCursor" } } },
      "Candidate": { "type": "object", "required": ["source_ordinal", "candidate_id", "objective", "parameters"], "properties": { "source_ordinal": { "type": "integer", "minimum": 0 }, "candidate_id": { "type": "string" }, "objective": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] }, "parameters": { "type": "object", "maxProperties": 24, "additionalProperties": { "$ref": "#/components/schemas/Decimal" } } } },
      "Selection": { "type": "object", "required": ["state", "selected_trial_id", "objective", "parameters", "availability"], "properties": { "state": { "const": "AVAILABLE" }, "selected_trial_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "objective": { "anyOf": [{ "$ref": "#/components/schemas/Decimal" }, { "type": "null" }] }, "parameters": { "type": "object", "maxProperties": 24, "additionalProperties": { "$ref": "#/components/schemas/Decimal" } }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Evidence": { "allOf": [{ "$ref": "#/components/schemas/Common" }, { "type": "object", "required": ["schema_version", "passport", "series", "source_absences"], "properties": { "schema_version": { "const": "research.current-source-evidence.v1" }, "passport": { "type": "object", "required": ["artifact_table_rows", "initial_equity", "final_equity", "net_return_fraction", "max_drawdown_fraction", "retained_position_count"], "properties": { "artifact_table_rows": { "type": "object", "properties": { "observations": { "type": "integer" }, "folds": { "type": "integer" }, "trials": { "type": "integer" }, "candidates": { "type": "integer" }, "selection": { "const": 1 } }, "required": ["observations", "folds", "trials", "candidates", "selection"] }, "initial_equity": { "$ref": "#/components/schemas/Decimal" }, "final_equity": { "$ref": "#/components/schemas/Decimal" }, "net_return_fraction": { "$ref": "#/components/schemas/Decimal" }, "max_drawdown_fraction": { "$ref": "#/components/schemas/Decimal" }, "retained_position_count": { "type": "integer" } } }, "series": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "object", "required": ["kind", "availability", "href"], "properties": { "kind": { "$ref": "#/components/schemas/SeriesKind" }, "availability": { "$ref": "#/components/schemas/Availability" }, "href": { "type": "string" } } } }, "source_absences": { "type": "object", "required": ["route_ledger", "audited_fills", "benchmark"], "properties": { "route_ledger": { "$ref": "#/components/schemas/Fact" }, "audited_fills": { "$ref": "#/components/schemas/Fact" }, "benchmark": { "$ref": "#/components/schemas/Fact" } } } } }] },
      "EvidenceSeries": { "allOf": [{ "$ref": "#/components/schemas/Common" }, { "type": "object", "required": ["schema_version", "kind", "availability", "source_sample", "values"], "properties": { "schema_version": { "const": "research.current-source-evidence-series.v1" }, "kind": { "$ref": "#/components/schemas/SeriesKind" }, "availability": { "$ref": "#/components/schemas/Availability" }, "source_sample": { "$ref": "#/components/schemas/SourceSample" }, "values": { "type": "array", "maxItems": 192, "items": { "oneOf": [{ "$ref": "#/components/schemas/ObservationSample" }, { "$ref": "#/components/schemas/MonthlySample" }, { "$ref": "#/components/schemas/RollingSample" }, { "$ref": "#/components/schemas/DistributionBucket" }] } } } }] },
      "Split": { "allOf": [{ "$ref": "#/components/schemas/Common" }, { "type": "object", "required": ["schema_version", "fold_plan", "data_use"], "properties": { "schema_version": { "const": "research.current-source-split.v1" }, "fold_plan": { "type": "object", "required": ["state", "folds", "chronology", "availability"], "properties": { "state": { "const": "AVAILABLE" }, "folds": { "type": "array", "minItems": 2, "maxItems": 256, "items": { "$ref": "#/components/schemas/Fold" } }, "chronology": { "const": "SOURCE_OBSERVED_ADVANCED_WFO" }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "data_use": { "type": "object", "required": ["warmup", "purge", "embargo", "strict_outer_oos_selection"], "properties": { "warmup": { "$ref": "#/components/schemas/Fact" }, "purge": { "$ref": "#/components/schemas/Fact" }, "embargo": { "$ref": "#/components/schemas/Fact" }, "strict_outer_oos_selection": { "$ref": "#/components/schemas/Fact" } } } } }] },
      "Search": { "allOf": [{ "$ref": "#/components/schemas/Common" }, { "type": "object", "required": ["schema_version", "selection", "ledger", "candidates", "diagnostics"], "properties": { "schema_version": { "const": "research.current-source-search.v1" }, "selection": { "$ref": "#/components/schemas/Selection" }, "ledger": { "type": "object", "required": ["source_trial_count", "returned_rows", "trials", "page", "availability"], "properties": { "source_trial_count": { "type": "integer", "minimum": 2, "maximum": 64 }, "returned_rows": { "type": "integer", "minimum": 0, "maximum": 200 }, "trials": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Trial" } }, "page": { "$ref": "#/components/schemas/Page" }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "candidates": { "type": "object", "required": ["source_candidate_count", "rows", "availability"], "properties": { "source_candidate_count": { "type": "integer", "minimum": 1, "maximum": 64 }, "rows": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/components/schemas/Candidate" } }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "diagnostics": { "type": "object", "required": ["candidates", "objective_components", "prune_reasons", "importance"], "properties": { "candidates": { "$ref": "#/components/schemas/Fact" }, "objective_components": { "$ref": "#/components/schemas/Fact" }, "prune_reasons": { "$ref": "#/components/schemas/Fact" }, "importance": { "$ref": "#/components/schemas/Fact" } } } } }] },
