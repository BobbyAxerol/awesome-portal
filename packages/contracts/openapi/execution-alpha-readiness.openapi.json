{
  "openapi": "3.1.0",
  "info": {
    "title": "alpha-readiness",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/readiness": {
      "get": {
        "operationId": "executionAlphaReadinessGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Per alpha: gate readiness {met, total} and the archive disposition, for the Fleet KPIs (Ready for exit, Archive in progress), the 7-segment stage and the Archived lens. CONTRACT ONLY: no producer exists yet (Edge/Core inputs are in WP_K_CONTRACTS_2026-10-23.md), so nothing serves this route and every screen keeps its typed absence.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "paper",
                "sandbox",
                "live"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current answer; absence stays typed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlphaReadiness"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlphaReadinessProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlphaReadinessProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlphaReadinessProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlphaReadinessProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "AlphaReadiness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms",
          "environment"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.alpha-readiness.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "environment": {
            "type": "string",
            "enum": [
              "paper",
              "sandbox",
              "live"
            ]
          },
          "items": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "alpha_id"
                  ],
                  "properties": {
                    "alpha_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "readiness": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "met",
                            "total"
                          ],
                          "properties": {
                            "met": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "total": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "archive_state": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ACTIVE",
                            "PAPER_WATCH",
                            "ARCHIVE_IN_PROGRESS",
                            "ARCHIVED"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AlphaReadinessProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
