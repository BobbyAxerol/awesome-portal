{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal incident action eligibility",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/operations/incidents/{incident_id}/eligibility": {
      "get": {
        "operationId": "executionIncidentActionEligibilityGetV1",
        "description": "Current advisory preconditions for the EXISTING Portal ADMIN incident workflow, not a scoped grant, command permit or trading-safety assessment. Same ADMIN/workspace and pre/post reader-mode checks as the legacy incident workflow. SCOPED_V2 refuses INCIDENT_SCOPED_PARENT_NOT_COMMISSIONED before lookup; no ADMIN override into that scoped family. Evidence presence is an EXISTS by kind over the full incident, not a truncated detail page. Eligible does not attest the submitted hash: POST checks exact evidence hash, current session/admin/workspace, Origin/CSRF, request key and expected_workflow_version again. No source effect or deployment resume.",
        "security": [
          {
            "portalSession": []
          }
        ],
        "x-strict-query-keys": [
          "workspace_id"
        ],
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,191}$"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,191}$",
              "maxLength": 96
            },
            "description": "Defaults to the authenticated workspace; explicit workspace must be a current membership."
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow preconditions at the returned version; never a permit.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentActionEligibility"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INCIDENT_ELIGIBILITY: invalid scalar identifier or query; no unknown keys.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEligibilityProblem"
                }
              }
            }
          },
          "401": {
            "description": "Current authenticated Portal session required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEligibilityProblem"
                }
              }
            }
          },
          "403": {
            "description": "ADMIN_ROLE_REQUIRED or current read-scope refusal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEligibilityProblem"
                }
              }
            }
          },
          "404": {
            "description": "WORKSPACE_NOT_FOUND or INCIDENT_NOT_FOUND; wrong-workspace and unknown IDs disclose no incident.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEligibilityProblem"
                }
              }
            }
          },
          "409": {
            "description": "EXECUTION_READ_ACCESS_CHANGED: policy changed during the read; do not fall back.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEligibilityProblem"
                }
              }
            }
          },
          "503": {
            "description": "INCIDENT_SCOPED_PARENT_NOT_COMMISSIONED: scoped writer authority is not commissioned; no legacy fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEligibilityProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "portalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "IncidentActionEligibility": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "incident_id",
          "environment",
          "workflow_version",
          "observed_at_ms",
          "current_only",
          "advisory_only",
          "authority_basis",
          "family_check",
          "source_side_effect_requested",
          "deployment_resume_requested",
          "actions"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.incident-action-eligibility.v1"
          },
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,191}$",
            "maxLength": 96
          },
          "incident_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,191}$"
          },
          "environment": {
            "enum": [
              "PAPER",
              "SANDBOX",
              "LIVE"
            ]
          },
          "workflow_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "observed_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "current_only": {
            "const": true
          },
          "advisory_only": {
            "const": true
          },
          "authority_basis": {
            "const": "EXISTING_PORTAL_ADMIN_INCIDENT_WORKFLOW"
          },
          "family_check": {
            "const": "PORTAL_INCIDENT_WORKFLOW_RECHECK_REQUIRED"
          },
          "source_side_effect_requested": {
            "const": false
          },
          "deployment_resume_requested": {
            "const": false
          },
          "actions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "eligible",
                  "blocker_codes",
                  "required_inputs"
                ],
                "properties": {
                  "action": {
                    "const": "incident.acknowledge"
                  },
                  "eligible": {
                    "type": "boolean"
                  },
                  "blocker_codes": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "enum": [
                        "INCIDENT_ALREADY_RESOLVED",
                        "INCIDENT_NOT_ACKNOWLEDGEABLE"
                      ]
                    }
                  },
                  "required_inputs": {
                    "const": []
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "eligible": {
                          "const": true
                        }
                      },
                      "required": [
                        "eligible"
                      ]
                    },
                    "then": {
                      "properties": {
                        "blocker_codes": {
                          "maxItems": 0
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "blocker_codes": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "eligible",
                  "blocker_codes",
                  "required_inputs"
                ],
                "properties": {
                  "action": {
                    "const": "incident.mitigate"
                  },
                  "eligible": {
                    "type": "boolean"
                  },
                  "blocker_codes": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "enum": [
                        "INCIDENT_ALREADY_RESOLVED",
                        "INCIDENT_NOT_MITIGATABLE",
                        "INCIDENT_ACKNOWLEDGEMENT_REQUIRED",
                        "INCIDENT_ASSIGNEE_REQUIRED",
                        "MITIGATION_EVIDENCE_REQUIRED"
                      ]
                    }
                  },
                  "required_inputs": {
                    "const": [
                      "mitigation_evidence_hash"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "eligible": {
                          "const": true
                        }
                      },
                      "required": [
                        "eligible"
                      ]
                    },
                    "then": {
                      "properties": {
                        "blocker_codes": {
                          "maxItems": 0
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "blocker_codes": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "eligible",
                  "blocker_codes",
                  "required_inputs"
                ],
                "properties": {
                  "action": {
                    "const": "incident.resolve"
                  },
                  "eligible": {
                    "type": "boolean"
                  },
                  "blocker_codes": {
                    "type": "array",
                    "uniqueItems": true,
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "enum": [
                        "INCIDENT_ALREADY_RESOLVED",
                        "INCIDENT_NOT_MITIGATED",
                        "CLEAN_DRY_RUN_EVIDENCE_REQUIRED"
                      ]
                    }
                  },
                  "required_inputs": {
                    "const": [
                      "clean_dry_run_evidence_hash",
                      "reason"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "eligible": {
                          "const": true
                        }
                      },
                      "required": [
                        "eligible"
                      ]
                    },
                    "then": {
                      "properties": {
                        "blocker_codes": {
                          "maxItems": 0
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "blocker_codes": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "items": false
          }
        },
        "description": "Current advisory preconditions for the EXISTING Portal ADMIN incident workflow, not a scoped grant, command permit or trading-safety assessment. Same ADMIN/workspace and pre/post reader-mode checks as the legacy incident workflow. SCOPED_V2 refuses INCIDENT_SCOPED_PARENT_NOT_COMMISSIONED before lookup; no ADMIN override into that scoped family. Evidence presence is an EXISTS by kind over the full incident, not a truncated detail page. Eligible does not attest the submitted hash: POST checks exact evidence hash, current session/admin/workspace, Origin/CSRF, request key and expected_workflow_version again. No source effect or deployment resume."
      },
      "IncidentEligibilityProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
