{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Release Candidate Publication API",
    "version": "1.1.0",
    "description": "P22 actor-scoped publication to the unchanged strict R1 create service. No approval decision or Execution command."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "portalSession": []
    }
  ],
  "paths": {
    "/api/v1/research/release-candidates/{releaseCandidateId}/publication": {
      "get": {
        "operationId": "researchReleaseCandidatePublicationGetV1",
        "summary": "Read durable publication state and existing R1 mirror",
        "parameters": [
          {
            "$ref": "#/components/parameters/ReleaseCandidateId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Private no-store P22 publication state and authorized existing-R1 mirror.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/research/release-candidates/{releaseCandidateId}/publish": {
      "post": {
        "operationId": "researchReleaseCandidatePublishV1",
        "summary": "Create or reconcile one existing R1 request",
        "parameters": [
          {
            "$ref": "#/components/parameters/ReleaseCandidateId"
          },
          {
            "$ref": "#/components/parameters/WorkspaceId"
          },
          {
            "$ref": "#/components/parameters/Csrf"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private no-store P22 publication state and authorized existing-R1 mirror.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "portalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portal_session"
      }
    },
    "parameters": {
      "ReleaseCandidateId": {
        "name": "releaseCandidateId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/ReleaseCandidateId"
        }
      },
      "WorkspaceId": {
        "name": "workspace_id",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/WorkspaceId"
        }
      },
      "Csrf": {
        "name": "x-portal-csrf",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Typed same-origin refusal.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "WorkspaceId": {
        "type": "string",
        "minLength": 3,
        "maxLength": 96
      },
      "ReleaseCandidateId": {
        "type": "string",
        "pattern": "^rc_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "RunId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "Digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "LegacySha": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "Reason": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,159}$"
      },
      "UtcMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "PublishRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "expected_pack_digest",
          "methodology_claim_id"
        ],
        "properties": {
          "schema_version": {
            "const": "research.release-candidate-publish-request.v1"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/WorkspaceId"
          },
          "expected_pack_digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "request_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$",
            "description": "Optional. When absent the server uses rcpub:<release candidate id>."
          },
          "methodology_claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "summary": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000,
            "description": "Optional. When absent the server writes the R1 summary from the sealed pack's own identity (release candidate, pack digest, evidence run)."
          }
        }
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "availability",
          "reason_code",
          "run_status",
          "legacy_artifact_sha256",
          "artifact_schema_version",
          "eligible_methodology_claim_ids",
          "captured_at"
        ],
        "properties": {
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "PARTIAL",
              "UNAVAILABLE",
              "NOT_CHECKED"
            ]
          },
          "reason_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reason"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_status": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "legacy_artifact_sha256": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LegacySha"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact_schema_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 191
              },
              {
                "type": "null"
              }
            ]
          },
          "eligible_methodology_claim_ids": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191
            }
          },
          "captured_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Published": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "by_user_id",
          "by_username",
          "approval_id",
          "at_utc_ms",
          "receipt_digest"
        ],
        "properties": {
          "by_user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "by_username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "approval_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "at_utc_ms": {
            "$ref": "#/components/schemas/UtcMs"
          },
          "receipt_digest": {
            "$ref": "#/components/schemas/Digest"
          }
        }
      },
      "Condition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limitation_id",
          "kind",
          "label",
          "statement",
          "expires_at"
        ],
        "properties": {
          "limitation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "kind": {
            "type": "string",
            "enum": [
              "lineage",
              "warning",
              "restriction",
              "waiver"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ApprovalMirror": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id",
          "gate",
          "status",
          "subject_id",
          "requester_user_id",
          "evidence_set_hash",
          "sla_due_at",
          "expires_at",
          "created_at",
          "read_at",
          "conditions",
          "href"
        ],
        "properties": {
          "approval_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "gate": {
            "const": "R1"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "APPROVED_WITH_CONDITION",
              "DENIED",
              "CHANGES_REQUESTED",
              "EXPIRED"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "requester_user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "evidence_set_hash": {
            "$ref": "#/components/schemas/LegacySha"
          },
          "sla_due_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "read_at": {
            "type": "string",
            "format": "date-time"
          },
          "conditions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/Condition"
            }
          },
          "href": {
            "type": "string",
            "pattern": "^/governance/approvals/[A-Za-z0-9._-]+/r1$"
          }
        }
      },
      "PublicationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "release_candidate_id",
          "run_id",
          "alpha_id",
          "alpha_version_id",
          "pack_digest",
          "source",
          "state",
          "candidate_relation",
          "may_publish",
          "blocked_reason",
          "published",
          "approval_read",
          "approval",
          "as_of_utc_ms",
          "replayed"
        ],
        "properties": {
          "schema_version": {
            "const": "research.release-candidate-publication.v1"
          },
          "release_candidate_id": {
            "$ref": "#/components/schemas/ReleaseCandidateId"
          },
          "run_id": {
            "$ref": "#/components/schemas/RunId"
          },
          "alpha_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "alpha_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "pack_digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "state": {
            "type": "string",
            "enum": [
              "NOT_PUBLISHED",
              "PENDING",
              "UNKNOWN",
              "DELIVERED",
              "REFUSED"
            ]
          },
          "candidate_relation": {
            "type": "string",
            "enum": [
              "CURRENT",
              "SUPERSEDED",
              "UNKNOWN"
            ]
          },
          "may_publish": {
            "type": "boolean"
          },
          "blocked_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reason"
              },
              {
                "type": "null"
              }
            ]
          },
          "published": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Published"
              },
              {
                "type": "null"
              }
            ]
          },
          "approval_read": {
            "type": "string",
            "enum": [
              "NOT_PUBLISHED",
              "AVAILABLE",
              "DENIED",
              "NOT_FOUND",
              "UNAVAILABLE"
            ]
          },
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApprovalMirror"
              },
              {
                "type": "null"
              }
            ]
          },
          "as_of_utc_ms": {
            "$ref": "#/components/schemas/UtcMs"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
