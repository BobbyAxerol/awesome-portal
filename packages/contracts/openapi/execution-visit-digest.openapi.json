{
  "openapi": "3.1.0",
  "info": {
    "title": "visit-digest",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/digest": {
      "get": {
        "operationId": "executionVisitDigestGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "What changed since this user last looked, in this workspace. The baseline is kept on the server per user and workspace (never in the browser): `baseline` is null before the first visit. `current_cut` is the cut the items were read at. POST /api/v1/execution/digest/baseline {cut_revision} moves the baseline to that cut (mark seen); it is defined in this contract and served by the fixture lane only. CONTRACT ONLY: no producer exists yet (Edge/Core inputs are in WP_K_CONTRACTS_2026-10-23.md), so nothing serves this route and every screen keeps its typed absence.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current answer; absence stays typed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigest"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/execution/digest/baseline": {
      "post": {
        "operationId": "executionVisitDigestMarkV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Mark seen: moves the caller's baseline for this workspace to the named cut. Idempotent for the same cut. FIXTURE ONLY today. CONTRACT ONLY.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisitDigestMark"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The answer after the baseline moved",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigest"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDigestProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "VisitDigest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms",
          "user_id",
          "baseline",
          "current_cut",
          "items",
          "counts_by_kind"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.visit-digest.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          },
          "baseline": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "set_at_ms",
                  "set_by",
                  "cut_revision"
                ],
                "properties": {
                  "set_at_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "set_by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  "cut_revision": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "current_cut": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "as_of_ms",
              "revision"
            ],
            "properties": {
              "as_of_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "revision": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
              }
            }
          },
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "kind",
                "at_ms",
                "title",
                "subject",
                "since_baseline"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 191,
                  "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "APPROVAL_DECIDED",
                    "INCIDENT_OPENED",
                    "OPERATION_FAILED",
                    "STAGE_CHANGED",
                    "RECALL",
                    "CAPITAL_COMMAND",
                    "ACCESS_CHANGED"
                  ]
                },
                "at_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                },
                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "id"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "ALPHA",
                        "PORTFOLIO",
                        "ACCOUNT",
                        "DEPLOYMENT",
                        "OPERATION",
                        "INCIDENT",
                        "APPROVAL"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    }
                  }
                },
                "since_baseline": {
                  "type": "boolean"
                }
              }
            }
          },
          "counts_by_kind": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "count"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "APPROVAL_DECIDED",
                    "INCIDENT_OPENED",
                    "OPERATION_FAILED",
                    "STAGE_CHANGED",
                    "RECALL",
                    "CAPITAL_COMMAND",
                    "ACCESS_CHANGED"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      },
      "VisitDigestProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "VisitDigestMark": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_id",
          "cut_revision"
        ],
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "cut_revision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
          }
        }
      }
    }
  }
}
