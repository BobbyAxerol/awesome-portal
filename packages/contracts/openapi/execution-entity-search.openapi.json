{
  "openapi": "3.1.0",
  "info": {
    "title": "Entity search",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/search": {
      "get": {
        "operationId": "executionEntitySearchGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Cross-entity search for the command bar: per kind (alpha, portfolio, account, operation, incident, approval) at most `limit` rows `{kind, id, label, detail, route_hint}`, already scoped to the caller. An entity the caller may not see is absent, never denied or counted. `total_matched` is an integer, or null when the source did not count it. CONTRACT ONLY: no producer exists yet (inputs are in WP_K_CONTRACTS_2026-10-23.md), so nothing serves this route and the bar keeps fanning out to the list reads.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "kinds",
            "in": "query",
            "required": false,
            "description": "Comma-separated subset of the six kinds; default all.",
            "schema": {
              "type": "string",
              "pattern": "^(?:alpha|portfolio|account|operation|incident|approval)(?:,(?:alpha|portfolio|account|operation|incident|approval))*$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 8
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current matches; absence is absence",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitySearch"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitySearchProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitySearchProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitySearchProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "EntitySearch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms",
          "query",
          "groups"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.entity-search.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "query": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "q",
              "kinds",
              "limit"
            ],
            "properties": {
              "q": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "kinds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "alpha",
                    "portfolio",
                    "account",
                    "operation",
                    "incident",
                    "approval"
                  ]
                }
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              }
            }
          },
          "groups": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "total_matched",
                "rows"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "alpha",
                    "portfolio",
                    "account",
                    "operation",
                    "incident",
                    "approval"
                  ]
                },
                "total_matched": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rows": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "label",
                      "detail",
                      "route_hint"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "alpha",
                          "portfolio",
                          "account",
                          "operation",
                          "incident",
                          "approval"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 191,
                        "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                      },
                      "detail": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "route_hint": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/[^\\u0000-\\u001f\\u007f\\s]*$(?![\\s\\S])"
                      }
                    }
                  }
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "NOT_COMMISSIONED"
                  ]
                }
              },
              "if": {
                "properties": {
                  "state": {
                    "const": "NOT_COMMISSIONED"
                  }
                },
                "required": [
                  "state"
                ],
                "type": "object"
              },
              "then": {
                "properties": {
                  "total_matched": {
                    "type": "null"
                  },
                  "rows": {
                    "type": "array",
                    "maxItems": 0
                  }
                },
                "type": "object"
              }
            }
          }
        }
      },
      "EntitySearchProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
