{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal N22 source-backed Paper screen API",
    "version": "1.0.0",
    "description": "Session and workspace scoped product BFFs over the Paper Manager-v2 profile. Browser callers never select source relations or receive Manager envelopes."
  },
  "paths": {
    "/api/v1/execution/screens/paper": {
      "get": {
        "operationId": "executionPaperOverviewV1",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": { "200": { "description": "Current Paper overview or honest typed state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaperReadResponse" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/execution/screens/paper/{deployment_id}": {
      "get": {
        "operationId": "executionPaperWorkbenchV1",
        "parameters": [{ "$ref": "#/components/parameters/DeploymentId" }, { "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": { "200": { "description": "Current deployment-scoped Paper workbench", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaperReadResponse" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/execution/screens/paper/{deployment_id}/vn-market": {
      "get": {
        "operationId": "executionPaperWorkbenchVnmV1",
        "parameters": [{ "$ref": "#/components/parameters/DeploymentId" }, { "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": { "200": { "description": "Current deployment-scoped VNM Paper workbench", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaperReadResponse" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/execution/screens/blotter": {
      "get": {
        "operationId": "executionFullBlotterV1",
        "description": "Paper-only read. Scope filters run over authorized retained tuples before pagination/counts; alpha-to-strategy mapping requires qualified lineage. Missing attribution is typed PARTIAL, not exact empty. Other stages are refused, not silently routed. Scoped views omit legacy global mirror proof/totals and retain SOURCE_PARTIAL; per-order fills/costs are not synthesized from a bounded fill page.",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
          { "name": "after", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 4096 } },
          { "name": "before", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 4096 } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["INITIALIZED", "SUBMITTED", "ACCEPTED", "REJECTED", "DENIED", "PENDING_UPDATE", "PENDING_CANCEL", "PARTIALLY_FILLED", "FILLED", "CANCELED", "EXPIRED", "TRIGGERED"] } },
          { "name": "status_bucket", "in": "query", "required": false, "schema": { "type": "string", "enum": ["FILLED", "PARTIAL", "REJECTED", "OPEN"] } },
          { "name": "stage", "in": "query", "required": false, "description": "Only PAPER is served by this route; other stages return N22_BLOTTER_STAGE_NOT_AVAILABLE.", "schema": { "type": "string", "enum": ["PAPER", "SANDBOX", "CANARY", "LIVE"] } },
          { "name": "deployment_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/Identifier" } },
          { "name": "account_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/Identifier" } },
          { "name": "alpha_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/Identifier" } },
          { "name": "venue", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 64 } },
          { "name": "symbol", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 128 } },
          { "name": "side", "in": "query", "required": false, "schema": { "type": "string", "enum": ["BUY", "SELL"] } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["submitted_at_desc", "submitted_at_asc", "updated_at_desc"], "default": "submitted_at_desc" } }
        ],
        "responses": { "200": { "description": "Current Paper blotter page with bidirectional keyset, exact totals and bounded aggregates", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaperReadResponse" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    }
  },
  "components": {
    "parameters": {
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/Identifier" } },
      "DeploymentId": { "name": "deployment_id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identifier" } }
    },
    "responses": {
      "Problem": { "description": "Safe Portal problem", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "VenueCalendar": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "market",
          "basis",
          "timezone",
          "windows",
          "breaks",
          "holidays",
          "is_open",
          "as_of"
        ],
        "properties": {
          "schema_version": {
            "const": "execution.venue-calendar.v1"
          },
          "market": {
            "const": "VN_EQUITY"
          },
          "basis": {
            "const": "SOURCE_SESSION_CALENDAR_NOT_A_CLIENT_INFERENCE"
          },
          "timezone": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "AVAILABLE"
                  },
                  "value": {
                    "$ref": "#/components/schemas/VenueTimezone"
                  },
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "NOT_PUBLISHED"
                  },
                  "value": {
                    "type": "null"
                  },
                  "reason_code": {
                    "$ref": "#/components/schemas/StageReasonCode"
                  }
                }
              }
            ]
          },
          "windows": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "AVAILABLE"
                  },
                  "value": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "$ref": "#/components/schemas/VenueWindow"
                    }
                  },
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "NOT_PUBLISHED"
                  },
                  "value": {
                    "type": "null"
                  },
                  "reason_code": {
                    "$ref": "#/components/schemas/StageReasonCode"
                  }
                }
              }
            ]
          },
          "breaks": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "AVAILABLE"
                  },
                  "value": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "$ref": "#/components/schemas/VenueBreak"
                    }
                  },
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "NOT_PUBLISHED"
                  },
                  "value": {
                    "type": "null"
                  },
                  "reason_code": {
                    "$ref": "#/components/schemas/StageReasonCode"
                  }
                }
              }
            ]
          },
          "holidays": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "AVAILABLE"
                  },
                  "value": {
                    "type": "array",
                    "maxItems": 400,
                    "items": {
                      "$ref": "#/components/schemas/VenueHoliday"
                    }
                  },
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "NOT_PUBLISHED"
                  },
                  "value": {
                    "type": "null"
                  },
                  "reason_code": {
                    "$ref": "#/components/schemas/StageReasonCode"
                  }
                }
              }
            ]
          },
          "is_open": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "AVAILABLE"
                  },
                  "value": {
                    "type": "boolean"
                  },
                  "reason_code": {
                    "type": "null"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "availability",
                  "value",
                  "reason_code"
                ],
                "properties": {
                  "availability": {
                    "const": "NOT_PUBLISHED"
                  },
                  "value": {
                    "type": "null"
                  },
                  "reason_code": {
                    "$ref": "#/components/schemas/StageReasonCode"
                  }
                }
              }
            ]
          },
          "as_of": {
            "$ref": "#/components/schemas/StageFactTimestamp"
          }
        },
        "description": "FE-070. Present only on the VN market workbench variant. Every member is a Fact: the Portal holds no trading-calendar source of truth, so each is NOT_PUBLISHED (N28_VENUE_CALENDAR_NOT_ACTIVE) until the market-data-layer session calendar is wired. is_open is the SOURCE's own statement at as_of; a client never infers PAUSED or AGING from window arithmetic."
      },
      "VenueHoliday": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "name"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
          },
          "name": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "VenueBreak": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "from",
          "to",
          "basis"
        ],
        "properties": {
          "name": {
            "const": "BREAK"
          },
          "from": {
            "$ref": "#/components/schemas/VenueClock"
          },
          "to": {
            "$ref": "#/components/schemas/VenueClock"
          },
          "basis": {
            "const": "GAP_BETWEEN_PUBLISHED_WINDOWS"
          }
        },
        "description": "The interval between two consecutive published windows (the lunch break). Arithmetic on published windows only."
      },
      "VenueWindow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "open",
          "close"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "TRADING_SESSION",
              "OPENING_AUCTION",
              "CLOSING_AUCTION"
            ]
          },
          "open": {
            "$ref": "#/components/schemas/VenueClock"
          },
          "close": {
            "$ref": "#/components/schemas/VenueClock"
          }
        },
        "description": "A named window in the venue's local time. OPENING_AUCTION / CLOSING_AUCTION (ATO / ATC) only when the source names them; a generic session is TRADING_SESSION. Window kinds describe the market calendar, not which order types the Portal can route."
      },
      "VenueClock": {
        "type": "string",
        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "VenueTimezone": {
        "type": "string",
        "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+-]+){1,2}$",
        "description": "IANA time-zone name, e.g. Asia/Ho_Chi_Minh."
      },
      "StageFacts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "runtime",
          "reconciliation",
          "sessions"
        ],
        "properties": {
          "schema_version": {
            "const": "execution.stage-facts.v1"
          },
          "runtime": {
            "$ref": "#/components/schemas/StageRuntimeFacts"
          },
          "reconciliation": {
            "$ref": "#/components/schemas/StageReconciliationFacts"
          },
          "sessions": {
            "$ref": "#/components/schemas/StageSessionsFact"
          }
        },
        "description": "FE-067. Additive on the Paper workbench (`data.stage_facts`) and on the Sandbox, Canary and Live Full bodies (top level `stage_facts`). The pre-existing pinned-null `runtime_state` members are unchanged."
      },
      "StageSessionsFact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "availability",
          "reason_code",
          "basis",
          "rows",
          "returned_count",
          "omitted_count",
          "source_complete"
        ],
        "properties": {
          "availability": {
            "enum": [
              "AVAILABLE",
              "NOT_PUBLISHED"
            ]
          },
          "reason_code": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/StageReasonCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "const": "EXECUTION_SESSIONS_BOUNDED_WINDOW"
          },
          "rows": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/StageSessionRow"
            }
          },
          "returned_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "omitted_count": {
            "type": "integer",
            "minimum": 0
          },
          "source_complete": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "description": "Newest first. `ended` null while the session has no completion time. A row the reader cannot type is counted in omitted_count, never listed. `state` is the source's own word or null.",
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "NOT_PUBLISHED"
                }
              },
              "required": [
                "availability"
              ]
            },
            "then": {
              "properties": {
                "reason_code": {
                  "$ref": "#/components/schemas/StageReasonCode"
                },
                "rows": {
                  "type": "array",
                  "maxItems": 0
                },
                "returned_count": {
                  "const": 0
                },
                "omitted_count": {
                  "const": 0
                },
                "source_complete": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "reason_code": {
                  "type": "null"
                },
                "source_complete": {
                  "type": "boolean"
                }
              }
            }
          }
        ]
      },
      "StageSessionRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "started",
          "ended",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,190}$"
          },
          "started": {
            "$ref": "#/components/schemas/StageTimestamp"
          },
          "ended": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/StageTimestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "StageReconciliationFacts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "basis",
          "verdict",
          "open_finding_count",
          "unknown_order_count",
          "as_of"
        ],
        "properties": {
          "basis": {
            "const": "FINDINGS_RELATION_NOT_A_RECONCILIATION_RUN"
          },
          "verdict": {
            "$ref": "#/components/schemas/StageFactVerdict"
          },
          "open_finding_count": {
            "$ref": "#/components/schemas/StageFactInteger"
          },
          "unknown_order_count": {
            "$ref": "#/components/schemas/StageFactInteger",
            "description": "Open findings the reviewed finding-type table classes as UNKNOWN_ORDER. Exact 0 only when no finding is open; NOT_PUBLISHED (FINDING_TYPE_VOCABULARY_NOT_CLASSIFIED) while any open finding is unclassified."
          },
          "as_of": {
            "$ref": "#/components/schemas/StageFactTimestamp"
          }
        }
      },
      "StageFactInteger": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              },
              "value": {
                "type": "integer",
                "minimum": 0
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "NOT_PUBLISHED"
              },
              "value": {
                "type": "null"
              },
              "reason_code": {
                "$ref": "#/components/schemas/StageReasonCode"
              }
            }
          }
        ]
      },
      "StageFactVerdict": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              },
              "value": {
                "enum": [
                  "NO_OPEN_FINDINGS",
                  "OPEN_FINDINGS"
                ]
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "NOT_PUBLISHED"
              },
              "value": {
                "type": "null"
              },
              "reason_code": {
                "$ref": "#/components/schemas/StageReasonCode"
              }
            }
          }
        ],
        "description": "NO_OPEN_FINDINGS is a statement about the findings relation, not a reconciliation run: it is never published from a partial window or when any finding status is unreadable."
      },
      "StageRuntimeFacts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_state",
          "since"
        ],
        "properties": {
          "runtime_state": {
            "$ref": "#/components/schemas/StageFactRuntimeState"
          },
          "since": {
            "$ref": "#/components/schemas/StageFactTimestamp"
          }
        }
      },
      "StageFactTimestamp": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              },
              "value": {
                "$ref": "#/components/schemas/StageTimestamp"
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "NOT_PUBLISHED"
              },
              "value": {
                "type": "null"
              },
              "reason_code": {
                "$ref": "#/components/schemas/StageReasonCode"
              }
            }
          }
        ]
      },
      "StageTimestamp": {
        "type": "string",
        "format": "date-time"
      },
      "StageFactRuntimeState": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "AVAILABLE"
              },
              "value": {
                "enum": [
                  "RUNNING",
                  "PAUSED",
                  "HALTED",
                  "STOPPED"
                ]
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "availability",
              "value",
              "reason_code"
            ],
            "properties": {
              "availability": {
                "const": "NOT_PUBLISHED"
              },
              "value": {
                "type": "null"
              },
              "reason_code": {
                "$ref": "#/components/schemas/StageReasonCode"
              }
            }
          }
        ],
        "description": "Closed vocabulary. Published only when the SOURCE deployment row carries the word; never derived from `active`, a session, readiness or freshness. A source word outside the vocabulary is refused (reason RUNTIME_STATE_WORD_NOT_IN_CLOSED_VOCABULARY), not echoed."
      },
      "StageReasonCode": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
        "description": "Reviewed machine code saying why a fact is not published. Never free text, never a source message."
      },
      "Identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,190}$" },
      "Actor": { "type": "object", "additionalProperties": false, "required": ["user_id", "username", "roles"], "properties": { "user_id": { "$ref": "#/components/schemas/Identifier" }, "username": { "type": "string" }, "roles": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "enum": ["ADMIN", "USER"] } } } },
      "Capability": {
        "type": "object", "additionalProperties": false,
        "required": ["capability_id", "state", "relations", "reason_code", "retryable"],
        "properties": {
          "capability_id": { "$ref": "#/components/schemas/Identifier" },
          "state": { "type": "string", "enum": ["AVAILABLE", "EMPTY", "PARTIAL", "UNAVAILABLE"] },
          "relations": { "type": "array", "items": { "type": "string" } },
          "reason_code": { "type": ["string", "null"] },
          "retryable": { "type": "boolean", "const": false },
          "quarantined_rows": { "type": "integer", "minimum": 1 },
          "status_map_version": { "type": "string" },
          "authority": { "type": ["string", "null"], "enum": ["DERIVED", "TRADING_SYSTEM", null] },
          "formula_version": { "type": ["string", "null"], "pattern": "^[a-z0-9.-]{3,96}$" },
          "lineage_rejects": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
        }
      },
      "NarrowRecord": { "type": "object", "maxProperties": 40, "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }, { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] } }] } },
      "PaperData": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "deployment": { "oneOf": [{ "$ref": "#/components/schemas/NarrowRecord" }, { "type": "null" }] },
          "deployments": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "positions": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "sessions": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "performance": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "account_equity": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "portfolio_equity": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "orders": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "fills": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "conditional_groups": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "conditional_legs": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "reconciliation": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "command_journal": { "type": "array", "items": { "$ref": "#/components/schemas/NarrowRecord" } },
          "observation_gate": { "oneOf": [{ "$ref": "#/components/schemas/NarrowRecord" }, { "type": "null" }] },
          "query_analytics": { "type": ["object", "null"], "additionalProperties": true },
          "page": { "type": "object", "additionalProperties": false, "required": ["limit", "next_cursor", "previous_cursor"], "properties": { "limit": { "type": "integer" }, "next_cursor": { "type": ["string", "null"] }, "previous_cursor": { "type": ["string", "null"] } } },
          "query": { "type": "object", "additionalProperties": false, "required": ["filters", "sort", "filter_allowlist", "sort_allowlist", "count_scope"], "properties": {
            "filters": { "type": "object", "additionalProperties": false, "required": ["status", "status_bucket", "venue", "symbol", "side", "stage", "deployment_id", "account_id", "alpha_id"], "properties": {
              "status": { "type": ["string", "null"], "enum": ["INITIALIZED", "SUBMITTED", "ACCEPTED", "REJECTED", "DENIED", "PENDING_UPDATE", "PENDING_CANCEL", "PARTIALLY_FILLED", "FILLED", "CANCELED", "EXPIRED", "TRIGGERED", null] },
              "status_bucket": { "type": ["string", "null"], "enum": ["FILLED", "PARTIAL", "REJECTED", "OPEN", null] },
              "venue": { "type": ["string", "null"] }, "symbol": { "type": ["string", "null"] }, "side": { "type": ["string", "null"], "enum": ["BUY", "SELL", null] },
              "stage": { "type": ["string", "null"], "enum": ["PAPER", null] },
              "deployment_id": { "oneOf": [{ "$ref": "#/components/schemas/Identifier" }, { "type": "null" }] },
              "account_id": { "oneOf": [{ "$ref": "#/components/schemas/Identifier" }, { "type": "null" }] },
              "alpha_id": { "oneOf": [{ "$ref": "#/components/schemas/Identifier" }, { "type": "null" }] }
            } },
            "sort": { "type": "string", "enum": ["submitted_at_desc", "submitted_at_asc", "updated_at_desc"] },
            "filter_allowlist": { "type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [{ "const": "status" }, { "const": "venue" }, { "const": "symbol" }, { "const": "side" }, { "const": "stage" }, { "const": "deployment_id" }, { "const": "account_id" }, { "const": "alpha_id" }], "items": false },
            "sort_allowlist": { "type": "array", "prefixItems": [{ "const": "submitted_at_desc" }, { "const": "submitted_at_asc" }, { "const": "updated_at_desc" }], "items": false },
            "count_scope": { "type": "string", "const": "COMMITTED_HOT_PROJECTION" }
          } },
          "exact_total": { "type": ["integer", "null"], "minimum": 0 },
          "filtered_total": { "type": ["integer", "null"], "minimum": 0 },
          "aggregates": { "type": ["object", "null"], "additionalProperties": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } },
          "exact_query": { "$ref": "#/components/schemas/BlotterExactQuery" },
          "derived_insights": { "oneOf": [{ "$ref": "#/components/schemas/DerivedInsights" }, { "type": "null" }] },
          "stage_facts": { "$ref": "#/components/schemas/StageFacts" },
          "venue_calendar": { "$ref": "#/components/schemas/VenueCalendar" }
        }
      },
      "BlotterMirrorRevision": {
        "type": "object", "additionalProperties": false,
        "required": ["projection_epoch", "projection_sequence", "payload_digest", "last_successful_refresh_at"],
        "properties": {
          "projection_epoch": { "type": "string", "minLength": 1, "maxLength": 200 },
          "projection_sequence": { "type": "integer", "minimum": 0 },
          "payload_digest": { "type": "string", "minLength": 1, "maxLength": 200 },
          "last_successful_refresh_at": { "type": "string", "format": "date-time" }
        }
      },
      "BlotterExactQueryCoverage": {
        "type": "object", "additionalProperties": false,
        "required": ["relation_completeness", "scope_state", "returned_page_rows", "current_population_rows", "filtered_population_rows"],
        "properties": {
          "relation_completeness": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
          "scope_state": { "type": "string", "enum": ["EXACT", "PARTIAL"] },
          "returned_page_rows": { "type": "integer", "minimum": 0, "maximum": 200 },
          "current_population_rows": { "type": ["integer", "null"], "minimum": 0 },
          "filtered_population_rows": { "type": ["integer", "null"], "minimum": 0 }
        }
      },
      "BlotterExactQuery": {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "relation", "history_semantics", "state", "authority", "formula_version", "reason_code", "coverage"],
        "properties": {
          "schema_version": { "type": "string", "const": "execution.blotter-exact-query.v1" },
          "relation": { "type": "string", "const": "orders" },
          "history_semantics": { "type": "string", "const": "CURRENT_PROJECTION_POPULATION_NOT_FULL_HISTORY" },
          "state": { "type": "string", "enum": ["AVAILABLE", "PARTIAL", "UNAVAILABLE"] },
          "authority": { "type": ["string", "null"], "enum": ["DERIVED", "TRADING_SYSTEM", null] },
          "formula_version": { "type": ["string", "null"], "pattern": "^[a-z0-9.-]{3,96}$" },
          "reason_code": { "type": ["string", "null"], "pattern": "^[A-Z0-9_]{3,128}$" },
          "mirror_revision": { "$ref": "#/components/schemas/BlotterMirrorRevision" },
          "coverage": { "oneOf": [{ "$ref": "#/components/schemas/BlotterExactQueryCoverage" }, { "type": "null" }] }
        },
        "allOf": [
          { "if": { "properties": { "authority": { "const": "DERIVED" } }, "required": ["authority"] }, "then": { "required": ["mirror_revision"], "properties": { "formula_version": { "const": "portal.current-projection.orders-exact-query.v1" }, "mirror_revision": { "$ref": "#/components/schemas/BlotterMirrorRevision" }, "coverage": { "$ref": "#/components/schemas/BlotterExactQueryCoverage" } } } },
          { "if": { "properties": { "authority": { "const": "TRADING_SYSTEM" } }, "required": ["authority"] }, "then": { "properties": { "formula_version": { "type": "null" }, "coverage": { "$ref": "#/components/schemas/BlotterExactQueryCoverage" } } } },
          { "if": { "properties": { "state": { "const": "AVAILABLE" } }, "required": ["state"] }, "then": { "properties": { "authority": { "type": "string", "enum": ["DERIVED", "TRADING_SYSTEM"] }, "reason_code": { "type": "null" }, "coverage": { "$ref": "#/components/schemas/BlotterExactQueryCoverage" } } } }
        ]
      },
      "DerivedInsights": {
        "type": "object", "additionalProperties": false,
        "required": ["formula_version", "as_of", "order_funnel_7d", "cumulative_return"],
        "properties": {
          "formula_version": { "type": "string" },
          "as_of": { "type": "string", "format": "date-time" },
          "order_funnel_7d": { "type": "object", "additionalProperties": false, "required": ["total_orders", "status_counts"], "properties": { "total_orders": { "type": "integer", "minimum": 0 }, "status_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } } },
          "cumulative_return": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["deployment_id", "currency", "points"], "properties": { "deployment_id": { "type": "string" }, "currency": { "type": ["string", "null"] }, "points": { "type": "array", "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["t", "return_pct"], "properties": { "t": { "type": "string", "format": "date-time" }, "return_pct": { "type": "number" } } } } } } }
        }
      },
      "PaperReadResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "record_authority", "source_authority", "delivery_profile", "workspace_id", "read_at", "as_of", "state", "freshness", "completeness", "actor", "capabilities", "data"],
        "properties": {
          "schema_version": { "type": "string", "enum": ["execution.paper-overview.v1", "execution.paper-workbench.v1", "execution.paper-workbench-vnm.v1", "execution.full-blotter.v1"] },
          "record_authority": { "type": "string", "const": "PORTAL_CONTROL" }, "source_authority": { "type": "string", "const": "TRADING_SYSTEM" }, "delivery_profile": { "type": "string", "const": "PAPER_BINANCE_USDM" },
          "workspace_id": { "$ref": "#/components/schemas/Identifier" }, "read_at": { "type": "string", "format": "date-time" }, "as_of": { "type": ["string", "null"], "format": "date-time" },
          "state": { "type": "string", "enum": ["ready", "empty", "stale", "partial", "unavailable"] }, "freshness": { "type": "string", "enum": ["FRESH", "AGING", "STALE", "UNKNOWN"] }, "completeness": { "type": "string", "enum": ["COMPLETE", "PARTIAL"] },
          "actor": { "$ref": "#/components/schemas/Actor" }, "resource": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "type": "string", "const": "DEPLOYMENT" }, "id": { "$ref": "#/components/schemas/Identifier" } } },
          "capabilities": { "type": "array", "items": { "$ref": "#/components/schemas/Capability" } }, "data": { "$ref": "#/components/schemas/PaperData" }
        }
      },
      "Problem": { "type": "object", "required": ["error", "request_id"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }, "request_id": { "type": "string" } } }
    }
  }
}
