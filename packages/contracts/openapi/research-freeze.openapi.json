{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Freeze API",
    "version": "1.1.0",
    "description": "P16 same-origin current-source Freeze and retained integrity reader. It reads one immutable Portal P10/P14 receipt and compares exactly three retained digest bindings. A PARTIAL_MATCH never attests source artifact bytes, causal wall-clock ordering, a selection artifact, an optimizer candidate pool, or a what-if evaluation. It never starts a worker, diagnostic evaluation, source adapter, or mutation. X2 (additive, 1.1.0): the detail adds `stage4_binding` (CG-P16-02: the registered fixed bundle and adapter digests vs what the P04 child executed, from its P14 receipt and producer row) and `parameter_authority` (CG-P16-03: declared values in the params digest, code-fixed values under the code digest bound by the adapter contract digest)."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/freeze": {
      "get": {
        "operationId": "researchFreezeDetailGetV1",
        "summary": "Read immutable current-source Freeze truth and retained-binding integrity for one run",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/Fold" },
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "Current retained Freeze truth or typed source absence", "headers": { "ETag": { "$ref": "#/components/headers/Etag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FreezeDetail" } } } },
          "304": { "description": "The exact immutable P16 retained-binding revision has not changed" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/quantbt/runs/{runId}/freeze/verify": {
      "post": {
        "operationId": "researchFreezeVerifyPostV1",
        "summary": "Explicitly re-read retained Freeze bindings and, when enabled, re-hash the sealed P05 artifact bytes into one immutable receipt; never submits work",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/Fold" },
          { "$ref": "#/components/parameters/PortalCsrf" }
        ],
        "responses": {
          "200": { "description": "Typed retained-binding verification result; PARTIAL_MATCH is not a source-artifact PASS", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FreezeVerification" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "Etag": { "description": "Quoted immutable P16 retained-binding revision.", "schema": { "type": "string", "pattern": "^\\\"p16r1_[0-9a-f]{64}\\\"$" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "Fold": { "name": "fold", "in": "query", "required": false, "description": "Bounded inspection request only. Current P04 has no fold selection artifact.", "schema": { "type": "integer", "minimum": 1, "maximum": 256 } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 96 } },
      "PortalCsrf": { "name": "x-portal-csrf", "in": "header", "required": true, "description": "Same-origin CSRF proof for the explicit re-read action.", "schema": { "type": "string", "minLength": 1, "maxLength": 512 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal; no source relation, source cursor, credential, artifact path, raw market input, worker custody value, command or diagnostic authority is disclosed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "ImportedAlphaReadBinding": {"type":"object","additionalProperties":false,"required":["schema_version","source_digest","entrypoint","parameter_bundle_digest","parameters"],"properties":{"schema_version":{"const":"research.imported-alpha-read-binding.v1"},"source_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"entrypoint":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]{0,159}$"},"parameter_bundle_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"parameters":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["name","kind","value"],"properties":{"name":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]{0,63}$"},"kind":{"enum":["fixed","int_range","float_range","categorical"]},"value":{"anyOf":[{"type":"string","maxLength":4096},{"type":"number"},{"type":"boolean"}]}}}}}},
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" },
      "ExactDecimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "SourceGap": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_PUBLISHED", "NOT_APPLICABLE", "NOT_ASSERTED", "NOT_ATTESTED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "BoundWarning": { "type": "object", "additionalProperties": false, "description": "DR-02 research.bound-warning.v1: one relative definition shared by Search S06 and Freeze S07. Reference space is the declared range; AT_BOUND at <=6% or >=94%, NEAR_BOUND at <=18% or >=82% (inclusive, exact decimal); NOT_APPLICABLE with a typed reason for zero-width, categorical or out-of-declaration values. A display diagnostic, never a gate and never a claim that the value is not an optimum.", "required": ["definition_id", "copy_version", "reference_space", "state", "side", "reason_code"], "properties": { "definition_id": { "const": "research.bound-warning.v1" }, "copy_version": { "const": "research.bound-warning-copy.v1" }, "reference_space": { "const": "DECLARED_RANGE" }, "state": { "enum": ["AT_BOUND", "NEAR_BOUND", "INTERIOR", "NOT_APPLICABLE"] }, "side": { "anyOf": [{ "enum": ["LOWER", "UPPER"] }, { "type": "null" }] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "Parameter": { "type": "object", "additionalProperties": false, "required": ["name", "kind", "minimum", "maximum", "step", "frozen_value", "position_percent", "bound_state", "bound_warning"], "properties": { "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }, "kind": { "const": "NUMERIC" }, "minimum": { "$ref": "#/components/schemas/ExactDecimal" }, "maximum": { "$ref": "#/components/schemas/ExactDecimal" }, "step": { "$ref": "#/components/schemas/ExactDecimal" }, "frozen_value": { "$ref": "#/components/schemas/ExactDecimal" }, "position_percent": { "type": "number", "minimum": 0, "maximum": 100 }, "bound_state": { "const": "WITHIN_DECLARED_RANGE" }, "bound_warning": { "$ref": "#/components/schemas/BoundWarning" } } },
      "Window": { "type": "object", "additionalProperties": false, "required": ["start_utc_ms", "end_exclusive_utc_ms", "bars", "data_role", "child_input_state", "evaluation_state", "availability"], "properties": { "start_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "end_exclusive_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "bars": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2000000 }, { "type": "null" }] }, "data_role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, "child_input_state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, "evaluation_state": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "DataTime": { "type": "object", "additionalProperties": false, "required": ["state", "chronology_kind", "is", "outer_oos", "holdout", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "chronology_kind": { "anyOf": [{ "const": "THREE_WINDOW_CURRENT" }, { "type": "null" }] }, "is": { "anyOf": [{ "$ref": "#/components/schemas/Window" }, { "type": "null" }] }, "outer_oos": { "anyOf": [{ "$ref": "#/components/schemas/Window" }, { "type": "null" }] }, "holdout": { "anyOf": [{ "$ref": "#/components/schemas/Window" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "IntegrityCheck": { "type": "object", "additionalProperties": false, "required": ["key", "state", "expected_digest", "observed_digest", "availability"], "properties": { "key": { "enum": ["P04_ADAPTER_CONTRACT", "P10_MANIFEST_BINDING", "P04_FIXED_PARAMETER_BUNDLE", "IMPORTED_SOURCE_CODE", "EXECUTION_ADAPTER_CONTRACT", "DECLARED_PARAMETER_BUNDLE"] }, "state": { "enum": ["MATCH", "MISMATCH", "NOT_PUBLISHED"] }, "expected_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "observed_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Integrity": { "type": "object", "additionalProperties": false, "required": ["state", "verification_scope", "checks", "source_artifact_bytes", "availability"], "properties": { "state": { "enum": ["PARTIAL", "BLOCKED", "NOT_PUBLISHED"] }, "verification_scope": { "enum": ["PORTAL_RETAINED_DIGEST_BINDING_ONLY", "NONE"] }, "checks": { "type": "array", "maxItems": 4, "items": { "$ref": "#/components/schemas/IntegrityCheck" } }, "source_artifact_bytes": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "EnginePin": { "type": "object", "additionalProperties": false, "required": ["state", "engine_version", "execution_adapter_id", "adapter_contract_digest", "availability"], "description": "E16-R2 exact engine and adapter identity retained with the immutable P04 source binding.", "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "engine_version": { "anyOf": [{ "enum": ["1.1.0", "1.1.1"] }, { "type": "null" }] }, "execution_adapter_id": { "anyOf": [{ "enum": ["p04.delta-rsi.v1", "p17.imported-signal-notional.v1"] }, { "type": "null" }] }, "adapter_contract_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "FreezeDetail": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "run_id", "revision", "etag", "availability", "readiness", "as_of_utc_ms", "provenance", "engine_pin", "freeze", "source_absences", "artifact_bytes"], "properties": {
        "schema_version": { "const": "research.freeze-detail.v1" },
        "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" },
        "run_id": { "$ref": "#/components/schemas/RunId" },
        "revision": { "anyOf": [{ "type": "string", "pattern": "^p16r1_[0-9a-f]{64}$" }, { "type": "null" }] },
        "etag": { "anyOf": [{ "type": "string", "pattern": "^\\\"p16r1_[0-9a-f]{64}\\\"$" }, { "type": "null" }] },
        "availability": { "$ref": "#/components/schemas/Availability" },
        "readiness": { "enum": ["PARTIAL", "NOT_READY"] },
        "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["source_adapter_id", "adapter_contract_digest", "p14_split_revision", "source_split_digest", "requested_spec_digest", "effective_spec_digest", "dataset_binding_digest", "manifest_digest"], "properties": { "source_adapter_id": { "anyOf": [{ "enum": ["p04.delta-rsi.v1", "p17.imported-signal-notional.v1"] }, { "type": "null" }] }, "adapter_contract_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "p14_split_revision": { "anyOf": [{ "type": "string", "pattern": "^p14r1_[0-9a-f]{64}$" }, { "type": "null" }] }, "source_split_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "requested_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "effective_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "dataset_binding_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "manifest_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] } } },
        "engine_pin": { "$ref": "#/components/schemas/EnginePin" },
        "imported_alpha": { "$ref": "#/components/schemas/ImportedAlphaReadBinding" },
        "freeze": { "type": "object", "additionalProperties": false, "required": ["source_profile", "inspection", "selection", "ordering", "frozen_parameters", "integrity", "what_if"], "properties": {
          "source_profile": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["FIXED_PROFILE_NO_SELECTION_ARTIFACT", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_PUBLISHED"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "inspection": { "type": "object", "additionalProperties": false, "required": ["requested_fold", "state", "availability"], "properties": { "requested_fold": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 256 }, { "type": "null" }] }, "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "selection": { "type": "object", "additionalProperties": false, "required": ["state", "selection_artifact_ref", "selected_trial_ref", "selection_sequence", "parameter_bundle_digest", "strict_outer_oos", "availability"], "properties": { "state": { "enum": ["FIXED_PARAMETER_PROFILE", "NOT_PUBLISHED"] }, "selection_artifact_ref": { "type": "null" }, "selected_trial_ref": { "type": "null" }, "selection_sequence": { "type": "null" }, "parameter_bundle_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "strict_outer_oos": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "ordering": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "wall_clock", "data_time", "availability"], "properties": { "state": { "enum": ["NOT_ASSERTED", "NOT_PUBLISHED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "wall_clock": { "$ref": "#/components/schemas/SourceGap" }, "data_time": { "$ref": "#/components/schemas/DataTime" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "frozen_parameters": { "type": "array", "maxItems": 32, "items": { "$ref": "#/components/schemas/Parameter" } },
          "integrity": { "$ref": "#/components/schemas/Integrity" },
          "what_if": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "grid", "actions", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "grid": { "type": "object", "additionalProperties": false, "required": ["state", "effective_cell_count", "objective_definition", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "effective_cell_count": { "type": "null" }, "objective_definition": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "actions": { "type": "object", "additionalProperties": false, "required": ["diagnostic_evaluate", "sibling_draft"], "properties": { "diagnostic_evaluate": { "type": "object", "additionalProperties": false, "required": ["state", "may_submit", "href", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "may_submit": { "const": false }, "href": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "sibling_draft": { "type": "object", "additionalProperties": false, "required": ["state", "may_create", "href", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "may_create": { "const": false }, "href": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } } } }, "availability": { "$ref": "#/components/schemas/Availability" } } }
        } },
        "source_absences": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/SourceGap" } },
        "artifact_bytes": { "$ref": "#/components/schemas/ArtifactByteVerification" },
        "stage4_binding": { "$ref": "#/components/schemas/Stage4Binding" },
        "parameter_authority": { "$ref": "#/components/schemas/ParameterAuthority" }
      } },
      "Stage4BindingRow": {"type":"object","additionalProperties":false,"required":["key","label","value","identity_rule","source_key","folds","state","reason_code"],"properties":{"key":{"enum":["SEALED_PARAMS","REPLAY_PARAMS","SEALED_BUNDLE","RUNTIME_BUNDLE"]},"label":{"enum":["sealed params digest","params digest used by replay","sealed bundle digest","runtime bundle digest"]},"value":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{24,64}$"},{"type":"null"}]},"identity_rule":{"enum":["QUANTBT_WALKFORWARD_STRATEGY_CANDIDATE_ID_V1","QUANTBT_STRATEGY_FINGERPRINT_V1","SHA256_CANONICAL_PARAMETER_MAP_V1","P04_ADAPTER_CONTRACT_DIGEST_V1","IMPORTED_SOURCE_AND_ADAPTER_SHA256_V1"]},"source_key":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{2,95}$"},"folds":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["fold_id","value","audit_ordinal","state","reason_code"],"properties":{"fold_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"},"value":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{24,64}$"},{"type":"null"}]},"audit_ordinal":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]},"state":{"enum":["MATCH","MISMATCH","NOT_PUBLISHED"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]}}},"maxItems":256},"state":{"enum":["MATCH","MISMATCH","NOT_PUBLISHED"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]}}},
      "Stage4Binding": {"type":"object","additionalProperties":false,"required":["schema_version","lane","state","reason_code","sealed_params_sha256","rows","pairs"],"properties":{"schema_version":{"const":"research.stage4-binding.v1"},"lane":{"enum":["RS02_RETAINED_CHILD_AUDIT","P04_FIXED_QUALIFICATION","IMPORTED_FIXED_QUALIFICATION"]},"state":{"enum":["BOUND","DRIFT","NOT_COMPARED"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]},"sealed_params_sha256":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"rows":{"type":"array","items":{"$ref":"#/components/schemas/Stage4BindingRow"},"minItems":4,"maxItems":4},"pairs":{"type":"object","additionalProperties":false,"required":["params","bundle"],"properties":{"params":{"enum":["MATCH","MISMATCH","NOT_PUBLISHED"]},"bundle":{"enum":["MATCH","MISMATCH","NOT_PUBLISHED"]}}},"selection_scope":{"enum":["GLOBAL","PER_FOLD"]}},"description":"X2 · B4 · CG-P16-02 (HiFi 07 F4): sealed vs replayed params and sealed vs runtime bundle, compared on the server under a named identity rule per lane. RS-02: QuantBT candidate identity of the sealed θ* vs each fold's out-of-sample generation child, and the strategy fingerprint of the frozen candidate's selection-stage children vs the generation child's. P04: the registered fixed bundle and adapter digests vs what the P04 child executed (its P14 receipt and producer row). Any MISMATCH is DRIFT; a missing side is NOT_COMPARED with its reason, never a tick."},
      "ParameterAuthority": {"type":"object","additionalProperties":false,"required":["schema_version","state","reason_code","declared","code_fixed"],"properties":{"schema_version":{"const":"research.parameter-authority.v1"},"state":{"enum":["AVAILABLE","NOT_PUBLISHED"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]},"declared":{"type":"object","additionalProperties":false,"required":["hash_scope","names"],"properties":{"hash_scope":{"const":"PARAMS_DIGEST"},"names":{"type":"array","items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]{0,63}$"},"maxItems":24}}},"code_fixed":{"type":"object","additionalProperties":false,"required":["state","reason_code","values","hash_scope","code_digest","specification_digest","adapter_contract_digest"],"properties":{"state":{"enum":["AVAILABLE","NOT_PUBLISHED"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]},"values":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"type":"string","minLength":1,"maxLength":64},"value":{"type":"string","minLength":1,"maxLength":64}}},"maxItems":32},"hash_scope":{"enum":["ADAPTER_CONTRACT_DIGEST","SOURCE_CODE_SHA256"]},"code_digest":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"specification_digest":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"adapter_contract_digest":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]}}}},"description":"X2 · B4 · CG-P16-03 (guide §6.6): declared/swept/pinned values live in the params (θ) digest; values the code fixes are outside it and are covered by the protected code digest bound into the adapter contract digest. The Delta kernel publishes no machine-readable list of its fixed values, so `code_fixed.values` is a typed absence (P04_DELTA_KERNEL_PUBLISHES_NO_CODE_FIXED_VALUE_LIST) with the exact hash scope."},
      "ArtifactByteMismatch": { "type": "object", "additionalProperties": false, "required": ["kind", "table_kind", "ordinal", "expected_digest", "observed_digest"], "properties": { "kind": { "enum": ["MANIFEST", "PART", "DOCUMENT"] }, "table_kind": { "anyOf": [{ "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" }, { "type": "null" }] }, "ordinal": { "type": "integer", "minimum": 0, "maximum": 512 }, "expected_digest": { "$ref": "#/components/schemas/Digest" }, "observed_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] } } },
