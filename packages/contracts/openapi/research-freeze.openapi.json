{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Freeze API",
    "version": "1.0.0",
    "description": "P16 same-origin current-source Freeze and retained integrity reader. It reads one immutable Portal P10/P14 receipt and compares exactly three retained digest bindings. A PARTIAL_MATCH never attests source artifact bytes, causal wall-clock ordering, a selection artifact, an optimizer candidate pool, or a what-if evaluation. It never starts a worker, diagnostic evaluation, source adapter, or mutation."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/freeze": {
      "get": {
        "operationId": "researchFreezeDetailGetV1",
        "summary": "Read immutable current-source Freeze truth and retained-binding integrity for one run",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/Fold" },
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "Current retained Freeze truth or typed source absence", "headers": { "ETag": { "$ref": "#/components/headers/Etag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FreezeDetail" } } } },
          "304": { "description": "The exact immutable P16 retained-binding revision has not changed" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/quantbt/runs/{runId}/freeze/verify": {
      "post": {
        "operationId": "researchFreezeVerifyPostV1",
        "summary": "Explicitly re-read retained Freeze bindings without persisting a receipt or submitting work",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/Fold" },
          { "$ref": "#/components/parameters/PortalCsrf" }
        ],
        "responses": {
          "200": { "description": "Typed retained-binding verification result; PARTIAL_MATCH is not a source-artifact PASS", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FreezeVerification" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "Etag": { "description": "Quoted immutable P16 retained-binding revision.", "schema": { "type": "string", "pattern": "^\\\"p16r1_[0-9a-f]{64}\\\"$" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "Fold": { "name": "fold", "in": "query", "required": false, "description": "Bounded inspection request only. Current P04 has no fold selection artifact.", "schema": { "type": "integer", "minimum": 1, "maximum": 256 } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 96 } },
      "PortalCsrf": { "name": "x-portal-csrf", "in": "header", "required": true, "description": "Same-origin CSRF proof for the explicit re-read action.", "schema": { "type": "string", "minLength": 1, "maxLength": 512 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal; no source relation, source cursor, credential, artifact path, raw market input, worker custody value, command or diagnostic authority is disclosed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" },
      "ExactDecimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "SourceGap": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_PUBLISHED", "NOT_APPLICABLE", "NOT_ASSERTED", "NOT_ATTESTED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Parameter": { "type": "object", "additionalProperties": false, "required": ["name", "kind", "minimum", "maximum", "step", "frozen_value", "position_percent", "bound_state"], "properties": { "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" }, "kind": { "const": "NUMERIC" }, "minimum": { "$ref": "#/components/schemas/ExactDecimal" }, "maximum": { "$ref": "#/components/schemas/ExactDecimal" }, "step": { "$ref": "#/components/schemas/ExactDecimal" }, "frozen_value": { "$ref": "#/components/schemas/ExactDecimal" }, "position_percent": { "type": "number", "minimum": 0, "maximum": 100 }, "bound_state": { "const": "WITHIN_DECLARED_RANGE" } } },
      "Window": { "type": "object", "additionalProperties": false, "required": ["start_utc_ms", "end_exclusive_utc_ms", "bars", "data_role", "child_input_state", "evaluation_state", "availability"], "properties": { "start_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "end_exclusive_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "bars": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2000000 }, { "type": "null" }] }, "data_role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, "child_input_state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, "evaluation_state": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "DataTime": { "type": "object", "additionalProperties": false, "required": ["state", "chronology_kind", "is", "outer_oos", "holdout", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "chronology_kind": { "anyOf": [{ "const": "THREE_WINDOW_CURRENT" }, { "type": "null" }] }, "is": { "anyOf": [{ "$ref": "#/components/schemas/Window" }, { "type": "null" }] }, "outer_oos": { "anyOf": [{ "$ref": "#/components/schemas/Window" }, { "type": "null" }] }, "holdout": { "anyOf": [{ "$ref": "#/components/schemas/Window" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "IntegrityCheck": { "type": "object", "additionalProperties": false, "required": ["key", "state", "expected_digest", "observed_digest", "availability"], "properties": { "key": { "enum": ["P04_ADAPTER_CONTRACT", "P10_MANIFEST_BINDING", "P04_FIXED_PARAMETER_BUNDLE"] }, "state": { "enum": ["MATCH", "MISMATCH", "NOT_PUBLISHED"] }, "expected_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "observed_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Integrity": { "type": "object", "additionalProperties": false, "required": ["state", "verification_scope", "checks", "source_artifact_bytes", "availability"], "properties": { "state": { "enum": ["PARTIAL", "BLOCKED", "NOT_PUBLISHED"] }, "verification_scope": { "enum": ["PORTAL_RETAINED_DIGEST_BINDING_ONLY", "NONE"] }, "checks": { "type": "array", "maxItems": 3, "items": { "$ref": "#/components/schemas/IntegrityCheck" } }, "source_artifact_bytes": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "FreezeDetail": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "run_id", "revision", "etag", "availability", "readiness", "as_of_utc_ms", "provenance", "freeze", "source_absences"], "properties": {
        "schema_version": { "const": "research.freeze-detail.v1" },
        "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" },
        "run_id": { "$ref": "#/components/schemas/RunId" },
        "revision": { "anyOf": [{ "type": "string", "pattern": "^p16r1_[0-9a-f]{64}$" }, { "type": "null" }] },
        "etag": { "anyOf": [{ "type": "string", "pattern": "^\\\"p16r1_[0-9a-f]{64}\\\"$" }, { "type": "null" }] },
        "availability": { "$ref": "#/components/schemas/Availability" },
        "readiness": { "enum": ["PARTIAL", "NOT_READY"] },
        "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["source_adapter_id", "adapter_contract_digest", "p14_split_revision", "source_split_digest", "requested_spec_digest", "effective_spec_digest", "dataset_binding_digest", "manifest_digest"], "properties": { "source_adapter_id": { "anyOf": [{ "const": "p04.delta-rsi.v1" }, { "type": "null" }] }, "adapter_contract_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "p14_split_revision": { "anyOf": [{ "type": "string", "pattern": "^p14r1_[0-9a-f]{64}$" }, { "type": "null" }] }, "source_split_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "requested_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "effective_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "dataset_binding_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "manifest_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] } } },
        "freeze": { "type": "object", "additionalProperties": false, "required": ["source_profile", "inspection", "selection", "ordering", "frozen_parameters", "integrity", "what_if"], "properties": {
          "source_profile": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["FIXED_PROFILE_NO_SELECTION_ARTIFACT", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_PUBLISHED"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "inspection": { "type": "object", "additionalProperties": false, "required": ["requested_fold", "state", "availability"], "properties": { "requested_fold": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 256 }, { "type": "null" }] }, "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "selection": { "type": "object", "additionalProperties": false, "required": ["state", "selection_artifact_ref", "selected_trial_ref", "selection_sequence", "parameter_bundle_digest", "strict_outer_oos", "availability"], "properties": { "state": { "enum": ["FIXED_PARAMETER_PROFILE", "NOT_PUBLISHED"] }, "selection_artifact_ref": { "type": "null" }, "selected_trial_ref": { "type": "null" }, "selection_sequence": { "type": "null" }, "parameter_bundle_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "strict_outer_oos": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "ordering": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "wall_clock", "data_time", "availability"], "properties": { "state": { "enum": ["NOT_ASSERTED", "NOT_PUBLISHED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "wall_clock": { "$ref": "#/components/schemas/SourceGap" }, "data_time": { "$ref": "#/components/schemas/DataTime" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
          "frozen_parameters": { "type": "array", "maxItems": 32, "items": { "$ref": "#/components/schemas/Parameter" } },
          "integrity": { "$ref": "#/components/schemas/Integrity" },
          "what_if": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "grid", "actions", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "grid": { "type": "object", "additionalProperties": false, "required": ["state", "effective_cell_count", "objective_definition", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "effective_cell_count": { "type": "null" }, "objective_definition": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "actions": { "type": "object", "additionalProperties": false, "required": ["diagnostic_evaluate", "sibling_draft"], "properties": { "diagnostic_evaluate": { "type": "object", "additionalProperties": false, "required": ["state", "may_submit", "href", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "may_submit": { "const": false }, "href": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "sibling_draft": { "type": "object", "additionalProperties": false, "required": ["state", "may_create", "href", "availability"], "properties": { "state": { "enum": ["NOT_APPLICABLE", "NOT_PUBLISHED"] }, "may_create": { "const": false }, "href": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } } } }, "availability": { "$ref": "#/components/schemas/Availability" } } }
        } },
        "source_absences": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/SourceGap" } }
      } },
      "FreezeVerification": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "run_id", "freeze_revision", "verified_at_utc_ms", "result", "integrity"], "properties": { "schema_version": { "const": "research.freeze-verification.v1" }, "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "freeze_revision": { "anyOf": [{ "type": "string", "pattern": "^p16r1_[0-9a-f]{64}$" }, { "type": "null" }] }, "verified_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "result": { "enum": ["PARTIAL_MATCH", "BLOCKED", "NOT_PUBLISHED"] }, "integrity": { "$ref": "#/components/schemas/Integrity" } } },
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } }
    }
  }
}
