{
  "openapi": "3.1.0",
  "info": {
    "title": "Execution Core-observed read (not TS-qualified)",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/observed/overview": {
      "get": {
        "operationId": "executionObservedOverviewGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Explicit opt-in read lane; feature defaults OFF. Whole-workspace legacy-compatible access only. SCOPED_V2 is refused before repository work and rechecked before delivery. Paper figures are exact-decimal per-currency observations from one bounded snapshot, never inferred TS ownership. Sandbox/Live and unsupported figures publish typed absence. Missing coverage calibration cannot produce numeric Return/Drawdown.",
        "x-strict-query-keys": [
          "workspace_id",
          "environment"
        ],
        "x-server-invariants": [
          "METHOD_FIGURE_MISMATCH",
          "UNIT_FIGURE_MISMATCH",
          "VALUE_AVAILABILITY_MISMATCH",
          "REASON_REQUIRED",
          "ACCOUNT_COUNT_INVALID",
          "WINDOW_ORDER_INVALID",
          "TIMESTAMP_ORDER_INVALID",
          "DUPLICATE_FIGURE_PARTITION",
          "RESPONSE_TOO_LARGE"
        ],
        "parameters": [
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "paper",
                "sandbox",
                "live"
              ],
              "default": "paper"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Core observation only. Not TS-qualified, not a qualified Manager fallback.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedOverview"
                }
              }
            }
          },
          "400": {
            "description": "EXECUTION_OBSERVED_QUERY_INVALID: closed scalar query.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedProblem"
                }
              }
            }
          },
          "401": {
            "description": "Authenticated current session required.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedProblem"
                }
              }
            }
          },
          "403": {
            "description": "Current access policy refused the read.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedProblem"
                }
              }
            }
          },
          "404": {
            "description": "Lane disabled or workspace/profile/membership unavailable; no existence disclosure.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedProblem"
                }
              }
            }
          },
          "409": {
            "description": "Policy, source snapshot or retained mirror changed during delivery.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedProblem"
                }
              }
            }
          },
          "503": {
            "description": "Bounded read capability unavailable.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedProblem"
                }
              }
            }
          }
        }
      }
    }
  },
