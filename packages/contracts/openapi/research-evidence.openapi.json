{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Evidence Flow API",
    "version": "1.0.0",
    "description": "P13 same-origin Screen-04 Evidence Flow Hub. The Hub reads a compact immutable Portal projection and lazy bounded chart series. It never runs QuantBT, scans an artifact/Parquet file, exposes a worker/source path, or lets a browser supply a projection revision."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/evidence": {
      "get": {
        "operationId": "researchEvidenceHubGetV1",
        "summary": "Read compact Evidence Flow Hub state for one run",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": {
          "200": { "description": "Hub summary whose lazy series remain pinned to one immutable evidence revision", "headers": { "ETag": { "$ref": "#/components/headers/HubEtag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceHub" } } } },
          "304": { "description": "The Hub's semantic representation has not changed (weak comparison)", "headers": { "ETag": { "$ref": "#/components/headers/HubEtag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/quantbt/runs/{runId}/evidence/series": {
      "get": {
        "operationId": "researchEvidenceSeriesGetV1",
        "summary": "Read one bounded lazy Evidence Flow chart series",
        "description": "The selected named series carries the same immutable revision semantics as the Hub. A source absence is returned as a typed empty array, never as zero data.",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/SeriesKind" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": {
          "200": { "description": "At most 192 display values from one named evidence series", "headers": { "ETag": { "$ref": "#/components/headers/SeriesEtag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvidenceSeries" } } } },
          "304": { "description": "The exact immutable revision has not changed (weak comparison: a gzip-weakened W/ tag matches)", "headers": { "ETag": { "$ref": "#/components/headers/SeriesEtag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } } },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "CacheControl": { "description": "RF-05 CG-P13-13: every 200/304 is `private, no-cache` (store privately, revalidate before reuse). If-None-Match uses weak comparison, so a gateway-weakened W/ tag still revalidates.", "schema": { "const": "private, no-cache" } }, "HubEtag": { "description": "Weak semantic validator for the full Hub representation. The separate `revision` field still pins immutable evidence series.", "schema": { "type": "string", "pattern": "^W/\\\"p13h1_[0-9a-f]{64}\\\"$" } }, "SeriesEtag": { "description": "Quoted immutable P13 evidence-series revision.", "schema": { "type": "string", "pattern": "^\\\"p13r1_[0-9a-f]{64}\\\"$" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "SeriesKind": { "name": "kind", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/SeriesKind" } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 96 } }
    },
    "responses": { "Problem": { "description": "Typed same-origin refusal. It never discloses a database relation, source transport, artifact path, worker identity, lease, raw market data or credential.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } } },
    "schemas": {
      "RetainedAnalytics": {"title":"ResearchRetainedAnalytics","description":"E11/E14 source-time analytics sealed with one immutable artifact/projection. UTC milliseconds, exact decimals, no compute on GET. Child-tape trade count is not an audited ledger.","type":"object","additionalProperties":false,"required":["schema_version","input_digest","scope_locator","oos_observation_count","trade_ledger_record_count","net_oos_return","total_trade_count","rolling_sharpe_63","in_sample_equity","behaviour"],"properties":{"schema_version":{"const":"research.retained-analytics.v1"},"input_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"scope_locator":{"$ref":"#/components/schemas/RetainedAnalyticsLocator"},"oos_observation_count":{"type":"integer","minimum":1,"maximum":2000000},"trade_ledger_record_count":{"$ref":"#/components/schemas/RetainedAnalyticsCount"},"net_oos_return":{"allOf":[{"$ref":"#/components/schemas/RetainedAnalyticsFact"},{"properties":{"scope":{"const":"OOS"},"origin":{"const":"ENGINE_DIRECT"}}}]},"total_trade_count":{"allOf":[{"$ref":"#/components/schemas/RetainedAnalyticsFact"},{"properties":{"scope":{"const":"CHILD_TAPE"},"origin":{"const":"ENGINE_DIRECT"},"value":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^(?:0|[1-9][0-9]*)$","maxLength":96}]}}}]},"rolling_sharpe_63":{"$ref":"#/components/schemas/RetainedAnalyticsRolling"},"in_sample_equity":{"$ref":"#/components/schemas/RetainedAnalyticsCurve"},"behaviour":{"type":"object","additionalProperties":false,"required":["win_rate","payoff_ratio","average_hold_seconds","max_consecutive_losses","turnover_notional","exposure_fraction"],"properties":{"win_rate":{"$ref":"#/components/schemas/RetainedAnalyticsOosFact"},"payoff_ratio":{"$ref":"#/components/schemas/RetainedAnalyticsOosFact"},"average_hold_seconds":{"$ref":"#/components/schemas/RetainedAnalyticsOosFact"},"max_consecutive_losses":{"$ref":"#/components/schemas/RetainedAnalyticsOosFact"},"turnover_notional":{"$ref":"#/components/schemas/RetainedAnalyticsOosFact"},"exposure_fraction":{"$ref":"#/components/schemas/RetainedAnalyticsOosFact"}}}}},
      "RetainedAnalyticsDecimal": {"type":"string","pattern":"^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$","maxLength":96},
      "RetainedAnalyticsUtcMs": {"type":"integer","minimum":0,"maximum":9007199254740991},
      "RetainedAnalyticsCount": {"type":"integer","minimum":0,"maximum":2000000},
      "RetainedAnalyticsLocator": {"type":"string","minLength":1,"maxLength":256},
      "RetainedAnalyticsReason": {"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},
      "RetainedAnalyticsState": {"enum":["AVAILABLE","NOT_PUBLISHED","NOT_APPLICABLE"]},
      "RetainedAnalyticsFact": {"type":"object","additionalProperties":false,"required":["state","reason_code","value","source_locator","scope","origin"],"properties":{"state":{"$ref":"#/components/schemas/RetainedAnalyticsState"},"reason_code":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsReason"},{"type":"null"}]},"value":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsDecimal"},{"type":"null"}]},"source_locator":{"$ref":"#/components/schemas/RetainedAnalyticsLocator"},"scope":{"enum":["OOS","CHILD_TAPE"]},"origin":{"enum":["ENGINE_DIRECT","SOURCE_DERIVED"]}},"allOf":[{"if":{"properties":{"state":{"const":"AVAILABLE"}}},"then":{"properties":{"value":{"$ref":"#/components/schemas/RetainedAnalyticsDecimal"},"reason_code":{"type":"null"}}},"else":{"properties":{"value":{"type":"null"},"reason_code":{"$ref":"#/components/schemas/RetainedAnalyticsReason"}}}}]},
      "RetainedAnalyticsOosFact": {"allOf":[{"$ref":"#/components/schemas/RetainedAnalyticsFact"},{"properties":{"scope":{"const":"OOS"}}}]},
      "RetainedAnalyticsCurve": {"type":"object","additionalProperties":false,"required":["state","reason_code","scope","source_locator","start_utc_ms","end_exclusive_utc_ms","source_observation_count","emitted_point_count","sampling","points"],"properties":{"state":{"$ref":"#/components/schemas/RetainedAnalyticsState"},"reason_code":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsReason"},{"type":"null"}]},"scope":{"enum":["DECLARED_IS","SELECTED_CANDIDATE_IS"]},"source_locator":{"$ref":"#/components/schemas/RetainedAnalyticsLocator"},"start_utc_ms":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsUtcMs"},{"type":"null"}]},"end_exclusive_utc_ms":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsUtcMs"},{"type":"null"}]},"source_observation_count":{"$ref":"#/components/schemas/RetainedAnalyticsCount"},"emitted_point_count":{"type":"integer","minimum":0,"maximum":24},"sampling":{"enum":["FULL","EXTREMA_BUCKET_V1",null]},"points":{"type":"array","maxItems":24,"items":{"type":"object","additionalProperties":false,"required":["at_utc_ms","equity"],"properties":{"at_utc_ms":{"$ref":"#/components/schemas/RetainedAnalyticsUtcMs"},"equity":{"$ref":"#/components/schemas/RetainedAnalyticsDecimal"}}}}},"allOf":[{"if":{"properties":{"state":{"const":"AVAILABLE"}}},"then":{"properties":{"reason_code":{"type":"null"},"start_utc_ms":{"$ref":"#/components/schemas/RetainedAnalyticsUtcMs"},"end_exclusive_utc_ms":{"$ref":"#/components/schemas/RetainedAnalyticsUtcMs"},"source_observation_count":{"minimum":1},"emitted_point_count":{"minimum":1},"sampling":{"enum":["FULL","EXTREMA_BUCKET_V1"]},"points":{"minItems":1}}},"else":{"properties":{"reason_code":{"$ref":"#/components/schemas/RetainedAnalyticsReason"},"emitted_point_count":{"const":0},"sampling":{"type":"null"},"points":{"maxItems":0}}}}]},
      "RetainedAnalyticsRolling": {"type":"object","additionalProperties":false,"required":["state","reason_code","window_days","daily_return_count","locator","source_observation_count","omitted_non_finite_count","emitted_point_count","sampling","points"],"properties":{"state":{"$ref":"#/components/schemas/RetainedAnalyticsState"},"reason_code":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsReason"},{"type":"null"}]},"window_days":{"const":63},"daily_return_count":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsCount"},{"type":"null"}]},"locator":{"anyOf":[{"$ref":"#/components/schemas/RetainedAnalyticsLocator"},{"type":"null"}]},"source_observation_count":{"$ref":"#/components/schemas/RetainedAnalyticsCount"},"omitted_non_finite_count":{"$ref":"#/components/schemas/RetainedAnalyticsCount"},"emitted_point_count":{"type":"integer","minimum":0,"maximum":12},"sampling":{"enum":["FULL","EXTREMA_BUCKET_V1",null]},"points":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["at_utc_ms","sharpe"],"properties":{"at_utc_ms":{"$ref":"#/components/schemas/RetainedAnalyticsUtcMs"},"sharpe":{"$ref":"#/components/schemas/RetainedAnalyticsDecimal"}}}}},"allOf":[{"if":{"properties":{"state":{"const":"AVAILABLE"}}},"then":{"properties":{"reason_code":{"type":"null"},"emitted_point_count":{"minimum":1},"sampling":{"enum":["FULL","EXTREMA_BUCKET_V1"]},"points":{"minItems":1}}},"else":{"properties":{"reason_code":{"$ref":"#/components/schemas/RetainedAnalyticsReason"},"emitted_point_count":{"const":0},"sampling":{"type":"null"},"points":{"maxItems":0}}}}]},
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "Revision": { "type": "string", "pattern": "^p13r1_[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ExactDecimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] } } },
      "CandleOverviewBucket": { "type": "object", "additionalProperties": false, "required": ["first_ordinal", "last_ordinal", "open_utc_ms", "close_utc_ms", "open", "high", "low", "close", "volume", "transitions"], "properties": { "first_ordinal": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "last_ordinal": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "open_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "close_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "open": { "$ref": "#/components/schemas/ExactDecimal" }, "high": { "$ref": "#/components/schemas/ExactDecimal" }, "low": { "$ref": "#/components/schemas/ExactDecimal" }, "close": { "$ref": "#/components/schemas/ExactDecimal" }, "volume": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "transitions": { "type": "integer", "minimum": 0, "maximum": 2000000 } } },
      "CandleOverview": { "type": "object", "additionalProperties": false, "required": ["source_bar_count", "emitted_bucket_count", "bucket_bars", "sampling", "envelope", "values"], "description": "E16-R1 bounded true-extrema source overview. It is not a per-bar replay tape and cannot establish execution marker ordering.", "properties": { "source_bar_count": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "emitted_bucket_count": { "type": "integer", "minimum": 1, "maximum": 12 }, "bucket_bars": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "sampling": { "enum": ["FULL", "OHLC_BUCKET_V1"] }, "envelope": { "type": "object", "additionalProperties": false, "required": ["max_high", "max_high_at_utc_ms", "min_low", "min_low_at_utc_ms"], "properties": { "max_high": { "$ref": "#/components/schemas/ExactDecimal" }, "max_high_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "min_low": { "$ref": "#/components/schemas/ExactDecimal" }, "min_low_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" } } }, "values": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/components/schemas/CandleOverviewBucket" } } } },
      "MarketOverview": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "semantics", "data", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "reason_code": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] }, "semantics": { "const": "BOUNDED_SOURCE_OVERVIEW_NOT_PER_BAR_REPLAY" }, "data": { "anyOf": [{ "$ref": "#/components/schemas/CandleOverview" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "SeriesKind": { "enum": ["EQUITY_OOS", "MONTHLY_RETURNS", "ROLLING_RETURNS_20", "RETURN_DISTRIBUTION", "ROLLING_SHARPE_63", "ROLLING_BETA_63"], "description": "ROLLING_SHARPE_63 is QuantBT rolling_sharpe over 63 UTC daily OOS returns (365-day annualisation). ROLLING_BETA_63 stays a typed NOT_PUBLISHED absence until a benchmark series is published; it never carries values." },
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } },
      "HeaderTextFact": { "type": "object", "additionalProperties": false, "required": ["value", "availability"], "properties": { "value": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 191 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "HeaderDigestFact": { "type": "object", "additionalProperties": false, "required": ["value", "availability"], "properties": { "value": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "HeaderUtcFact": { "type": "object", "additionalProperties": false, "required": ["value", "availability"], "properties": { "value": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "HeaderSeedFact": { "type": "object", "additionalProperties": false, "required": ["value", "availability"], "properties": { "value": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 2147483647 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "RunIdentity": { "type": "object", "additionalProperties": false, "required": ["display_label", "status", "binding", "created_at_utc_ms", "mode", "schedule", "route", "config_digest", "seed"], "properties": { "display_label": { "description": "D1 (audit X2): the short label the hi-fi names a run by (R-WFO-118) - the run's execution profile kind plus its position among the logical runs of that kind in this workspace, ordered by creation. Server-derived by the one rule every read shares, so two readers cannot disagree. Presentation only - run_id remains the identity. null when no label can be derived, and the screen prints the short id rather than a guess.", "anyOf": [{ "type": "string", "pattern": "^R-[A-Z0-9]{1,8}-[0-9]{3,6}$" }, { "type": "null" }] }, "status": { "type": "object", "additionalProperties": false, "required": ["value", "availability"], "properties": { "value": { "anyOf": [{ "enum": ["DRAFT", "QUEUED", "RUNNING", "SEALING", "READY", "FAILED", "CANCELLED", "RECOVERY_REQUIRED"] }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "binding": { "type": "object", "additionalProperties": false, "required": ["alpha_id", "alpha_name", "alpha_version_id", "availability"], "properties": { "alpha_id": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 191 }, { "type": "null" }] }, "alpha_name": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 240 }, { "type": "null" }] }, "alpha_version_id": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 191 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } }, "created_at_utc_ms": { "$ref": "#/components/schemas/HeaderUtcFact" }, "mode": { "$ref": "#/components/schemas/HeaderTextFact" }, "schedule": { "$ref": "#/components/schemas/HeaderTextFact" }, "route": { "type": "object", "additionalProperties": false, "required": ["id", "contract"], "properties": { "id": { "$ref": "#/components/schemas/HeaderTextFact" }, "contract": { "$ref": "#/components/schemas/HeaderTextFact" } } }, "config_digest": { "$ref": "#/components/schemas/HeaderDigestFact" }, "seed": { "$ref": "#/components/schemas/HeaderSeedFact" } } },
      "FoldNavigation": { "description": "Observed P11 snapshot set only; it does not assert a complete source fold plan or boundaries.", "type": "object", "additionalProperties": false, "required": ["observed_folds", "published_fold_count", "availability"], "properties": { "observed_folds": { "type": "array", "maxItems": 256, "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 } }, "published_fold_count": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 256 }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Metric": { "type": "object", "additionalProperties": false, "required": ["key", "label", "unit", "scope", "frequency", "origin", "definition_id", "value", "availability"], "properties": { "key": { "enum": ["INITIAL_EQUITY", "FINAL_EQUITY", "NET_RETURN_FRACTION", "MAX_DRAWDOWN_FRACTION", "TRADE_COUNT", "BARS_PROCESSED", "BENCHMARK_RETURN_FRACTION", "FUNDING_TOTAL"] }, "label": { "type": "string", "minLength": 1, "maxLength": 96 }, "unit": { "enum": ["CURRENCY", "FRACTION", "COUNT"] }, "scope": { "enum": ["OOS", "IS_PLUS_OOS", "CHILD_TAPE", "NOT_PUBLISHED"] }, "frequency": { "enum": ["RUN_FINAL", "PER_OBSERVATION", "CALENDAR_MONTH"] }, "origin": { "enum": ["ENGINE_DIRECT", "SOURCE_DERIVED", "NOT_PUBLISHED"] }, "definition_id": { "type": "string", "pattern": "^research\\.metric\\.v1\\.[a-z0-9_.-]{2,96}$" }, "value": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Warning": { "type": "object", "additionalProperties": false, "required": ["definition_id", "state", "reason_code", "copy"], "properties": { "definition_id": { "type": "string", "pattern": "^research\\.warning\\.v1\\.[a-z0-9_.-]{2,96}$" }, "state": { "enum": ["ACTIVE", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] }, "copy": { "type": "string", "minLength": 1, "maxLength": 512 } } },
      "Claim": { "type": "object", "additionalProperties": false, "required": ["state", "text", "cursor", "methodology_certificate", "availability"], "properties": { "state": { "enum": ["ISSUED", "NOT_ISSUED", "FORECAST", "NOT_PUBLISHED"] }, "text": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1024 }, { "type": "null" }] }, "cursor": { "anyOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }] }, "methodology_certificate": { "type": "object", "additionalProperties": false, "required": ["state", "grade", "issued_at_utc_ms", "reason_code"], "properties": { "state": { "enum": ["ISSUED", "NOT_ISSUED", "NOT_PUBLISHED"] }, "grade": { "anyOf": [{ "enum": ["A", "B", "C", "D"] }, { "type": "null" }] }, "issued_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] }, "reason_code": { "anyOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" }, { "type": "null" }] } } }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Stage": { "type": "object", "additionalProperties": false, "required": ["key", "state", "started_at_utc_ms", "completed_at_utc_ms"], "properties": { "key": { "enum": ["S1", "S2", "S3", "S4", "S5"] }, "state": { "enum": ["PENDING", "RUNNING", "DONE"] }, "started_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] }, "completed_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] } } },
      "SeriesLink": { "type": "object", "additionalProperties": false, "required": ["kind", "availability", "href"], "properties": { "kind": { "$ref": "#/components/schemas/SeriesKind" }, "availability": { "$ref": "#/components/schemas/Availability" }, "href": { "anyOf": [{ "type": "string", "pattern": "^/api/v1/quantbt/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/evidence/series\\?kind=[A-Z0-9_]+$" }, { "type": "null" }] } } },
      "EvidenceHub": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "run_id", "revision", "etag", "availability", "readiness", "as_of_utc_ms", "metric_registry_version", "core", "metrics", "claim", "stages", "series", "warnings", "source_absences"], "properties": {
        "schema_version": { "const": "research.evidence-hub.v1" }, "summary_analytics": { "$ref": "#/components/schemas/RetainedAnalytics" }, "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "revision": { "anyOf": [{ "$ref": "#/components/schemas/Revision" }, { "type": "null" }] }, "etag": { "anyOf": [{ "type": "string", "pattern": "^W/\\\"p13h1_[0-9a-f]{64}\\\"$" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" }, "readiness": { "enum": ["COMPLETE", "PARTIAL", "NOT_READY"] }, "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "metric_registry_version": { "enum": ["research.metric-registry.v1", "research.metric-registry.v2"] },
        "core": { "type": "object", "additionalProperties": false, "required": ["source_adapter_id", "engine_version", "input_scope", "source_transform_digest", "requested_spec_digest", "effective_spec_digest", "dataset_binding_digest", "manifest_digest", "data"], "properties": { "source_adapter_id": { "anyOf": [{ "enum": ["p04.delta-rsi.v1", "p17.imported-signal-notional.v1"] }, { "type": "null" }] }, "engine_version": { "anyOf": [{ "const": "1.1.1" }, { "type": "null" }] }, "input_scope": { "anyOf": [{ "const": "P08_OPTIONAL_WARMUP_PLUS_IS_OOS_ONLY" }, { "type": "null" }] }, "source_transform_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "requested_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "effective_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "dataset_binding_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "manifest_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "data": { "type": "object", "additionalProperties": false, "required": ["dataset_id", "symbol", "timeframe", "oos_observation_count"], "properties": { "dataset_id": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 191 }, { "type": "null" }] }, "symbol": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 191 }, { "type": "null" }] }, "timeframe": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 191 }, { "type": "null" }] }, "oos_observation_count": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2000000 }, { "type": "null" }] } } }, "run_identity": { "$ref": "#/components/schemas/RunIdentity", "description": "Optional during a bounded rolling deployment; new Hub responders always emit it." }, "fold_navigation": { "$ref": "#/components/schemas/FoldNavigation", "description": "Optional during a bounded rolling deployment; it bounds only the published 