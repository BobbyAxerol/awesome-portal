      "CorrectedDistributionBucket": { "type": "object", "additionalProperties": false, "required": ["lower_inclusive", "upper", "upper_inclusive", "count"], "properties": { "lower_inclusive": { "$ref": "#/components/schemas/ExactDecimal" }, "upper": { "$ref": "#/components/schemas/ExactDecimal" }, "upper_inclusive": { "enum": ["true", "false"] }, "count": { "type": "string", "pattern": "^[0-9]+$" } } },
      "EvidenceSeries": { "type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "revision", "etag", "kind", "availability", "source_sample", "values"], "properties": { "schema_version": { "const": "research.evidence-series.v1" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "revision": { "anyOf": [{ "$ref": "#/components/schemas/Revision" }, { "type": "null" }] }, "etag": { "anyOf": [{ "type": "string", "pattern": "^\\\"p13r1_[0-9a-f]{64}\\\"$" }, { "type": "null" }] }, "kind": { "$ref": "#/components/schemas/SeriesKind" }, "availability": { "$ref": "#/components/schemas/Availability" }, "source_sample": { "type": "object", "additionalProperties": false, "required": ["source_observation_count", "emitted_point_count", "sampling"], "properties": { "source_observation_count": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 2000000 }, { "type": "null" }] }, "emitted_point_count": { "type": "integer", "minimum": 0, "maximum": 192 }, "sampling": { "anyOf": [{ "enum": ["FULL", "EXTREMA_BUCKET_V1", "TAIL_WINDOW_V1", "FULL_RETURN_HISTOGRAM_V2"] }, { "type": "null" }] } } }, "values": { "type": "array", "maxItems": 192, "items": { "oneOf": [{ "$ref": "#/components/schemas/EquityPoint" }, { "$ref": "#/components/schemas/MonthlyReturnPoint" }, { "$ref": "#/components/schemas/RollingReturnPoint" }, { "$ref": "#/components/schemas/RollingSharpePoint" }, { "$ref": "#/components/schemas/DistributionBucket" }, { "$ref": "#/components/schemas/CorrectedDistributionBucket" }] } } } }
