      "PerformanceMetric": {"type": "object", "additionalProperties": false, "description": "RF-05 registry v3 OOS performance fact. ENGINE_DIRECT values are QuantBT 1.1.1 full_report fields over QuantBT's own OOS scope; source_locator names the exact field. Engine sentinels (0.0 for zero variance, inf without losses, 0.0 without exposure) are typed absences, never values.", "required": ["key", "label", "unit", "scope", "frequency", "origin", "definition_id", "source_locator", "value", "availability"], "properties": {"key": {"enum": ["OOS_SHARPE", "OOS_SORTINO", "OOS_CAGR_FRACTION", "OOS_PROFIT_FACTOR", "OOS_LONG_HIT_RATE_FRACTION", "OOS_SHORT_HIT_RATE_FRACTION", "OOS_SHARPE_DECAY"]}, "label": {"type": "string", "minLength": 1, "maxLength": 96}, "unit": {"enum": ["RATIO", "FRACTION"]}, "scope": {"const": "OOS"}, "frequency": {"const": "RUN_FINAL"}, "origin": {"enum": ["ENGINE_DIRECT", "NOT_PUBLISHED"]}, "definition_id": {"type": "string", "pattern": "^research\\.metric\\.v3\\.[a-z0-9_.-]{2,96}$"}, "source_locator": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 96}, {"type": "null"}]}, "value": {"anyOf": [{"$ref": "#/components/schemas/ExactDecimal"}, {"type": "null"}]}, "availability": {"$ref": "#/components/schemas/Availability"}}},
      "OosPerformance": {"type": "object", "additionalProperties": false, "description": "RF-05 CG-P13-03. Separate from `metrics` (registry v1/v2, frozen by P18 reports). Absent only from a Hub responder that predates RF-05.", "required": ["registry_version", "availability", "scope_locator", "report_locator", "return_sample", "metrics"], "properties": {"registry_version": {"const": "research.metric-registry.v3"}, "availability": {"$ref": "#/components/schemas/Availability"}, "scope_locator": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]}, "report_locator": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]}, "return_sample": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "observation_count", "annualization_periods"], "properties": {"kind": {"enum": ["DAILY_UTC_EQUITY", "BAR"]}, "observation_count": {"type": "integer", "minimum": 0, "maximum": 2000000}, "annualization_periods": {"$ref": "#/components/schemas/ExactDecimal"}}}, {"type": "null"}]}, "metrics": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/components/schemas/PerformanceMetric"}}}},
      "Lifecycle": {"type": "object", "additionalProperties": false, "description": "RF-05 CG-P13-10/12. display_status uses the Screen-01 run-library rule (job state, else durable state): SUCCEEDED/READY->COMPLETED, RUNNING/CLAIMED/SEALING/CANCEL_REQUESTED->RUNNING, FAILED, CANCELLED, DRAFT, RECOVERY_REQUIRED, otherwise QUEUED. phase is the typed terminal flag; a CANCELLED or FAILED run without evidence is TERMINAL, not an in-progress NOT_READY.", "required": ["vocabulary", "durable_status", "display_status", "phase", "terminal_outcome", "availability"], "properties": {"vocabulary": {"const": "research.run-status-vocabulary.v1"}, "durable_status": {"anyOf": [{"enum": ["DRAFT", "QUEUED", "RUNNING", "SEALING", "READY", "FAILED", "CANCELLED", "RECOVERY_REQUIRED"]}, {"type": "null"}]}, "display_status": {"anyOf": [{"enum": ["COMPLETED", "RUNNING", "FAILED", "QUEUED", "DRAFT", "CANCELLED", "RECOVERY_REQUIRED"]}, {"type": "null"}]}, "phase": {"enum": ["IN_PROGRESS", "TERMINAL", "ATTENTION_REQUIRED", "LEGACY", "NOT_PUBLISHED"]}, "terminal_outcome": {"anyOf": [{"enum": ["COMPLETED", "FAILED", "CANCELLED"]}, {"type": "null"}]}, "availability": {"$ref": "#/components/schemas/Availability"}}},
      "RevisionBinding": {"type": "object", "additionalProperties": false, "description": "RF-05 CG-P13-11. RUN_INPUT_BOUND: the revision hashes this run id and its requested-spec, effective-spec, dataset-binding and manifest digests with the evidence, so two runs never share it. SOURCE_CONTENT_ONLY: an immutable pre-RF-05 revision naming only evidence bytes; runs with identical output may share it, so match run_id as well.", "required": ["value", "availability"], "properties": {"value": {"anyOf": [{"enum": ["RUN_INPUT_BOUND", "SOURCE_CONTENT_ONLY"]}, {"type": "null"}]}, "availability": {"$ref": "#/components/schemas/Availability"}}},
      "RollingSharpePoint": {"type": "object", "additionalProperties": false, "required": ["at_utc_ms", "sharpe"], "properties": {"at_utc_ms": {"$ref": "#/components/schemas/UtcMilliseconds"}, "sharpe": {"$ref": "#/components/schemas/ExactDecimal"}}},
      "EquityPoint": { "type": "object", "additionalProperties": false, "required": ["at_utc_ms", "equity", "drawdown_fraction"], "properties": { "at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "equity": { "$ref": "#/components/schemas/ExactDecimal" }, "drawdown_fraction": { "$ref": "#/components/schemas/ExactDecimal" } } },
