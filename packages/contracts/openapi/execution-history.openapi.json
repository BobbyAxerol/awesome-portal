          "400": {
            "description": "Typed public refusal, no hidden counts, SQL, custody or source credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryProblem"
                }
              }
            }
          },
          "401": {
            "description": "Typed public refusal, no hidden counts, SQL, custody or source credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryProblem"
                }
              }
            }
          },
          "403": {
            "description": "Typed public refusal, no hidden counts, SQL, custody or source credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryProblem"
                }
              }
            }
          },
          "404": {
            "description": "Typed public refusal, no hidden counts, SQL, custody or source credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryProblem"
                }
              }
            }
          },
          "409": {
            "description": "Typed public refusal, no hidden counts, SQL, custody or source credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryProblem"
                }
              }
            }
          },
          "503": {
            "description": "Typed public refusal, no hidden counts, SQL, custody or source credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryProblem"
                }
              }
            }
          }
        }
      }
    }
  },
