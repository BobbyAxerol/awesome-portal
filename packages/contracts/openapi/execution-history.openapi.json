{
  "openapi": "3.1.0",
  "info": {
    "title": "Execution retained history scoped compatibility read",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v1/execution/history/{environment}/{relationKey}": {
      "get": {
        "operationId": "executionRetainedHistoryGet",
        "deprecated": true,
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Existing deprecated, catalogue-bound history compatibility route, not an arbitrary relation proxy. private,no-store. V2 policy refuses hidden filter fields, scope/workspace/profile/limit/revision cursor changes and raw legacy cursors. No browser authority/qualification/actor input.",
        "parameters": [
          {
            "name": "environment",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "paper",
                "sandbox",
                "live"
              ]
            }
          },
          {
            "name": "relationKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "description": "Only existing server-catalogued ladder bindings; no SQL, schema, URL or cursor relation input."
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "description": "Current authenticated membership; never a scope grant."
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 35
            },
            "description": "ISO UTC/offset input; V2 [from,to), equal/reversed endpoints refused."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 35
            },
            "description": "ISO UTC/offset input; V2 [from,to), equal/reversed endpoints refused."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "default": 500
            },
            "description": "Page bound, not a total-history cap."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[A-Za-z0-9._-]+$(?![\\s\\S])"
            },
            "description": "V2 opaque signed cursor; bound to actor/session/policy/source/filter/window/limit."
          },
          {
            "name": "after_ts",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 35
            },
            "description": "Legacy-only; V2 refuses this parameter.",
            "deprecated": true
          },
          {
            "name": "after_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Legacy-only; V2 refuses this parameter.",
            "deprecated": true
          },
          {
            "name": "account_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "description": "At most one entity filter; field must be disclosed/queryable under current policy."
          },
          {
            "name": "portfolio_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "description": "At most one entity filter; field must be disclosed/queryable under current policy."
          },
          {
            "name": "deployment_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "description": "At most one entity filter; field must be disclosed/queryable under current policy."
          },
          {
            "name": "strategy_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "description": "At most one entity filter; field must be disclosed/queryable under current policy."
          },
          {
            "name": "instrument_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "description": "At most one entity filter; field must be disclosed/queryable under current policy."
          }
        ],
        "responses": {
          "200": {
            "description": "Server-selected schema; authorized empty is 200, not an unqualified source success.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ScopedHistoryResponse"
                    },
                    {
                      "$ref": "#/components/schemas/LegacyHistoryResponse"
                    }
                  ]
                }
