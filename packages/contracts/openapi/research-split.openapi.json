{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Split Truth API",
    "version": "1.0.0",
    "description": "P14 same-origin current-P04 Split, chronology and holdout-truth reader. It reads one bounded immutable Portal projection. It never reads a snapshot/Parquet file, raw holdout data, a worker journal/path, a seal/unlock action channel, or generic WFO state. RF-05 (additive): `as_of_utc_ms` is the time of the durable fact the representation is built from (`as_of_basis`), never read time; the ETag is the representation validator (compare weakly, RFC 9110 §13.1.2) and responses are `Cache-Control: private, no-cache`; `dataset` publishes the P08-bound timeframe and bar interval; facts a three-window protocol cannot carry are `NOT_APPLICABLE`; absences are authoritative where the fact lives and `absence_index` lists each once (`source_absences` is deprecated)."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/split": {
      "get": {
        "operationId": "researchSplitDetailGetV1",
        "summary": "Read immutable current-source split and holdout truth for one run",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "Current P04 three-window truth or typed source absence", "headers": { "ETag": { "$ref": "#/components/headers/Etag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SplitDetail" } } } },
          "304": { "description": "The If-None-Match validator (weak comparison) names this exact representation", "headers": { "ETag": { "$ref": "#/components/headers/Etag" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "Etag": { "description": "Quoted strong representation validator for one immutable P14 revision (RF-05: a digest of the exact published body, not the bare revision). A proxy may weaken it to W/\"…\"; the server compares weakly.", "schema": { "type": "string", "pattern": "^\\\"p14r1_[0-9a-f]{64}\\\"$" } }, "CacheControl": { "description": "Per-session read; revalidate before reuse.", "schema": { "const": "private, no-cache" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "description": "Entity-tag list or *; W/ prefixes are compared weakly.", "schema": { "type": "string", "maxLength": 512 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal; no source relation, cursor, worker/path, raw market row, holdout value or credential is disclosed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "RunDeclarationAlphaVersionDeclaration": {"type":"object","additionalProperties":false,"description":"Safe immutable AlphaVersion validator inputs, not raw source, provenance or mutable execution instructions.","required":["schema_version","entrypoint","timeframes","determinism","parameter_space","required_columns","warmup_bars"],"properties":{"schema_version":{"const":"research.alpha-version-declaration.v1"},"entrypoint":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z][A-Za-z0-9_.:]{0,159}$"},"timeframes":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","pattern":"^[1-9][0-9]*(?:m|h|d|w)$"}},"required_columns":{"type":"array","minItems":1,"maxItems":5,"uniqueItems":true,"items":{"enum":["open","high","low","close","volume"]}},"warmup_bars":{"type":"integer","minimum":0,"maximum":100000},"determinism":{"type":"object","additionalProperties":false,"required":["seed_required"],"properties":{"seed_required":{"type":"boolean"}}},"parameter_space":{"type":"object","maxProperties":12,"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,63}$"},"additionalProperties":{"$ref":"#/components/schemas/RunDeclarationParameterDeclaration"}}}},
      "RunDeclarationParameterDeclaration": {"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"const":"fixed"},"value":{"$ref":"#/components/schemas/RunDeclarationDeclarationScalar"}}},{"type":"object","additionalProperties":false,"required":["kind","low","high","step"],"properties":{"kind":{"const":"int_range"},"low":{"type":"integer"},"high":{"type":"integer"},"step":{"type":"integer","minimum":1}}},{"type":"object","additionalProperties":false,"required":["kind","low","high","step"],"properties":{"kind":{"const":"float_range"},"low":{"type":"number"},"high":{"type":"number"},"step":{"type":"number","exclusiveMinimum":0}}},{"type":"object","additionalProperties":false,"required":["kind","values"],"properties":{"kind":{"const":"categorical"},"values":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/components/schemas/RunDeclarationDeclarationScalar"}}}}]},
      "RunDeclarationDeclarationScalar": {"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},
      "RunDeclaration": {"type":"object","additionalProperties":false,"required":["schema_version","state","reason_code","source_ref","alpha_binding","declaration_digest","requested_spec_digest","declaration","requested_overrides"],"properties":{"schema_version":{"const":"research.run-declaration.v1"},"state":{"enum":["AVAILABLE","NOT_PUBLISHED","NOT_APPLICABLE"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]},"source_ref":{"const":"IMMUTABLE_RUN_REQUEST_AND_ALPHA_VERSION_DECLARATION_V1"},"alpha_binding":{"anyOf":[{"type":"object","additionalProperties":false,"required":["alpha_id","alpha_version_id"],"properties":{"alpha_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"},"alpha_version_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"}}},{"type":"null"}]},"declaration_digest":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"requested_spec_digest":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"declaration":{"anyOf":[{"$ref":"#/components/schemas/RunDeclarationAlphaVersionDeclaration"},{"type":"null"}]},"requested_overrides":{"anyOf":[{"type":"array","items":{"oneOf":[{"type":"object","additionalProperties":false,"required":["name","kind","low","high"],"properties":{"name":{"type":"string","minLength":1,"maxLength":191,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"},"kind":{"const":"sweep"},"low":{"type":["string","number","boolean"]},"high":{"type":["string","number","boolean"]}}},{"type":"object","additionalProperties":false,"required":["name","kind","value"],"properties":{"name":{"type":"string","minLength":1,"maxLength":191,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$"},"kind":{"const":"pin"},"value":{"type":["string","number","boolean"]}}}]},"maxItems":64},{"type":"null"}]}},"allOf":[{"if":{"properties":{"state":{"const":"AVAILABLE"}}},"then":{"properties":{"reason_code":{"type":"null"},"alpha_binding":{"type":"object"},"declaration":{"type":"object"},"declaration_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"requested_spec_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"requested_overrides":{"type":"array"}}},"else":{"properties":{"reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},"declaration":{"type":"null"},"declaration_digest":{"type":"null"},"requested_overrides":{"type":"null"}}}}]},
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "Range": { "type": "object", "required": ["start_utc_ms", "end_exclusive_utc_ms"], "description": "Half-open UTC range. Closed to extra members wherever it is composed (unevaluatedProperties on the composing schema).", "properties": { "start_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "end_exclusive_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" } } },
      "AbsentFact": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "description": "NOT_APPLICABLE (RF-05): the run's protocol cannot carry the fact. NOT_PUBLISHED: the fact applies and the source did not publish it. NOT_ASSERTED: nobody claimed it.", "properties": { "state": { "enum": ["NOT_PUBLISHED", "NOT_ASSERTED", "NOT_APPLICABLE"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Warmup": { "oneOf": [
        { "allOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "object", "required": ["state", "bars", "data_role", "child_input_state", "availability"], "properties": { "state": { "const": "AVAILABLE" }, "bars": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "data_role": { "const": "WARMUP_NOT_SCORED" }, "child_input_state": { "const": "EXPOSED_TO_CHILD_TAPE" }, "availability": { "$ref": "#/components/schemas/Availability" } } }], "unevaluatedProperties": false },
        { "type": "object", "additionalProperties": false, "required": ["state", "bars", "reason_code", "availability"], "properties": { "state": { "const": "NOT_APPLICABLE" }, "bars": { "const": 0 }, "reason_code": { "const": "P08_WARMUP_NOT_REQUESTED" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        { "$ref": "#/components/schemas/AbsentFact" }
      ] },
      "IsWindow": { "oneOf": [
        { "allOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "object", "required": ["bars", "data_role", "child_input_state", "availability"], "properties": { "bars": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "data_role": { "const": "IS_CALIBRATION_HISTORY" }, "child_input_state": { "const": "EXPOSED_TO_CHILD_TAPE" }, "availability": { "$ref": "#/components/schemas/Availability" } } }], "unevaluatedProperties": false },
        { "$ref": "#/components/schemas/AbsentFact" }
      ] },
      "OuterOosWindow": {"oneOf":[{"allOf":[{"$ref":"#/components/schemas/Range"},{"type":"object","required":["bars","data_role","child_input_state","evaluation_state","availability"],"properties":{"bars":{"type":"integer","minimum":1,"maximum":2000000},"data_role":{"const":"OUTER_OOS_OBSERVATION"},"child_input_state":{"const":"EXPOSED_TO_CHILD_TAPE"},"evaluation_state":{"enum":["P04_OBSERVED_AFTER_FIXED_PROFILE","IMPORTED_ALPHA_OBSERVED_AFTER_FIXED_PROFILE","VN_OBSERVED_AFTER_FIXED_PROFILE"]},"availability":{"$ref":"#/components/schemas/Availability"}}}],"unevaluatedProperties":false},{"$ref":"#/components/schemas/AbsentFact"}]},
      "HoldoutWindow": { "oneOf": [
        { "allOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "object", "required": ["bars", "data_role", "child_input_state", "evaluation_state", "result_exposure_state", "snapshot_integrity_state", "physical_io", "source_seal", "unlock", "bars_absence", "availability"], "properties": { "bars": { "type": "null" }, "data_role": { "const": "HOLDOUT" }, "child_input_state": { "const": "NOT_EXPOSED_TO_CHILD_TAPE" }, "evaluation_state": { "const": "NOT_EVALUATED" }, "result_exposure_state": { "const": "NOT_EXPOSED" }, "snapshot_integrity_state": { "const": "P08_METADATA_BOUND" }, "physical_io": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "const": "NOT_ATTESTED" }, "reason_code": { "const": "P10_ROW_GROUP_PHYSICAL_IO_BOUNDARY_NOT_PUBLISHED" } } }, "source_seal": { "$ref": "#/components/schemas/AbsentFact" }, "unlock": { "$ref": "#/components/schemas/AbsentFact" }, "bars_absence": { "$ref": "#/components/schemas/AbsentFact", "description": "RF-05: why `bars` is null — P10 counts only rows copied into the child tape and never copies the holdout." }, "availability": { "$ref": "#/components/schemas/Availability" } } }], "unevaluatedProperties": false },
        { "$ref": "#/components/schemas/AbsentFact" }
      ] },
      "DatasetFact": { "description": "RF-05 CG-P14-05: dataset, symbol and bar interval from the P08 dataset binding whose canonical digest equals provenance.dataset_binding_digest. bar_interval_ms is parsed from the bound timeframe (<n>m|h|d|w); null with a reason when the timeframe has no fixed duration.", "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state", "dataset_id", "symbol", "timeframe", "bar_interval_ms", "provenance", "reason_code", "availability"], "properties": { "state": { "const": "AVAILABLE" }, "dataset_id": { "type": "string", "minLength": 1, "maxLength": 191 }, "symbol": { "type": "string", "minLength": 1, "maxLength": 64 }, "timeframe": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" }, "bar_interval_ms": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 31536000000 }, { "type": "null" }] }, "provenance": { "const": "P08_DATASET_BINDING" }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "dataset_id", "symbol", "timeframe", "bar_interval_ms", "provenance", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY"] }, "dataset_id": { "type": "null" }, "symbol": { "type": "null" }, "timeframe": { "type": "null" }, "bar_interval_ms": { "type": "null" }, "provenance": { "const": "NONE" }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } }
      ] },
      "AbsenceIndexEntry": { "type": "object", "additionalProperties": false, "required": ["key", "pointer", "state"], "description": "RF-05 CG-P14-06: one absent fact, as a JSON pointer (RFC 6901) into the field that owns it.", "properties": { "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }, "pointer": { "type": "string", "pattern": "^(?:/[a-z][a-z0-9_]{0,63}){1,4}$" }, "state": { "enum": ["NOT_PUBLISHED", "NOT_ASSERTED", "NOT_APPLICABLE"] } } },
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } },
      "SplitDetail": {"type":"object","additionalProperties":false,"required":["schema_version","read_authority","run_id","revision","etag","availability","readiness","as_of_utc_ms","as_of_basis","dataset","provenance","timeline","protocol","windows","actions","absence_authority","absence_index","source_absences"],"properties":{"schema_version":{"const":"research.split-detail.v1"},"read_authority":{"const":"PORTAL_PERSISTED_RESEARCH"},"run_id":{"$ref":"#/components/schemas/RunId"},"revision":{"anyOf":[{"type":"string","pattern":"^p14r1_[0-9a-f]{64}$"},{"type":"null"}]},"etag":{"anyOf":[{"type":"string","pattern":"^\\\"p14r1_[0-9a-f]{64}\\\"$"},{"type":"null"}]},"availability":{"$ref":"#/components/schemas/Availability"},"readiness":{"enum":["COMPLETE","PARTIAL","NOT_READY"]},"as_of_utc_ms":{"$ref":"#/components/schemas/UtcMilliseconds","description":"RF-05 CG-P14-04: time of the durable fact named by as_of_basis; stable for one immutable revision, never read time."},"as_of_basis":{"enum":["P14_PROJECTION_RECEIVED_AT","RUN_STATE_UPDATED_AT","LEGACY_READ_MODEL_UPDATED_AT"]},"dataset":{"$ref":"#/components/schemas/DatasetFact"},"provenance":{"type":"object","additionalProperties":false,"required":["source_adapter_id","engine_version","input_scope","source_transform_digest","requested_spec_digest","effective_spec_digest","dataset_binding_digest","manifest_digest"],"properties":{"source_adapter_id":{"anyOf":[{"enum":["p04.delta-rsi.v1","p17.imported-signal-notional.v1","full03.delta-rsi.v1"]},{"type":"null"}]},"engine_version":{"anyOf":[{"enum":["1.1.0","1.1.1"]},{"type":"null"}]},"input_scope":{"anyOf":[{"const":"P08_OPTIONAL_WARMUP_PLUS_IS_OOS_ONLY"},{"type":"null"}]},"source_transform_digest":{"anyOf":[{"$ref":"#/components/schemas/Digest"},{"type":"null"}]},"requested_spec_digest":{"anyOf":[{"$ref":"#/components/schemas/Digest"},{"type":"null"}]},"effective_spec_digest":{"anyOf":[{"$ref":"#/components/schemas/Digest"},{"type":"null"}]},"dataset_binding_digest":{"anyOf":[{"$ref":"#/components/schemas/Digest"},{"type":"null"}]},"manifest_digest":{"anyOf":[{"$ref":"#/components/schemas/Digest"},{"type":"null"}]}}},"timeline":{"anyOf":[{"$ref":"#/components/schemas/Range"},{"type":"null"}]},"protocol":{"type":"object","additionalProperties":false,"required":["kind","selection","fold_plan","inner_folds","purge","embargo","theta_per_fold","gap_scan"],"properties":{"kind":{"anyOf":[{"const":"THREE_WINDOW_CURRENT"},{"type":"null"}]},"selection":{"type":"object","additionalProperties":false,"required":["state","parameter_bundle_digest","strict_outer_oos"],"properties":{"state":{"enum":["FIXED_PROFILE_NO_SEARCH","NOT_PUBLISHED","NATIVE_OPTIMIZATION_SEALED_SEPARATELY"]},"parameter_bundle_digest":{"anyOf":[{"$ref":"#/components/schemas/Digest"},{"type":"null"}]},"strict_outer_oos":{"$ref":"#/components/schemas/AbsentFact"},"native_optimization":{"type":"object","additionalProperties":false,"required":["schema_version","authority","scope","objective_name","selection_method","requested_trials","completed_trials","retained_trials","distinct_parameter_sets","selected_trial_number","selected_parameters","selected_objective","train_start_utc_ms","train_end_exclusive_utc_ms","holdout_used","table_kind","table_schema_version","sha256"],"properties":{"schema_version":{"const":"research.native-optimization.v1"},"authority":{"const":"PINNED_QUANTBT_NATIVE_IS_SHARPE"},"scope":{"const":"P08_WARMUP_PLUS_IS_ONLY"},"objective_name":{"const":"sharpe"},"selection_method":{"const":"QUANTBT_GENERIC_ROBUST_PLATEAU_NOT_SCALAR_WFO_V1"},"requested_trials":{"type":"integer","minimum":2,"maximum":400},"completed_trials":{"type":"integer","minimum":1,"maximum":400},"retained_trials":{"type":"integer","minimum":1,"maximum":400},"distinct_parameter_sets":{"type":"integer","minimum":1,"maximum":400},"selected_trial_number":{"type":"integer","minimum":0,"maximum":399},"selected_parameters":{"type":"object","additionalProperties":{"type":"string","pattern":"^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$","maxLength":96},"maxProperties":8},"selected_objective":{"type":"string","pattern":"^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$","maxLength":96},"train_start_utc_ms":{"type":"integer","minimum":0},"train_end_exclusive_utc_ms":{"type":"integer","minimum":0},"holdout_used":{"const":false},"table_kind":{"const":"native_optimizer_trials"},"table_schema_version":{"const":"research.native-optimizer-trial-table.v1"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}},"fold_plan":{"$ref":"#/components/schemas/AbsentFact"},"inner_folds":{"$ref":"#/components/schemas/AbsentFact"},"purge":{"$ref":"#/components/schemas/AbsentFact"},"embargo":{"$ref":"#/components/schemas/AbsentFact"},"theta_per_fold":{"$ref":"#/components/schemas/AbsentFact"},"gap_scan":{"$ref":"#/components/schemas/AbsentFact"}}},"windows":{"type":"object","additionalProperties":false,"required":["warmup","is","outer_oos","holdout"],"properties":{"warmup":{"$ref":"#/components/schemas/Warmup"},"is":{"$ref":"#/components/schemas/IsWindow"},"outer_oos":{"$ref":"#/components/schemas/OuterOosWindow"},"holdout":{"$ref":"#/components/schemas/HoldoutWindow"}}},"actions":{"type":"object","additionalProperties":false,"required":["holdout_unlock"],"properties":{"holdout_unlock":{"type":"object","additionalProperties":false,"required":["state","href","availability"],"properties":{"state":{"const":"NOT_PUBLISHED"},"href":{"type":"null"},"availability":{"$ref":"#/components/schemas/Availability"}}}}},"absence_authority":{"const":"FIELD_LOCAL","description":"RF-05 CG-P14-06: protocol.*, windows.* and actions.* are the authoritative location of every absence."},"absence_index":{"type":"array","maxItems":32,"items":{"$ref":"#/components/schemas/AbsenceIndexEntry"}},"source_absences":{"type":"object","deprecated":true,"description":"Deprecated since RF-05; each value equals the field-local fact named in absence_index. Kept readable for older clients.","additionalProperties":{"$ref":"#/components/schemas/AbsentFact"}},"run_declaration":{"$ref":"#/components/schemas/RunDeclaration","description":"Immutable bound version declaration and explicit requested overrides. Never current registry defaults or evidence of actual runtime/sampler execution. Optional during additive rollout."}}}
    }
  }
}
