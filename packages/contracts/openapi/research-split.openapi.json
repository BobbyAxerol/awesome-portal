{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Split Truth API",
    "version": "1.0.0",
    "description": "P14 same-origin current-P04 Split, chronology and holdout-truth reader. It reads one bounded immutable Portal projection. It never reads a snapshot/Parquet file, raw holdout data, a worker journal/path, a seal/unlock action channel, or generic WFO state."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/split": {
      "get": {
        "operationId": "researchSplitDetailGetV1",
        "summary": "Read immutable current-source split and holdout truth for one run",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/IfNoneMatch" }
        ],
        "responses": {
          "200": { "description": "Current P04 three-window truth or typed source absence", "headers": { "ETag": { "$ref": "#/components/headers/Etag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SplitDetail" } } } },
          "304": { "description": "The exact immutable P14 projection has not changed" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "Etag": { "description": "Quoted immutable P14 projection revision.", "schema": { "type": "string", "pattern": "^\\\"p14r1_[0-9a-f]{64}\\\"$" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 96 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal; no source relation, cursor, worker/path, raw market row, holdout value or credential is disclosed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "Range": { "type": "object", "additionalProperties": false, "required": ["start_utc_ms", "end_exclusive_utc_ms"], "properties": { "start_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "end_exclusive_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" } } },
      "AbsentFact": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_PUBLISHED", "NOT_ASSERTED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Warmup": { "oneOf": [
        { "allOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "object", "additionalProperties": false, "required": ["state", "bars", "data_role", "child_input_state", "availability"], "properties": { "state": { "const": "AVAILABLE" }, "bars": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "data_role": { "const": "WARMUP_NOT_SCORED" }, "child_input_state": { "const": "EXPOSED_TO_CHILD_TAPE" }, "availability": { "$ref": "#/components/schemas/Availability" } } }] },
        { "type": "object", "additionalProperties": false, "required": ["state", "bars", "reason_code", "availability"], "properties": { "state": { "const": "NOT_APPLICABLE" }, "bars": { "const": 0 }, "reason_code": { "const": "P08_WARMUP_NOT_REQUESTED" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
        { "$ref": "#/components/schemas/AbsentFact" }
      ] },
      "IsWindow": { "oneOf": [
        { "allOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "object", "additionalProperties": false, "required": ["bars", "data_role", "child_input_state", "availability"], "properties": { "bars": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "data_role": { "const": "IS_CALIBRATION_HISTORY" }, "child_input_state": { "const": "EXPOSED_TO_CHILD_TAPE" }, "availability": { "$ref": "#/components/schemas/Availability" } } }] },
        { "$ref": "#/components/schemas/AbsentFact" }
      ] },
      "OuterOosWindow": { "oneOf": [
        { "allOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "object", "additionalProperties": false, "required": ["bars", "data_role", "child_input_state", "evaluation_state", "availability"], "properties": { "bars": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "data_role": { "const": "OUTER_OOS_OBSERVATION" }, "child_input_state": { "const": "EXPOSED_TO_CHILD_TAPE" }, "evaluation_state": { "const": "P04_OBSERVED_AFTER_FIXED_PROFILE" }, "availability": { "$ref": "#/components/schemas/Availability" } } }] },
        { "$ref": "#/components/schemas/AbsentFact" }
      ] },
      "HoldoutWindow": { "oneOf": [
        { "allOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "object", "additionalProperties": false, "required": ["bars", "data_role", "child_input_state", "evaluation_state", "result_exposure_state", "snapshot_integrity_state", "physical_io", "source_seal", "unlock", "availability"], "properties": { "bars": { "type": "null" }, "data_role": { "const": "HOLDOUT" }, "child_input_state": { "const": "NOT_EXPOSED_TO_CHILD_TAPE" }, "evaluation_state": { "const": "NOT_EVALUATED" }, "result_exposure_state": { "const": "NOT_EXPOSED" }, "snapshot_integrity_state": { "const": "P08_METADATA_BOUND" }, "physical_io": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "const": "NOT_ATTESTED" }, "reason_code": { "const": "P10_ROW_GROUP_PHYSICAL_IO_BOUNDARY_NOT_PUBLISHED" } } }, "source_seal": { "$ref": "#/components/schemas/AbsentFact" }, "unlock": { "$ref": "#/components/schemas/AbsentFact" }, "availability": { "$ref": "#/components/schemas/Availability" } } }] },
        { "$ref": "#/components/schemas/AbsentFact" }
      ] },
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } },
      "SplitDetail": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "run_id", "revision", "etag", "availability", "readiness", "as_of_utc_ms", "provenance", "timeline", "protocol", "windows", "actions", "source_absences"], "properties": {
        "schema_version": { "const": "research.split-detail.v1" }, "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "revision": { "anyOf": [{ "type": "string", "pattern": "^p14r1_[0-9a-f]{64}$" }, { "type": "null" }] }, "etag": { "anyOf": [{ "type": "string", "pattern": "^\\\"p14r1_[0-9a-f]{64}\\\"$" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" }, "readiness": { "enum": ["COMPLETE", "PARTIAL", "NOT_READY"] }, "as_of_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["source_adapter_id", "engine_version", "input_scope", "source_transform_digest", "requested_spec_digest", "effective_spec_digest", "dataset_binding_digest", "manifest_digest"], "properties": { "source_adapter_id": { "anyOf": [{ "const": "p04.delta-rsi.v1" }, { "type": "null" }] }, "engine_version": { "anyOf": [{ "const": "1.1.1" }, { "type": "null" }] }, "input_scope": { "anyOf": [{ "const": "P08_OPTIONAL_WARMUP_PLUS_IS_OOS_ONLY" }, { "type": "null" }] }, "source_transform_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "requested_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "effective_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "dataset_binding_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "manifest_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] } } },
        "timeline": { "anyOf": [{ "$ref": "#/components/schemas/Range" }, { "type": "null" }] },
        "protocol": { "type": "object", "additionalProperties": false, "required": ["kind", "selection", "fold_plan", "inner_folds", "purge", "embargo", "theta_per_fold", "gap_scan"], "properties": { "kind": { "anyOf": [{ "const": "THREE_WINDOW_CURRENT" }, { "type": "null" }] }, "selection": { "type": "object", "additionalProperties": false, "required": ["state", "parameter_bundle_digest", "strict_outer_oos"], "properties": { "state": { "enum": ["FIXED_PROFILE_NO_SEARCH", "NOT_PUBLISHED"] }, "parameter_bundle_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "strict_outer_oos": { "$ref": "#/components/schemas/AbsentFact" } } }, "fold_plan": { "$ref": "#/components/schemas/AbsentFact" }, "inner_folds": { "$ref": "#/components/schemas/AbsentFact" }, "purge": { "$ref": "#/components/schemas/AbsentFact" }, "embargo": { "$ref": "#/components/schemas/AbsentFact" }, "theta_per_fold": { "$ref": "#/components/schemas/AbsentFact" }, "gap_scan": { "$ref": "#/components/schemas/AbsentFact" } } },
        "windows": { "type": "object", "additionalProperties": false, "required": ["warmup", "is", "outer_oos", "holdout"], "properties": { "warmup": { "$ref": "#/components/schemas/Warmup" }, "is": { "$ref": "#/components/schemas/IsWindow" }, "outer_oos": { "$ref": "#/components/schemas/OuterOosWindow" }, "holdout": { "$ref": "#/components/schemas/HoldoutWindow" } } },
        "actions": { "type": "object", "additionalProperties": false, "required": ["holdout_unlock"], "properties": { "holdout_unlock": { "type": "object", "additionalProperties": false, "required": ["state", "href", "availability"], "properties": { "state": { "const": "NOT_PUBLISHED" }, "href": { "type": "null" }, "availability": { "$ref": "#/components/schemas/Availability" } } } } },
        "source_absences": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/AbsentFact" } }
      } }
    }
  }
}
