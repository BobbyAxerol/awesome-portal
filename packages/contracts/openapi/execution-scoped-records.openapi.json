  "paths": {
    "/api/v1/execution/adapters/{environment}/{capabilityId}": {
      "get": {
        "operationId": "executionScopedAdapterGet",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "parameters": [
          {
            "name": "environment",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "paper",
                "sandbox",
                "live"
              ]
            }
          },
          {
            "name": "capabilityId",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "admin.inspect",
                "admin.performance",
                "admin.broker-read",
                "event.order-lifecycle"
              ]
            }
          }
        ],
        "description": "V2 alternative selected by durable server policy only. Existing legacy compatibility DTO is unchanged. No caller-provided scope, raw relation selector, credentials or global metadata. This document publishes scoped consumers; not a browser opt-in. HTTP private,no-store.",
        "responses": {
          "200": {
            "description": "Scoped response on V2 authority",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScopedAdapterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Typed safe refusal; never a legacy/upstream fallback."
          },
          "401": {
            "description": "Typed safe refusal; never a legacy/upstream fallback."
          },
          "403": {
            "description": "Typed safe refusal; never a legacy/upstream fallback."
          },
