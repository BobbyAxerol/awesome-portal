  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "OrdinaryDelegateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "subject_user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "parent_grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "expected_parent_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "expected_head": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "revision",
              "digest"
            ]
          },
          "valid_from_ms": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "valid_until_ms": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          }
        },
        "required": [
          "operation_id",
          "workspace_id",
          "subject_user_id",
          "parent_grant_id",
          "expected_parent_revision",
          "expected_head",
          "valid_from_ms",
          "valid_until_ms",
          "reason"
        ],
        "x-server-invariants": [
          "ONE_CURRENT_PARENT",
          "EXACT_PROFILE_SEALS",
          "OWNER_CEILING",
          "INTERVAL_SUBSET",
          "CURRENT_STEP_UP",
          "HEAD_REVISION_AND_DIGEST_CAS",
          "NO_ONWARD_DELEGATION"
        ]
      },
      "OrdinaryRevokeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "expected_grant_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "expected_head": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "revision",
              "digest"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          }
        },
        "required": [
          "operation_id",
          "workspace_id",
          "grant_id",
          "expected_grant_revision",
          "expected_head",
          "reason"
        ]
      },
      "OrdinaryAuthorityReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "portal.ordinary-profile-operation.v1"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "operation": {
            "type": "string",
            "enum": [
              "INSTALL",
              "DELEGATE",
              "REVOKE"
            ]
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "head_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "head_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
          },
          "grant_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "const": "APP_APPLIED"
          },
          "decided_at_ms": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "source_qualified": {
            "const": false
          },
          "stream_commissioned": {
            "const": false
          },
          "command_commissioned": {
            "const": false
          }
        },
        "required": [
          "schema_version",
          "operation_id",
          "operation",
          "workspace_id",
          "head_revision",
          "head_digest",
          "grant_id",
          "outcome",
          "decided_at_ms",
          "source_qualified",
          "stream_commissioned",
          "command_commissioned"
        ]
      },
      "OrdinaryStepUpRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "workspace_id",
          "password"
        ]
      },
      "OrdinaryStepUpResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "portal.access-step-up.v1"
          },
          "state": {
            "const": "ACTIVE"
          },
          "family": {
            "const": "ACCESS_ADMIN"
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "schema_version",
          "state",
          "family",
          "expires_at_ms"
        ]
      },
      "OrdinaryAuthorityProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable Portal AuthError/authority refusal code; no secret context."
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
