{
  "openapi": "3.1.0",
  "info": {
    "title": "Execution ordinary profile authority",
    "version": "1.0.0"
  },
  "paths": {
    "/api/admin/ordinary-profile-access/v1/delegations": {
      "post": {
        "operationId": "ordinaryProfileDelegateV1",
        "description": "Only mounted by explicit private composition. Authenticated current session, same-origin CSRF and fresh own-password ACCESS_ADMIN step-up. READ app authority only; not source qualification, HISTORY, STREAM, command or Live. Delegation/revocation operation_id must equal the idempotency header. No root artifact installation over HTTP.",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Portal-Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured Portal origin."
          },
          {
            "name": "X-Portal-CSRF",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must match the csrf cookie and authenticated session hash."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrdinaryDelegateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "App authority receipt or session-only step-up; no upstream acceptance inferred.",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdinaryAuthorityReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid closed request or key",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdinaryAuthorityProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdinaryAuthorityProblem"
                }
              }
            }
          },
          "403": {
            "description": "CSRF, password, current authority or delegation refused",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdinaryAuthorityProblem"
                }
              }
            }
          },
          "404": {
            "description": "Private composition not installed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdinaryAuthorityProblem"
                }
              }
            }
          },
          "409": {
            "description": "CAS/key conflict or current authority changed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdinaryAuthorityProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source-independent authority/drain/capacity unavailable; reconcile same operation",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdinaryAuthorityProblem"
                }
              }
            }
          }
        }
      }
    },
