{
  "openapi": "3.1.0",
  "info": {
    "title": "cost-events",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/cost-events": {
      "get": {
        "operationId": "executionCostEventsGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Fee, funding and interest events of a subject. One currency per event; nothing is summed across currencies; a window total, when asked, is per currency. CONTRACT ONLY: no producer exists yet (Edge/Core inputs are in WP_K_CONTRACTS_2026-10-23.md), so nothing serves this route and every screen keeps its typed absence.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "subject_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "subject_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current answer; absence stays typed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostEvents"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostEventsProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostEventsProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostEventsProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostEventsProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "CostEvents": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms",
          "subject"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.cost-events.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ALPHA",
                  "PORTFOLIO",
                  "ACCOUNT",
                  "DEPLOYMENT",
                  "OPERATION",
                  "INCIDENT",
                  "APPROVAL"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              }
            }
          },
          "events": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id",
                    "kind",
                    "at_ms",
                    "currency",
                    "amount",
                    "order_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "FEE",
                        "FUNDING",
                        "INTEREST"
                      ]
                    },
                    "at_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "currency": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                    },
                    "amount": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
                    },
                    "order_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 191,
                          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "totals": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "currency",
                    "amount"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "FEE",
                        "FUNDING",
                        "INTEREST"
                      ]
                    },
                    "currency": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                    },
                    "amount": {
                      "type": "string",
                      "maxLength": 80,
                      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CostEventsProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
