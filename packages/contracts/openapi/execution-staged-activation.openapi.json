{
  "openapi": "3.1.0",
  "info": {
    "title": "Primus Portal source-dark staged activation API",
    "version": "1.0.0",
    "description": "N13A Portal-owned plan/apply/verify foundation. Promotion is blocked; only fixture rollback can be applied and verified."
  },
  "paths": {
    "/api/v1/execution/activation/capabilities": {
      "get": {
        "operationId": "listActivationCapabilities",
        "parameters": [{ "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "Seven independent source-dark capabilities.",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-staged-activation.v1.schema.json#/$defs/CapabilitiesResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/activation/plans": {
      "post": {
        "operationId": "planStagedActivation",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanRequest" } } } },
        "responses": {
          "201": {
            "description": "Source-dark immutable plan; promotion remains blocked.",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-staged-activation.v1.schema.json#/$defs/PlanResponse" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/activation/plans/{plan_id}": {
      "get": {
        "operationId": "getStagedActivationPlan",
        "parameters": [
          { "name": "plan_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Persisted plan snapshot.", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-staged-activation.v1.schema.json#/$defs/PlanResponse" } } } },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/activation/plans/{plan_id}/apply": {
      "post": {
        "operationId": "applyStagedActivationPlan",
        "parameters": [{ "name": "plan_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransitionRequest" } } } },
        "responses": {
          "202": { "description": "Fixture rollback durably applied; response is not a source activation.", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-staged-activation.v1.schema.json#/$defs/PlanResponse" } } } },
          "409": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/activation/plans/{plan_id}/verify": {
      "post": {
        "operationId": "verifyStagedActivationPlan",
        "parameters": [{ "name": "plan_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TransitionRequest" } } } },
        "responses": {
          "201": { "description": "Persisted source-dark rollback verified.", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-staged-activation.v1.schema.json#/$defs/PlanResponse" } } } },
          "409": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "PlanRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "workspace_id", "request_key", "capability_key", "action", "target_profile", "expected_capability_version", "compatibility_requirements", "evidence_refs", "reason"],
        "properties": {
          "schema_version": { "const": "execution.staged-activation-plan-request.v1" },
          "workspace_id": { "type": "string" },
          "request_key": { "type": "string" },
          "capability_key": { "enum": ["PROJECTION", "QUERY", "SSE", "COMMAND_R1", "COMMAND_R2", "COMMAND_R3", "COMMAND_R4"] },
          "action": { "enum": ["PROMOTE", "ROLLBACK"] },
          "target_profile": { "enum": ["fixture", "shadow", "paper", "sandbox", "live_canary", "live_full"] },
          "expected_capability_version": { "type": "integer", "minimum": 1 },
          "compatibility_requirements": { "type": "array", "maxItems": 16, "items": { "type": "object" } },
          "evidence_refs": { "type": "array", "maxItems": 16, "items": { "type": "object" } },
          "reason": { "type": "string", "minLength": 8, "maxLength": 2000 }
        }
      },
      "TransitionRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "workspace_id", "request_key", "expected_plan_version", "expected_capability_version"],
        "properties": {
          "schema_version": { "enum": ["execution.staged-activation-apply-request.v1", "execution.staged-activation-verify-request.v1"] },
          "workspace_id": { "type": "string" },
          "request_key": { "type": "string" },
          "expected_plan_version": { "type": "integer", "minimum": 1 },
          "expected_capability_version": { "type": "integer", "minimum": 1 }
        }
      },
      "Problem": { "type": "object", "additionalProperties": true, "required": ["type", "title", "status"], "properties": { "type": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "integer" }, "code": { "type": "string" } } }
    },
    "responses": {
      "Problem": { "description": "Typed fail-closed problem.", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    }
  }
}
