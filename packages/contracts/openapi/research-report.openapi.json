{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Report API",
    "version": "1.0.0",
    "description": "P18 same-origin immutable Research report and bounded reproducible JSON/CSV export. Report assembly reads only sealed P13--P17 Portal projections; no operation starts QuantBT, reads a worker/artifact path, opens a source data store, or exposes source cursors/credentials. Approval annotation is intentionally outside the frozen core."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/report": {
      "get": {
        "operationId": "researchReportDetailGetV1",
        "summary": "Read the latest sealed immutable report core for a run",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/IfNoneMatch" }],
        "responses": {
          "200": { "description": "Sealed Report with a private ETag.", "headers": { "ETag": { "$ref": "#/components/headers/ReportEtag" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportDetail" } } } },
          "304": { "description": "Exact immutable report revision remains current." },
          "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/quantbt/runs/{runId}/report/exports": {
      "post": {
        "operationId": "researchReportExportCreateV1",
        "summary": "Create or return one durable bounded export job for the caller",
        "description": "Requires same-origin CSRF/origin checks. A request persists a JSON/CSV transform job only; it does not rerun an engine or touch a source/artifact filesystem.",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/WorkspaceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportCreate" } } } },
        "responses": { "202": { "description": "Durable queued/running/ready export job.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportJob" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quantbt/runs/{runId}/report/exports/{jobId}": {
      "get": {
        "operationId": "researchReportExportStatusGetV1",
        "summary": "Read the caller-owned export job status",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/JobId" }, { "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": { "200": { "description": "Bounded job status; download link exists only at READY.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportJob" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/api/v1/quantbt/runs/{runId}/report/exports/{jobId}/download": {
      "get": {
        "operationId": "researchReportExportDownloadGetV1",
        "summary": "Download one caller-owned completed bounded export",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }, { "$ref": "#/components/parameters/JobId" }, { "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": { "200": { "description": "Authenticated JSON or CSV attachment; max 512 KiB and generated filename only.", "headers": { "Content-Disposition": { "schema": { "type": "string" } }, "X-Content-Type-Options": { "schema": { "const": "nosniff" } } }, "content": { "application/json": { "schema": { "type": "object" } }, "text/csv": { "schema": { "type": "string" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "ReportEtag": { "description": "Quoted immutable P18 report revision.", "schema": { "type": "string", "pattern": "^\\\"p18r1_[0-9a-f]{64}\\\"$" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "JobId": { "name": "jobId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/JobId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 96 } }
    },
    "responses": { "Problem": { "description": "Typed same-origin refusal. No source relation, cursor, worker/artifact path, source credentials or compute authority is disclosed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } } },
    "schemas": {
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "JobId": { "type": "string", "pattern": "^rpex_[0-9A-HJKMNP-TV-Z]{26}$" },
      "Revision": { "type": "string", "pattern": "^p18r1_[0-9a-f]{64}$" },
      "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ExactDecimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$", "maxLength": 96 },
      "ReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "ReportFact": { "type": "object", "additionalProperties": false, "required": ["state", "text", "reason_code", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "NOT_ASSERTED", "NOT_APPLICABLE"] }, "text": { "anyOf": [{ "type": "string", "maxLength": 1024 }, { "type": "null" }] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "IdentityField": { "type": "object", "additionalProperties": false, "required": ["key", "label", "value", "availability"], "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "value": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Metric": { "type": "object", "additionalProperties": false, "required": ["key", "label", "unit", "scope", "origin", "definition_id", "value", "availability"], "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "unit": { "enum": ["CURRENCY", "FRACTION", "COUNT"] }, "scope": { "enum": ["OOS", "IS_PLUS_OOS", "CHILD_TAPE", "NOT_PUBLISHED"] }, "origin": { "enum": ["ENGINE_DIRECT", "SOURCE_DERIVED", "NOT_PUBLISHED"] }, "definition_id": { "type": "string" }, "value": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Headline": { "type": "object", "additionalProperties": false, "required": ["key", "label", "value", "availability"], "properties": { "key": { "enum": ["OOS_SHARPE", "DECAY_MEAN", "MAX_DRAWDOWN", "TRADES", "WIN_RATE", "FUNDING"] }, "label": { "type": "string" }, "value": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Equity": { "type": "object", "additionalProperties": false, "required": ["state", "source_observation_count", "emitted_point_count", "sampling", "points", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "source_observation_count": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }, "emitted_point_count": { "type": "integer", "minimum": 0, "maximum": 600 }, "sampling": { "anyOf": [{ "enum": ["FULL", "EXTREMA_BUCKET_V1"] }, { "type": "null" }] }, "points": { "type": "array", "maxItems": 600, "items": { "type": "object", "additionalProperties": false, "required": ["at_utc_ms", "equity", "drawdown_fraction"], "properties": { "at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "equity": { "$ref": "#/components/schemas/ExactDecimal" }, "drawdown_fraction": { "$ref": "#/components/schemas/ExactDecimal" } } } }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "FoldRow": { "type": "object", "additionalProperties": false, "required": ["fold_id", "start_utc_ms", "end_exclusive_utc_ms", "verdict"], "properties": { "fold_id": { "type": "string", "maxLength": 128 }, "start_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "end_exclusive_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "verdict": { "enum": ["PASS", "WARN", "DRAG"] } } },
      "Folds": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "rows", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "rows": { "type": "array", "maxItems": 256, "items": { "$ref": "#/components/schemas/FoldRow" } }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Stage": { "type": "object", "additionalProperties": false, "required": ["key", "state", "started_at_utc_ms", "completed_at_utc_ms"], "properties": { "key": { "enum": ["S1", "S2", "S3", "S4", "S5"] }, "state": { "enum": ["PENDING", "RUNNING", "DONE"] }, "started_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] }, "completed_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] } } },
      "Artifact": { "type": "object", "additionalProperties": false, "required": ["key", "digest", "state", "availability"], "properties": { "key": { "enum": ["RUN_SPEC", "SELECTION_TRACE", "FOLD_PLAN", "FILL_LEDGER", "METRICS_SUMMARY", "CLAIM", "BUNDLE"] }, "digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "state": { "enum": ["SEALED", "NOT_PUBLISHED", "NOT_APPLICABLE", "ABORTED"] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Warning": { "type": "object", "additionalProperties": false, "required": ["definition_id", "state", "reason_code", "copy"], "properties": { "definition_id": { "type": "string" }, "state": { "enum": ["ACTIVE", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "copy": { "type": "string", "maxLength": 512 } } },
      "Promotion": { "type": "object", "additionalProperties": false, "required": ["state", "line", "availability"], "properties": { "state": { "const": "NOT_PUBLISHED" }, "line": { "type": "string", "maxLength": 512 }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Provenance": { "type": "object", "additionalProperties": false, "required": ["line", "metric_registry_version", "data_signature", "read_model_revision", "verdict_rule_revision"], "properties": { "line": { "type": "string", "maxLength": 1024 }, "metric_registry_version": { "enum": ["research.metric-registry.v1", "research.metric-registry.v2"] }, "data_signature": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "read_model_revision": { "const": "research.report-read-model.v1" }, "verdict_rule_revision": { "const": "research.report-verdict-rule.v1" } } },
      "UnavailableExportFormat": { "type": "object", "additionalProperties": false, "required": ["format", "reason_code"], "properties": { "format": { "enum": ["PARQUET", "ARCHIVE"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" } } },
      "ExportCapabilities": { "type": "object", "additionalProperties": false, "required": ["formats", "maximum_bytes", "unavailable_formats"], "properties": { "formats": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": ["REPORT_JSON", "REPORT_CSV"] } }, "maximum_bytes": { "type": "integer", "minimum": 16384, "maximum": 524288 }, "unavailable_formats": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/components/schemas/UnavailableExportFormat" } } } },
      "FrozenCore": { "type": "object", "additionalProperties": false, "required": ["schema_version", "report_source", "source_revisions", "source_digests", "passport", "identity", "metrics", "headline", "headline_footnote", "equity", "folds", "stages", "artifacts", "warnings", "promotion", "provenance", "source_absences"], "properties": {
        "schema_version": { "const": "research.report-frozen-core.v1" }, "report_source": { "const": "P13_P17_FIXED_PROFILE" },
        "source_revisions": { "type": "object", "additionalProperties": false, "required": ["evidence_revision", "split_revision", "search_revision", "freeze_revision", "replay_revision"], "properties": { "evidence_revision": { "type": "string" }, "split_revision": { "type": "string" }, "search_revision": { "type": "string" }, "freeze_revision": { "type": "string" }, "replay_revision": { "type": "string" } } },
        "source_digests": { "type": "object", "additionalProperties": false, "required": ["source_transform_digest", "requested_spec_digest", "effective_spec_digest", "dataset_binding_digest", "manifest_digest"], "properties": { "source_transform_digest": { "$ref": "#/components/schemas/Digest" }, "requested_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "effective_spec_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "dataset_binding_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "manifest_digest": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] } } },
        "passport": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/components/schemas/ReportFact" } }, "identity": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/components/schemas/IdentityField" } }, "metrics": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/components/schemas/Metric" } }, "headline": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/components/schemas/Headline" } }, "headline_footnote": { "type": "string" }, "equity": { "$ref": "#/components/schemas/Equity" },
        "folds": { "$ref": "#/components/schemas/Folds" }, "stages": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/components/schemas/Stage" } }, "artifacts": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/components/schemas/Artifact" } }, "warnings": { "type": "array", "maxItems": 8, "items": { "$ref": "#/components/schemas/Warning" } }, "promotion": { "$ref": "#/components/schemas/Promotion" }, "provenance": { "$ref": "#/components/schemas/Provenance" }, "source_absences": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/ReportFact" } }
      } },
      "Annotation": { "type": "object", "additionalProperties": false, "required": ["state", "text", "source_updated_at_utc_ms", "availability"], "properties": { "state": { "enum": ["NOT_PUBLISHED", "AVAILABLE"] }, "text": { "anyOf": [{ "type": "string", "maxLength": 2048 }, { "type": "null" }] }, "source_updated_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "ReportDetail": { "type": "object", "additionalProperties": false, "required": ["schema_version", "read_authority", "run_id", "report_revision", "etag", "sealed_at_utc_ms", "presentation_revision", "frozen_core", "approval_annotation", "exports"], "properties": { "schema_version": { "const": "research.report-detail.v1" }, "read_authority": { "const": "PORTAL_PERSISTED_RESEARCH" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "report_revision": { "$ref": "#/components/schemas/Revision" }, "etag": { "type": "string" }, "sealed_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "presentation_revision": { "const": "research.report-presentation.v1" }, "frozen_core": { "$ref": "#/components/schemas/FrozenCore" }, "approval_annotation": { "$ref": "#/components/schemas/Annotation" }, "exports": { "$ref": "#/components/schemas/ExportCapabilities" } } },
      "ExportCreate": { "type": "object", "additionalProperties": false, "required": ["format"], "properties": { "format": { "enum": ["REPORT_JSON", "REPORT_CSV"] } } },
      "ExportJob": { "type": "object", "additionalProperties": false, "required": ["schema_version", "job_id", "run_id", "report_revision", "format", "state", "requested_at_utc_ms", "completed_at_utc_ms", "size_bytes", "sha256", "content_type", "filename", "download_href", "failure_code"], "properties": { "schema_version": { "const": "research.report-export.v1" }, "job_id": { "$ref": "#/components/schemas/JobId" }, "run_id": { "$ref": "#/components/schemas/RunId" }, "report_revision": { "$ref": "#/components/schemas/Revision" }, "format": { "enum": ["REPORT_JSON", "REPORT_CSV"] }, "state": { "enum": ["QUEUED", "RUNNING", "READY", "FAILED"] }, "requested_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "completed_at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] }, "size_bytes": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 524288 }, { "type": "null" }] }, "sha256": { "anyOf": [{ "$ref": "#/components/schemas/Digest" }, { "type": "null" }] }, "content_type": { "anyOf": [{ "enum": ["application/json", "text/csv"] }, { "type": "null" }] }, "filename": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "download_href": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "failure_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } }
    }
  }
}
