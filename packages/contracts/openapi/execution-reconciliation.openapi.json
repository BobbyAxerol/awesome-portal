{
  "openapi": "3.1.0",
  "info": {
    "title": "reconciliation",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/reconciliation": {
      "get": {
        "operationId": "executionReconciliationGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Reconciliation runs and the breaks they found for a subject, so the Reconciliation tab, the stage chips and the Account 360 triad stop counting rows. Source-dark route: no positive producer is commissioned; the route refuses instead of inventing data.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "subject_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "subject_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current answer; absence stays typed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reconciliation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationProblem"
                }
              }
            }
          },
          "403": {
            "description": "Profile not commissioned",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationProblem"
                }
              }
            }
          },
          "409": {
            "description": "Authority or source changed before dispatch",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "Reconciliation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms",
          "subject"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.reconciliation.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ALPHA",
                  "PORTFOLIO",
                  "ACCOUNT",
                  "DEPLOYMENT",
                  "OPERATION",
                  "INCIDENT",
                  "APPROVAL"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 191,
                "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
              }
            }
          },
          "runs": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run_id",
                    "state",
                    "started_at_ms",
                    "finished_at_ms",
                    "breaks_open"
                  ],
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "RUNNING",
                        "MATCHED",
                        "BREAKS_FOUND",
                        "FAILED"
                      ]
                    },
                    "started_at_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "finished_at_ms": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "breaks_open": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "breaks": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "break_id",
                    "run_id",
                    "state",
                    "kind",
                    "resolution_revision",
                    "detected_at_ms"
                  ],
                  "properties": {
                    "break_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "OPEN",
                        "RESOLVING",
                        "RESOLVED"
                      ]
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "POSITION",
                        "BALANCE",
                        "ORDER",
                        "FILL"
                      ]
                    },
                    "resolution_revision": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "detected_at_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ReconciliationProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID",
                  "SESSION_REQUIRED",
                  "REQUEST_REJECTED",
                  "PORTAL_AUTHORITY_UNAVAILABLE",
                  "PORTAL_READ_STORE_UNAVAILABLE",
                  "EXECUTION_LOCAL_READ_BUSY",
                  "EXECUTION_READ_SCOPE_REQUIRED",
                  "EXECUTION_READ_ACCESS_CHANGED",
                  "EXECUTION_READ_CURRENT_ONLY",
                  "EXECUTION_READ_POLICY_PENDING",
                  "EXECUTION_READ_PUBLICATION_NOT_QUALIFIED",
                  "EXECUTION_READ_FIELD_POLICY_PENDING",
                  "EXECUTION_READ_SCOPE_LIMIT",
                  "EXECUTION_READ_AUTHORITY_UNAVAILABLE",
                  "EXECUTION_READ_CURSOR_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
