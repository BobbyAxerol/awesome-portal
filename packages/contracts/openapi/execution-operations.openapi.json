{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Execution Operations API",
    "version": "0.4.0-f1b-incident-detail",
    "description": "EX-BE-05b/F1b: F0/F1a plus a Portal-owned Incident Detail workflow. Incident mutations are source-dark, evidence-gated, audited and never relay to the Trading System or resume a deployment."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/execution/commands/catalog": {
      "get": {
        "operationId": "executionCommandCatalog",
        "description": "ADMIN-only catalogue evaluated for one Portal workspace/environment/entity scope. Capability remains disabled and freshness unavailable in F0.",
        "parameters": [
          { "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string", "minLength": 3, "maxLength": 96 } },
          { "name": "environment", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PAPER", "SANDBOX", "LIVE"], "default": "PAPER" } },
          { "name": "target_type", "in": "query", "required": false, "description": "Must be supplied together with target_id.", "schema": { "type": "string", "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] } },
          { "name": "target_id", "in": "query", "required": false, "description": "Must be supplied together with target_type.", "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,191}$" } },
          { "name": "risk_tier", "in": "query", "required": false, "schema": { "type": "string", "enum": ["R0_READ", "R1_PAPER_MUTATION", "R2_SANDBOX", "R3_LIVE_PROTECTIVE", "R4_LIVE_RISK_INCREASING", "UNCLASSIFIED", "BLOCKED"] } }
        ],
        "responses": {
          "200": {
            "description": "Canonical 64-action catalogue; F0 entries are all unreachable",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/CommandCatalogue" } } }
          },
          "403": { "description": "ADMIN_ROLE_REQUIRED" },
          "404": { "description": "WORKSPACE_NOT_FOUND" }
        }
      }
    },
    "/api/v1/execution/commands/plans": {
      "post": {
        "operationId": "planExecutionCommandF0",
        "description": "Creates an immutable blocked plan. Conditions require nonblank text/owner and expiry on or after deadline. Payloads have bounded shape, reject sensitive credential keys and are persisted as hash-only. F0 never issues an apply token.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandPlanRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Blocked immutable plan",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandPlan" } } }
          }
        }
      }
    },
    "/api/v1/execution/operations": {
      "get": {
        "operationId": "listExecutionOperationsQueue",
        "description": "ADMIN-only Portal-owned queue with exact counts and opaque bidirectional keysets. Source integration remains unavailable in F1a.",
        "parameters": [
          { "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string", "minLength": 3, "maxLength": 96 } },
          { "name": "after", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 4096 } },
          { "name": "before", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 4096 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 250 } },
          { "name": "triage_state", "in": "query", "required": false, "schema": { "type": "string", "enum": ["UNACKNOWLEDGED", "ACKNOWLEDGED", "RESOLVED"] } },
          { "name": "environment", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PAPER", "SANDBOX", "LIVE"] } },
          { "name": "source_status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["BLOCKED", "PENDING", "RUNNING", "SUCCEEDED", "FAILED", "EXPIRED", "UNCERTAIN"] } },
          { "name": "verification_result", "in": "query", "required": false, "schema": { "type": "string", "enum": ["NOT_STARTED", "PENDING", "SUCCEEDED", "FAILED", "PARTIAL", "UNCERTAIN", "DENIED", "EXPIRED"] } },
          { "name": "severity", "in": "query", "required": false, "schema": { "type": "string", "enum": ["INFO", "WARNING", "ERROR", "CRITICAL"] } },
          { "name": "target_type", "in": "query", "required": false, "schema": { "type": "string", "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] } },
          { "name": "command_key", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["created_at:asc", "created_at:desc"], "default": "created_at:desc" } }
        ],
        "responses": {
          "200": { "description": "Bounded Portal operations queue", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationQueueResponse" } } } },
          "403": { "description": "ADMIN or query policy required" }
        }
      }
    },
    "/api/v1/execution/operations/{operation_id}": {
      "get": {
        "operationId": "getExecutionCommandOperationF0",
        "parameters": [
          { "name": "operation_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Blocked operation with no relay receipt",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandOperation" } } }
          }
        }
      }
    },
    "/api/v1/execution/operations/{operation_id}/acknowledge": {
      "post": {
        "operationId": "acknowledgeExecutionOperation",
        "description": "ADMIN-only Portal sidecar workflow mutation; never changes source status or requests a source side effect.",
        "parameters": [{ "name": "operation_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationAcknowledgeRequest" } } } },
        "responses": { "201": { "description": "Acknowledged or idempotently replayed", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/{operation_id}/resolve": {
      "post": {
        "operationId": "resolveExecutionOperation",
        "description": "ADMIN-only resolution after acknowledgement with evidence hash; never changes source status or requests a source side effect.",
        "parameters": [{ "name": "operation_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationResolveRequest" } } } },
        "responses": { "201": { "description": "Resolved or idempotently replayed", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents": {
      "post": {
        "operationId": "createExecutionIncident",
        "description": "ADMIN-only Portal incident creation with optional same-workspace operation correlation. No source fact or side effect is inferred.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentCreateRequest" } } } },
        "responses": { "201": { "description": "Created or idempotently replayed Portal incident", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}": {
      "get": {
        "operationId": "getExecutionIncidentDetail",
        "description": "ADMIN-only bounded incident detail. Findings, alerts, dead letters and trace-order panels remain explicitly unavailable.",
        "parameters": [
          { "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string", "minLength": 3, "maxLength": 96 } }
        ],
        "responses": { "200": { "description": "Portal-owned incident detail", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentDetail" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}/acknowledge": {
      "post": {
        "operationId": "acknowledgeExecutionIncident",
        "parameters": [{ "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentAcknowledgeRequest" } } } },
        "responses": { "201": { "description": "Acknowledged incident", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}/assign": {
      "post": {
        "operationId": "assignExecutionIncident",
        "parameters": [{ "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentAssignRequest" } } } },
        "responses": { "201": { "description": "Assigned incident", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}/annotations": {
      "post": {
        "operationId": "annotateExecutionIncident",
        "description": "Appends a bounded workspace note after credential-like content rejection.",
        "parameters": [{ "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentAnnotateRequest" } } } },
        "responses": { "201": { "description": "Annotated incident", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}/evidence": {
      "post": {
        "operationId": "attachExecutionIncidentEvidence",
        "description": "Appends hash-only evidence metadata. Declared EXECUTION/BROKER authority remains unverified while source integration is unavailable.",
        "parameters": [{ "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentEvidenceRequest" } } } },
        "responses": { "201": { "description": "Attached incident evidence reference", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}/operations": {
      "post": {
        "operationId": "correlateExecutionIncidentOperation",
        "description": "Links one existing operation from the same workspace without changing either source result.",
        "parameters": [{ "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentCorrelateOperationRequest" } } } },
        "responses": { "201": { "description": "Correlated incident operation", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}/mitigate": {
      "post": {
        "operationId": "mitigateExecutionIncident",
        "description": "Moves the Portal workflow OPEN to MITIGATED only after acknowledgement, assignment and a stored mitigation-attestation hash. No source side effect is requested.",
        "parameters": [{ "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentMitigateRequest" } } } },
        "responses": { "201": { "description": "Mitigated incident workflow", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/incidents/{incident_id}/resolve": {
      "post": {
        "operationId": "resolveExecutionIncident",
        "description": "Moves MITIGATED to RESOLVED only with a stored clean-dry-run hash and bounded reason. Resolution never resumes a deployment.",
        "parameters": [{ "name": "incident_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentResolveRequest" } } } },
        "responses": { "201": { "description": "Resolved incident workflow", "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/IncidentWorkflowResponse" } } } } }
      }
    },
    "/api/v1/execution/operations/{operation_id}/apply": {
      "post": {
        "operationId": "applyExecutionCommandF0",
        "description": "Always denied in F0 before any relay/source call.",
        "parameters": [{ "name": "operation_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandApplyRequest" } } }
        },
        "responses": { "409": { "description": "COMMAND_RELAY_DISABLED" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" }
    }
  }
}
