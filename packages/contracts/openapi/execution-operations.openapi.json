{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Execution Operations API",
    "version": "0.6.0-phase2-controlled-commands",
    "description": "Phase 2 controlled command plane: four bounded R0 tasks read the SGP projection; every mutation remains governed, hash-only and fail-closed unless an exact owner capability is published."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/execution/operations/f0": {
      "get": {
        "operationId": "executionF0BlockedOperationsListV2",
        "description": "Explicit F0 blocked intents ONLY, not the mixed operation queue. Current exact TS-accepted audit.read is required BEFORE the five-predicate SQL census and again after the last await for success and contextual errors. Full DENY and delegation graph remains effective. Creator is an additional disclosure ceiling, not permission; no ADMIN/read_all bypass, source call, mutation or historical planning-expiry filter. Cursor binds actor/session, exact query/current authority and visible own intents; hidden other-creator/target/environment rows never influence it. Keyset tokens are signed, not encrypted; no private actor/session bytes are embedded in their boundary.",
        "x-strict-query-keys": [
          "workspace_id",
          "resource_kind",
          "resource_id",
          "environment",
          "limit",
          "after"
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 96
            }
          },
          {
            "name": "resource_kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ACCOUNT",
                "PORTFOLIO",
                "DEPLOYMENT"
              ]
            }
          },
          {
            "name": "resource_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,191}$"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "paper",
                "sandbox",
                "live"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact current audit authority and creator ceiling; complete bounded F0-only cohort.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/F0CommandCollection"
                }
              }
            }
          },
          "400": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "COMMAND_INPUT_INVALID or COMMAND_COLLECTION_CURSOR_INVALID; strict scalar query or invalid/expired cursor."
          },
          "401": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "Current authenticated Portal session required."
          },
          "403": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "CURRENT_ACTOR_AUTHORITY_REQUIRED; no page or cursor disclosed after current session expiry."
          },
          "404": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "COMMAND_RESOURCE_NOT_FOUND; unauthorized and unknown scopes have one safe envelope."
          },
          "409": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "ACCESS_RETRY_REQUIRED or COMMAND_COLLECTION_CURSOR_CHANGED; refresh instead of falling back."
          },
          "503": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "Fixed COMMAND_COLLECTION_OVERFLOW/RESPONSE_BOUND/NOT_CONFIGURED, COMMAND_STATUS_UNVERIFIED or COMMAND_UNAVAILABLE. No false empty, silent truncation or raw provider text."
          }
        }
      }
    },
    "/api/v1/execution/operations/f0/{operation_id}": {
      "get": {
        "operationId": "executionF0BlockedOperationGetV2",
        "description": "Explicit F0 family only; creator is an extra lookup ceiling, not permission. Requires current TS-accepted audit.read for the exact original ACCOUNT/PORTFOLIO/DEPLOYMENT target and paper/sandbox/live environment. No owner/ADMIN/read_all override, target-kind alias, generic-family fallback, source call or mutation. Original planning expiry does not expire historical read. Private no-store with final current Core/receipt fence.",
        "x-strict-query-keys": [
          "workspace_id"
        ],
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,191}$"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 96
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current exact audit authority; finite retained BLOCKED intent only.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/F0BlockedOperationRead"
                }
              }
            }
          },
          "400": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "COMMAND_INPUT_INVALID: explicit workspace and one compatible opaque operation id required; no extra or duplicate query keys."
          },
          "401": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "Authenticated current Portal session required."
          },
          "403": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "Current actor/session lifecycle refused; no record disclosed."
          },
          "404": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "COMMAND_RESOURCE_NOT_FOUND: unknown, other creator/workspace/family, unsupported target and hidden intents have the same safe envelope."
          },
          "409": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "ACCESS_RETRY_REQUIRED: current authority changed during read; no legacy or family fallback."
          },
          "503": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            },
            "description": "Fixed COMMAND_STATUS_UNVERIFIED or COMMAND_UNAVAILABLE; no raw stored/provider/validation text."
          }
        }
      }
    },
    "/api/v1/execution/commands/catalog": {
      "get": {
        "operationId": "executionCommandCatalog",
        "description": "ADMIN-only catalogue evaluated for one Portal workspace/environment/entity scope. Capability remains disabled and freshness unavailable in F0.",
        "parameters": [
          { "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string", "minLength": 3, "maxLength": 96 } },
          { "name": "environment", "in": "query", "required": false, "schema": { "type": "string", "enum": ["PAPER", "SANDBOX", "LIVE"], "default": "PAPER" } },
          { "name": "target_type", "in": "query", "required": false, "description": "Must be supplied together with target_id.", "schema": { "type": "string", "enum": ["ACCOUNT", "BROKER_BINDING", "DEPLOYMENT", "ORDER", "PORTFOLIO", "SYSTEM"] } },
          { "name": "target_id", "in": "query", "required": false, "description": "Must be supplied together with target_type.", "schema": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,191}$" } },
          { "name": "risk_tier", "in": "query", "required": false, "schema": { "type": "string", "enum": ["R0_READ", "R1_PAPER_MUTATION", "R2_SANDBOX", "R3_LIVE_PROTECTIVE", "R4_LIVE_RISK_INCREASING", "UNCLASSIFIED", "BLOCKED"] } }
        ],
        "responses": {
          "200": {
            "description": "Canonical 64-action catalogue; F0 entries are all unreachable",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/CommandCatalogue" } } }
          },
          "403": { "description": "ADMIN_ROLE_REQUIRED" },
          "404": { "description": "WORKSPACE_NOT_FOUND" }
        }
      }
    },
    "/api/v1/execution/commands/tasks": {
      "get": {
        "operationId": "executionOperatorTaskCatalogue",
        "description": "ADMIN-only exact 24-task Drawer catalogue. Four R0 tasks may be connected to the SGP-local projection; source mutation transport remains disabled.",
        "parameters": [
          { "name": "workspace_id", "in": "query", "required": false, "schema": { "type": "string", "minLength": 3, "maxLength": 96 } }
        ],
        "responses": {
          "200": {
            "description": "Typed task catalogue with current connection state and bounded forms",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-command-tasks.v1.schema.json" } } }
          },
          "403": { "description": "ADMIN_ROLE_REQUIRED" },
          "404": { "description": "WORKSPACE_NOT_FOUND" }
        }
      }
    },
    "/api/v1/execution/commands/tasks/{task_id}/run": {
      "post": {
        "operationId": "runExecutionOperatorReadTask",
        "description": "Runs only a typed R0 task after session/workspace/ADMIN checks. Connected reads use the SGP-local projection, return bounded typed output and store a hash-only audit record without AWS-HK dispatch.",
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-command-tasks.v1.schema.json#/$defs/RunRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Bounded local projection result; source_request_sent=false",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-command-tasks.v1.schema.json#/$defs/RunResult" } } }
          },
          "409": { "description": "SUPPORTED_BUT_INACTIVE; source_request_sent=false" },
          "422": { "description": "SEMANTICALLY_INCOMPATIBLE; source_request_sent=false" }
        }
      }
    },
    "/api/v1/execution/commands/tasks/{task_id}/plan": {
      "post": {
        "operationId": "planExecutionOperatorMutationTask",
        "description": "Creates the existing immutable hash-only governed plan after enforcing the task parameter allowlist and bounded reason. Source apply remains disabled.",
        "parameters": [
          { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-command-tasks.v1.schema.json#/$defs/PlanRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Blocked hash-only plan with no source dispatch",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandPlan" } } }
          }
        }
      }
    },
    "/api/v1/execution/commands/plans": {
      "post": {
        "operationId": "planExecutionCommandF0",
        "description": "Creates an immutable blocked plan. Conditions require nonblank text/owner and expiry on or after deadline. Payloads have bounded shape, reject sensitive credential keys and are persisted as hash-only. F0 never issues an apply token.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandPlanRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Blocked immutable plan",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandPlan" } } }
          }
        }
      }
    },
    "/api/v1/execution/operations": {
      "get": {
        "operationId": "listExecutionOperationsQueue",
        "description": "Sticky current Core mode is selected before strict parsing. Legacy v1 remains separate. V2 requires complete current TS-accepted audit tuples ACCOUNT/PORTFOLIO/DEPLOYMENT per environment BEFORE SQL counts/page; USER/ADMIN are not grants. Source journal unavailable, no mutation. assigned_to is unsupported in V2 (400), not ignored. Existing limit1..250 and both cursor directions preserved; optional target_id narrows the query.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 96
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250
            }
          },
          {
            "name": "triage_state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "UNACKNOWLEDGED",
                "ACKNOWLEDGED",
                "RESOLVED"
              ]
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PAPER",
                "SANDBOX",
                "LIVE"
              ]
            }
          },
          {
            "name": "source_status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "BLOCKED",
                "PENDING",
                "RUNNING",
                "SUCCEEDED",
                "FAILED",
                "EXPIRED",
                "UNCERTAIN"
              ]
            }
          },
          {
            "name": "verification_result",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "NOT_STARTED",
                "PENDING",
                "SUCCEEDED",
                "FAILED",
                "PARTIAL",
                "UNCERTAIN",
                "DENIED",
                "EXPIRED"
              ]
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "INFO",
                "WARNING",
                "ERROR",
                "CRITICAL"
              ]
            }
          },
          {
            "name": "target_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACCOUNT",
                "BROKER_BINDING",
                "DEPLOYMENT",
                "ORDER",
                "PORTFOLIO",
                "SYSTEM"
              ]
            }
          },
          {
            "name": "command_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "created_at:asc",
                "created_at:desc"
              ],
              "default": "created_at:desc"
            }
          },
          {
            "name": "target_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,191}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Legacy Portal queue OR finite current-audit V2 cohort, never a global/source completeness claim.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationQueueResponse"
                    },
                    {
                      "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationalQueueV2"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Strict input/cursor invalid or unsupported assigned_to filter; contextual refusal fenced after current authority.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "401": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Authenticated current Portal session/authority required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "403": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Authenticated current Portal session/authority required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "404": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Uniform missing/hidden operational record or no usable current audit authority.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "409": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Current authority/cursor/incident root changed; refresh without legacy fallback.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          },
          "503": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "description": "Fixed unqualified/not-configured/integrity/byte/census unavailable; never raw provider/SQL/prose or false empty.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/execution/operations/{operation_id}": {
      "get": {
        "operationId": "getExecutionCommandOperationF0",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized concrete operation; finite workflow and selected R2/Paper plan variants are additive, not source receipts.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/ExecutionCommandOperation"
                    },
                    {
                      "$ref": "../schemas/execution-governance-portal-decisions.v1.schema.json#/$defs/R1DecisionOperation"
                    },
                    {
                      "$ref": "../schemas/execution-governance-portal-decisions.v1.schema.json#/$defs/R2DecisionOperation"
                    },
                    {
                      "$ref": "../schemas/execution-governance-portal-decisions.v1.schema.json#/$defs/LiveDecisionOperation"
                    },
                    {
                      "$ref": "../schemas/execution-governance-paper-exit.v1.schema.json#/$defs/PaperExitDecisionOperation"
                    },
                    {
                      "$ref": "execution-trusted-commands.openapi.json#/components/schemas/CommandStatus"
                    },
                    {
                      "$ref": "../schemas/execution-operations.v1.schema.json#/$defs/OperationalWorkflowV2"
