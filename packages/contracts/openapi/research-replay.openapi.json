{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Research Replay API",
    "version": "1.0.0",
    "description": "P17 same-origin, read-only route-aware replay BFF. The installed P04 Delta source publishes only a sealed bounded OOS equity sample series. It does not publish execution orders, fills, trades, positions, event streams, per-bar candle windows, OCO/leg/funding facts, MAE/MFE inputs or execution state snapshots. E16-R1 adds one bounded whole-window OHLC overview that the confined child retains while it still holds the tape: a downsample with true bucket extrema, not a bar ledger and never a backfill of a run whose tape is gone. The API preserves those absences rather than synthesizing a ledger or starting QuantBT when a user seeks."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/quantbt/runs/{runId}/execute/replay": {
      "get": {
        "operationId": "researchReplayDetailGetV1",
        "summary": "Read one bounded immutable route-aware retrospective replay window",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Before" },
          { "$ref": "#/components/parameters/At" },
          { "$ref": "#/components/parameters/AtOrdinal" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "description": "Bounded current-source equity samples and route-specific typed source absences. Cache-Control is private, no-store because navigation cursors expire.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Replay" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" } },
    "headers": { "Etag": { "description": "Quoted immutable P17 replay revision.", "schema": { "type": "string", "pattern": "^\\\"p17r1_[0-9a-f]{64}\\\"$" } } },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/RunId" } },
      "WorkspaceId": { "name": "workspace_id", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkspaceId" } },
      "Cursor": { "name": "cursor", "in": "query", "required": false, "description": "Opaque signed next-page source-sample cursor; mutually exclusive with before and at.", "schema": { "$ref": "#/components/schemas/Cursor" } },
      "Before": { "name": "before", "in": "query", "required": false, "description": "Opaque signed previous-page source-sample cursor; mutually exclusive with cursor and at.", "schema": { "$ref": "#/components/schemas/Cursor" } },
      "At": { "name": "at", "in": "query", "required": false, "description": "Opaque signed direct-seek cursor for exactly one source equity sample; mutually exclusive with cursor and before.", "schema": { "$ref": "#/components/schemas/Cursor" } },
      "AtOrdinal": { "name": "at_ordinal", "in": "query", "required": false, "description": "Stable public sample ordinal. Re-resolved under current workspace/run/revision authority; use after typed cursor expiry.", "schema": { "type": "integer", "minimum": 0, "maximum": 2000000 } },
      "Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } },
      "IfNoneMatch": { "name": "If-None-Match", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 96 } }
    },
    "responses": {
      "Problem": { "description": "Typed same-origin refusal. No source relation, artifact path, raw market row, worker identity, source cursor, credential, command or compute authority is disclosed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    },
    "schemas": {
      "ReplayNavigationWindow": {"type":"object","additionalProperties":false,"required":["window","start_utc_ms","end_utc_ms","bars","bounds_semantics","count_basis","segments","basis","availability"],"properties":{"window":{"enum":["IS","OOS","HOLDOUT"]},"start_utc_ms":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"end_utc_ms":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"bars":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"bounds_semantics":{"anyOf":[{"enum":["START_INCLUSIVE_END_EXCLUSIVE","SOURCE_RETAINED_FOLD_BOUNDS"]},{"type":"null"}]},"count_basis":{"anyOf":[{"enum":["FULL_SOURCE_WINDOW_OBSERVATIONS","SUM_OF_FOLD_WINDOWS_MAY_OVERLAP"]},{"type":"null"}]},"segments":{"type":"array","maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["fold_id","start_utc_ms","end_utc_ms","bars"],"properties":{"fold_id":{"type":"string","minLength":1,"maxLength":191},"start_utc_ms":{"type":"integer","minimum":0,"maximum":9007199254740991},"end_utc_ms":{"type":"integer","minimum":0,"maximum":9007199254740991},"bars":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]}}}},"basis":{"enum":["BOUND_WINDOW_METADATA","DECLARED_IS_WINDOW","DECLARED_OOS_WINDOW","DECLARED_HOLDOUT_WINDOW","RETAINED_FOLD_TRAIN_WINDOWS","RETAINED_FOLD_TEST_WINDOWS"]},"availability":{"type":"object","additionalProperties":false,"required":["state","reason_code"],"properties":{"state":{"enum":["AVAILABLE","NOT_PUBLISHED","NOT_APPLICABLE"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]}}},"access_basis":{"const":"COMPLETED_THREE_WINDOW_RETAINED_ACCOUNT"}},"description":"Retained fold start/end are exact source bounds; sums may overlap. Holdout AVAILABLE requires completed Three Window retained custody, never pre-execution permission. Old seals remain typed absent; WFO has no independent Holdout.","allOf":[{"if":{"properties":{"availability":{"properties":{"state":{"const":"AVAILABLE"}}}}},"then":{"properties":{"start_utc_ms":{"type":"integer","minimum":0,"maximum":9007199254740991},"end_utc_ms":{"type":"integer","minimum":0,"maximum":9007199254740991},"bars":{"type":"integer","minimum":0,"maximum":9007199254740991},"bounds_semantics":{"type":"string"},"count_basis":{"type":"string"},"availability":{"properties":{"reason_code":{"type":"null"}}}}},"else":{"properties":{"availability":{"properties":{"reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"}}}}}},{"if":{"properties":{"window":{"const":"HOLDOUT"}}},"then":{"properties":{"segments":{"maxItems":0}},"allOf":[{"if":{"properties":{"availability":{"properties":{"state":{"const":"AVAILABLE"}}}}},"then":{"required":["access_basis"],"properties":{"access_basis":{"const":"COMPLETED_THREE_WINDOW_RETAINED_ACCOUNT"}}},"else":{"properties":{"bars":{"type":"null"},"count_basis":{"type":"null"}}}}]}}]},
      "ReplayNavigationIdentity": {"type":"object","additionalProperties":false,"required":["alpha_id","alpha_version_id","basis","availability"],"properties":{"alpha_id":{"anyOf":[{"type":"string","minLength":1,"maxLength":191},{"type":"null"}]},"alpha_version_id":{"anyOf":[{"type":"string","minLength":1,"maxLength":191},{"type":"null"}]},"basis":{"enum":["IMMUTABLE_REQUEST_ALPHA_BINDING","HUB_BOUND_ALPHA_IDENTITY"]},"availability":{"type":"object","additionalProperties":false,"required":["state","reason_code"],"properties":{"state":{"enum":["AVAILABLE","NOT_PUBLISHED","NOT_APPLICABLE"]},"reason_code":{"anyOf":[{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"},{"type":"null"}]}}}},"allOf":[{"if":{"properties":{"availability":{"properties":{"state":{"const":"AVAILABLE"}}}}},"then":{"properties":{"alpha_id":{"type":"string"},"alpha_version_id":{"type":"string"},"availability":{"properties":{"reason_code":{"type":"null"}}}}},"else":{"properties":{"alpha_id":{"type":"null"},"alpha_version_id":{"type":"null"},"availability":{"properties":{"reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,159}$"}}}}}}]},
      "WorkspaceId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "RunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
      "UtcMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "ExactDecimal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$", "maxLength": 96 },
      "ReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,159}$" },
      "Cursor": { "type": "string", "pattern": "^kc1\\.[A-Za-z0-9_-]{1,32}\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$", "maxLength": 4096 },
      "Availability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "PENDING_SOURCE_CALLBACK", "LEGACY_METADATA_ONLY", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] } } },
      "LegacyCandleOverviewBucket": { "type": "object", "additionalProperties": false, "required": ["first_ordinal", "last_ordinal", "open_utc_ms", "close_utc_ms", "open", "high", "low", "close", "volume", "transitions"], "properties": { "first_ordinal": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "last_ordinal": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "open_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "close_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "open": { "$ref": "#/components/schemas/ExactDecimal" }, "high": { "$ref": "#/components/schemas/ExactDecimal" }, "low": { "$ref": "#/components/schemas/ExactDecimal" }, "close": { "$ref": "#/components/schemas/ExactDecimal" }, "volume": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "transitions": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 2000000 }, { "type": "null" }] } } },
      "LegacyCandleOverview": { "type": "object", "additionalProperties": false, "required": ["source_bar_count", "emitted_bucket_count", "bucket_bars", "sampling", "envelope", "values"], "description": "E16-R1 bounded true-extrema source overview. It is not a per-bar replay tape and cannot establish execution marker ordering.", "properties": { "source_bar_count": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "emitted_bucket_count": { "type": "integer", "minimum": 1, "maximum": 48 }, "bucket_bars": { "type": "integer", "minimum": 1, "maximum": 2000000 }, "sampling": { "enum": ["FULL", "OHLC_BUCKET_V1"] }, "envelope": { "type": "object", "additionalProperties": false, "required": ["max_high", "max_high_at_utc_ms", "min_low", "min_low_at_utc_ms"], "properties": { "max_high": { "$ref": "#/components/schemas/ExactDecimal" }, "max_high_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "min_low": { "$ref": "#/components/schemas/ExactDecimal" }, "min_low_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" } } }, "values": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "$ref": "#/components/schemas/LegacyCandleOverviewBucket" } } } },
      "MarketOverview": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "semantics", "data", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "semantics": { "const": "BOUNDED_SOURCE_OVERVIEW_NOT_PER_BAR_REPLAY" }, "data": { "anyOf": [{ "$ref": "#/components/schemas/LegacyCandleOverview" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "SourceGap": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["NOT_PUBLISHED", "NOT_APPLICABLE", "NOT_ASSERTED"] }, "reason_code": { "$ref": "#/components/schemas/ReasonCode" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "ReplayPoint": { "type": "object", "additionalProperties": false, "required": ["playback_ordinal", "at_utc_ms", "equity", "drawdown_fraction", "playback_cursor"], "properties": { "playback_ordinal": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "equity": { "$ref": "#/components/schemas/ExactDecimal" }, "drawdown_fraction": { "$ref": "#/components/schemas/ExactDecimal" }, "playback_cursor": { "$ref": "#/components/schemas/Cursor" } } },
      "StateAtCursor": { "type": "object", "additionalProperties": false, "required": ["state", "semantics", "playback_ordinal", "at_utc_ms", "equity", "drawdown_fraction", "source_sampling", "execution_state", "availability"], "properties": { "state": { "enum": ["AVAILABLE_RETROSPECTIVE_EQUITY_SAMPLE", "NOT_SELECTED", "NOT_PUBLISHED"] }, "semantics": { "enum": ["RETROSPECTIVE_EQUITY_NOT_EXECUTION_STATE", "NO_SELECTED_PLAYHEAD", "SOURCE_DID_NOT_PUBLISH_EXECUTION_STATE"] }, "playback_ordinal": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 2000000 }, { "type": "null" }] }, "at_utc_ms": { "anyOf": [{ "$ref": "#/components/schemas/UtcMilliseconds" }, { "type": "null" }] }, "equity": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "drawdown_fraction": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "source_sampling": { "anyOf": [{ "enum": ["FULL", "EXTREMA_BUCKET_V1"] }, { "type": "null" }] }, "execution_state": { "$ref": "#/components/schemas/SourceGap" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "ReplayPage": { "type": "object", "additionalProperties": false, "required": ["limit", "next_cursor", "prev_cursor", "has_more", "has_previous", "order"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "next_cursor": { "anyOf": [{ "$ref": "#/components/schemas/Cursor" }, { "type": "null" }] }, "prev_cursor": { "anyOf": [{ "$ref": "#/components/schemas/Cursor" }, { "type": "null" }] }, "has_more": { "type": "boolean" }, "has_previous": { "type": "boolean" }, "order": { "const": "SOURCE_CHRONOLOGICAL_SAMPLE_ORDINAL_ASC" } } },
      "ReplayWindow": { "type": "object", "additionalProperties": false, "required": ["state", "source_observation_count", "emitted_point_count", "sampling", "items", "page", "state_at_cursor", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "source_observation_count": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2000000 }, { "type": "null" }] }, "emitted_point_count": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 192 }, { "type": "null" }] }, "sampling": { "anyOf": [{ "enum": ["FULL", "EXTREMA_BUCKET_V1"] }, { "type": "null" }] }, "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/ReplayPoint" } }, "page": { "$ref": "#/components/schemas/ReplayPage" }, "state_at_cursor": { "$ref": "#/components/schemas/StateAtCursor" }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "CandleBucket": { "type": "object", "additionalProperties": false, "description": "E16-R1 one bucket of the retained OHLC overview. high/low are the TRUE extremes of the bars the bucket covers, never an interpolation. transitions is always null: P04 publishes no execution ledger through this adapter. The field names are the retained WFO lane's execution.candle_overview.values[] so one component draws both lanes.", "required": ["first_ordinal", "last_ordinal", "open_utc_ms", "close_utc_ms", "open", "high", "low", "close", "volume", "transitions"], "properties": { "first_ordinal": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "last_ordinal": { "type": "integer", "minimum": 0, "maximum": 2000000 }, "open_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "close_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "open": { "$ref": "#/components/schemas/ExactDecimal" }, "high": { "$ref": "#/components/schemas/ExactDecimal" }, "low": { "$ref": "#/components/schemas/ExactDecimal" }, "close": { "$ref": "#/components/schemas/ExactDecimal" }, "volume": { "anyOf": [{ "$ref": "#/components/schemas/ExactDecimal" }, { "type": "null" }] }, "transitions": { "type": "null" } } },
      "CandleOverview": { "type": "object", "additionalProperties": false, "description": "E16-R1 the bounded whole-window OHLC overview the confined P06 child retained while it still held the tape the P10 producer deletes. A summary, never a bar ledger: route_capabilities.candle_windows still reports the per-bar absence. A run sealed before the producer retained one keeps a typed absence with its own reason code; nothing is backfilled.", "required": ["state", "reason_code", "scope", "source_bar_count", "emitted_bucket_count", "bucket_bars", "sampling", "envelope", "values", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "scope": { "anyOf": [{ "const": "OOS_EQUITY_WINDOW" }, { "type": "null" }] }, "source_bar_count": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2000000 }, { "type": "null" }] }, "emitted_bucket_count": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 160 }, { "type": "null" }] }, "bucket_bars": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2000000 }, { "type": "null" }] }, "sampling": { "anyOf": [{ "enum": ["FULL", "OHLC_BUCKET_V1"] }, { "type": "null" }] }, "envelope": { "anyOf": [{ "type": "object", "additionalProperties": false, "required": ["max_high", "max_high_at_utc_ms", "min_low", "min_low_at_utc_ms"], "properties": { "max_high": { "$ref": "#/components/schemas/ExactDecimal" }, "max_high_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" }, "min_low": { "$ref": "#/components/schemas/ExactDecimal" }, "min_low_at_utc_ms": { "$ref": "#/components/schemas/UtcMilliseconds" } } }, { "type": "null" }] }, "values": { "type": "array", "maxItems": 160, "items": { "$ref": "#/components/schemas/CandleBucket" } }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "RouteCapability": { "type": "object", "additionalProperties": false, "required": ["state", "reason_code", "availability"], "properties": { "state": { "enum": ["AVAILABLE", "NOT_PUBLISHED", "NOT_APPLICABLE"] }, "reason_code": { "anyOf": [{ "$ref": "#/components/schemas/ReasonCode" }, { "type": "null" }] }, "availability": { "$ref": "#/components/schemas/Availability" } } },
      "Replay": {"type":"object","additionalProperties":false,"required":["schema_version","read_authority","run_id","revision","etag","availability","readiness","as_of_utc_ms","provenance","route","equity_replay","candle_overview","route_capabilities","source_absences"],"properties":{"schema_version":{"const":"research.replay.v1"},"read_authority":{"const":"PORTAL_PERSISTED_RESEARCH"},"run_id":{"$ref":"#/components/schemas/RunId"},"revision":{"anyOf":[{"type":"string","pattern":"^p17r1_[0-9a-f]{64}$"},{"type":"null"}]},"etag":{"anyOf":[{"type":"string","pattern":"^\\\"p17r1_[0-9a-f]{64}\\\"$"},{"type":"null"}]},"availability":{"$ref":"#/components/schemas/Availability"},"readiness":{"enum":["PARTIAL","NOT_READY"]},"as_of_utc_ms":{"$ref":"#/components/schemas/UtcMilliseconds"},"provenance":{"type":"object","additionalProperties":false,"required":["source_adapter_id","evidence_revision","source_transform_digest","input_scope"],"properties":{"source_adapter_id":{"anyOf":[{"enum":["p04.delta-rsi.v1","p17.imported-signal-notional.v1","full03.delta-rsi.v1"]},{"type":"null"}]},"evidence_revision":{"anyOf":[{"type":"string","pattern":"^p13r1_[0-9a-f]{64}$"},{"type":"null"}]},"source_transform_digest":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},"input_scope":{"anyOf":[{"const":"P08_OPTIONAL_WARMUP_PLUS_IS_OOS_ONLY"},{"type":"null"}]}}},"route":{"type":"object","additionalProperties":false,"required":["id","state","replay_contract","availability"],"properties":{"id":{"anyOf":[{"enum":["signal_notional","intrabar_bracket","reactive","event_driven"]},{"type":"null"}]},"state":{"enum":["RETROSPECTIVE_EQUITY_ONLY","PENDING_SOURCE_CALLBACK","LEGACY_METADATA_ONLY","NOT_PUBLISHED"]},"replay_contract":{"anyOf":[{"enum":["P17_CURRENT_P04_EQUITY_SAMPLE_V1","P17_IMPORTED_FIXED_EQUITY_SAMPLE_V1","P17_NATIVE_FIXED_EQUITY_SAMPLE_V1"]},{"type":"null"}]},"availability":{"$ref":"#/components/schemas/Availability"}}},"equity_replay":{"$ref":"#/components/schemas/ReplayWindow"},"market_overview":{"$ref":"#/components/schemas/MarketOverview"},"candle_overview":{"$ref":"#/components/schemas/CandleOverview"},"execution":{"type":"object","additionalProperties":false,"required":["counts"],"description":"P04 retained count subset. bars is OOS only; trades_reported is an exact child-tape/IS_PLUS_OOS QuantBT count, not a published trade ledger. Ledger counts remain typed absent.","properties":{"counts":{"type":"object","additionalProperties":false,"required":["bars","trades_reported","orders_published","fills_published","trades_published","transitions"],"properties":{"bars":{"type":"object","additionalProperties":false,"required":["value","scope","availability"],"properties":{"value":{"anyOf":[{"type":"integer","minimum":0,"maximum":2000000},{"type":"null"}]},"scope":{"anyOf":[{"const":"OOS_EQUITY_WINDOW"},{"type":"null"}]},"availability":{"$ref":"#/components/schemas/Availability"}}},"trades_reported":{"type":"object","additionalProperties":false,"required":["value","scope","availability"],"properties":{"value":{"anyOf":[{"type":"string","pattern":"^[0-9]+$","maxLength":24},{"type":"null"}]},"scope":{"anyOf":[{"enum":["CHILD_TAPE","IS_PLUS_OOS"]},{"type":"null"}]},"availability":{"$ref":"#/components/schemas/Availability"}}},"orders_published":{"$ref":"#/components/schemas/RouteCapability"},"fills_published":{"$ref":"#/components/schemas/RouteCapability"},"trades_published":{"$ref":"#/components/schemas/RouteCapability"},"transitions":{"$ref":"#/components/schemas/RouteCapability"}}}}},"route_capabilities":{"type":"object","additionalProperties":false,"required":["orders","fills","trades","positions","execution_events","candle_windows","sl_tp_ambiguity","oco_tree","multi_leg","funding","mae_mfe","fold_capital","child_audit_provenance"],"properties":{"orders":{"$ref":"#/components/schemas/RouteCapability"},"fills":{"$ref":"#/components/schemas/RouteCapability"},"trades":{"$ref":"#/components/schemas/RouteCapability"},"positions":{"$ref":"#/components/schemas/RouteCapability"},"execution_events":{"$ref":"#/components/schemas/RouteCapability"},"candle_windows":{"$ref":"#/components/schemas/RouteCapability"},"sl_tp_ambiguity":{"$ref":"#/components/schemas/RouteCapability"},"oco_tree":{"$ref":"#/components/schemas/RouteCapability"},"multi_leg":{"$ref":"#/components/schemas/RouteCapability"},"funding":{"$ref":"#/components/schemas/RouteCapability"},"mae_mfe":{"$ref":"#/components/schemas/RouteCapability"},"fold_capital":{"$ref":"#/components/schemas/RouteCapability"},"child_audit_provenance":{"$ref":"#/components/schemas/RouteCapability"}}},"source_absences":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/SourceGap"}},"identity":{"$ref":"#/components/schemas/ReplayNavigationIdentity"},"is_window":{"$ref":"#/components/schemas/ReplayNavigationWindow"},"oos_window":{"$ref":"#/components/schemas/ReplayNavigationWindow"},"holdout_window":{"$ref":"#/components/schemas/ReplayNavigationWindow"},"presentation_revision":{"const":"research.replay-navigation.v1","description":"Separate additive presentation; immutable replay source revision, source digest and frozen Report/RC pins are unchanged."},"presentation_digest":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"Canonical SHA256 of presentation_revision plus identity/is_window/oos_window/holdout_window. Neither a source digest nor an HTTP cache validator (Replay is private no-store)."}}},
      "Problem": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "maxLength": 160 }, "message": { "type": "string", "maxLength": 1024 } } }, "request_id": { "type": "string", "maxLength": 128 } } }
    }
  }
}
