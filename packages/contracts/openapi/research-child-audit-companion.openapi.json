{
  "openapi": "3.1.0",
  "info": {
    "title": "Research full-source child audit companion",
    "version": "1.0.0",
    "description": "Additive bounded source-file lifecycle custody; legacy <=64 fold witnesses and original five-table P05 seal remain unchanged. FULL_SOURCE_RETAINED means all rows available in the bounded source file, not complete engine generation/history: source-dropped rows are irrecoverable. GET reads tenant-scoped immutable custody only, never runs an engine or opens Parquet. Cursor pages are private/no-store."
  },
  "paths": {
    "/api/v1/quantbt/runs/{run_id}/current-source/child-audit-companion": {
      "get": {
        "operationId": "researchChildAuditCompanionGetV1",
        "summary": "Page full available source lifecycle rows or typed legacy absence",
        "security": [
          {
            "portalSession": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RunId"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
            }
          },
          {
            "name": "fold_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            }
          },
          {
            "name": "context",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "anti-leakage in-sample search",
                "in-sample scoring",
                "out-of-sample scoring",
                "out-of-sample generation"
              ]
            }
          },
          {
            "name": "audit_ordinal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19999
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        ],
        "description": "Strict closed selectors. Exact audit_ordinal lookup and cursor are mutually exclusive. Opaque signed cursors bind tenant/actor/run/revision/full filter/page limit; expire and cannot restart on a changed/missing seal. Counts matching_fold and matching_filter cover the full retained population, not only returned rows.",
        "responses": {
          "200": {
            "description": "Sealed full-source page or typed absence; dropped source history stays explicit",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Typed refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Typed refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Typed refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Typed refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Typed refusal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
