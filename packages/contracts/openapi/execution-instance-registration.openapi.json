  "paths": {
    "/api/v1/execution/instance-registrations/preview": {
      "post": {
        "operationId": "executionInstanceRegistrationPreviewV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "parameters": [
          {
            "name": "x-portal-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        ],
        "description": "Source-dark by default. Current exact deployment.register plus accepted source DEPLOY mapping, Portfolio/environment/alpha scope, CSRF/Origin, and fresh step-up on submit. Durable attempt commits before any source APPLY I/O. Retained preview rejects mutation. No funding/binding/activation/native effects are admitted. Repeated submit never sends a known intent again; use its original key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstanceRegistrationIntent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed registration preview or durable registry status; not source commissioning.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceRegistrationPreview"
                }
              }
            }
          },
          "400": {
            "description": "Closed input, current authority, context, same-key correlation or finite-capacity refusal. Fixed public copy, never source diagnostics.",
