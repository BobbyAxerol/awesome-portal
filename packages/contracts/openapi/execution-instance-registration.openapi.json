    "/api/v1/execution/instance-registrations/{id}/reconcile": {
      "post": {
        "operationId": "executionInstanceRegistrationReconcileV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ecm_[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          {
            "name": "x-portal-idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        ],
        "description": "Query the same durable registration intent using the original source registration target/key and verified lookup; never resend. Requires independent current audit.read, Origin/CSRF and same-request idempotency header. Accepted-obligation service recovery does not impersonate an expired human session. Unknown remains unknown without a verified receipt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstanceRegistrationQuery"
              }
            }
          }
        },
