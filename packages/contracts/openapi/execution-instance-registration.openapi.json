  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "InstanceRegistrationIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "portal.execution.instance-registration-intent.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "PORTFOLIO"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "paper",
              "sandbox",
              "live"
            ]
          },
          "expected_policy_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "business_payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": "pma.management-command.v1"
              },
              "operation": {
                "const": "REGISTER_INSTANCE"
              },
              "idempotency_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{8,128}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "expected_version": {
                "const": "0"
              },
              "expected_policy_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 19,
                "pattern": "^(?:0|[1-9][0-9]{0,17}|9223372036854775807|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6])(?![\\s\\S])"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "alpha_slug": {
                    "type": "string",
                    "minLength": 1
                  },
                  "venue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "account_type": {
                    "type": "string",
                    "enum": [
                      "CASH",
                      "MARGIN",
                      "BETTING"
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "alpha_slug",
                  "venue",
                  "account_type",
                  "currency"
                ]
              }
            },
            "required": [
              "schema_version",
              "operation",
              "idempotency_key",
              "reason",
              "expected_version",
              "expected_policy_revision",
              "parameters"
            ]
          }
        },
        "required": [
          "schema_version",
          "workspace_id",
          "resource",
          "environment",
          "expected_policy_revision",
          "business_payload"
        ],
        "description": "Exact PM management REGISTER_INSTANCE wire inside a Portal Portfolio/environment intent. expected_policy_revision outside business_payload is the opaque Portal policy revision; the PM body counter is an independent source CAS. Browser cannot supply target_ref, actor, workload, source URL or trusted authority. Runtime additionally enforces UTF-8/text bounds and initial source version 0."
      },
      "InstanceRegistrationSubmit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/InstanceRegistrationIntent"
          },
          "preview_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "intent",
          "preview_digest"
        ]
      },
      "InstanceRegistrationQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
          }
        },
        "required": [
          "workspace_id"
        ]
      },
      "InstanceRegistrationPreview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "portal.execution.instance-registration-preview.v1"
          },
          "operation": {
            "const": "REGISTER_INSTANCE"
          },
          "allowed": {
            "type": "boolean"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "REGISTRATION_NOT_QUALIFIED",
                  "REGISTRATION_CONTEXT_INVALID",
                  "REGISTRATION_CONTEXT_EXPIRED",
                  "REGISTRATION_PREVIEW_CHANGED",
                  "REGISTRATION_IDEMPOTENCY_CONFLICT",
                  "REGISTRATION_NOT_FOUND",
                  "REGISTRATION_CAPACITY_EXCEEDED",
                  "REGISTRATION_RECEIPT_UNVERIFIED",
                  "REGISTRATION_UNAVAILABLE"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "preview_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "profile_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "business_applied": {
            "const": false
          },
          "reserved": {
            "const": false
          }
        },
        "required": [
          "schema_version",
          "operation",
          "allowed",
          "reason_code",
          "preview_digest",
          "expires_at_ms",
          "profile_ref",
          "business_applied",
          "reserved"
        ],
