{
  "openapi": "3.1.0",
  "info": {
    "title": "controls",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/controls": {
      "get": {
        "operationId": "executionControlsGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "Locks in force and the trading state of a scope (the workspace, a portfolio, an account or a deployment). `trading_state` REDUCING means only reducing orders are allowed. History is the recorded transitions, newest first. CONTRACT ONLY: no producer exists yet (Edge/Core inputs are in WP_K_CONTRACTS_2026-10-23.md), so nothing serves this route and every screen keeps its typed absence.",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "scope_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          {
            "name": "scope_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current answer; absence stays typed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Controls"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlsProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlsProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlsProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlsProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "Controls": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.controls.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "locks": {
            "anyOf": [
              {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "lock_id",
                    "scope",
                    "revision",
                    "state",
                    "set_at_ms",
                    "set_by",
                    "reason_code"
                  ],
                  "properties": {
                    "lock_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 191,
                      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                    },
                    "scope": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "id"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "WORKSPACE",
                            "PORTFOLIO",
                            "ACCOUNT",
                            "DEPLOYMENT"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 191,
                          "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                        }
                      }
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "ACTIVE",
                        "RELEASED"
                      ]
                    },
                    "set_at_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "set_by": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256,
                          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reason_code": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "trading_state": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "since_ms",
                  "history"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "REDUCING",
                      "HALTED"
                    ]
                  },
                  "since_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "history": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "state",
                        "at_ms",
                        "actor",
                        "reason_code"
                      ],
                      "properties": {
                        "state": {
                          "type": "string",
                          "enum": [
                            "ACTIVE",
                            "REDUCING",
                            "HALTED"
                          ]
                        },
                        "at_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "actor": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "reason_code": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[A-Z][A-Z0-9_]{1,63}$(?![\\s\\S])"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ControlsProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
