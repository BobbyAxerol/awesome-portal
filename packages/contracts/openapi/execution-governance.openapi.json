{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal Execution Governance Review API",
    "version": "1.3.0",
    "description": "Same-origin, session-guarded Portal governance boundaries for R1/R2 review, immutable approval history, Paper Exit and source-dark Sandbox Certification. No endpoint in this slice commands the Trading System."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "portalSession": [] }],
  "paths": {
    "/api/v1/execution/governance/approvals/{approval_id}/r1": {
      "get": {
        "operationId": "executionGovernanceR1Review",
        "description": "Returns one workspace-bound Portal R1 review, its immutable evidence manifest, known limitations, eligibility and decision history.",
        "parameters": [
          { "$ref": "#/components/parameters/ApprovalId" },
          { "$ref": "#/components/parameters/WorkspaceId" }
        ],
        "responses": {
          "200": {
            "description": "Portal-owned R1 review",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/execution-governance-approval-workflow.v1.schema.json#/$defs/R1ReviewResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/governance/approvals/history": {
      "get": {
        "operationId": "executionGovernanceApprovalHistory",
        "description": "Returns immutable terminal approval attempts with bounded bidirectional keyset pagination. REQUEST_CHANGES appears as CHANGES_REQUESTED and never rewrites the governed gate.",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "name": "after", "in": "query", "schema": { "type": "string", "maxLength": 4096 } },
          { "name": "before", "in": "query", "schema": { "type": "string", "maxLength": 4096 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 250 } },
          { "name": "gate", "in": "query", "schema": { "enum": ["R1", "R2", "PAPER_EXIT", "SANDBOX_EXIT", "LIVE_GATE"] } },
          { "name": "subject", "in": "query", "schema": { "type": "string", "maxLength": 160 } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "maxLength": 256 } }
        ],
        "responses": {
          "200": {
            "description": "Portal-owned immutable approval history",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/execution-governance-approval-workflow.v1.schema.json#/$defs/ApprovalHistoryResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/governance/approvals/{approval_id}/r2": {
      "get": {
        "operationId": "executionGovernanceR2Review",
        "description": "Returns an active, workspace-bound R2 review only when its immutable portfolio/currency scope exists. Missing, cross-workspace, closed, and expired reviews are not disclosed.",
        "parameters": [
          { "$ref": "#/components/parameters/ApprovalId" },
          { "$ref": "#/components/parameters/WorkspaceId" }
        ],
        "responses": {
          "200": {
            "description": "Portal-owned R2 review scope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/R2ReviewResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/governance/exit-reviews/{review_id}": {
      "get": {
        "operationId": "executionGovernancePaperExitReview",
        "description": "Returns a Portal-owned Paper Exit Review with deterministic evidence evaluation. Missing, partial, stale and unavailable evidence are explicit fail-closed states.",
        "parameters": [
          { "$ref": "#/components/parameters/ReviewId" },
          { "$ref": "#/components/parameters/WorkspaceId" }
        ],
        "responses": {
          "200": {
            "description": "Portal-owned Paper Exit Review",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/execution-governance-paper-exit.v1.schema.json#/$defs/PaperExitReviewResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/commands/plans": {
      "post": {
        "operationId": "planGovernanceDecision",
        "description": "Plans a Portal-local R1 or Paper Exit decision. REQUEST_CHANGES closes only the current immutable approval attempt; it does not deny the governed gate or create a replacement request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "../schemas/execution-governance-approval-workflow.v1.schema.json#/$defs/R1DecisionPlanRequest" },
                  { "$ref": "../schemas/execution-governance-paper-exit.v1.schema.json#/$defs/PaperExitDecisionPlanRequest" }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable decision plan",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/execution-governance-paper-exit.v1.schema.json#/$defs/PaperExitDecisionPlan" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/operations/{operation_id}/apply": {
      "post": {
        "operationId": "applyPaperExitDecision",
        "description": "Records the planned Portal decision. HTTP 202 is an acknowledgement, not terminal success. No Trading System effect is requested.",
        "parameters": [{ "$ref": "#/components/parameters/OperationId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "../schemas/execution-governance-paper-exit.v1.schema.json#/$defs/PaperExitApplyRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for Portal-local settlement",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/execution-governance-paper-exit.v1.schema.json#/$defs/PaperExitApplyResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/operations/{operation_id}": {
      "get": {
        "operationId": "getPaperExitDecisionOperation",
        "description": "Returns workflow status and verification_result separately for a Paper Exit decision operation.",
        "parameters": [
          { "$ref": "#/components/parameters/OperationId" },
          { "$ref": "#/components/parameters/WorkspaceId" }
        ],
        "responses": {
          "200": {
            "description": "Decision operation",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/execution-governance-paper-exit.v1.schema.json#/$defs/PaperExitDecisionOperation" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/deployments/{deployment_id}/certification": {
      "get": {
        "operationId": "getSandboxCertification",
        "description": "Returns the Portal-owned seven-step Sandbox Certification and three source-attributed panels. Missing source evidence remains explicitly unavailable.",
        "parameters": [
          { "$ref": "#/components/parameters/DeploymentId" },
          { "$ref": "#/components/parameters/WorkspaceId" }
        ],
        "responses": {
          "200": {
            "description": "Sandbox Certification detail",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/CertificationResponse" } } }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/governance/sandbox-certifications": {
      "post": {
        "operationId": "createSandboxCertification",
        "description": "Creates one Portal-owned certification from an available Paper Exit promotion grant; does not activate sandbox runtime.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/CreateRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Created or idempotently replayed certification",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/CertificationResponse" } } }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/governance/sandbox-certifications/{certification_id}/submit": {
      "post": {
        "operationId": "submitSandboxCertification",
        "description": "Submits only a complete, verified and current 7/7 evidence set for review.",
        "parameters": [{ "$ref": "#/components/parameters/CertificationId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/SubmitRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Submitted or idempotently replayed certification",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/CertificationResponse" } } }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/governance/sandbox-certifications/{certification_id}/decisions": {
      "post": {
        "operationId": "decideSandboxCertification",
        "description": "Approves or denies an in-review certification. Approval is separation-of-duties and evidence-hash gated.",
        "parameters": [{ "$ref": "#/components/parameters/CertificationId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/DecisionRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Recorded or idempotently replayed decision",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/CertificationResponse" } } }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/v1/execution/governance/sandbox-certifications/{certification_id}/promotion-plans": {
      "post": {
        "operationId": "planSandboxPromotion",
        "description": "Records a hash-bound CANARY promotion intent as BLOCKED. No outbox, runtime activation or Trading System side effect is created.",
        "parameters": [{ "$ref": "#/components/parameters/CertificationId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/PromotionPlanRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Immutable blocked promotion plan",
            "content": { "application/json": { "schema": { "$ref": "../schemas/execution-sandbox-certification.v1.schema.json#/$defs/PromotionPlanResponse" } } }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "portalSession": { "type": "apiKey", "in": "cookie", "name": "portal_session" }
    },
    "parameters": {
      "ApprovalId": {
        "name": "approval_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      },
      "ReviewId": {
        "name": "review_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      },
      "OperationId": {
        "name": "operation_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      },
      "DeploymentId": {
        "name": "deployment_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      },
      "CertificationId": {
        "name": "certification_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Identifier" }
      },
      "WorkspaceId": {
        "name": "workspace_id",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/WorkspaceId" }
      }
    },
    "responses": {
      "Problem": {
        "description": "Typed fail-closed error",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      }
    },
    "schemas": {
      "Identifier": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$"
      },
      "WorkspaceId": {
        "type": "string",
        "minLength": 3,
        "maxLength": 96
      },
      "Currency": {
        "type": "string",
        "pattern": "^[A-Z0-9]{2,12}$"
      },
      "DateTime": { "type": "string", "format": "date-time" },
      "Hash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "PortalActor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "username"],
        "properties": {
          "user_id": { "$ref": "#/components/schemas/Identifier" },
          "username": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "ReviewActor": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "username", "roles"],
        "properties": {
          "user_id": { "$ref": "#/components/schemas/Identifier" },
          "username": { "type": "string", "minLength": 1, "maxLength": 128 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "enum": ["ADMIN", "USER"] }
          }
        }
      },
      "R2Approval": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id",
          "gate",
          "subject_type",
          "subject_id",
          "subject_label",
          "release_candidate",
          "environment",
          "target_label",
          "requester",
          "creator",
          "status",
          "policy_version",
          "quorum_met",
          "quorum_required",
          "approval_version",
          "evidence_set_hash",
          "evidence_complete",
          "blocker_count",
          "blocker_summary",
          "sla_due_at",
          "expires_at",
          "created_at",
          "updated_at",
          "portfolio_id",
          "currency"
        ],
        "properties": {
          "approval_id": { "$ref": "#/components/schemas/Identifier" },
          "gate": { "type": "string", "const": "R2" },
          "subject_type": { "type": "string", "minLength": 1, "maxLength": 64 },
          "subject_id": { "$ref": "#/components/schemas/Identifier" },
          "subject_label": { "type": "string", "minLength": 1, "maxLength": 512 },
          "release_candidate": { "type": ["string", "null"], "maxLength": 256 },
          "environment": { "type": "string", "minLength": 1, "maxLength": 32 },
          "target_label": { "type": "string", "minLength": 1, "maxLength": 256 },
          "requester": { "$ref": "#/components/schemas/PortalActor" },
          "creator": { "$ref": "#/components/schemas/PortalActor" },
          "status": { "type": "string", "const": "PENDING" },
          "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "quorum_met": { "type": "integer", "minimum": 0 },
          "quorum_required": { "type": "integer", "minimum": 1 },
          "approval_version": { "type": "integer", "minimum": 1 },
          "evidence_set_hash": { "$ref": "#/components/schemas/Hash" },
          "evidence_complete": { "type": "boolean" },
          "blocker_count": { "type": "integer", "minimum": 0 },
          "blocker_summary": { "type": ["string", "null"], "maxLength": 2000 },
          "sla_due_at": { "$ref": "#/components/schemas/DateTime" },
          "expires_at": { "$ref": "#/components/schemas/DateTime" },
          "created_at": { "$ref": "#/components/schemas/DateTime" },
          "updated_at": { "$ref": "#/components/schemas/DateTime" },
          "portfolio_id": { "$ref": "#/components/schemas/Identifier" },
          "currency": { "$ref": "#/components/schemas/Currency" }
        }
      },
      "R2ReviewData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval", "actor"],
        "properties": {
          "approval": { "$ref": "#/components/schemas/R2Approval" },
          "actor": { "$ref": "#/components/schemas/ReviewActor" }
        }
      },
      "R2ReviewResponse": {
        "$ref": "../schemas/execution-governance-r2-review.v1.schema.json"
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 128 },
              "message": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          },
          "request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
