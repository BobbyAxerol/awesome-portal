{
  "openapi": "3.1.0",
  "info": {
    "title": "Execution equity projection (source-backed V2)",
    "version": "2.0.0",
    "description": "Sibling of the fixture-only V1 route. Unmounted by default; the only port implementation is SOURCE_NOT_COMMISSIONED."
  },
  "paths": {
    "/api/v1/execution/deployments/{deploymentId}/equity-projection/source": {
      "get": {
        "operationId": "executionEquityProjectionSource",
        "parameters": [
          {
            "name": "deploymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "paper",
                "sandbox",
                "live"
              ]
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1d",
                "7d",
                "30d",
                "90d",
                "1y"
              ],
              "default": "30d"
            }
          },
          {
            "name": "intent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "overview",
                "inspect"
              ],
              "default": "overview"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000,
              "default": 5000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source-backed projection, or typed absence per section.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquityProjectionSourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, cursor or limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquityProjectionSourceProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquityProjectionSourceProblem"
                }
              }
            }
          },
          "403": {
            "description": "Current authority required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquityProjectionSourceProblem"
                }
              }
            }
          },
          "404": {
            "description": "Workspace or deployment unavailable (no existence oracle).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquityProjectionSourceProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source integrity or authority unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquityProjectionSourceProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EquityProjectionSourceResponse": {
        "$ref": "../schemas/execution-equity-projection-source.v2.schema.json#/$defs/EquityProjectionSourceResponse"
      },
      "EquityProjectionSourceProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
