{
  "openapi": "3.1.0",
  "info": {
    "title": "command-receipt",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/execution/commands/{operation_id}/receipt": {
      "get": {
        "operationId": "executionCommandReceiptGetV1",
        "security": [
          {
            "PortalSession": []
          }
        ],
        "description": "The receipt of one command operation: its state, what the Portal decided, and (once applied) the receipt reference, hash, what changed and the verification. A DENIED command carries the denial and no receipt. This is the positive companion of the pinned F0 denial; it does not change that denial. CONTRACT ONLY: no producer exists yet (Edge/Core inputs are in WP_K_CONTRACTS_2026-10-23.md), so nothing serves this route and every screen keeps its typed absence.",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191,
              "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized current answer; absence stays typed",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceiptProblem"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceiptProblem"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable or not authorized",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceiptProblem"
                }
              }
            }
          },
          "503": {
            "description": "Source unavailable",
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandReceiptProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PortalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-portal_session"
      }
    },
    "schemas": {
      "CommandReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "workspace_id",
          "record_authority",
          "read_at_ms",
          "operation_id",
          "command_key",
          "request_key",
          "state",
          "side_effect"
        ],
        "properties": {
          "schema_version": {
            "const": "portal.execution.command-receipt.v1"
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "record_authority": {
            "const": "PORTAL_PROJECTION"
          },
          "read_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          },
          "command_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "request_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191,
            "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
          },
          "state": {
            "type": "string",
            "enum": [
              "PLANNED",
              "DENIED",
              "APPLIED",
              "VERIFIED",
              "FAILED",
              "EXPIRED"
            ]
          },
          "side_effect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_request_sent",
              "relay"
            ],
            "properties": {
              "source_request_sent": {
                "type": "boolean"
              },
              "relay": {
                "type": "string",
                "enum": [
                  "DISABLED",
                  "NOT_ATTEMPTED",
                  "RELAYED"
                ]
              }
            }
          },
          "receipt": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "receipt_ref",
                  "content_hash",
                  "issued_at_ms",
                  "issued_by",
                  "what_changes",
                  "verification"
                ],
                "properties": {
                  "receipt_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
                  },
                  "issued_at_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "issued_by": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "what_changes": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
                  },
                  "verification": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "result",
                          "verified_at_ms"
                        ],
                        "properties": {
                          "result": {
                            "type": "string",
                            "enum": [
                              "PENDING",
                              "SUCCEEDED",
                              "FAILED",
                              "PARTIAL"
                            ]
                          },
                          "verified_at_ms": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "APPLIED",
                    "VERIFIED"
                  ]
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "receipt"
              ],
              "properties": {
                "receipt": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "const": "DENIED"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "side_effect": {
                  "type": "object",
                  "properties": {
                    "source_request_sent": {
                      "const": false
                    },
                    "relay": {
                      "enum": [
                        "DISABLED",
                        "NOT_ATTEMPTED"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "CommandReceiptProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "EXECUTION_READ_NOT_AVAILABLE",
                  "EXECUTION_READ_QUERY_INVALID"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
