# Docker Compose project and public HTTP endpoint
PORTAL_STACK_NAME=portal
PORTAL_HTTP_PORT=8080
PORTAL_IMAGE_PREFIX=local/portal
PORTAL_IMAGE_TAG=dev

# Historical input is only for backtest/research consumers. Realtime market
# feeds, paper orders/fills and paper account state use separate future services.
# Generic local/CI mode is disabled; target VPS uses `required` after staging the
# approved reader wheel and mounting canonical storage read-only.
PORTAL_HISTORICAL_DATA_MODE=disabled
PORTAL_HISTORICAL_DATA_DIR=./runtime/historical-market-data
# Local disabled mode uses the image's portal group. For a real host mount,
# replace this with the numeric GID that has the storage reader ACL, e.g.
# `getent group primus-market-data-readers | cut -d: -f3` (never chmod data 644).
PORTAL_HMD_READER_GID=10001
PORTAL_CRYPTO_RESAMPLE_ENGINE=duckdb

# Command Center summary aggregation; deadline accepts 100-2000 ms.
PORTAL_SUMMARY_DEADLINE_MS=500
PORTAL_ENVIRONMENT=research

# Control API (U07 thin identity BFF). Local default is dev auth; production
# sets cloudflare_access_local_password with the real Cloudflare Access values
# and INTERNAL_PRINCIPAL_SECRET as a runtime secret, never committed here.
#
# PRODUCTION (domain https://portal.primusspark.com) — set before deploy:
#   CONTROL_API_AUTH_MODE=cloudflare_access_local_password
#   PORTAL_PUBLIC_ORIGIN=https://portal.primusspark.com   (else login 403)
#   + uncomment the CLOUDFLARE_ACCESS_* values with the real AUD/ISSUER/JWKS
#   + INTERNAL_PRINCIPAL_SECRET as a real runtime secret
#   + hand over one-time credentials ONCE: run
#       node dist/cli/bootstrap.js --file bootstrap-users.yaml --print-one-time-credentials
#     (the container CMD never prints tokens; rotate after first use)
CONTROL_API_AUTH_MODE=dev
CONTROL_API_FEATURE_PROXY_PORTAL=true
PORTAL_PUBLIC_ORIGIN=http://localhost:8080
# Gateway wire (U10 façade): every /api/ (except health/ready/SSE) hits the
# Control API BFF. Rollback in one line: PORTAL_WEB_UPSTREAM=portal-api:8000.
PORTAL_WEB_UPSTREAM=control-api:4000
# CLOUDFLARE_TEAM_DOMAIN=https://primussparkquant.cloudflareaccess.com
# CLOUDFLARE_ACCESS_ISSUER=https://primussparkquant.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=<portal-access-application-aud>
# CLOUDFLARE_ACCESS_JWKS_URI=https://primussparkquant.cloudflareaccess.com/cdn-cgi/access/certs
# CLOUDFLARE_ALLOWED_EMAIL_DOMAIN=azdag.com
# CONTROL_API_INTERNAL_PRINCIPAL_SECRET=<random-32+chars>
# Non-local Control API deployments require two independently rotated HMAC
# keyrings. Cursor tokens and governance apply tokens must never share a key.
# CONTROL_API_QUERY_CURSOR_ACTIVE_KEY_ID=query-k1
# CONTROL_API_QUERY_CURSOR_KEYS_JSON={"query-k1":"<random-32+chars>"}
# CONTROL_API_GOVERNANCE_APPLY_ACTIVE_KEY_ID=governance-k1
# CONTROL_API_GOVERNANCE_APPLY_KEYS_JSON={"governance-k1":"<different-random-32+chars>"}
# CONTROL_API_GOVERNANCE_PLAN_TTL_SECONDS=300

# Roadmap & Task Board is served within the same web image. Local-first is the
# safe default; the smoke stack deliberately enables the audited V1 API path.
ROADMAP_TASK_BOARD_LOCAL_ONLY=false
ROADMAP_TASK_BOARD_PERSISTENCE=v1
ROADMAP_TASK_BOARD_API_BASE=/roadmap-task-board/api
PORTAL_PLANNING_SUMMARY_MODE=local
PORTAL_PLANNING_SUMMARY_TIMEOUT_MS=500
PORTAL_PLANNING_SUMMARY_MAX_BYTES=65536
ROADMAP_TASK_BOARD_ENV=development
ROADMAP_TASK_BOARD_PUBLIC_URL=http://localhost:8080/roadmap-task-board
ROADMAP_TASK_BOARD_DEFAULT_ACTOR=local-user
ROADMAP_TASK_BOARD_LOG_LEVEL=INFO
# ROADMAP_TASK_BOARD_DISCORD_WEBHOOK_URL=  # provision only as a runtime secret
# LARK_WEBHOOK_URL=  # provision only as a runtime secret; must be an https://open.larksuite.com custom-bot hook
# LARK_WEBHOOK_SIGN_SECRET=  # provision only as a runtime secret; never commit the Lark sign secret
# PORTAL_NOTIFY_CHANNELS=discord,lark  # notification outbox channels; supports discord/lark
# LARK_MENTION_MAP='{"Bobby":"ou_xxx","Thanh Vuong":"ou_xxx","Stan":"ou_xxx"}'  # owner name -> Lark open_id for @-mentions
