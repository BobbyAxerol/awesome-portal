# Default dynamic Binance futures provider. Point this to the host directory
# containing the compatible data_loader.py surface; a manifest overrides it.
PORTAL_CRYPTO_DATA_ROOT=/absolute/path/to/market-data
PORTAL_CRYPTO_RESAMPLE_ENGINE=duckdb
# PORTAL_DATASET_MANIFEST=/absolute/path/to/datasets.json
PORTAL_ARTIFACT_ROOT=artifacts/runs
