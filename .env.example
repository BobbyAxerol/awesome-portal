# Docker Compose project and public HTTP endpoint
PORTAL_STACK_NAME=portal
PORTAL_HTTP_PORT=8080
PORTAL_IMAGE_PREFIX=local/portal
PORTAL_IMAGE_TAG=dev

# Historical input is only for backtest/research consumers. Realtime market
# feeds, paper orders/fills and paper account state use separate future services.
# Generic local/CI mode is disabled; target VPS uses `required` after staging the
# approved reader wheel and mounting canonical storage read-only.
PORTAL_HISTORICAL_DATA_MODE=disabled
PORTAL_HISTORICAL_DATA_DIR=./runtime/historical-market-data
PORTAL_HMD_READER_GID=10001
PORTAL_CRYPTO_RESAMPLE_ENGINE=duckdb

# Roadmap & Task Board is served within the same web image. Local-first is the
# safe default; the smoke stack deliberately enables the audited V1 API path.
ROADMAP_TASK_BOARD_LOCAL_ONLY=true
ROADMAP_TASK_BOARD_PERSISTENCE=legacy
ROADMAP_TASK_BOARD_API_BASE=/roadmap-task-board/api
ROADMAP_TASK_BOARD_ENV=development
ROADMAP_TASK_BOARD_PUBLIC_URL=http://localhost:8080/roadmap-task-board
ROADMAP_TASK_BOARD_DEFAULT_ACTOR=local-user
ROADMAP_TASK_BOARD_LOG_LEVEL=INFO
# ROADMAP_TASK_BOARD_DISCORD_WEBHOOK_URL=  # provision only as a runtime secret
