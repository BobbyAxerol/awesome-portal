# Docker Compose project and public HTTP endpoint
PORTAL_STACK_NAME=portal
PORTAL_HTTP_PORT=8080
PORTAL_IMAGE_PREFIX=local/portal
PORTAL_IMAGE_TAG=dev

# The directory mounted read-only into the QuantBT API. It must contain the
# existing Pool Alpha-compatible data_loader.py surface when market runs are
# enabled. Keep real market data and credentials outside Git.
PORTAL_MARKET_DATA_DIR=./runtime/market-data
PORTAL_CRYPTO_RESAMPLE_ENGINE=duckdb
