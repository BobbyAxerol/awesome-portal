# EDS-11R4/R5 extension to the immutable Manager-v2 V1 location pack.
#
# This file is rendered only with SOURCE_PROXY_MANAGER_EXTENSION_SET=eds11r-r4-r5
# and is appended to the already-imported V1 pack.  It deliberately has no
# issuer location of its own: all four fixed routes use the V1 private issuer,
# TLS 1.3 mTLS leaf and per-request delegated Manager JWT chain.
#
# Do not add a wildcard path here.  Browser traffic never reaches the two
# event-ledger routes; their opaque lease and cursor stay in the Edge worker.

location = /portal/execution/v2/manager/market/latest {
    limit_except GET { deny all; }
    limit_req zone=manager_v2_paper_read burst=20 nodelay;
    limit_req_status 429;
    auth_request /_manager_v2_issue;
    auth_request_set $manager_v2_authorization $upstream_http_x_manager_authorization;
    proxy_pass_request_headers off;
    proxy_set_header Host manager-facade;
    proxy_set_header Accept application/json;
    proxy_set_header Authorization $manager_v2_authorization;
    proxy_set_header X-Request-ID $request_id;
    proxy_ssl_protocols TLSv1.3;
    proxy_ssl_certificate /run/secrets/manager-v2-client.pem;
    proxy_ssl_certificate_key /run/secrets/manager-v2-client.pem;
    proxy_ssl_trusted_certificate /run/secrets/manager-v2-ca.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 1;
    proxy_ssl_server_name on;
    proxy_ssl_name manager-facade;
    proxy_ssl_session_reuse off;
    proxy_pass https://127.0.0.1:8023;
}

