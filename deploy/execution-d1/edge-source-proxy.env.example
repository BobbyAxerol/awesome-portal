# D2 dark-render values only. D1 must not pull or start either image.
PORTAL_EXECUTION_EDGE_IMAGE=ghcr.io/your-github-owner/portal-execution-edge@sha256:REPLACE_WITH_DIGEST
PORTAL_SOURCE_PROXY_IMAGE=ghcr.io/your-github-owner/portal-source-proxy@sha256:REPLACE_WITH_DIGEST
EDGE_PRIVATE_BIND_IP=10.70.0.2
EDGE_SECRET_DIRECTORY=/srv/primus/portal/execution-edge/secrets
SOURCE_PROXY_SECRET_DIRECTORY=/srv/primus/portal/source-proxy/secrets
SOURCE_PROXY_CONFIG_FILE=/srv/primus/portal/source-proxy/nginx.conf
PORTAL_BRIDGE_CIDR=172.23.0.0/24
PORTAL_BRIDGE_GATEWAY_IP=172.23.0.1
SOURCE_PROXY_PRIVATE_PORT=8444

EDGE_ENVIRONMENT=paper
EDGE_DELEGATION_ISSUER=portal-control-api
EDGE_DELEGATION_AUDIENCE=portal-execution-edge-paper
EDGE_SOURCE_ORIGIN=https://172.23.0.1:8444
EDGE_SOURCE_GATEWAY_DIGEST=sha256:4f63dc9949f810_REPLACE_WITH_FULL_DIGEST
EDGE_SOURCE_CLIENT_IDENTITY_FILE=/run/secrets/source-proxy-client.pem
EDGE_SOURCE_API_KEY_FILE=/run/secrets/source-proxy-admission-token
EDGE_PROBE_ALPHA_ID=

# All source/projection/realtime/screen capabilities remain dark.
EDGE_PROJECTION_INGESTION_ENABLED=false
EDGE_REALTIME_SSE_ENABLED=false
EDGE_ANALYTICS_QUERY_ENABLED=false
EDGE_ANALYTICS_SOURCE_PROFILE=fixture
