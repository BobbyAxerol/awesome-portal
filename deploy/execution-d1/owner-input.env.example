# EX-BE-02-LIVE D1 owner input. Copy outside Git, keep mode 0600, and fill
# values through the approved private channel. The preflight parser never
# sources this file and never prints values.
INPUT_VERSION=portal.execution-d1.owner-input.v1
OWNER=
OWNER_CONFIRMED_AT_UTC=
D1_AUTHORIZED=false
D1_CHANGE_WINDOW_START_UTC=
D1_CHANGE_WINDOW_END_UTC=
ROLLBACK_OWNER=

# DigitalOcean Singapore Research Cell
SGP_PROVIDER=digitalocean
SGP_REGION=sgp1
SGP_STABLE_PUBLIC_IP=
SGP_RESERVED_IP=
SGP_PUBLIC_IP_CONFIRMED_STATIC=false
SGP_CLOUD_FIREWALL=

# AWS Hong Kong Execution Cell
AWS_SSH_HOST=
AWS_SSH_PORT=22
AWS_SSH_USER=bobby
AWS_SSH_ED25519_FINGERPRINT=
AWS_REGION=ap-east-1
AWS_INSTANCE_ID=
AWS_PUBLIC_IPV4=
AWS_ELASTIC_IP=
# Optional for D1 readiness; mandatory at the production metadata stop-gate.
AWS_EIP_ALLOCATION_ID=
AWS_SECURITY_GROUP_ID=
AWS_VPC_ID=
AWS_SUBNET_ID=
# Optional for host-to-host D1; mandatory at the production conflict-proof gate.
AWS_ROUTE_TABLE_ID=
AWS_SG_CHANGE_MODE=OWNER_MANUAL

# Locked candidate network. Approval is separate from choosing candidate values.
WG_CIDR=10.70.0.0/30
WG_AWS_IP=10.70.0.2
WG_SGP_IP=10.70.0.1
WG_UDP_PORT=51820
WG_VALUES_APPROVED=false
EDGE_PRIVATE_PORT=8443
EDGE_PRIVATE_DNS=
EDGE_TLS_IDENTITY=spiffe://primusspark/portal/execution-edge/paper
PORTAL_BRIDGE_CIDR=172.23.0.0/24
SOURCE_PROXY_PRIVATE_PORT=8444
PORTAL_NETWORK_VALUES_APPROVED=false

# D4 scope is recorded now but does not authorize source traffic in D1.
FIRST_SOURCE_SCOPE=PAPER_BINANCE_USDM
FIRST_SOURCE_SCOPE_APPROVED=false
TRADING_SYSTEM_READ_IDENTITY_OWNER=

# D2/D4 decisions. They may remain pending while D1 preparation is reviewed.
PROJECTION_DB_MODE=RDS_POSTGRESQL_16
PROJECTION_DB_REGION=ap-east-1
PROJECTION_INITIAL_STORAGE_GB=20
PROJECTION_PITR_RETENTION_DAYS=7
PROJECTION_RPO_MINUTES=
PROJECTION_RTO_MINUTES=
PROJECTION_DB_DECISION_APPROVED=false

# Runtime identities are separate from SSH and from each other.
PKI_MODE=PRIVATE_OFFLINE_ROOT_SEPARATE_INTERMEDIATES
PKI_OWNER=
AWS_SECRET_DELIVERY=AWS_SSM_OR_SECRETS_MANAGER
SGP_SECRET_DELIVERY=ROOT_GROUP_FILES
JWT_ISSUER=portal-control-api
JWT_AUDIENCE=portal-execution-edge-paper
JWT_MAX_TTL_SECONDS=60
IDENTITY_DECISIONS_APPROVED=false

# D2 admission and operations decisions.
AWS_OOM_IO_REVIEW_OWNER=
D2_RESOURCE_BUDGET_APPROVED=false
OBSERVABILITY_DESTINATION=
OBSERVABILITY_OWNER=
BACKUP_OWNER=

# Permanent safety locks for this read-only runway.
ALLOW_TRADING_SYSTEM_CHANGES=false
ALLOW_TRADING_SYSTEM_DB_REDIS_CLI=false
ALLOW_COMMANDS=false
ALLOW_LIVE=false
ALLOW_DELIVERY_PROFILE_ACTIVATION=false
