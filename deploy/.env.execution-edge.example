# AWS HK only. Copy to a root-readable deployment file; never commit secrets.
PORTAL_EXECUTION_EDGE_IMAGE=ghcr.io/your-github-owner/portal-execution-edge@sha256:REPLACE_WITH_DIGEST
EDGE_PRIVATE_BIND_IP=10.70.0.2
EDGE_SECRET_DIRECTORY=/srv/primus/portal-execution-edge/secrets
EDGE_ENVIRONMENT=paper
EDGE_DELEGATION_ISSUER=portal-control-api
EDGE_DELEGATION_AUDIENCE=portal-execution-edge-paper

# D1 target origin is the AWS-local Source Proxy. The proxy owns the real
# Trading System read credential; it is never copied to Edge or SGP.
EDGE_SOURCE_ORIGIN=https://172.23.0.1:8444
# This is a deployment attestation because /v1/contracts does not expose the
# image digest. It must retain the EX-BE-01 lock prefix sha256:4f63dc9949f8.
EDGE_SOURCE_GATEWAY_DIGEST=sha256:4f63dc9949f810_REPLACE_WITH_FULL_DIGEST
# Enable only after Source Proxy provisioning supplies these separate files.
# EDGE_SOURCE_CLIENT_IDENTITY_FILE=/run/secrets/source-proxy-client.pem
# EDGE_SOURCE_API_KEY_FILE=/run/secrets/source-proxy-admission-token

# Leave empty to run only non-alpha contract/health/capability probes. Setting
# this enables four credential-gated read probes with limit=1.
EDGE_PROBE_ALPHA_ID=
EDGE_PROBE_INTERVAL_SECONDS=30
EDGE_CONNECT_TIMEOUT_MS=2000
EDGE_REQUEST_TIMEOUT_MS=5000
EDGE_QUEUE_TIMEOUT_MS=250
EDGE_MAXIMUM_CONCURRENCY=32
EDGE_MAXIMUM_RESPONSE_BYTES=2097152
EDGE_MAXIMUM_RETRIES=1
EDGE_RETRY_BACKOFF_MS=100
EDGE_RUST_LOG=info

# EX-BE-03 projection runtime is independently gated. Keep false until a
# Portal-owned AWS projection PostgreSQL and its root-only URL secret exist.
EDGE_PROJECTION_INGESTION_ENABLED=false
EDGE_PROJECTION_DATABASE_URL_FILE=/run/secrets/projection-database-url

# Dark by default. Enable only together with the SGP Control API overlay after
# projection ingestion/source integration and the EX-BE-06 acceptance run.
EDGE_REALTIME_SSE_ENABLED=false
EDGE_REALTIME_QUEUE_CAPACITY=256
EDGE_REALTIME_REPLAY_LIMIT=1024
EDGE_REALTIME_POLL_INTERVAL_MS=100
EDGE_REALTIME_POLL_BATCH=512
EDGE_REALTIME_HEARTBEAT_SECONDS=15
EDGE_REALTIME_EPOCH_JITTER_MS=5000
EDGE_REALTIME_FRESHNESS_POLICY_VERSION=paper.realtime.v1
EDGE_REALTIME_FRESHNESS_WARNING_AFTER_MS=2000
EDGE_REALTIME_FRESHNESS_STALE_AFTER_MS=10000
EDGE_REALTIME_MAXIMUM_FUTURE_SKEW_MS=2000
# OPEN | PAUSED | UNKNOWN. Keep UNKNOWN until the source adapter supplies an audited venue calendar.
EDGE_REALTIME_VENUE_SESSION=UNKNOWN

# EX-BE-07b source-backed analytics stays dark until projection parity,
# capability identity, mTLS and cross-cell performance evidence are accepted.
EDGE_ANALYTICS_QUERY_ENABLED=false
EDGE_ANALYTICS_SOURCE_PROFILE=fixture
