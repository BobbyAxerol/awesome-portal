{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primusspark.com/schemas/deployment-profile.v1.schema.json",
  "title": "Portal source-dark deployment profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": "portal.deployment-profiles.v1"},
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id", "cell", "source_branch", "compose_file",
          "project_name", "loopback_port", "public_origin", "database_namespace",
          "mutable_volumes", "services", "execution_source_enabled",
          "query_enabled", "sse_enabled", "command_enabled"
        ],
        "properties": {
          "profile_id": {"enum": ["research_sgp_stable", "execution_aws_hk_dark"]},
          "cell": {"enum": ["SGP_RESEARCH", "AWS_HK_EXECUTION"]},
          "source_branch": {"enum": ["main", "IMAGE_ONLY"]},
          "compose_file": {"type": "string", "pattern": "^deploy/[A-Za-z0-9._/-]+\\.yaml$"},
          "project_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "loopback_port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
          "public_origin": {"type": ["string", "null"]},
          "database_namespace": {"type": "string", "minLength": 3, "maxLength": 128},
          "mutable_volumes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "services": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "execution_source_enabled": {"const": false},
          "query_enabled": {"const": false},
          "sse_enabled": {"const": false},
          "command_enabled": {"const": false}
        }
      }
    }
  }
}
