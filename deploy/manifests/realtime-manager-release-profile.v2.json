    "edge_analytics_query": true,
    "edge_realtime_sse": true,
    "control_api_execution_analytics_query": true,
    "control_api_execution_realtime_sse": true,
    "edge_command_relay": false,
    "control_api_command_relay": false
  },
  "activation_order": ["paper", "sandbox", "live"],
  "rollback": {
    "disable_realtime_only": true,
    "query_remains_available": true,
    "projection_epoch_remains_active": true,
    "source_or_trading_system_mutation": false
  },
  "phase_authorization": {
    "decision": "BOBBY_APPROVED_N26_REALTIME_SSE",
    "implementation_authorized": true,
    "signed_dev_deployment_authorized": false,
    "stable_runtime_change_authorized": false,
    "trading_system_change_authorized": false
  }
