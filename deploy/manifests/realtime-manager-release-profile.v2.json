{
  "schema_version": "portal.execution.realtime-manager-release-profile.v2",
  "phase": "N26",
  "snapshot_contract": "execution.manager-realtime-snapshot.v2",
  "event_contract": "execution.realtime.v1",
  "delivery_profile": "current_projection",
  "projection_schema": "portal.execution.manager-projection.v2",
  "projection_adapter": "portal.execution.manager-projection.manager-v2.runtime.v3",
  "profiles": {
    "paper": "PAPER_BINANCE_USDM",
    "sandbox": "SANDBOX_BINANCE_USDM",
    "live": "LIVE_BINANCE_USDM"
  },
  "resources": {
    "delegated_jwt": "execution:manager-realtime",
    "snapshot": "/api/v1/execution/command-center/realtime-snapshot",
    "stream": "/api/v1/execution/command-center/stream"
  },
  "bounds": {
    "journal_batch": 512,
    "replay_limit": 1024,
