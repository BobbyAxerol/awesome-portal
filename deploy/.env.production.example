# Copy to the deployment host as .env.production. This file is deliberately
# ignored by Git; provision registry credentials separately on that host.
PORTAL_STACK_NAME=portal-stable
PORTAL_HTTP_PORT=18081
PORTAL_IMAGE_PREFIX=ghcr.io/your-github-owner/portal
PORTAL_IMAGE_TAG=sha-REPLACE_WITH_PUBLISHED_PARENT_COMMIT
# N14A stable Compose consumes exact per-service digest references from the
# accepted release manifest. Tags remain metadata only and never select bytes.
PORTAL_API_IMAGE=ghcr.io/your-github-owner/portal-portal-api@sha256:REPLACE_WITH_DIGEST
PORTAL_WEB_IMAGE=ghcr.io/your-github-owner/portal-portal-web@sha256:REPLACE_WITH_DIGEST
PORTAL_CONTROL_API_IMAGE=ghcr.io/your-github-owner/portal-control-api@sha256:REPLACE_WITH_DIGEST
PORTAL_ROADMAP_API_IMAGE=ghcr.io/your-github-owner/portal-roadmap-task-board-api@sha256:REPLACE_WITH_DIGEST

# Approved canonical historical storage for backtest/research only. The image
# contains the checksum-verified code-only reader wheel; source/collectors are
# never mounted. Resolve the numeric GID of primus-market-data-readers on host.
PORTAL_HISTORICAL_DATA_DIR=/srv/primus/historical-market-data/storage
PORTAL_HMD_READER_GID=REPLACE_WITH_NUMERIC_READER_GROUP_GID
PORTAL_CRYPTO_RESAMPLE_ENGINE=duckdb

# Roadmap & Task Board's stateful API is private behind the same web gateway.
# Do not place a real Discord webhook value in this file; use the host secret
# environment or deployment secret injection instead.
ROADMAP_TASK_BOARD_PUBLIC_URL=https://portal.primusspark.com/roadmap-task-board
ROADMAP_TASK_BOARD_DEFAULT_ACTOR=portal-service
ROADMAP_TASK_BOARD_LOG_LEVEL=INFO
PORTAL_PLANNING_SUMMARY_TIMEOUT_MS=500
PORTAL_PLANNING_SUMMARY_MAX_BYTES=65536
# ROADMAP_TASK_BOARD_CORS_ORIGINS=https://portal.example
# ROADMAP_TASK_BOARD_DISCORD_WEBHOOK_URL=
# Notification channels are explicit. When lark is enabled, the HTTPS webhook,
# signing secret and directory app credentials are injected by the deployment
# owner. The map contains tenant organization user_ids; the backend resolves
# them to app-scoped open_ids without logging either ID.
PORTAL_NOTIFY_CHANNELS=lark
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/REPLACE_WITH_BOT_HOOK
LARK_WEBHOOK_SIGN_SECRET=REPLACE_WITH_LARK_BOT_SIGN_SECRET
LARK_APP_ID=cli_REPLACE_WITH_INTERNAL_APP_ID
LARK_APP_SECRET=REPLACE_WITH_RUNTIME_SECRET
LARK_ORG_USER_ID_MAP={"bobby":"REPLACE_BOBBY_USER_ID","stan":"REPLACE_STAN_USER_ID","thanhvuong":"REPLACE_THANHVUONG_USER_ID"}
# Keep text until an owner-approved tenant probe accepts the interactive card.
LARK_MESSAGE_FORMAT=text

# ---- Control API (U07 identity BFF) — REQUIRED for the gateway wire ----
# AUTH_MODE must be cloudflare_access_local_password in production; dev mode
# would bypass authentication on the public domain.
CONTROL_API_AUTH_MODE=cloudflare_access_local_password
# Product authority cell for this deployment (not the Docker release mode).
CONTROL_API_PORTAL_ENV=research
# Public origin the browser uses; must be the real https origin or every
# login/change-password/logout is 403 (originAllowed check).
PORTAL_PUBLIC_ORIGIN=https://portal.primusspark.com
# Database credentials for the Control API PostgreSQL. Set a strong password
# here and inject it from host secrets at deploy time.
PORTAL_CONTROL_DB_USER=portal
PORTAL_CONTROL_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
PORTAL_CONTROL_DB_NAME=portal_control
# Runtime secret that signs the internal principal passed downstream.
# Generate with: openssl rand -hex 32
CONTROL_API_INTERNAL_PRINCIPAL_SECRET=REPLACE_WITH_openssl_rand_hex_32
# Independent HMAC keyrings. Keep the previous key in each JSON object until
# every cursor/plan signed by it has expired; never reuse a value across rings.
CONTROL_API_QUERY_CURSOR_ACTIVE_KEY_ID=query-k1
CONTROL_API_QUERY_CURSOR_KEYS_JSON={"query-k1":"REPLACE_WITH_DIFFERENT_openssl_rand_hex_32"}
CONTROL_API_GOVERNANCE_APPLY_ACTIVE_KEY_ID=governance-k1
CONTROL_API_GOVERNANCE_APPLY_KEYS_JSON={"governance-k1":"REPLACE_WITH_ANOTHER_openssl_rand_hex_32"}
CONTROL_API_GOVERNANCE_PLAN_TTL_SECONDS=300
# Cloudflare Access — real values for the portal application.
CLOUDFLARE_TEAM_DOMAIN=https://primussparkquant.cloudflareaccess.com
CLOUDFLARE_ACCESS_ISSUER=https://primussparkquant.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=564a9f0023fbaa7af966e1056687ae4f6d9523f052b75b83be623678ac70684e
CLOUDFLARE_ACCESS_JWKS_URI=https://primussparkquant.cloudflareaccess.com/cdn-cgi/access/certs
CLOUDFLARE_ALLOWED_EMAIL_DOMAIN=azdag.com
# Gateway upstream rollback (one line): PORTAL_WEB_UPSTREAM=portal-api:8000
PORTAL_WEB_UPSTREAM=control-api:4000
# Header/connect deadline only; accepted SSE streams remain long-lived.
CONTROL_API_PORTAL_SSE_CONNECT_TIMEOUT_MS=3000

# EX-BE-06 opt-in overlay inputs. Keep disabled until the projection source and
# cross-cell HTTP/2/SSE acceptance evidence are approved.
# CONTROL_API_FEATURE_EXECUTION_REALTIME_SSE=false
# CONTROL_API_EXECUTION_REALTIME_AUTHORITY_MODE=legacy_shadow
# CONTROL_API_FEATURE_EXECUTION_ANALYTICS_QUERY=false
# CONTROL_API_FEATURE_EXECUTION_SHADOW_QUERY=false
# CONTROL_API_FEATURE_EXECUTION_PAPER_WORKBENCH_SHADOW=false
# CONTROL_API_FEATURE_EXECUTION_COMMAND_CENTER_SNAPSHOT=false
# CONTROL_API_FEATURE_EXECUTION_COMMAND_RELAY=false
# N13B current-source reads are independently enabled per exact profile. The
# Canary BFF path deliberately reuses the Live origin/profile and adds Portal
# governance; there is no CANARY source identity.
# CONTROL_API_FEATURE_EXECUTION_CURRENT_SOURCE_PAPER=false
# CONTROL_API_FEATURE_EXECUTION_CURRENT_SOURCE_SANDBOX=false
# CONTROL_API_FEATURE_EXECUTION_CURRENT_SOURCE_LIVE=false
# EXECUTION_EDGE_PAPER_ORIGIN=https://10.70.0.2:8443
# EXECUTION_EDGE_PAPER_PROFILE_ID=PAPER_BINANCE_USDM
# EXECUTION_EDGE_PAPER_AUDIENCE=portal-execution-edge-paper
# EXECUTION_EDGE_SANDBOX_ORIGIN=https://10.70.0.2:8444
# EXECUTION_EDGE_SANDBOX_PROFILE_ID=SANDBOX_BINANCE_USDM
# EXECUTION_EDGE_SANDBOX_AUDIENCE=portal-execution-edge-sandbox
# EXECUTION_EDGE_LIVE_ORIGIN=https://10.70.0.2:8445
# EXECUTION_EDGE_LIVE_PROFILE_ID=LIVE_BINANCE_USDM
# EXECUTION_EDGE_LIVE_AUDIENCE=portal-execution-edge-live
# EXECUTION_EDGE_ORIGIN=https://10.70.0.2:8443
# EXECUTION_EDGE_ENVIRONMENT=paper
# EXECUTION_EDGE_DELEGATION_AUDIENCE=portal-execution-edge-paper
# EXECUTION_EDGE_MANAGER_V2_PROFILE_ID=PAPER_BINANCE_USDM
# CONTROL_API_EXECUTION_EDGE_SECRET_DIRECTORY=/srv/primus/control-api/execution-edge-secrets
# EXECUTION_EDGE_ANALYTICS_REQUEST_TIMEOUT_MS=5000
# EXECUTION_EDGE_ANALYTICS_MAXIMUM_CONCURRENCY=64
# EXECUTION_EDGE_ANALYTICS_MAXIMUM_QUEUE=128
# EXECUTION_EDGE_ANALYTICS_QUEUE_TIMEOUT_MS=250
# EXECUTION_EDGE_CURRENT_SOURCE_REQUEST_TIMEOUT_MS=5000
# EXECUTION_EDGE_CURRENT_SOURCE_MAX_RESPONSE_BYTES=2097152
# EXECUTION_EDGE_CURRENT_SOURCE_MAXIMUM_CONCURRENCY=64
# EXECUTION_EDGE_CURRENT_SOURCE_MAXIMUM_QUEUE=128
# EXECUTION_EDGE_CURRENT_SOURCE_QUEUE_TIMEOUT_MS=250
# N17B current Manager-v2 source is 20 r/s; Portal must stay at or below 15.
# EXECUTION_EDGE_CURRENT_SOURCE_MAX_REQUESTS_PER_SECOND=15
# EXECUTION_EDGE_CURRENT_SOURCE_MAXIMUM_PACE_WAIT_MS=1000
