# Copy to the deployment host as .env.production. This file is deliberately
# ignored by Git; provision registry credentials separately on that host.
PORTAL_STACK_NAME=portal
PORTAL_HTTP_PORT=8080
PORTAL_IMAGE_PREFIX=ghcr.io/your-github-owner/portal
PORTAL_IMAGE_TAG=sha-REPLACE_WITH_PUBLISHED_PARENT_COMMIT

# Approved canonical historical storage for backtest/research only. The image
# contains the checksum-verified code-only reader wheel; source/collectors are
# never mounted. Resolve the numeric GID of primus-market-data-readers on host.
PORTAL_HISTORICAL_DATA_DIR=/srv/primus/historical-market-data/storage
PORTAL_HMD_READER_GID=REPLACE_WITH_NUMERIC_READER_GROUP_GID
PORTAL_CRYPTO_RESAMPLE_ENGINE=duckdb

# Roadmap & Task Board's stateful API is private behind the same web gateway.
# Do not place a real Discord webhook value in this file; use the host secret
# environment or deployment secret injection instead.
ROADMAP_TASK_BOARD_PUBLIC_URL=https://portal.example/roadmap-task-board
ROADMAP_TASK_BOARD_DEFAULT_ACTOR=portal-service
ROADMAP_TASK_BOARD_LOG_LEVEL=INFO
# ROADMAP_TASK_BOARD_CORS_ORIGINS=https://portal.example
# ROADMAP_TASK_BOARD_DISCORD_WEBHOOK_URL=
