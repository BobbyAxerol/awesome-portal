# Canonical SGP development channel. This file contains no secret and exists
# only to prove the dev/stable namespace boundary. Copy required secret values
# from deploy/.env.production.example into a private dev env file.
PORTAL_STACK_NAME=portal
PORTAL_HTTP_PORT=8080
PORTAL_IMAGE_PREFIX=local/portal
PORTAL_IMAGE_TAG=dev
PORTAL_PUBLIC_ORIGIN=https://dev-portal.primusspark.com

# Dev owns distinct Compose volumes/database state. Never point these values at
# portal-stable or restore a dev backup over stable.
PORTAL_CONTROL_DB_NAME=portal_control_dev
ROADMAP_TASK_BOARD_PUBLIC_URL=https://dev-portal.primusspark.com/roadmap-task-board

# N14A remains source-dark. These values are explicit even though Compose also
# defaults them to false.
CONTROL_API_FEATURE_EXECUTION_REALTIME_SSE=false
CONTROL_API_EXECUTION_REALTIME_AUTHORITY_MODE=legacy_shadow
CONTROL_API_FEATURE_EXECUTION_ANALYTICS_QUERY=false
CONTROL_API_FEATURE_EXECUTION_SHADOW_QUERY=false
CONTROL_API_FEATURE_EXECUTION_PAPER_WORKBENCH_SHADOW=false
CONTROL_API_FEATURE_EXECUTION_COMMAND_CENTER_SNAPSHOT=false
CONTROL_API_FEATURE_EXECUTION_LOCAL_R0_TASKS=false
CONTROL_API_FEATURE_EXECUTION_COMMAND_RELAY=false
# BE-R2-1 uses the same production-safe default: collect a bounded dry-run
# inventory first. Dev may set FEATURE=true and DRY_RUN=false only for its own
# `portal_control_dev` database after capturing the inventory result.
CONTROL_API_FEATURE_EXECUTION_SHARED_READ_CACHE_SWEEPER=false
CONTROL_API_EXECUTION_SHARED_READ_CACHE_SWEEPER_DRY_RUN=true
CONTROL_API_EXECUTION_SHARED_READ_CACHE_SWEEPER_INTERVAL_MS=60000
CONTROL_API_EXECUTION_SHARED_READ_CACHE_SWEEPER_STARTUP_JITTER_MS=5000
CONTROL_API_EXECUTION_SHARED_READ_CACHE_SWEEPER_MAX_RUNTIME_MS=2000
CONTROL_API_EXECUTION_SHARED_READ_CACHE_SWEEPER_BATCH_ROWS=128
CONTROL_API_EXECUTION_SHARED_READ_CACHE_SWEEPER_BATCH_BYTES=8388608
CONTROL_API_EXECUTION_SHARED_READ_CACHE_MAXIMUM_ROWS=20000
CONTROL_API_EXECUTION_SHARED_READ_CACHE_MAXIMUM_BYTES=268435456
