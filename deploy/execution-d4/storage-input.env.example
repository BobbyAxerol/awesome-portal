# D4 encrypted projection-storage decisions/evidence only. Never put keys here.
INPUT_VERSION=portal.execution-d4.storage-input.v1
OWNER=
STORAGE_APPROVED=false
AWS_INSTANCE_ID=
AWS_AVAILABILITY_ZONE=
AWS_VOLUME_ID=
AWS_EBS_ENCRYPTED=false
AWS_KMS_KEY_ID_SHA256=
AWS_DESCRIBE_VOLUME_EVIDENCE_SHA256=
EXPECTED_DEVICE=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_REPLACE
EXPECTED_FILESYSTEM_UUID=
MOUNT_PATH=/srv/primus/portal/projection-d4
DATA_DIRECTORY=/srv/primus/portal/projection-d4/postgres
FILESYSTEM=ext4
REQUIRED_MOUNT_OPTIONS=rw,nodev,nosuid,noexec
MINIMUM_SIZE_GIB=20
PROJECTION_DB_CONTAINER_UID=70
PROJECTION_DB_CONTAINER_GID=70
PROJECTION_DB_VOLUME_NAME=portal-execution-projection-pgdata-v2
