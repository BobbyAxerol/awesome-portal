# D4-only Portal Source Proxy. The listener is the Portal bridge gateway, and
# its sole upstream surface is the imported d4.paper-read.v1 location include.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 128;
}

http {
    log_format d4_source_safe escape=json
        '{"method":"$request_method","path":"$uri","status":$status,'
        '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';
    access_log /dev/stdout d4_source_safe;

    server_tokens off;
    proxy_http_version 1.1;
    proxy_connect_timeout 1s;
    proxy_read_timeout 5s;
    proxy_send_timeout 2s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_pass_request_body off;
    proxy_intercept_errors off;
    client_body_timeout 1s;
    client_max_body_size 1k;

    limit_req_zone $binary_remote_addr zone=d4_paper_read:1m rate=__SOURCE_RATE_LIMIT_RPM__r/m;

    server {
        listen __PORTAL_BRIDGE_GATEWAY_IP__:__SOURCE_PROXY_PRIVATE_PORT__ ssl;
        http2 on;
        server_name _;

        ssl_protocols TLSv1.3;
        ssl_certificate /run/secrets/source-proxy-server.crt;
        ssl_certificate_key /run/secrets/source-proxy-server.key;
        ssl_client_certificate /run/secrets/projection-ingestor-ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 2;
        ssl_session_tickets off;

        limit_req zone=d4_paper_read burst=4 nodelay;
        limit_req_status 429;

        if ($request_method != GET) {
            return 405;
        }

        # Container-local liveness only; never forwarded to Trading System.
        location = /internal/healthz {
            access_log off;
            return 200 'ok\n';
        }

        include /etc/nginx/d4-paper-read-locations.conf;

        location / {
            return 404;
        }
    }
}
