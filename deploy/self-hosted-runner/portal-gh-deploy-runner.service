[Unit]
Description=GitHub Actions Portal production deployment runner
Documentation=https://github.com/BobbyAxerol/awesome-portal/blob/main/deploy/self-hosted-runner/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal-gh-runner
Group=portal-gh-runner
WorkingDirectory=/srv/portal-gh-runner/actions-runner
Environment=HOME=/srv/portal-gh-runner
Environment=RUNNER_ALLOW_RUNASROOT=0
# Use the runner-supplied service wrapper so a controlled restart forwards
# SIGTERM as SIGINT to the listener instead of orphaning its GitHub session.
ExecStart=/srv/portal-gh-runner/actions-runner/bin/runsvc.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=5min
KillMode=process
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/srv/portal-gh-runner
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
