# BE-R2-9 non-secret last-layer inputs. Use only with the existing dev base and
# execution profile files via COMPOSE_ENV_FILES, never as standalone activation.
PORTAL_STACK_NAME=portal
PORTAL_HTTP_PORT=8080
PORTAL_PUBLIC_ORIGIN=https://dev-portal.primusspark.com
PORTAL_EXECUTION_PREVIEW_ENABLED=true
# Existing accepted dev scope; do not infer activation of private Market Context.
CONTROL_API_FEATURE_EXECUTION_MARKET_CONTEXT=false
CONTROL_API_EXECUTION_MARKET_CANDLES_SOURCE=venue_public
CONTROL_API_FEATURE_EXECUTION_PUBLIC_MARKET_CANDLES=true
CONTROL_API_FEATURE_EXECUTION_SHARED_READ_CACHE_SWEEPER=true
CONTROL_API_EXECUTION_SHARED_READ_CACHE_SWEEPER_DRY_RUN=false
# Set exact clean candidate commit and its immutable local image tag at rollout.
# PORTAL_BUILD_COMMIT=<full-candidate-sha>
# PORTAL_IMAGE_TAG=be-r2-9-<candidate-short-sha>
# CONTROL_API_SECRETS_DIR=<existing-absolute-dev-secret-directory>
