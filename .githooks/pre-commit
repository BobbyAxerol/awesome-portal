#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
source "$ROOT_DIR/.githooks/lib/access-policy.sh"

portal_require_contributor_branch

git diff --cached --check

# Portal is a monorepo. Source in apps/ and features/ is deliberately tracked
# here, while secrets and generated runtime output remain blocked below.
while IFS= read -r staged_path; do
  case "${staged_path}" in
    apps/portal/strategy/main.py)
      printf 'The protected strategy kernel cannot be modified: %s\n' "${staged_path}" >&2
      exit 1
      ;;
    *.env.example|*.env.*.example)
      # Versioned templates are safe; actual environment files remain blocked.
      ;;
    .env|.env.*|*.env|*.pem|*.key|*.p12|*.pfx|*.age|secrets/*|credentials/*)
      printf 'Refusing to stage a likely secret or local environment file: %s\n' "${staged_path}" >&2
      exit 1
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

portal_require_no_contributor_control_plane_changes

if portal_is_maintainer; then
  "$ROOT_DIR/scripts/verify-workspace.sh"
else
  "$ROOT_DIR/scripts/verify-contributor-workspace.sh"
fi
