#!/usr/bin/env bash
set -euo pipefail

branch="$(git branch --show-current)"
if [[ "${branch}" == "main" ]]; then
  echo "Direct commits to main are blocked. Commit on dev and merge after review." >&2
  exit 1
fi

git diff --cached --check

protected_file="strategy/main.py"
expected_file="strategy/PROTECTED_SHA256"
if git cat-file -e ":${protected_file}" 2>/dev/null; then
  expected="$(git show ":${expected_file}" | awk 'NR == 1 {print $1}')"
  actual="$(git show ":${protected_file}" | sha256sum | awk '{print $1}')"
  if [[ "${actual}" != "${expected}" ]]; then
    echo "Protected source changed: ${protected_file}" >&2
    echo "Expected ${expected}, got ${actual}." >&2
    exit 1
  fi
fi
