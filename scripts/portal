#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE=(docker compose --project-directory "${ROOT_DIR}" -f "${ROOT_DIR}/compose.yaml")
CURRENT_SOURCE_COMPOSE=(
  "${COMPOSE[@]}"
  -f "${ROOT_DIR}/deploy/compose.execution-current-source.yaml"
)
CURRENT_SOURCE_REALTIME_COMPOSE=(
  "${CURRENT_SOURCE_COMPOSE[@]}"
  -f "${ROOT_DIR}/deploy/compose.execution-manager-realtime.yaml"
)

usage() {
  cat <<'EOF'
Usage: ./scripts/portal <command> [arguments]

Commands:
  up       Build source and start the complete portal stack in the background.
  run      Build source and run the complete portal stack in the foreground.
  down     Stop the complete portal stack.
  logs     Follow logs from every portal service.
  status   Show status for every portal service.
  build    Build every portal service image from source.
  config   Render and validate the composed deployment configuration.
  hmd-doctor Validate the HMD mount, installed reader and release manifest.
  verify   Validate tracked source, source contracts and Compose config.
  smoke    Build, start, probe and tear down an isolated local portal stack.
  current-source-up
           Build/start the stack with the reviewed read-only Execution current-source overlay.
  current-source-config
           Render the stack with the reviewed read-only Execution current-source overlay.
  current-source-realtime-up
           Build/start current-source reads plus the exact Paper Command Center SSE overlay.
  current-source-realtime-config
           Render current-source reads plus the exact Paper Command Center SSE overlay.
EOF
}

require_docker_cli() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'Docker CLI is required but was not found in PATH.\n' >&2
    exit 1
  fi
}

require_docker_access() {
  require_docker_cli
  if ! docker info >/dev/null 2>&1; then
    printf 'Cannot access the Docker daemon. Run with sudo or configure Docker group access for this user.\n' >&2
    exit 1
  fi
}

validate_historical_data_mount() {
  "${COMPOSE[@]}" config --format json \
    | python3 "${ROOT_DIR}/scripts/validate_historical_data_mount.py" -
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "${command}" in
  up)
    require_docker_access
    validate_historical_data_mount
    exec "${COMPOSE[@]}" up --detach --build "$@"
    ;;
  run)
    require_docker_access
    validate_historical_data_mount
    exec "${COMPOSE[@]}" up --build "$@"
    ;;
  down)
    require_docker_access
    exec "${COMPOSE[@]}" down "$@"
    ;;
  logs)
    require_docker_access
    exec "${COMPOSE[@]}" logs --follow "$@"
    ;;
  status)
    require_docker_access
    exec "${COMPOSE[@]}" ps "$@"
    ;;
  build)
    require_docker_access
    exec "${COMPOSE[@]}" build "$@"
    ;;
  config)
    require_docker_cli
    exec "${COMPOSE[@]}" config "$@"
    ;;
  hmd-doctor)
    require_docker_access
    validate_historical_data_mount
    exec "${COMPOSE[@]}" run --rm --no-deps portal-api \
      python -m portal_api.historical_data_doctor "$@"
    ;;
  verify)
    exec "${ROOT_DIR}/scripts/verify-workspace.sh" "$@"
    ;;
  smoke)
    require_docker_access
    exec "${ROOT_DIR}/scripts/smoke-stack.sh" "$@"
    ;;
  current-source-up)
    require_docker_access
    validate_historical_data_mount
    exec "${CURRENT_SOURCE_COMPOSE[@]}" up --detach --build "$@"
    ;;
  current-source-config)
    require_docker_cli
    exec "${CURRENT_SOURCE_COMPOSE[@]}" config "$@"
    ;;
  current-source-realtime-up)
    require_docker_access
    validate_historical_data_mount
    exec "${CURRENT_SOURCE_REALTIME_COMPOSE[@]}" up --detach --build "$@"
    ;;
  current-source-realtime-config)
    require_docker_cli
    exec "${CURRENT_SOURCE_REALTIME_COMPOSE[@]}" config "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "${command}" >&2
    usage >&2
    exit 2
    ;;
esac
