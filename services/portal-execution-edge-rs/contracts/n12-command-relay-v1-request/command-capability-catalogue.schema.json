{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primusspark.com/contracts/trading-system.portal-command-publication.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","request_revision","source_contract_revision","source_contract_commit","owner_id","owner_accepted","partial_publication","authority","capabilities"],
  "properties": {
    "schema_version": {"const":"trading-system.portal-command-publication.v1"},
    "request_revision": {"const":"portal.execution.command-publication-request.v1"},
    "source_contract_revision": {"type":"string","minLength":1,"maxLength":128},
    "source_contract_commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "owner_id": {"type":"string","minLength":1,"maxLength":128},
    "owner_accepted": {"type":"boolean"},
    "partial_publication": {"type":"boolean"},
    "authority": {
      "type":"object","additionalProperties":false,
      "required":["dedicated_command_identity","separate_from_read_identity","portal_database_credential","portal_redis_authority","portal_cli_authority","portal_broker_authority"],
      "properties": {
        "dedicated_command_identity":{"const":true},
        "separate_from_read_identity":{"const":true},
        "portal_database_credential":{"const":false},
        "portal_redis_authority":{"const":false},
        "portal_cli_authority":{"const":false},
        "portal_broker_authority":{"const":false}
      }
    },
    "capabilities": {
      "type":"array","minItems":1,"maxItems":9,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","environments","risk_tier","effect","target_types","apply_method","apply_path","verify_method","verify_path","authentication","source_idempotent","monotonic_protection","requires_webauthn","requires_dual_approval","maximum_request_bytes","maximum_response_bytes","request_schema_sha256","receipt_schema_sha256","published","portal_reachable"],
        "properties": {
          "id":{"type":"string"},
          "environments":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"enum":["PAPER","SANDBOX","LIVE_CANARY","LIVE_FULL"]}},
          "risk_tier":{"enum":["R1_PAPER_MUTATION","R2_SANDBOX","R3_LIVE_PROTECTIVE","R4_LIVE_RISK_INCREASING"]},
          "effect":{"enum":["PROTECTIVE","RISK_INCREASING"]},
          "target_types":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["ACCOUNT","DEPLOYMENT","PORTFOLIO"]}},
          "apply_method":{"const":"POST"},
          "apply_path":{"type":"string","pattern":"^/portal/execution/v1/commands/"},
          "verify_method":{"const":"GET"},
          "verify_path":{"const":"/portal/execution/v1/command-operations/{source_operation_id}"},
          "authentication":{"const":"MTLS_AND_ONE_OPERATION_DELEGATED_JWT"},
          "source_idempotent":{"type":"boolean"},
          "monotonic_protection":{"type":"boolean"},
          "requires_webauthn":{"type":"boolean"},
          "requires_dual_approval":{"type":"boolean"},
          "maximum_request_bytes":{"type":"integer","minimum":1,"maximum":65536},
          "maximum_response_bytes":{"type":"integer","minimum":1,"maximum":1048576},
          "request_schema_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "receipt_schema_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
          "published":{"type":"boolean"},
          "portal_reachable":{"type":"boolean"}
        }
      }
    }
  }
}
