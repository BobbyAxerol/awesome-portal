{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution/market-latest-envelope.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_revision", "authority", "profile_id", "availability", "freshness", "completeness", "as_of_ms", "data"],
  "properties": {
    "schema_version": {"const": "trading-system.portal-execution.market-context-envelope.v1"},
    "contract_revision": {"const": "trading-system.portal-execution.market-context.v1"},
    "authority": {"const": "EXECUTION_CELL"},
    "profile_id": {"type": "string", "pattern": "^(?:PAPER|SANDBOX|LIVE)_[A-Z0-9_]{2,120}$"},
    "availability": {"const": "AVAILABLE"},
    "freshness": {"enum": ["FRESH", "AGING", "DEGRADED", "STALE"]},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "POLL_BOUNDED"]},
    "as_of_ms": {"type": "integer", "minimum": 0, "maximum": 8640000000000000},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "items"],
      "properties": {
        "operation_id": {"const": "managerMarketContextLatestV1"},
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["venue", "instrument", "value", "observation_kind", "observed_at_ms", "quote_currency", "provider"],
            "properties": {
              "venue": {"type": "string", "minLength": 1, "maxLength": 96},
              "instrument": {"type": "string", "minLength": 1, "maxLength": 191},
              "value": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
              "observation_kind": {"enum": ["TRADE", "MARK", "INDEX", "BAR_CLOSE"]},
              "observed_at_ms": {"type": "integer", "minimum": 0, "maximum": 8640000000000000},
              "quote_currency": {"type": "string", "minLength": 1, "maxLength": 32},
              "provider": {"type": "string", "minLength": 1, "maxLength": 96}
            }
          }
        }
      }
    }
  }
}
