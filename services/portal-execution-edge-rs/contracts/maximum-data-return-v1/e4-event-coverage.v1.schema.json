{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.execution.maximum-data.e4.event-coverage.schema.v1",
  "title": "Maximum-data E4 replay event coverage ruling",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "e2_semantic_registry_sha256", "global_ordered_journal_status", "coverage"],
  "properties": {
    "schema_version": { "type": "string" },
    "e2_semantic_registry_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "global_ordered_journal_status": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_type", "domain_id", "status", "replay_eligible", "source_basis", "owner_action_id"],
        "properties": {
          "event_type": { "type": "string", "minLength": 1 },
          "domain_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["AVAILABLE", "DERIVABLE", "CURRENT_STATE_ONLY", "NOT_RETAINED", "SOURCE_ABSENT"] },
          "replay_eligible": { "type": "boolean" },
          "source_basis": { "type": "string", "minLength": 1 },
          "owner_action_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
