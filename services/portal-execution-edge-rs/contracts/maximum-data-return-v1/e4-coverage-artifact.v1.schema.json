{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.execution.maximum-data.e4.coverage-artifact.schema.v1",
  "title": "Maximum-data E4 field operation coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "e3_coverage_manifest_sha256", "bindings"],
  "properties": {
    "schema_version": { "type": "string" },
    "e3_coverage_manifest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "schema_ref", "binding_status", "logical_operation_id", "typed_absence_id", "snapshot_semantics", "continuation_semantics", "source_status"],
        "properties": {
          "field_id": { "type": "string", "minLength": 1 },
          "schema_ref": { "type": "string", "minLength": 1 },
          "binding_status": { "enum": ["EXISTING_CONTRACT_COMPATIBLE", "E5_NAMED_OPERATION_REQUIRED", "SOURCE_OWNER_GAP"] },
          "logical_operation_id": { "type": ["string", "null"] },
          "typed_absence_id": { "type": ["string", "null"] },
          "snapshot_semantics": { "type": "string", "minLength": 1 },
          "continuation_semantics": { "type": "string", "minLength": 1 },
          "source_status": { "enum": ["AVAILABLE_CURRENT_STATE_ONLY", "AVAILABLE_RETAINED_HISTORY", "EXISTS_NOT_PUBLISHED", "SOURCE_OWNER_GAP"] }
        }
      }
    }
  }
}
