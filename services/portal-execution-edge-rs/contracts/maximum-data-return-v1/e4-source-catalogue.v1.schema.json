{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.execution.maximum-data.e4.source-catalogue.schema.v1",
  "title": "Maximum-data E4 source catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "e2_semantic_registry_sha256",
    "e2_semantic_contract_sha256",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "e2_semantic_registry_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "e2_semantic_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_kind",
          "source_contract_revision",
          "source_status",
          "supported_profile_ids",
          "supported_modes",
          "history_semantics",
          "correction_semantics",
          "runtime_binding",
          "owner"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_kind": { "type": "string", "minLength": 1 },
          "source_contract_revision": { "type": "string", "minLength": 1 },
          "source_status": { "enum": ["AVAILABLE_CURRENT_STATE_ONLY", "AVAILABLE_RETAINED_HISTORY", "EXISTS_NOT_PUBLISHED", "SOURCE_OWNER_GAP"] },
          "supported_profile_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "supported_modes": { "type": "array", "items": { "enum": ["PAPER", "SANDBOX", "LIVE"] } },
          "history_semantics": { "type": "string", "minLength": 1 },
          "correction_semantics": { "type": "string", "minLength": 1 },
          "runtime_binding": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
