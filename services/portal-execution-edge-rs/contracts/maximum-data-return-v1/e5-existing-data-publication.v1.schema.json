{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.execution.maximum-data.e5.existing-data-publication.schema.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "status",
    "e3_coverage_manifest_sha256",
    "e4_contract_manifest_sha256",
    "manager_census_sha256",
    "current_source_map_sha256",
    "manager_compatibility_authority_revision",
    "current_source_contract_version",
    "manager_runtime_contract_revision",
    "page_bounds",
    "entries",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "portal.execution.maximum-data.e5.existing-data-publication.v1" },
    "phase": { "const": "EX-DP-05" },
    "status": { "const": "EDGE_IMPLEMENTED_SOURCE_DARK" },
    "e3_coverage_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "e4_contract_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "manager_census_sha256": { "$ref": "#/$defs/sha256" },
    "current_source_map_sha256": { "$ref": "#/$defs/sha256" },
    "manager_compatibility_authority_revision": { "type": "string", "minLength": 1 },
    "current_source_contract_version": { "type": "string", "minLength": 1 },
    "manager_runtime_contract_revision": { "type": "string", "minLength": 1 },
    "page_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_page_rows", "maximum_response_bytes", "maximum_cursor_bytes", "total_history_cap"],
      "properties": {
        "maximum_page_rows": { "const": 200 },
        "maximum_response_bytes": { "const": 1048576 },
        "maximum_cursor_bytes": { "const": 4096 },
        "total_history_cap": { "const": false }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": { "$ref": "#/$defs/entry" }
    },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "profile": { "enum": ["PAPER", "SANDBOX", "LIVE", "CANARY"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "implementation",
        "publication_state",
        "manager_relation_id",
        "existing_contract_id",
        "portal_delegate_id",
        "typed_status_code",
        "typed_absence_id",
        "profiles"
      ],
      "properties": {
        "field_id": { "type": "string", "minLength": 1 },
        "implementation": {
          "enum": [
            "EXISTING_PORTAL_CONTRACT",
            "MANAGER_RELATION_PAGE",
            "PORTAL_DERIVED_DELEGATE",
            "TYPED_UNAVAILABLE",
            "TYPED_SOURCE_OWNER_GAP"
          ]
        },
        "publication_state": {
          "enum": [
            "IMPLEMENTED_REUSE",
            "IMPLEMENTED_MANAGER_ADAPTER",
            "IMPLEMENTED_NAMED_PORTAL_DELEGATE",
            "TYPED_UNAVAILABLE",
            "SOURCE_OWNER_GAP"
          ]
        },
        "manager_relation_id": { "type": ["string", "null"] },
        "existing_contract_id": { "type": ["string", "null"] },
        "portal_delegate_id": { "type": ["string", "null"] },
        "typed_status_code": { "type": ["string", "null"] },
        "typed_absence_id": { "type": ["string", "null"] },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_direct_source_access",
        "direct_database_access",
        "direct_redis_access",
        "raw_relation_or_sql_selection",
        "source_identity_or_credential",
        "source_network_change",
        "command_or_cli_execution",
        "runtime_activation",
        "typed_unavailable_retained"
      ],
      "properties": {
        "browser_direct_source_access": { "const": false },
        "direct_database_access": { "const": false },
        "direct_redis_access": { "const": false },
        "raw_relation_or_sql_selection": { "const": false },
        "source_identity_or_credential": { "const": false },
        "source_network_change": { "const": false },
        "command_or_cli_execution": { "const": false },
        "runtime_activation": { "const": false },
        "typed_unavailable_retained": { "const": true }
      }
    }
  }
}
