{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primusspark.com/schemas/portal-execution-eds12-release-qualification.v1.schema.json",
  "title": "Portal Execution EDS-12 release qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "decision",
    "runtime_effect",
    "baseline",
    "profiles",
    "failure_matrix",
    "evidence_inputs",
    "source_extensions",
    "release_gates",
    "authority",
    "rollback",
    "artifact_generation"
  ],
  "properties": {
    "schema_version": {"const": "portal.execution.eds12-release-qualification.v1"},
    "phase": {"const": "EDS-12"},
    "decision": {"const": "EDS12_QUALIFICATION_READY_DEPLOYED_EVIDENCE_PENDING"},
    "runtime_effect": {"const": "NONE"},
    "baseline": {"type": "object"},
    "profiles": {"type": "array", "minItems": 4, "maxItems": 4},
    "failure_matrix": {"type": "object"},
    "evidence_inputs": {"type": "array", "minItems": 1},
    "source_extensions": {"type": "array", "minItems": 3, "maxItems": 3},
    "release_gates": {"type": "object"},
    "authority": {"type": "object"},
    "rollback": {"type": "object"},
    "artifact_generation": {"type": "object"}
  }
}
