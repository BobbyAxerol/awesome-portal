{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution/eds08-source-event-envelope.v1.schema.json",
  "title": "Portal EDS-08 authoritative source event envelope",
  "description": "A source-owned event envelope for an accepted EDS-08 event class. It is not a current Manager-v2 page and it never authorizes a browser, direct database or command path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_revision",
    "stream_id",
    "profile",
    "source_epoch",
    "source_sequence",
    "event_id",
    "operation",
    "occurred_at_ms",
    "published_at_ms",
    "entity",
    "causation_id",
    "correlation_id",
    "correction_of_event_id",
    "tombstone_of_event_id",
    "payload_schema_revision",
    "payload_sha256",
    "payload",
    "resume_cursor"
  ],
  "properties": {
    "schema_version": {"const": "portal.execution.eds08.source-event.v1"},
    "contract_revision": {"$ref": "#/$defs/Identifier"},
    "stream_id": {"$ref": "#/$defs/Identifier"},
    "profile": {"$ref": "#/$defs/Profile"},
    "source_epoch": {"$ref": "#/$defs/Identifier"},
    "source_sequence": {"$ref": "#/$defs/DecimalU64"},
    "event_id": {"$ref": "#/$defs/Identifier"},
    "operation": {"enum": ["UPSERT", "CORRECTION", "TOMBSTONE"]},
    "occurred_at_ms": {"$ref": "#/$defs/UtcEpochMs"},
    "published_at_ms": {"$ref": "#/$defs/UtcEpochMs"},
    "entity": {"$ref": "#/$defs/Entity"},
    "causation_id": {"oneOf": [{"$ref": "#/$defs/Identifier"}, {"type": "null"}]},
    "correlation_id": {"oneOf": [{"$ref": "#/$defs/Identifier"}, {"type": "null"}]},
    "correction_of_event_id": {"oneOf": [{"$ref": "#/$defs/Identifier"}, {"type": "null"}]},
    "tombstone_of_event_id": {"oneOf": [{"$ref": "#/$defs/Identifier"}, {"type": "null"}]},
    "payload_schema_revision": {"$ref": "#/$defs/Identifier"},
    "payload_sha256": {"$ref": "#/$defs/Sha256"},
    "payload": {"type": "object"},
    "resume_cursor": {"oneOf": [{"$ref": "#/$defs/OpaqueCursor"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "CORRECTION"}}, "required": ["operation"]},
      "then": {"properties": {"correction_of_event_id": {"$ref": "#/$defs/Identifier"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "TOMBSTONE"}}, "required": ["operation"]},
      "then": {"properties": {"tombstone_of_event_id": {"$ref": "#/$defs/Identifier"}}}
    }
  ],
  "$defs": {
    "Identifier": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9._:-]+$"},
    "Sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "DecimalU64": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "description": "Exact unsigned 64-bit source sequence encoded as a decimal string. Consumers must reject a value greater than 18446744073709551615."},
    "UtcEpochMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "OpaqueCursor": {"type": "string", "minLength": 1, "maxLength": 4096},
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "mode", "profile_id", "venue_id", "resource_kind", "resource_id", "filter_digest"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/Identifier"},
        "mode": {"enum": ["PAPER", "SANDBOX", "LIVE"]},
        "profile_id": {"$ref": "#/$defs/Identifier"},
        "venue_id": {"$ref": "#/$defs/Identifier"},
        "resource_kind": {"$ref": "#/$defs/Identifier"},
        "resource_id": {"$ref": "#/$defs/Identifier"},
        "filter_digest": {"$ref": "#/$defs/Sha256"}
      }
    },
    "Entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_kind", "entity_id", "entity_version"],
      "properties": {
        "entity_kind": {"$ref": "#/$defs/Identifier"},
        "entity_id": {"$ref": "#/$defs/Identifier"},
        "entity_version": {"$ref": "#/$defs/DecimalU64"}
      }
    }
  }
}
