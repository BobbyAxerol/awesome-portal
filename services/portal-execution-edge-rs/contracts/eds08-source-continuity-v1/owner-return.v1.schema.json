{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution/eds08-owner-return.v1.schema.json",
  "title": "Portal EDS-08 sanitized source-owner return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_revision",
    "publication_state",
    "source_revision",
    "owner_id",
    "owner_accepted",
    "entries",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "trading-system.portal.execution.eds08-owner-return.v1"},
    "request_revision": {"const": "portal.execution.eds08.source-continuity-owner-request.v1"},
    "publication_state": {"enum": ["PENDING_TEMPLATE_NOT_EVIDENCE", "OWNER_RETURN"]},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 192},
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner_accepted": {"type": "boolean"},
    "entries": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/Entry"}
    },
    "authority": {"$ref": "#/$defs/Authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"publication_state": {"const": "PENDING_TEMPLATE_NOT_EVIDENCE"}}, "required": ["publication_state"]},
      "then": {"properties": {"owner_accepted": {"const": false}}}
    }
  ],
  "$defs": {
    "Identifier": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9._:-]+$"},
    "Sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "state",
        "contract_revision",
        "schema_sha256",
        "fixture_index_sha256",
        "acceptance_evidence_sha256",
        "event_class_id",
        "event_contract",
        "capability_contract",
        "reason"
      ],
      "properties": {
        "gap_id": {"$ref": "#/$defs/Identifier"},
        "state": {"enum": ["EVENT_SOURCE_ACCEPTED", "CAPABILITY_ACCEPTED_NON_EVENT", "SOURCE_GAP_CONFIRMED"]},
        "contract_revision": {"oneOf": [{"$ref": "#/$defs/Identifier"}, {"type": "null"}]},
        "schema_sha256": {"oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "fixture_index_sha256": {"oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "acceptance_evidence_sha256": {"oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "event_class_id": {"oneOf": [{"$ref": "#/$defs/Identifier"}, {"type": "null"}]},
        "event_contract": {"oneOf": [{"$ref": "#/$defs/EventContract"}, {"type": "null"}]},
        "capability_contract": {"oneOf": [{"$ref": "#/$defs/CapabilityContract"}, {"type": "null"}]},
        "reason": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2048}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "EVENT_SOURCE_ACCEPTED"}}, "required": ["state"]},
          "then": {
            "properties": {
              "contract_revision": {"$ref": "#/$defs/Identifier"},
              "schema_sha256": {"$ref": "#/$defs/Sha256"},
              "fixture_index_sha256": {"$ref": "#/$defs/Sha256"},
              "acceptance_evidence_sha256": {"$ref": "#/$defs/Sha256"},
              "event_class_id": {"$ref": "#/$defs/Identifier"},
              "event_contract": {"$ref": "#/$defs/EventContract"},
              "capability_contract": {"type": "null"},
              "reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "CAPABILITY_ACCEPTED_NON_EVENT"}}, "required": ["state"]},
          "then": {
            "properties": {
              "contract_revision": {"$ref": "#/$defs/Identifier"},
              "schema_sha256": {"$ref": "#/$defs/Sha256"},
              "fixture_index_sha256": {"$ref": "#/$defs/Sha256"},
              "acceptance_evidence_sha256": {"$ref": "#/$defs/Sha256"},
              "event_class_id": {"type": "null"},
              "event_contract": {"type": "null"},
              "capability_contract": {"$ref": "#/$defs/CapabilityContract"},
              "reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "SOURCE_GAP_CONFIRMED"}}, "required": ["state"]},
          "then": {
            "properties": {
              "contract_revision": {"type": "null"},
              "schema_sha256": {"type": "null"},
              "fixture_index_sha256": {"type": "null"},
              "acceptance_evidence_sha256": {"type": "null"},
              "event_class_id": {"type": "null"},
              "event_contract": {"type": "null"},
              "capability_contract": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "EventContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "profile_scope", "sequence_encoding", "retention_floor_declared", "correction_tombstone_supported", "snapshot_tail_supported", "cross_profile_rejection", "resumable_cursor"],
      "properties": {
        "stream_id": {"$ref": "#/$defs/Identifier"},
        "profile_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PAPER", "SANDBOX", "LIVE"]}},
        "sequence_encoding": {"const": "DECIMAL_STRING_U64"},
        "retention_floor_declared": {"const": true},
        "correction_tombstone_supported": {"const": true},
        "snapshot_tail_supported": {"const": true},
        "cross_profile_rejection": {"const": true},
        "resumable_cursor": {"const": true}
      }
    },
    "CapabilityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "profile_scope", "semantics"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/Identifier"},
        "profile_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PAPER", "SANDBOX", "LIVE", "CANARY"]}},
        "semantics": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "Authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_credentials", "contains_private_keys", "contains_dsn_or_raw_sql", "contains_raw_business_rows", "portal_runtime_flags_changed", "portal_direct_database_or_redis_authority", "portal_command_or_cli_authority"],
      "properties": {
        "contains_credentials": {"const": false},
        "contains_private_keys": {"const": false},
        "contains_dsn_or_raw_sql": {"const": false},
        "contains_raw_business_rows": {"const": false},
        "portal_runtime_flags_changed": {"const": false},
        "portal_direct_database_or_redis_authority": {"const": false},
        "portal_command_or_cli_authority": {"const": false}
      }
    }
  }
}
