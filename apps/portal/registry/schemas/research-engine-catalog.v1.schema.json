{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/research-engine-catalog.v1.schema.json",
  "title": "Research Engine Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_revision", "releases", "routes", "modes", "claims", "evidence_contract"],
  "properties": {
    "schema_version": {"const": "research-engine-catalog.v1"},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "releases": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/release"}},
    "routes": {"type": "array", "minItems": 14, "maxItems": 32, "items": {"$ref": "#/$defs/route"}},
    "modes": {"type": "array", "minItems": 5, "maxItems": 8, "items": {"$ref": "#/$defs/mode"}},
    "claims": {"type": "array", "minItems": 7, "maxItems": 16, "items": {"$ref": "#/$defs/claim"}},
    "evidence_contract": {"$ref": "#/$defs/evidenceContract"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "role", "package", "version", "dist_info_record_sha256", "wheel_sha256"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "role": {"enum": ["current", "historical_reader"]},
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[a-z0-9.+]*$"},
        "dist_info_record_sha256": {"$ref": "#/$defs/sha256"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "native_dependency": {"$ref": "#/$defs/nativeDependency"},
        "trial_ceiling": {"type": "integer", "minimum": 1, "maximum": 100000},
        "optimizer_defaults": {"$ref": "#/$defs/optimizerDefaults"},
        "submission_constraints": {"$ref": "#/$defs/submissionConstraints"}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "current"}}, "required": ["role"]},
          "then": {"required": ["trial_ceiling", "optimizer_defaults", "submission_constraints"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["trial_ceiling"]},
                {"required": ["optimizer_defaults"]},
                {"required": ["submission_constraints"]}
              ]
            }
          }
        }
      ]
    },
    "nativeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "dist_info_record_sha256", "wheel_sha256", "platform_marker"],
      "properties": {
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[a-z0-9.+]*$"},
        "dist_info_record_sha256": {"$ref": "#/$defs/sha256"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "platform_marker": {"type": "string", "minLength": 3, "maxLength": 180}
      }
    },
    "optimizerDefaultScalar": {"type": ["string", "number", "boolean", "null"]},
    "optimizerDefaultValue": {
      "anyOf": [
        {"$ref": "#/$defs/optimizerDefaultScalar"},
        {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/optimizerDefaultScalar"}}
      ]
    },
    "optimizerDefaultField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "default_value", "value_source", "override_state", "detail"],
      "properties": {
        "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "default_value": {"$ref": "#/$defs/optimizerDefaultValue"},
        "value_source": {"const": "RELEASE_DEFAULT"},
        "override_state": {"enum": ["LOCKED", "OVERRIDE_ALLOWED"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "optimizerGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "fields"],
      "properties": {
        "group_id": {"enum": ["study", "sampler", "objective", "candidate_selection"]},
        "fields": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/optimizerDefaultField"}}
      }
    },
    "optimizerDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "groups"],
      "properties": {
        "schema_version": {"const": "research.optimizer-defaults.v1"},
        "groups": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/optimizerGroup"}, {"properties": {"group_id": {"const": "study"}}}]},
            {"allOf": [{"$ref": "#/$defs/optimizerGroup"}, {"properties": {"group_id": {"const": "sampler"}}}]},
            {"allOf": [{"$ref": "#/$defs/optimizerGroup"}, {"properties": {"group_id": {"const": "objective"}}}]},
            {"allOf": [{"$ref": "#/$defs/optimizerGroup"}, {"properties": {"group_id": {"const": "candidate_selection"}}}]}
          ],
          "items": false
        }
      }
    },
    "submissionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "optimization_overrides", "accepted_trial_count", "early_stopping", "random_seed", "reason"],
      "properties": {
        "profile_id": {"const": "p10.fixed-qualification.v1"},
        "optimization_overrides": {"const": "FORBIDDEN"},
        "accepted_trial_count": {"const": 1},
        "early_stopping": {"const": "MUST_BE_NULL"},
        "random_seed": {"const": "MUST_BE_NULL"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "integration", "evidence", "admission"],
      "properties": {
        "engine": {"enum": ["ENGINE_SUPPORTED", "ENGINE_PARTIAL", "ENGINE_DEFERRED"]},
        "integration": {"enum": ["ADAPTER_AVAILABLE", "INTEGRATION_GAP", "DEFERRED_BY_PORTAL"]},
        "evidence": {"enum": ["EVIDENCE_MAPPED", "EVIDENCE_GAP", "NOT_APPLICABLE"]},
        "admission": {"enum": ["P04_BASELINE_ONLY", "NOT_ADMITTED", "DEFERRED"]}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "family", "execution_contract", "factory", "factory_kwargs", "backend", "report_levels", "default_for_new_runs", "axes", "reason", "required_input_class"],
      "properties": {
        "route_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "execution_contract": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "factory": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "factory_kwargs": {"type": "object", "additionalProperties": {"type": "string"}},
        "backend": {"type": "string", "minLength": 1, "maxLength": 80},
        "report_levels": {"type": "array", "minItems": 1, "items": {"enum": ["minimal", "standard", "audit", "score"]}},
        "default_for_new_runs": {"type": "boolean"},
        "axes": {"$ref": "#/$defs/axes"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "required_input_class": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode_id", "display_name", "valid_schedules", "default_schedule", "objective_summary", "suspect", "artifact_fields", "when_to_use", "rules"],
      "properties": {
        "mode_id": {"type": "string", "pattern": "^mode_[1-5]_[a-z0-9_]+$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "valid_schedules": {"type": "array", "minItems": 1, "items": {"enum": ["global", "per_fold_decay", "per_fold_causal"]}},
        "default_schedule": {"enum": ["global", "per_fold_decay", "per_fold_causal"]},
        "objective_summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "suspect": {"type": "string", "minLength": 1, "maxLength": 500},
        "artifact_fields": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "when_to_use": {"type": "string", "minLength": 1, "maxLength": 400},
        "rules": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "facts": {"$ref": "#/$defs/modeFacts"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "engine_certification", "numeric_guarantee", "never_claims"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "engine_certification": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"},
        "numeric_guarantee": {"type": "string", "minLength": 1, "maxLength": 400},
        "never_claims": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "required_fields", "writer_state"],
      "properties": {
        "schema_id": {"const": "research-run-evidence.v1"},
        "required_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "engine_release_id",
              "route_id",
              "effective_spec_digest",
              "market_data_content_hash",
              "report_level",
              "selection_resolution",
              "result_summary"
            ]
          }
        },
        "writer_state": {"const": "P05_OWNED_NOT_ACTIVE"}
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lines", "sha256", "anchor"],
      "properties": {
        "path": {"type": "string", "pattern": "^quantbt/[A-Za-z0-9_./-]{1,200}\\.py$"},
        "lines": {"type": "string", "pattern": "^[1-9][0-9]{0,5}-[1-9][0-9]{0,5}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "anchor": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "notPublishedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"const": "NOT_PUBLISHED"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 400},
        "source": {"$ref": "#/$defs/sourceLocator"}
      }
    },
    "scheduleFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "validation_claim", "chronological_validation_claim", "causality_claim", "causality_schedule_v2", "oos_use", "params_semantics", "cert_cap", "source"],
      "properties": {
        "schedule": {"enum": ["global", "per_fold_decay", "per_fold_causal"]},
        "validation_claim": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
        "chronological_validation_claim": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
        "causality_claim": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
        "causality_schedule_v2": {"enum": ["retrospective_global_v2", "trusted_strategy_global_v2", "engine_enforced_per_fold_v2", "engine_enforced_nested_v2"]},
        "oos_use": {"enum": ["USED", "NOT_USED"]},
        "oos_use_condition": {"type": "string", "minLength": 1, "maxLength": 300},
        "params_semantics": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
        "cert_cap": {"$ref": "#/$defs/notPublishedFact"},
        "source": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/sourceLocator"}}
      }
    },
    "objectiveFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "direction", "selection_metrics", "stages", "coefficients", "source"],
      "properties": {
        "state": {"const": "PUBLISHED"},
        "direction": {"enum": ["maximize", "minimize"]},
        "selection_metrics": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "formula_id", "formula"],
            "properties": {
              "stage": {"enum": ["is_search", "oos_candidate_selection", "fixed_or_post_selection_evaluation"]},
              "formula_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
              "formula": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        },
        "coefficients": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
              "release_default": {"type": ["string", "null"], "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
              "note": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        },
        "note": {"type": "string", "minLength": 1, "maxLength": 300},
        "source": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/sourceLocator"}}
      }
    },
    "readsFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "selection_inputs", "retention", "source"],
      "properties": {
        "state": {"const": "PUBLISHED"},
        "selection_inputs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "retention": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,119}$"},
        "source": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/sourceLocator"}}
      }
    },
    "modeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_release_id", "schedules", "objective", "reads", "avoid_when"],
      "properties": {
        "source_release_id": {"type": "string", "pattern": "^er_[a-z0-9_]{1,40}$"},
        "schedules": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/scheduleFact"}},
        "objective": {"oneOf": [{"$ref": "#/$defs/objectiveFact"}, {"$ref": "#/$defs/notPublishedFact"}]},
        "reads": {"oneOf": [{"$ref": "#/$defs/readsFact"}, {"$ref": "#/$defs/notPublishedFact"}]},
        "avoid_when": {"$ref": "#/$defs/notPublishedFact"}
      }
    }
  }
}
