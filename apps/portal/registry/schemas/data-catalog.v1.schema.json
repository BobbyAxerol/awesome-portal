{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/data-catalog.v1.schema.json",
  "title": "Portal Data Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_revision", "families"],
  "properties": {
    "schema_version": {"const": "data-catalog.v1"},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "families": {
      "type": "array",
      "items": {"$ref": "#/$defs/family"},
      "maxItems": 64
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "kind",
        "schema_version",
        "activated",
        "release_manifest",
        "quality"
      ],
      "properties": {
        "family_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "kind": {
          "enum": ["candle", "matrix", "metrics", "orderbook"]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}\\.v[0-9]+$"
        },
        "activated": {"type": "boolean"},
        "release_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_sha256", "accepted_at"],
          "properties": {
            "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "accepted_at": {"type": "string", "format": "date-time"}
          }
        },
        "quality": {"$ref": "#/$defs/qualityProfile"}
      }
    },
    "qualityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_gap_ratio", "max_duplicate_rows"],
      "properties": {
        "max_gap_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_duplicate_rows": {"type": "integer", "minimum": 0}
      }
    }
  }
}
