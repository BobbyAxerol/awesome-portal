  "modes": [
    {
      "mode_id": "mode_1_decay",
      "display_name": "Decay robustness",
      "valid_schedules": ["global", "per_fold_decay"],
      "default_schedule": "global",
      "objective_summary": "Ranks OOS stability against IS-to-OOS decay.",
      "suspect": "A high average OOS score with broad decay dispersion requires review.",
      "artifact_fields": ["fold_decay", "top_parameter_frequency"],
      "when_to_use": "Use when a frozen candidate pool needs an explicit decay diagnostic.",
      "rules": ["Do not relabel global output as strict outer OOS.", "Keep selected separate from best."]
    },
    {
      "mode_id": "mode_2_sbb",
      "display_name": "Stationary bootstrap robustness",
      "valid_schedules": ["global"],
      "default_schedule": "global",
      "objective_summary": "Scores an IS-only stationary bootstrap robustness estimate.",
      "suspect": "Bootstrap confidence is not out-of-sample proof.",
      "artifact_fields": ["bootstrap_samples", "bootstrap_decay"],
      "when_to_use": "Use for robustness calibration, not to make an OOS claim.",
      "rules": ["The current Portal proxy is not an engine certificate."]
    },
    {
      "mode_id": "mode_3_flat_minima",
      "display_name": "Flat minima",
      "valid_schedules": ["global"],
      "default_schedule": "global",
      "objective_summary": "Selects a stable plateau rather than a single sharp optimum.",
      "suspect": "A centroid can be unevaluated and must not be silently promoted as a trial.",
      "artifact_fields": ["robust_candidates", "selection_target"],
      "when_to_use": "Use when parameter stability is more meaningful than one peak score.",
      "rules": ["Centroid references are explicit.", "No fold-last fallback."]
    },
    {
      "mode_id": "mode_4_is_only_robust",
      "display_name": "IS-only robust",
      "valid_schedules": ["global", "per_fold_causal"],
      "default_schedule": "global",
      "objective_summary": "Combines robust IS subperiod statistics with explicit penalties.",
      "suspect": "Good central tendency with high temporal dispersion is a warning, not a pass.",
      "artifact_fields": ["subperiod_scores", "dispersion"],
      "when_to_use": "Use for train-only selection diagnostics or causal per-fold experiments.",
      "rules": ["Per-fold causal requires its own evidence lane."]
    },
    {
      "mode_id": "mode_5_full_robust",
      "display_name": "Full-sample robust",
      "valid_schedules": ["global"],
      "default_schedule": "global",
      "objective_summary": "Calibrates robustness on the full supplied sample.",
      "suspect": "Full-sample selection must never be described as OOS evidence.",
      "artifact_fields": ["full_sample_used_for_selection", "robust_candidates"],
      "when_to_use": "Use only for calibration where the full-sample label is explicit.",
      "rules": ["Publication labels must retain the full-sample disclosure."]
    }
  ],
