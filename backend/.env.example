# Export these in the process environment (or load this file through your process manager).
# `production` deliberately has no default CORS origin: set an explicit HTTPS
# allowlist only when the frontend is hosted on another origin.
PORTAL_ENV=development
PORTAL_DATABASE_PATH=data/portal.db
PORTAL_FILE=quant_trading_ecosystem_architecture_migration_portal_vi.html
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000
PORTAL_DEFAULT_ACTOR=local-user
PORTAL_PUBLIC_URL=http://127.0.0.1:8000
PORTAL_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
PORTAL_LOG_LEVEL=INFO

# Optional: leave empty to disable external notification delivery.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_MAX_ATTEMPTS=5
# Retry starts at this many seconds and doubles up to one hour. A delivery is
# leased while one worker posts it, preventing duplicate Discord messages.
DISCORD_WEBHOOK_RETRY_BASE_SECONDS=60
DISCORD_WEBHOOK_LEASE_SECONDS=60
