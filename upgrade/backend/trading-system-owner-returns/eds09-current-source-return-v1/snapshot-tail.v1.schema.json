{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.primusspark.com/portal/execution/eds08-snapshot-tail.v1.schema.json",
  "title": "Portal EDS-08 snapshot and tail boundary",
  "description": "The producer-defined handoff boundary for a single accepted event-class/profile/resource scope. A Portal consumer receives a snapshot at the high-watermark and tails strictly after it; it may not merge independent pages in a browser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_revision",
    "stream_id",
    "profile",
    "snapshot_id",
    "snapshot_as_of_ms",
    "snapshot_high_watermark",
    "tail_starts_after",
    "retention_floor",
    "resnapshot_required",
    "resume_cursor",
    "completeness"
  ],
  "properties": {
    "schema_version": {"const": "portal.execution.eds08.snapshot-tail.v1"},
    "contract_revision": {"$ref": "#/$defs/Identifier"},
    "stream_id": {"$ref": "#/$defs/Identifier"},
    "profile": {"$ref": "#/$defs/Profile"},
    "snapshot_id": {"$ref": "#/$defs/Identifier"},
    "snapshot_as_of_ms": {"$ref": "#/$defs/UtcEpochMs"},
    "snapshot_high_watermark": {"$ref": "#/$defs/Watermark"},
    "tail_starts_after": {"$ref": "#/$defs/Watermark"},
    "retention_floor": {"$ref": "#/$defs/RetentionFloor"},
    "resnapshot_required": {"type": "boolean"},
    "resume_cursor": {"oneOf": [{"$ref": "#/$defs/OpaqueCursor"}, {"type": "null"}]},
    "completeness": {"enum": ["COMPLETE", "PARTIAL", "RETENTION_FLOOR", "GAP"]}
  },
  "allOf": [
    {
      "if": {"properties": {"completeness": {"enum": ["RETENTION_FLOOR", "GAP"]}}, "required": ["completeness"]},
      "then": {"properties": {"resnapshot_required": {"const": true}}}
    }
  ],
  "$defs": {
    "Identifier": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9._:-]+$"},
    "Sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "DecimalU64": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"},
    "UtcEpochMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "OpaqueCursor": {"type": "string", "minLength": 1, "maxLength": 4096},
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "mode", "profile_id", "venue_id", "resource_kind", "resource_id", "filter_digest"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/Identifier"},
        "mode": {"enum": ["PAPER", "SANDBOX", "LIVE"]},
        "profile_id": {"$ref": "#/$defs/Identifier"},
        "venue_id": {"$ref": "#/$defs/Identifier"},
        "resource_kind": {"$ref": "#/$defs/Identifier"},
        "resource_id": {"$ref": "#/$defs/Identifier"},
        "filter_digest": {"$ref": "#/$defs/Sha256"}
      }
    },
    "Watermark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_epoch", "source_sequence"],
      "properties": {
        "source_epoch": {"$ref": "#/$defs/Identifier"},
        "source_sequence": {"$ref": "#/$defs/DecimalU64"}
      }
    },
    "RetentionFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_epoch", "source_sequence", "occurred_at_ms"],
      "properties": {
        "source_epoch": {"$ref": "#/$defs/Identifier"},
        "source_sequence": {"$ref": "#/$defs/DecimalU64"},
        "occurred_at_ms": {"$ref": "#/$defs/UtcEpochMs"}
      }
    }
  }
}
