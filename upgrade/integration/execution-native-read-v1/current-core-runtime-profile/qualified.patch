+    const altered=token.slice(0,-1)+(token.endsWith("A")?"B":"A");
+    expect(()=>decodeScopedReplayContinuationWithBinding(codec,altered,resolve)).toThrow(ScopedReplayError);
+    expect(resolve).not.toHaveBeenCalled();
+  });
